# =============================================================================
# OpenEvolve Development Environment Configuration
# =============================================================================
# Copy this file to .env.local and adjust values as needed for your
# local development environment.
#
# This file contains development-specific settings and should NOT be
# committed to version control.
# =============================================================================

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENV=development
LOG_LEVEL=DEBUG
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openevolve
POSTGRES_USER=openevolve
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://openevolve:changeme@localhost:5432/openevolve

# Database URL for SQLx (Rust)
DATABASE_URL=postgresql://openevolve:changeme@localhost:5432/openevolve

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=openevolve

# =============================================================================
# CACHE & MESSAGE BROKER CONFIGURATION
# =============================================================================

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# API KEYS - LLM PROVIDERS
# =============================================================================
# Configure at least one LLM provider for AI operations

# OpenAI (Required for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI (Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# OpenRouter (for multi-provider access)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq
GROQ_API_KEY=gsk-your-groq-key-here

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# HEPHAESTUS CONFIGURATION
# =============================================================================

# Hephaestus MCP Server
HEPHAESTUS_API_KEY=your-hephaestus-api-key
HEPHAESTUS_API_BASE=http://localhost:8000
HEPHAESTUS_PROJECT_ID=openevolve-workflows

# Hephaestus Database
HEPHAESTUS_DB_PATH=./data/hephaestus.db

# Monitoring Configuration
MONITORING_INTERVAL_SECONDS=60
MAX_HEALTH_CHECK_FAILURES=3
AGENT_TIMEOUT_MINUTES=30
MAX_CONCURRENT_AGENTS=10

# =============================================================================
# VIBE-KANBAN CONFIGURATION
# =============================================================================

# Vibe-Kanban Remote Server
VIBEKANBAN_REMOTE_URL=http://localhost:3000
VIBEKANBAN_REMOTE_JWT_SECRET=change-this-to-a-secure-random-string

# OAuth Configuration (for Vibe-Kanban authentication)
GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# BUBBLELABS CONFIGURATION
# =============================================================================

BUBBLELABS_API_KEY=your-bubblelabs-api-key
BUBBLELABS_BASE_URL=http://localhost:9000

# =============================================================================
# LEANAIDE CONFIGURATION
# =============================================================================

LEANAIDE_API_ENDPOINT=http://localhost:8080
LEANAIDE_MODEL=gpt-4

# =============================================================================
# KNOWLEDGE ENGINE CONFIGURATION
# =============================================================================

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=openevolve

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =============================================================================
# APPLICATION SERVER CONFIGURATION
# =============================================================================

# FastAPI Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_RELOAD=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# LLM GENERATION PARAMETERS (Default Values)
# =============================================================================
TEMPERATURE=0.7
TOP_P=0.95
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0
MAX_TOKENS=4096

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_DIR=./cache
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE_MB=500

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys for external access
API_KEY_ADMIN=
API_KEY_USER=
API_KEY_READONLY=

# =============================================================================
# MONITORING & TELEMETRY
# =============================================================================
OPENTELEMETRY_ENABLED=false
OPENTELEMETRY_ENDPOINT=http://localhost:4318

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json  # json or text
LOG_FILE=./logs/openevolve.log
LOG_ROTATION=true
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
TEST_DATABASE_URL=postgresql://openevolve:changeme@localhost:5432/openevolve_test
TEST_OPENAI_API_KEY=
TEST_ANTHROPIC_API_KEY=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable debug endpoints and features
DEBUG_ENDPOINTS=true
SWAGGER_UI=true
REDOC=true

# Auto-reload on file changes
AUTO_RELOAD=true

# =============================================================================
# NOTES
# =============================================================================
# 1. Replace all placeholder values with your actual keys and configuration
# 2. Never commit this file with real API keys to version control
# 3. Use strong, random passwords in production environments
# 4. Review CORS origins based on your development setup
# 5. Adjust rate limits based on your API quota and requirements
