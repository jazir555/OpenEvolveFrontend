# OpenEvolve Environment Configuration Template
# License: Apache 2.0
#
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control!

# =============================================================================
# Core Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
OPENEVOLVE_LOG_LEVEL=INFO

# Orchestrator port for service management
OPENEVOLVE_ORCHESTRATOR_PORT=8080

# =============================================================================
# Service Toggles (true/false)
# =============================================================================

OPENEVOLVE_SERVICES__REST_API=true
OPENEVOLVE_SERVICES__GRAPHQL_API=true
OPENEVOLVE_SERVICES__EVENT_BUS=true
OPENEVOLVE_SERVICES__MCP_SERVER=true
OPENEVOLVE_SERVICES__TELEMETRY=true

# =============================================================================
# REST API Configuration
# =============================================================================

OPENEVOLVE_REST_API__HOST=0.0.0.0
OPENEVOLVE_REST_API__PORT=8000

# CORS origins (comma-separated, or * for all)
OPENEVOLVE_REST_API__CORS_ORIGINS=*

# =============================================================================
# GraphQL Configuration
# =============================================================================

OPENEVOLVE_GRAPHQL__HOST=0.0.0.0
OPENEVOLVE_GRAPHQL__PORT=8001

# Enable GraphQL Playground (set to false in production)
OPENEVOLVE_GRAPHQL__ENABLE_PLAYGROUND=true

# =============================================================================
# Event Bus Configuration (Valkey)
# =============================================================================

OPENEVOLVE_EVENT_BUS__ENABLED=true
OPENEVOLVE_EVENT_BUS__BACKEND=valkey
OPENEVOLVE_EVENT_BUS__HOST=localhost
OPENEVOLVE_EVENT_BUS__PORT=6379

# Set if Valkey requires authentication
# OPENEVOLVE_EVENT_BUS__PASSWORD=your-password

# =============================================================================
# Telemetry Configuration (OpenTelemetry)
# =============================================================================

OPENEVOLVE_TELEMETRY__ENABLED=true
OPENEVOLVE_TELEMETRY__SERVICE_NAME=openevolve
OPENEVOLVE_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317

# Enable/disable specific telemetry features
OPENEVOLVE_TELEMETRY__METRICS_ENABLED=true
OPENEVOLVE_TELEMETRY__TRACING_ENABLED=true

# =============================================================================
# Security Configuration
# =============================================================================

# IMPORTANT: Change this in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-in-production-generate-random-string

# JWT configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API key for external access (optional)
# API_KEY=your-api-key

# =============================================================================
# Valkey Direct Configuration
# =============================================================================

VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=

# =============================================================================
# External Services (Optional)
# =============================================================================

# OpenAI API (for LLM features)
# OPENAI_API_KEY=sk-...

# Anthropic API (for Claude integration)
# ANTHROPIC_API_KEY=sk-ant-...

# Google API (for Gemini)
# GOOGLE_API_KEY=...

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (set to false in production)
DEBUG=false

# Reload on code changes (development only)
RELOAD=false

# =============================================================================
# Database (if using external database)
# =============================================================================

# DATABASE_URL=postgresql://user:password@localhost/openevolve
# DATABASE_URL=sqlite:///./openevolve.db

# =============================================================================
# Backup Configuration
# =============================================================================

# Backup directory
BACKUP_DIR=./backups

# Retention period in days
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Advanced Settings
# =============================================================================

# Maximum request size (in MB)
MAX_REQUEST_SIZE=100

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10

# Worker processes (0 = auto)
WORKERS=0

# Timeout in seconds
TIMEOUT=300
