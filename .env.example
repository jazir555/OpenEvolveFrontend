# OpenEvolve Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENV=development
LOG_LEVEL=INFO
PRODUCTION=false
DEVELOPMENT=true

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
WORKERS=1

# =============================================================================
# API KEYS - REQUIRED FOR LLM OPERATIONS
# =============================================================================
# OpenAI API Key - Required for OpenAI models
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key - Required for Claude models
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API Key - Required for Gemini models
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# OPENEVOLVE CONFIGURATION
# =============================================================================
# OpenEvolve API configuration
OPENEVOLVE_BASE_URL=http://localhost:8000
OPENEVOLVE_API_KEY=your-openevolve-api-key
MODEL_NAME=gpt-4
API_BASE=https://api.openai.com/v1

# =============================================================================
# HEPHAESTUS INTEGRATION
# =============================================================================
# Hephaestus task management system
HEPHAESTUS_API_KEY=your-hephaestus-api-key
HEPHAESTUS_API_BASE=http://localhost:8080
HEPHAESTUS_PROJECT_ID=openevolve-workflows

# =============================================================================
# BUBBLELABS INTEGRATION
# =============================================================================
# BubbleLabs enterprise system
BUBBLELABS_API_KEY=your-bubblelabs-api-key
BUBBLELABS_BASE_URL=http://localhost:9000

# =============================================================================
# LLM GENERATION PARAMETERS
# =============================================================================
# Temperature controls randomness (0.0 = deterministic, 2.0 = very random)
TEMPERATURE=0.7

# Top-p sampling (0.95 is conservative, 1.0 is full sampling)
TOP_P=0.95

# Frequency penalty (-2.0 to 2.0, reduces repetition)
FREQUENCY_PENALTY=0.0

# Presence penalty (-2.0 to 2.0, encourages new topics)
PRESENCE_PENALTY=0.0

# Maximum tokens in response
MAX_TOKENS=4096

# Random seed for reproducibility
SEED=42

# Reasoning effort (low, medium, high)
REASONING_EFFORT=medium

# =============================================================================
# EVOLUTIONARY ALGORITHM PARAMETERS
# =============================================================================
# Maximum iterations for evolution
MAX_ITERATIONS=100

# Population size
POPULATION_SIZE=10

# Number of islands for island model
NUM_ISLANDS=1

# Migration interval (iterations between migrations)
MIGRATION_INTERVAL=50

# Migration rate (fraction of population to migrate)
MIGRATION_RATE=0.1

# Archive size for best solutions
ARCHIVE_SIZE=100

# Elite ratio (fraction of best solutions to keep)
ELITE_RATIO=0.1

# Exploration ratio (fraction dedicated to exploration)
EXPLORATION_RATIO=0.2

# Exploitation ratio (fraction dedicated to exploitation)
EXPLOITATION_RATIO=0.7

# Checkpoint interval (iterations between checkpoints)
CHECKPOINT_INTERVAL=10

# Programming language
LANGUAGE=python

# File suffix for generated code
FILE_SUFFIX=.py

# Feature dimensions for diversity
FEATURE_DIMENSIONS=complexity,diversity

# Number of feature bins
FEATURE_BINS=10

# Diversity metric (edit_distance, euclidean, cosine)
DIVERSITY_METRIC=edit_distance

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_DIR=./llm_cache
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE_MB=100

# =============================================================================
# PARALLELIZATION CONFIGURATION
# =============================================================================
PARALLELIZATION_ENABLED=true
MAX_WORKERS=8

# =============================================================================
# ASYNC PROCESSING CONFIGURATION
# =============================================================================
ASYNC_PROCESSING_ENABLED=true
MAX_CONCURRENT_TASKS=100

# =============================================================================
# MEMORY MANAGEMENT CONFIGURATION
# =============================================================================
MEMORY_MANAGEMENT_ENABLED=true
MAX_POOL_SIZE=100
MEMORY_THRESHOLD_MB=100
GC_FREQUENCY=10

# =============================================================================
# RELIABILITY CONFIGURATION
# =============================================================================
# Retry configuration
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=60.0
RETRY_EXPONENTIAL_BASE=2.0
RETRY_JITTER=true

# Circuit breaker configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60.0

# Rate limiter configuration
RATE_LIMITER_ENABLED=true
RATE_LIMITER_MAX_REQUESTS=10
RATE_LIMITER_TIME_WINDOW=60.0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# SECRET KEY for JWT tokens - MUST be set in production!
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Enable encryption for stored data
ENABLE_ENCRYPTION=true

# Key encryption key for encrypting stored API keys
KEY_ENCRYPTION_KEY=

# =============================================================================
# API SERVER AUTHENTICATION
# =============================================================================
# API keys for external API server
# Format: API_KEY_<NAME>=<actual-key>:<role>
# Example: API_KEY_ADMIN=sk-admin123:admin
API_KEY_ADMIN=
API_KEY_USER=
API_KEY_READONLY=

# =============================================================================
# KNOWLEDGE BASE CONFIGURATION
# =============================================================================
# Elasticsearch configuration
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=openevolve

# AWS Bedrock configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Cloud configuration
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional, if not set logs to console only)
# LOG_FILE=./openevolve.log

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Enable debug mode (shows detailed error messages)
DEBUG=false

# Enable auto-reload on file changes
AUTO_RELOAD=true

# =============================================================================
# MONITORING & TELEMETRY
# =============================================================================
# OpenTelemetry configuration
OPENTELEMETRY_ENABLED=false
OPENTELEMETRY_ENDPOINT=http://localhost:4318

# Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test API keys (for testing only, never use in production)
# TEST_OPENAI_API_KEY=
# TEST_ANTHROPIC_API_KEY=

# =============================================================================
# NOTES
# =============================================================================
# 1. All API keys should be kept secret and never committed to version control
# 2. Use strong, randomly generated secrets for production
# 3. Set PRODUCTION=true for production deployments
# 4. Review and adjust parameters based on your use case
# 5. Monitor rate limits and adjust retry/rate limiting settings accordingly
