# =============================================================================
# OpenEvolve Infrastructure Configuration Template
# =============================================================================
# This is a minimal template showing only the essential environment variables
# needed to run the infrastructure services (Qdrant, PostgreSQL, Redis).
#
# For full development configuration, see .env.development
#
# Usage:
#   cp .env.infrastructure.example .env.infrastructure
#   # Edit .env.infrastructure with your values
#   docker-compose -f docker-compose.infrastructure.yml --env-file .env.infrastructure up -d
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_DB=openevolve
POSTGRES_USER=openevolve
POSTGRES_PASSWORD=changeme

# =============================================================================
# OPTIONAL: MANAGEMENT UI CREDENTIALS
# =============================================================================
# Only needed if you enable the 'tools' profile for pgAdmin/Redis Commander

# pgAdmin
PGADMIN_EMAIL=admin@openevolve.local
PGADMIN_PASSWORD=changeme

# =============================================================================
# NOTES
# =============================================================================
# 1. Change default passwords before running in production
# 2. Use strong, randomly generated passwords
# 3. Store sensitive credentials in secret management systems (Vault, AWS Secrets Manager, etc.)
# 4. Never commit this file with real credentials to version control
