# OpenEvolve Environment Variables Schema
# ====================================
# Following CLAUDE.md: Law of Configuration Explicitness
# All configuration MUST be via environment variables
# Application CRASHES if required variables are missing

# Core OpenEvolve Configuration
# ============================

# Log level: DEBUG, INFO, WARNING, ERROR
OPENEVOLVE_LOG_LEVEL=INFO

# Orchestrator service port (1-65535)
OPENEVOLVE_ORCHESTRATOR_PORT=8080

# Service toggles
OPENEVOLVE_SERVICES__REST_API=true
OPENEVOLVE_SERVICES__GRAPHQL_API=true
OPENEVOLVE_SERVICES__EVENT_BUS=true
OPENEVOLVE_SERVICES__MCP_SERVER=true
OPENEVOLVE_SERVICES__TELEMETRY=true

# REST API Configuration
OPENEVOLVE_REST_API__HOST=0.0.0.0
OPENEVOLVE_REST_API__PORT=8000
OPENEVOLVE_REST_API__CORS_ORIGINS=*

# GraphQL API Configuration
OPENEVOLVE_GRAPHQL__HOST=0.0.0.0
OPENEVOLVE_GRAPHQL__PORT=8001
OPENEVOLVE_GRAPHQL__ENABLE_PLAYGROUND=true

# Event Bus Configuration
OPENEVOLVE_EVENT_BUS__ENABLED=true
OPENEVOLVE_EVENT_BUS__BACKEND=valkey
OPENEVOLVE_EVENT_BUS__HOST=localhost
OPENEVOLVE_EVENT_BUS__PORT=6379
# OPENEVOLVE_EVENT_BUS__PASSWORD=your-password

# Telemetry Configuration
OPENEVOLVE_TELEMETRY__ENABLED=true
OPENEVOLVE_TELEMETRY__SERVICE_NAME=openevolve
OPENEVOLVE_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
OPENEVOLVE_TELEMETRY__METRICS_ENABLED=true
OPENEVOLVE_TELEMETRY__TRACING_ENABLED=true

# Security Configuration (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-in-production-generate-random-string

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10
RATE_LIMIT_ENABLED=true

# Request Configuration
MAX_REQUEST_SIZE=100
TIMEOUT=300
WORKERS=0

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Development Settings
DEBUG=false
RELOAD=false

# Database Configuration
# ===================
DATABASE_URL=sqlite:///./openevolve.db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=openevolve
DB_PASSWORD=your_password_here
DB_NAME=openevolve_kg

# Valkey/Redis Configuration
# =========================
VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# API Gateway Configuration
# =======================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
LOG_LEVEL=info

# Clerk JWT Configuration (Optional)
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=
# CLERK_AUDIENCE=
CLERK_JWKS_CACHE_TTL_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Evolution Orchestrator
EVOLUTION_ORCHESTRATOR_URL=http://localhost:8003/evolve

# Adapter Configuration
# ===================

# BubbleLab Adapter
BUBBLELAB_PORT=3001
BUBBLELAB_API_URL=http://bubblelab-core:8000
BUBBLELAB_API_KEY=your-bubblelab-api-key-here
BUBBLELAB_TIMEOUT_MS=30000
BUBBLELAB_MAX_RETRIES=3

# Graphiti Adapter
GRAPHITI_PORT=3000
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
GRAPHITI_API_URL=http://graphiti:3000
GRAPHITI_TIMEOUT_MS=30000
OPENAI_API_KEY=sk-your-openai-api-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
UPDATE_COMMUNITIES=false
STORE_RAW_EPISODES=true

# VectorDB Adapter
VECTORDB_PORT=3004
VECTORDB_TYPE=pinecone
VECTORDB_API_URL=https://your-pinecone-instance.pinecone.io
VECTORDB_API_KEY=your-pinecone-api-key-here
VECTORDB_TIMEOUT_MS=30000
VECTORDB_MAX_RETRIES=3
# VECTORDB_CONNECTION_STRING=
# PINECONE_ENVIRONMENT=

# Default VectorDB Settings (used by multiple adapters)
TIMEOUT_MS=5000
MAX_RETRIES=3

# OpenEvolve Adapter
OPENEVOLVE_PORT=3003
OPENEVOLVE_API_URL=http://openevolve-core:8000
OPENEVOLVE_API_KEY=your-openevolve-api-key-here
OPENEVOLVE_TIMEOUT_MS=30000
OPENEVOLVE_MAX_RETRIES=3
DEFAULT_REQUEST_TIMEOUT=30000

# ICR Adapter
ICR_PORT=3002
ICR_API_URL=http://icr-core:8000
ICR_API_KEY=your-icr-api-key-here
ICR_TIMEOUT_MS=30000
ICR_MAX_RETRIES=3
ICR_RETRY_DELAY_MS=1000

# LeanAide Adapter
LEANAIDE_PORT=3006
LEANAIDE_API_URL=http://leanaide-core:8000
LEANAIDE_TIMEOUT_MS=30000
LEANAIDE_MAX_RETRIES=3

# Z3 Adapter
Z3_PORT=3005
Z3_SOLVER_PATH=/usr/bin/z3
Z3_TIMEOUT_MS=30000
Z3_MAX_MEMORY_MB=4096
Z3_MAX_RETRIES=3
# Z3_API_URL=
Z3_HEALTH_CHECK=/health
Z3_VERIFY_PATH=/verify

# Knowledge Engine Configuration
# ===========================
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=
JWT_SECRET=your_jwt_secret_here_generate_with_python_c_secrets_token_hex_32
KE_VALIDATE_CONFIG=warn

# Event Bus Configuration
# =====================
EVENT_BUS_TYPE=memory
# EVENT_BUS_URL=redis://event-bus:6379
EVENT_BUS_MAX_EVENTS=10000
EVENT_BUS_PERSIST_EVENTS=true

# Unified Knowledge Query
# ====================
# RAGBITS_URL=http://ragbits:8000
# GRAPHITI_URL=http://graphiti:3000
# VECTORDB_URL=http://vectordb:3004

# Observability Configuration
# ========================
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SERVICE_NAME=unknown-service
METRICS_PREFIX=openevolve_
ENABLE_TRACING=false

# Plugin Configuration
# ===================
VITE_OPENEVOLVE_API_URL=http://localhost:8000

# Datapizza Plugin
DATAPIZZA_API_URL=/api/datapizza
# DATAPIZZA_API_KEY=
DATAPIZZA_TIMEOUT=30000

# LLM Configuration (used by multiple components)
# =========================================
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key
AI_API_KEY=your-generic-ai-api-key
API_KEY=your-generic-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# PES Configuration
# =================
PES_COST_OPTIMIZATION=false
PES_MAX_COST_USD=10.0
PES_COST_WARNING=0.7
PES_COST_CRITICAL=0.9
PES_EARLY_STOPPING=true
PES_STOPPING_PATIENCE=5
PES_MIN_IMPROVEMENT=0.001
PES_PLANNING=true
PES_SUMMARIZATION=true
PES_AUTO_SELECT=true
PES_USE_CHEAP_MODELS=true
PES_CHEAP_MODEL=gpt-3.5-turbo
PES_EXPENSIVE_MODEL=gpt-4o
# PES_PROMPT_TOKEN_PRICE=0.00001
# PES_COMPLETION_TOKEN_PRICE=0.00003

# Orchestration Configuration
# ========================
PIPELINE_TIMEOUT_MS=300000
MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000
CIRCUIT_BREAKER_HALF_OPEN_ATTEMPTS=3
DLQ_MAX_SIZE=1000

# RESE Configuration
# =================

# RESE DEE (Deep Exploration Engine)
RESE_DEE_PORT=8001
RESE_DEE_EXPLORATION_DEPTH=10
RESE_DEE_MCTS_ITERATIONS=1000
RESE_DEE_MCTS_EXPLORATION_CONSTANT=1.414
RESE_DEE_CONVERGENCE_THRESHOLD=0.001
RESE_DEE_EXPLORATION_TIMEOUT_MS=10000
RESE_DEE_MAX_HYPOTHESES=100
RESE_DEE_PATTERN_RECOGNITION_THRESHOLD=0.7

# RESE LLTL (Lean Latent Transformation Layer)
RESE_LLTDL_PORT=8002
RESE_LLTDL_ENCODING_DIM=128
RESE_LLTDL_USE_POSITIONAL=true
RESE_LLTDL_USE_TYPE_EMBEDDING=true
RESE_LLTDL_USE_CATEGORY_EMBEDDING=true
RESE_LLTDL_MAX_SEQUENCE_LENGTH=512
RESE_LLTDL_CACHE_SIZE=1000
RESE_LLTDL_DEFAULT_LOSS_TYPE=mse
RESE_LLTDL_COMBINATION_STRATEGY=weighted_sum
RESE_LLTDL_NORMALIZE_WEIGHTS=true
RESE_LLTDL_LEARNING_RATE=0.001
RESE_LLTDL_TIMEOUT_MS=3000
RESE_LLTDL_ENABLE_RTREE=false
RESE_LLTDL_ENABLE_LSH=false
RESE_LLTDL_ENABLE_HAG=false
RESE_LLTDL_CONTRADICTION_THRESHOLD=0.8
RESE_LLTDL_MAX_CONTRADICTIONS=1000

# RESE SCE (Symbolic Constraint Engine)
RESE_SCE_PORT=8003
SCE_TIMEOUT_MS=5000
SCE_CONSTRAINT_TIMEOUT_MS=3000
SCE_CONTRADICTION_DETECTION_TIMEOUT_MS=10000
SCE_MAX_ITERATIONS=1000
SCE_MAX_CONSTRAINTS=10000
SCE_MAX_CONTRADICTION_SET_SIZE=100
SCE_CIRCUIT_BREAKER_THRESHOLD=5
SCE_CIRCUIT_BREAKER_TIMEOUT_MS=60000
SCE_ENABLE_LEAN4_INTEGRATION=false
SCE_ENABLE_TACIT_MINING=true
SCE_CONTRADICTION_DETECTION=true
SCE_FORMAL_VERIFICATION=true

# RESE Phase Adapters
RESE_PHASE2_PORT=8004
RESE_PHASE4_PORT=8006
RESE_VERIFICATION_PORT=8007
RESE_Z3_BRIDGE_PORT=8008
RESE_LEANAIDE_WORKFLOW_PORT=8009
RESE_LEANAIDE_API_URL=http://leanaide-core:8000
RESE_LEANAIDE_TIMEOUT_MS=30000
RESE_LEANAIDE_MAX_RETRIES=3

# Curie-GlobalChem Integration
CURIE_GLOBALCHEM_PORT=5000
CURIE_GLOBALCHEM_API_URL=http://curie-core:8000
CURIE_GLOBALCHEM_API_KEY=your-curie-api-key-here
CURIE_GLOBALCHEM_TIMEOUT_MS=30000
CURIE_GLOBALCHEM_MAX_RETRIES=3

# LMQL-DSPY Integration
LMQL_DSPY_PORT=5001
LMQL_DSPY_API_URL=http://lmql-core:8000
LMQL_DSPY_API_KEY=your-lmql-api-key-here
LMQL_DSPY_TIMEOUT_MS=30000
LMQL_DSPY_MAX_RETRIES=3

# RagBits-Graphiti Sync
RAGBITS_GRAPHITI_SYNC_PORT=3010
RAGBITS_API_URL=http://ragbits-core:8000
GRAPHITI_API_URL=http://graphiti:3000
RAGBITS_GRAPHITI_SYNC_TIMEOUT_MS=30000
RAGBITS_GRAPHITI_SYNC_INTERVAL_MS=60000

# Testing Configuration
# ===================
SKIP_INTEGRATION_TESTS=false
