#!/bin/sh
# ============================================================================
# OpenEvolve Frontend - Commit Message Hook
# ============================================================================
# This hook validates commit messages follow conventional commits format.
#
# Format: <type>(<scope>): <description>
#
# Types: build, ci, docs, feat, fix, perf, refactor, style, test, chore
# ============================================================================

. "$(dirname "$0")/_/husky.sh"

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Conventional commit regex pattern
pattern="^(build|ci|docs|feat|fix|perf|refactor|style|test|chore)(\(.+\))?\!?:\s.{1,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
    echo "❌ Invalid commit message format."
    echo ""
    echo "Commit messages must follow the conventional commits format:"
    echo "  <type>(<scope>): <description>"
    echo ""
    echo "Types: build, ci, docs, feat, fix, perf, refactor, style, test, chore"
    echo ""
    echo "Examples:"
    echo "  feat(adapters): add LoongFlow adapter implementation"
    echo "  fix(workflows): resolve race condition in event handler"
    echo "  docs: update CI/CD documentation"
    echo ""
    echo "Your message:"
    echo "  $commit_msg"
    echo ""
    exit 1
fi

echo "✅ Commit message validated"
