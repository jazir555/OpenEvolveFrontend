# ENVIRONMENT: Development | Staging | Production
# LAST_UPDATED: 2026-01-17T00:00:00Z
# VERSION: 1.0.0
################################################################################

# =============================================================================
# SECTION 1: ENVIRONMENT CONFIGURATION (5 params)
# =============================================================================

# Environment name (REQUIRED)
# Options: development, staging, production
ENVIRONMENT=development

# Application name
APP_NAME=openevolve-bubblelab

# Application version
APP_VERSION=1.0.0

# Debug mode (true/false)
# WARNING: Always false in production
DEBUG_MODE=true

# Log level (OPTIONS: error, warn, info, debug)
LOG_LEVEL=debug

# =============================================================================
# SECTION 2: SERVER CONFIGURATION (8 params)
# =============================================================================

# Server port (REQUIRED)
PORT=3001

# Server host
HOST=0.0.0.0

# API base URL (REQUIRED in staging/production)
# Format: https://your-domain.com
API_BASE_URL=http://localhost:3001

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# Max request body size (e.g., 100mb, 1gb)
MAX_REQUEST_SIZE=100mb

# Max concurrent connections
MAX_CONCURRENT_CONNECTIONS=100

# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

