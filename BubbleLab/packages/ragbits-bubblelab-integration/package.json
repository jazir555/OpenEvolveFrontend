{
  "name": "ragbits-bubblelab-integration",
  "version": "1.0.0",
  "description": "RAGBits integration for BubbleLab workflow automation platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "dev": "concurrently \"npm run build:watch\" \"npm run test:watch\""
  },
  "keywords": [
    "rag",
    "bubblelab",
    "workflow",
    "automation",
    "integration"
  ],
  "author": "OpenEvolve",
  "license": "MIT",
  "peerDependencies": {
    "@bubblelab/core": "^1.0.0",
    "ragbits": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "concurrently": "^8.0.0",
    "nodemon": "^3.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  }
}