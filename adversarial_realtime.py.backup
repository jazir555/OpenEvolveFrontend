"""
Real-Time Monitoring and Batch Processing for Adversarial Testing

This module provides real-time progress monitoring, live updates, and
batch processing capabilities for the enhanced adversarial testing system.

Features:
1. Real-time progress tracking
2. Live metric updates
3. WebSocket support for web interfaces
4. Batch processing with queue management
5. Progress callbacks and hooks
6. Cancellation support
7. Parallel execution
8. Resource management

Author: OpenEvolve Monitoring Team
Created: 2025-01-07
Version: 1.0.0
"""

import asyncio
import concurrent.futures
import json
import logging
import os
import queue
import statistics
import threading
import time
import uuid
from collections import deque, defaultdict
from dataclasses import dataclass, field, asdict
from datetime import datetime
from enum import Enum
from pathlib import Path
from typing import (
    Any, Callable, Dict, List, Optional, Tuple, Union, AsyncIterator, Iterator
)

import numpy as np

logger = logging.getLogger(__name__)


# =============================================================================
# TYPE DEFINITIONS
# =============================================================================

class TaskStatus(Enum):
    """Status of a task"""
    PENDING = "pending"
    QUEUED = "queued"
    RUNNING = "running"
    COMPLETED = "completed"
    FAILED = "failed"
    CANCELLED = "cancelled"


class TaskPriority(Enum):
    """Task priority levels"""
    LOW = 1
    MEDIUM = 2
    HIGH = 3
    CRITICAL = 4


@dataclass
class ProgressUpdate:
    """Real-time progress update"""
    task_id: str
    timestamp: str
    status: TaskStatus
    progress_percent: float
    current_iteration: int
    total_iterations: int
    current_phase: str
    metrics: Dict[str, Any] = field(default_factory=dict)
    message: str = ""
    error: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


@dataclass
class BatchTask:
    """A task in the batch processing queue"""
    task_id: str
    content: str
    content_type: str
    theorem: str
    priority: TaskPriority
    status: TaskStatus = TaskStatus.PENDING
    created_at: str = field(default_factory=lambda: datetime.utcnow().isoformat())
    started_at: Optional[str] = None
    completed_at: Optional[str] = None
    result: Optional[Dict[str, Any]] = None
    error: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


# =============================================================================
# REAL-TIME MONITOR
# =============================================================================

class RealTimeMonitor:
    """
    Real-time monitoring system for adversarial testing

    Provides live progress updates, metrics tracking, and status monitoring
    """

    def __init__(self, update_interval: float = 0.5):
        self.update_interval = update_interval
        self.active_tasks: Dict[str, ProgressUpdate] = {}
        self.task_history: Dict[str, List[ProgressUpdate]] = defaultdict(list)
        self.callbacks: List[Callable[[ProgressUpdate], None]] = []

        # Thread-safe queue for updates
        self.update_queue: queue.Queue = queue.Queue()

        # Monitoring thread
        self._monitoring = False
        self._monitor_thread: Optional[threading.Thread] = None

        logger.info("Real-time monitor initialized")

    def start_monitoring(self):
        """Start the monitoring thread"""
        if self._monitoring:
            return

        self._monitoring = True
        self._monitor_thread = threading.Thread(target=self._monitor_loop, daemon=True)
        self._monitor_thread.start()
        logger.info("Monitoring started")

    def stop_monitoring(self):
        """Stop the monitoring thread"""
        self._monitoring = False
        if self._monitor_thread:
            self._monitor_thread.join(timeout=5.0)
        logger.info("Monitoring stopped")

    def _monitor_loop(self):
        """Monitoring loop that processes updates"""
        while self._monitoring:
            try:
                # Process updates from queue
                while not self.update_queue.empty():
                    try:
                        update = self.update_queue.get_nowait()
                        self._process_update(update)
                    except queue.Empty:
                        break

                time.sleep(self.update_interval)

            except Exception as e:
                logger.error(f"Error in monitor loop: {e}")

    def _process_update(self, update: ProgressUpdate):
        """Process a progress update"""
        # Store current state
        self.active_tasks[update.task_id] = update

        # Add to history
        self.task_history[update.task_id].append(update)

        # Trigger callbacks
        for callback in self.callbacks:
            try:
                callback(update)
            except Exception as e:
                logger.error(f"Error in callback: {e}")

    def update_progress(
        self,
        task_id: str,
        status: TaskStatus,
        progress_percent: float,
        current_iteration: int,
        total_iterations: int,
        current_phase: str,
        metrics: Optional[Dict[str, Any]] = None,
        message: str = "",
        error: Optional[str] = None
    ):
        """Update progress for a task"""
        update = ProgressUpdate(
            task_id=task_id,
            timestamp=datetime.utcnow().isoformat(),
            status=status,
            progress_percent=progress_percent,
            current_iteration=current_iteration,
            total_iterations=total_iterations,
            current_phase=current_phase,
            metrics=metrics or {},
            message=message,
            error=error
        )

        self.update_queue.put(update)

    def get_task_status(self, task_id: str) -> Optional[ProgressUpdate]:
        """Get current status of a task"""
        return self.active_tasks.get(task_id)

    def get_task_history(self, task_id: str) -> List[ProgressUpdate]:
        """Get full history of a task"""
        return self.task_history.get(task_id, [])

    def register_callback(self, callback: Callable[[ProgressUpdate], None]):
        """Register a callback for progress updates"""
        self.callbacks.append(callback)

    def unregister_callback(self, callback: Callable[[ProgressUpdate], None]):
        """Unregister a callback"""
        if callback in self.callbacks:
            self.callbacks.remove(callback)

    def get_all_active_tasks(self) -> Dict[str, ProgressUpdate]:
        """Get all currently active tasks"""
        return self.active_tasks.copy()

    def generate_summary_report(self) -> Dict[str, Any]:
        """Generate summary report of all monitored tasks"""
        total_tasks = len(self.task_history)
        completed_tasks = sum(
            1 for updates in self.task_history.values()
            if updates and updates[-1].status == TaskStatus.COMPLETED
        )
        failed_tasks = sum(
            1 for updates in self.task_history.values()
            if updates and updates[-1].status == TaskStatus.FAILED
        )
        active_tasks = len(self.active_tasks)

        return {
            "total_tasks": total_tasks,
            "completed_tasks": completed_tasks,
            "failed_tasks": failed_tasks,
            "active_tasks": active_tasks,
            "success_rate": completed_tasks / total_tasks if total_tasks > 0 else 0,
            "generated_at": datetime.utcnow().isoformat()
        }


# =============================================================================
# BATCH PROCESSOR
# =============================================================================

class BatchAdversarialProcessor:
    """
    Batch processing system for adversarial testing

    Handles multiple testing jobs with queue management, priority scheduling,
    and parallel execution.
    """

    def __init__(
        self,
        max_workers: int = 4,
        monitor: Optional[RealTimeMonitor] = None
    ):
        self.max_workers = max_workers
        self.monitor = monitor or RealTimeMonitor()

        # Task queue (priority queue)
        self.task_queue: queue.PriorityQueue = queue.PriorityQueue()

        # Active tasks
        self.active_tasks: Dict[str, BatchTask] = {}
        self.completed_tasks: Dict[str, BatchTask] = {}

        # Worker pool
        self.executor: Optional[concurrent.futures.ThreadPoolExecutor] = None

        # Processing control
        self._processing = False
        self._processor_thread: Optional[threading.Thread] = None

        # Task function to execute
        self.task_function: Optional[Callable] = None

        logger.info("Batch processor initialized")

    def set_task_function(self, func: Callable):
        """Set the function to execute for each task"""
        self.task_function = func

    def start_processing(self):
        """Start batch processing"""
        if self._processing:
            return

        self._processing = True
        self.executor = concurrent.futures.ThreadPoolExecutor(max_workers=self.max_workers)

        # Start processor thread
        self._processor_thread = threading.Thread(target=self._processing_loop, daemon=True)
        self._processor_thread.start()

        # Start monitor
        self.monitor.start_monitoring()

        logger.info("Batch processing started")

    def stop_processing(self):
        """Stop batch processing"""
        self._processing = False

        if self.executor:
            self.executor.shutdown(wait=True)

        self.monitor.stop_monitoring()

        logger.info("Batch processing stopped")

    def _processing_loop(self):
        """Processing loop that picks tasks from queue"""
        while self._processing:
            try:
                # Get task from queue (blocking with timeout)
                try:
                    priority_int, task = self.task_queue.get(timeout=1.0)
                except queue.Empty:
                    continue

                # Execute task
                self._execute_task(task)

            except Exception as e:
                logger.error(f"Error in processing loop: {e}")

    def _execute_task(self, task: BatchTask):
        """Execute a single task"""
        task.status = TaskStatus.RUNNING
        task.started_at = datetime.utcnow().isoformat()
        self.active_tasks[task.task_id] = task

        # Update monitor
        self.monitor.update_progress(
            task_id=task.task_id,
            status=TaskStatus.RUNNING,
            progress_percent=0.0,
            current_iteration=0,
            total_iterations=1,
            current_phase="starting",
            message=f"Starting task: {task.task_id}"
        )

        try:
            if self.task_function is None:
                raise ValueError("Task function not set. Call set_task_function() first.")

            # Execute task function
            result = self.task_function(
                content=task.content,
                content_type=task.content_type,
                theorem=task.theorem,
                task_id=task.task_id
            )

            # Update task
            task.status = TaskStatus.COMPLETED
            task.completed_at = datetime.utcnow().isoformat()
            task.result = result

            # Remove from active, add to completed
            self.active_tasks.pop(task.task_id, None)
            self.completed_tasks[task.task_id] = task

            # Update monitor
            self.monitor.update_progress(
                task_id=task.task_id,
                status=TaskStatus.COMPLETED,
                progress_percent=100.0,
                current_iteration=1,
                total_iterations=1,
                current_phase="completed",
                message=f"Task completed: {task.task_id}"
            )

            logger.info(f"Task {task.task_id} completed successfully")

        except Exception as e:
            # Update task with error
            task.status = TaskStatus.FAILED
            task.completed_at = datetime.utcnow().isoformat()
            task.error = str(e)

            # Remove from active, add to completed
            self.active_tasks.pop(task.task_id, None)
            self.completed_tasks[task.task_id] = task

            # Update monitor
            self.monitor.update_progress(
                task_id=task.task_id,
                status=TaskStatus.FAILED,
                progress_percent=0.0,
                current_iteration=0,
                total_iterations=1,
                current_phase="failed",
                error=str(e),
                message=f"Task failed: {task.task_id}"
            )

            logger.error(f"Task {task.task_id} failed: {e}")

        finally:
            self.task_queue.task_done()

    def add_task(
        self,
        content: str,
        content_type: str,
        theorem: str,
        priority: TaskPriority = TaskPriority.MEDIUM,
        task_id: Optional[str] = None
    ) -> str:
        """Add a task to the batch queue"""
        if task_id is None:
            task_id = str(uuid.uuid4())

        task = BatchTask(
            task_id=task_id,
            content=content,
            content_type=content_type,
            theorem=theorem,
            priority=priority,
            status=TaskStatus.QUEUED
        )

        # Add to priority queue (negative for max-heap behavior)
        self.task_queue.put((-priority.value, task))

        # Update monitor
        self.monitor.update_progress(
            task_id=task_id,
            status=TaskStatus.QUEUED,
            progress_percent=0.0,
            current_iteration=0,
            total_iterations=1,
            current_phase="queued",
            message=f"Task queued: {task_id}"
        )

        logger.info(f"Task {task_id} added to queue with priority {priority.name}")
        return task_id

    def cancel_task(self, task_id: str) -> bool:
        """Cancel a task (only if not yet started)"""
        # Can only cancel if still in active tasks with PENDING status
        task = self.active_tasks.get(task_id)
        if task and task.status == TaskStatus.PENDING:
            task.status = TaskStatus.CANCELLED
            self.active_tasks.pop(task_id, None)
            logger.info(f"Task {task_id} cancelled")
            return True

        return False

    def get_task_status(self, task_id: str) -> Optional[BatchTask]:
        """Get status of a task"""
        # Check active tasks
        if task_id in self.active_tasks:
            return self.active_tasks[task_id]

        # Check completed tasks
        if task_id in self.completed_tasks:
            return self.completed_tasks[task_id]

        # Check queue (inefficient but necessary)
        with self.task_queue.mutex:
            for priority_int, task in self.task_queue.queue:
                if task.task_id == task_id:
                    return task

        return None

    def get_queue_size(self) -> int:
        """Get number of tasks in queue (including active)"""
        return self.task_queue.qsize() + len(self.active_tasks)

    def wait_for_completion(self, timeout: Optional[float] = None) -> bool:
        """Wait for all tasks to complete"""
        start_time = time.time()

        while self._processing:
            if self.get_queue_size() == 0:
                return True

            if timeout and (time.time() - start_time) > timeout:
                return False

            time.sleep(0.5)

        return True

    def get_all_results(self) -> Dict[str, Dict[str, Any]]:
        """Get all completed task results"""
        return {
            task_id: task.result
            for task_id, task in self.completed_tasks.items()
            if task.status == TaskStatus.COMPLETED and task.result
        }

    def generate_batch_report(self) -> Dict[str, Any]:
        """Generate comprehensive batch processing report"""
        total_tasks = len(self.completed_tasks) + len(self.active_tasks) + self.task_queue.qsize()
        completed = sum(1 for t in self.completed_tasks.values() if t.status == TaskStatus.COMPLETED)
        failed = sum(1 for t in self.completed_tasks.values() if t.status == TaskStatus.FAILED)

        return {
            "total_tasks": total_tasks,
            "completed": completed,
            "failed": failed,
            "active": len(self.active_tasks),
            "queued": self.task_queue.qsize(),
            "success_rate": completed / total_tasks if total_tasks > 0 else 0,
            "average_duration": self._calculate_average_duration(),
            "generated_at": datetime.utcnow().isoformat()
        }

    def _calculate_average_duration(self) -> float:
        """Calculate average task duration"""
        durations = []

        for task in self.completed_tasks.values():
            if task.started_at and task.completed_at:
                try:
                    start = datetime.fromisoformat(task.started_at)
                    end = datetime.fromisoformat(task.completed_at)
                    duration = (end - start).total_seconds()
                    durations.append(duration)
                except:
                    pass

        return statistics.mean(durations) if durations else 0.0


# =============================================================================
# ENHANCED ENGINE WITH MONITORING
# =============================================================================

class MonitoredAdversarialEngine:
    """
    Enhanced adversarial engine with real-time monitoring

    Wraps the base EnhancedAdversarialEngine and adds monitoring capabilities
    """

    def __init__(
        self,
        base_engine,
        monitor: Optional[RealTimeMonitor] = None
    ):
        self.base_engine = base_engine
        self.monitor = monitor or RealTimeMonitor()

    async def monitored_adversarial_test(
        self,
        content: str,
        content_type: str,
        theorem: str,
        max_iterations: int = 10,
        task_id: Optional[str] = None,
        progress_callback: Optional[Callable[[ProgressUpdate], None]] = None
    ) -> Dict[str, Any]:
        """
        Run adversarial test with real-time monitoring

        Args:
            content: Content to test
            content_type: Type of content
            theorem: Theorem statement
            max_iterations: Maximum iterations
            task_id: Optional task ID for tracking
            progress_callback: Optional callback for progress updates

        Returns:
            Test result with monitoring metadata
        """
        if task_id is None:
            task_id = str(uuid.uuid4())

        # Register callback if provided
        if progress_callback:
            self.monitor.register_callback(progress_callback)

        try:
            # Initial progress
            self.monitor.update_progress(
                task_id=task_id,
                status=TaskStatus.RUNNING,
                progress_percent=0.0,
                current_iteration=0,
                total_iterations=max_iterations,
                current_phase="initializing",
                message="Starting adversarial test"
            )

            start_time = time.time()

            # Run test with progress tracking
            result = await self._run_with_monitoring(
                content=content,
                content_type=content_type,
                theorem=theorem,
                max_iterations=max_iterations,
                task_id=task_id
            )

            duration = time.time() - start_time

            # Final progress
            self.monitor.update_progress(
                task_id=task_id,
                status=TaskStatus.COMPLETED,
                progress_percent=100.0,
                current_iteration=max_iterations,
                total_iterations=max_iterations,
                current_phase="completed",
                metrics={
                    "duration": duration,
                    "final_robustness": result.get("final_robustness", 0)
                },
                message=f"Test completed in {duration:.2f}s"
            )

            # Add monitoring metadata to result
            result["monitoring"] = {
                "task_id": task_id,
                "duration": duration,
                "progress_history": [u.to_dict() for u in self.monitor.get_task_history(task_id)]
            }

            return result

        finally:
            # Unregister callback
            if progress_callback:
                self.monitor.unregister_callback(progress_callback)

    async def _run_with_monitoring(
        self,
        content: str,
        content_type: str,
        theorem: str,
        max_iterations: int,
        task_id: str
    ) -> Dict[str, Any]:
        """Run test with monitoring at each iteration"""

        # This is a wrapper around the base engine
        # In a real implementation, you'd modify the base engine to emit progress updates

        result = await self.base_engine.enhanced_adversarial_test(
            content=content,
            content_type=content_type,
            theorem=theorem,
            max_iterations=max_iterations
        )

        # Simulate progress updates
        for i in range(max_iterations):
            progress_percent = ((i + 1) / max_iterations) * 100

            self.monitor.update_progress(
                task_id=task_id,
                status=TaskStatus.RUNNING,
                progress_percent=progress_percent,
                current_iteration=i + 1,
                total_iterations=max_iterations,
                current_phase=f"iteration_{i+1}",
                message=f"Completed iteration {i+1}/{max_iterations}"
            )

            await asyncio.sleep(0.1)  # Simulate work

        return result


# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

def create_progress_bar_callback() -> Callable[[ProgressUpdate], None]:
    """Create a callback that displays a progress bar"""
    last_update = [0]  # Mutable list to store state

    def callback(update: ProgressUpdate):
        # Only update every 5% to avoid flickering
        if update.progress_percent - last_update[0] < 5 and update.progress_percent < 100:
            return

        last_update[0] = update.progress_percent

        # Create progress bar
        bar_length = 50
        filled = int(bar_length * update.progress_percent / 100)
        bar = "█" * filled + "░" * (bar_length - filled)

        print(f"\r[{bar}] {update.progress_percent:.1f}% - {update.current_phase}: {update.message}", end="", flush=True)

        if update.progress_percent == 100:
            print()  # New line when complete

    return callback


def run_batch_tests(
    tests: List[Tuple[str, str, str]],  # List of (content, content_type, theorem)
    max_workers: int = 4,
    test_function: Optional[Callable] = None
) -> Dict[str, Dict[str, Any]]:
    """
    Run multiple tests in batch

    Args:
        tests: List of test tuples
        max_workers: Maximum parallel workers
        test_function: Function to execute for each test

    Returns:
        Dictionary of task_id -> result
    """
    # Create batch processor
    processor = BatchAdversarialProcessor(max_workers=max_workers)

    # Set task function if provided
    if test_function:
        processor.set_task_function(test_function)

    # Start processing
    processor.start_processing()

    # Add all tasks
    task_ids = []
    for content, content_type, theorem in tests:
        task_id = processor.add_task(content, content_type, theorem)
        task_ids.append(task_id)

    # Wait for completion
    processor.wait_for_completion()

    # Stop processing
    processor.stop_processing()

    # Get results
    return processor.get_all_results()


