#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Comprehensive Bubble Inventory Analyzer
Scans all bubble files and categorizes them with operation counts
"""

import os
import sys
import re
from pathlib import Path
from typing import Dict, List, Tuple
import json

# Set UTF-8 encoding for Windows console
if sys.platform == 'win32':
    import codecs
    sys.stdout = codecs.getwriter('utf-8')(sys.stdout.buffer, 'strict')
    sys.stderr = codecs.getwriter('utf-8')(sys.stderr.buffer, 'strict')

def count_operations_in_file(file_path: str) -> int:
    """Count operations/methods in a bubble file"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()

        # Count different patterns that indicate operations
        patterns = [
            r'operation:\s*z\.literal\(',  # Zod literal operation definitions
            r'\.defineOperation\(',  # defineOperation calls
            r'async\s+\w+\s*\(',  # Async methods
            r'public\s+\w+\s*\(',  # Public methods
            r'export\s+const\s+\w+\s*=',  # Exported constants
            r'const\s+\w+ParamsSchema\s*=',  # Parameter schemas
        ]

        total_ops = 0
        for pattern in patterns:
            matches = re.findall(pattern, content)
            total_ops += len(matches)

        return total_ops
    except Exception as e:
        return 0

def extract_bubble_name(file_path: str) -> str:
    """Extract bubble class name from file"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()

        # Look for class declarations
        class_match = re.search(r'class\s+(\w+)\s+extends', content)
        if class_match:
            return class_match.group(1)

        # Look for export declarations
        export_match = re.search(r'export\s+(?:class|const)\s+(\w+)', content)
        if export_match:
            return export_match.group(1)

        return Path(file_path).stem
    except:
        return Path(file_path).stem

def has_test_file(bubble_file: str) -> bool:
    """Check if a bubble has a corresponding test file"""
    path = Path(bubble_file)
    test_patterns = [
        path.parent / f"{path.stem}.test.ts",
        path.parent / f"{path.stem}.spec.ts",
        path.parent / "tests" / f"{path.stem}.test.ts",
    ]

    for pattern in test_patterns:
        if pattern.exists():
            return True
    return False

def scan_directory(directory: str) -> List[str]:
    """Scan directory for TypeScript files"""
    files = []
    try:
        for root, dirs, filenames in os.walk(directory):
            # Skip node_modules, dist, and test directories
            dirs[:] = [d for d in dirs if d not in ['node_modules', 'dist', '__tests__', 'tests', '.next', 'actors']]

            for filename in filenames:
                if filename.endswith('.ts') and not filename.endswith('.test.ts') and not filename.endswith('.spec.ts'):
                    files.append(os.path.join(root, filename))
    except Exception as e:
        print(f"Error scanning {directory}: {e}")
    return files

def categorize_bubble(file_path: str) -> Tuple[str, str]:
    """Categorize bubble by type and subcategory"""
    path = file_path.lower()

    if 'service-bubble' in path:
        if 'apify/actors' in path:
            return ('Service Bubble', 'Apify Actor')
        return ('Service Bubble', 'Service')
    elif 'tool-bubble' in path:
        return ('Tool Bubble', 'Tool')
    elif 'workflow-bubble' in path:
        return ('Workflow Bubble', 'Workflow')
    elif 'template_codes' in path:
        return ('Template', 'BubbleFlow Template')
    elif 'integrations/openevolve' in path:
        if 'service-bubbles' in path:
            return ('Service Bubble', 'OpenEvolve Integration')
        elif 'tool-bubbles' in path:
            return ('Tool Bubble', 'OpenEvolve Integration')
    return ('Unknown', 'Unknown')

def main():
    base_path = r"C:\Users\mmeadow\Documents\OpenEvolve\Frontend\BubbleLab"

    # Define directories to scan
    directories = {
        'service_bubbles': os.path.join(base_path, r'packages\bubble-core\src\bubbles\service-bubble'),
        'tool_bubbles': os.path.join(base_path, r'packages\bubble-core\src\bubbles\tool-bubble'),
        'workflow_bubbles': os.path.join(base_path, r'packages\bubble-core\src\bubbles\workflow-bubble'),
        'openevolve_service': os.path.join(base_path, r'integrations\openevolve\service-bubbles'),
        'openevolve_tools': os.path.join(base_path, r'integrations\openevolve\tool-bubbles'),
        'templates': os.path.join(base_path, r'apps\bubble-studio\src\components\templates\template_codes'),
    }

    inventory = {
        'Service Bubble': [],
        'Tool Bubble': [],
        'Workflow Bubble': [],
        'Template': [],
        'Unknown': []
    }

    print("🔍 Scanning BubbleLab codebase for all bubbles...\n")

    total_files = 0
    for category, directory in directories.items():
        if not os.path.exists(directory):
            print(f"Directory not found: {directory}")
            continue

        files = scan_directory(directory)
        print(f"Found {len(files)} files in {category}")

        for file_path in files:
            total_files += 1
            bubble_type, subcategory = categorize_bubble(file_path)
            bubble_name = extract_bubble_name(file_path)
            operation_count = count_operations_in_file(file_path)
            has_tests = has_test_file(file_path)

            relative_path = os.path.relpath(file_path, base_path)

            inventory[bubble_type].append({
                'name': bubble_name,
                'path': relative_path,
                'operations': operation_count,
                'has_tests': has_tests,
                'subcategory': subcategory,
                'full_path': file_path
            })

    # Print inventory
    print("=" * 100)
    print("📊 BUBBLE INVENTORY - COMPLETE")
    print("=" * 100)
    print()

    total_bubbles = 0
    total_with_tests = 0
    total_needs_tests = 0

    for bubble_type in ['Service Bubble', 'Tool Bubble', 'Workflow Bubble', 'Template']:
        bubbles = inventory[bubble_type]
        if not bubbles:
            continue

        print(f"\n{'=' * 100}")
        print(f"{bubble_type.upper()}S ({len(bubbles)} total)")
        print(f"{'=' * 100}\n")

        # Group by subcategory
        subcategories = {}
        for bubble in bubbles:
            subcat = bubble['subcategory']
            if subcat not in subcategories:
                subcategories[subcat] = []
            subcategories[subcat].append(bubble)

        for subcat, subcat_bubbles in sorted(subcategories.items()):
            print(f"\n--- {subcat} ({len(subcat_bubbles)}) ---\n")

            for bubble in sorted(subcat_bubbles, key=lambda x: x['name']):
                status = "✅ TESTED" if bubble['has_tests'] else "❌ NEEDS TEST"
                ops = bubble['operations']
                name = bubble['name']
                path = bubble['path']

                print(f"{status} | {ops:3d} ops | {name:40s} | {path}")

                total_bubbles += 1
                if bubble['has_tests']:
                    total_with_tests += 1
                else:
                    total_needs_tests += 1

    # Print statistics
    print("\n" + "=" * 100)
    print("📈 STATISTICS")
    print("=" * 100)
    print(f"\nTotal Bubbles Found: {total_bubbles}")
    print(f"With Tests: {total_with_tests} ({100*total_with_tests/total_bubbles if total_bubbles > 0 else 0:.1f}%)")
    print(f"Need Tests: {total_needs_tests} ({100*total_needs_tests/total_bubbles if total_bubbles > 0 else 0:.1f}%)")

    # Count by type
    print("\n" + "-" * 100)
    print("BY TYPE:")
    print("-" * 100)
    for bubble_type in ['Service Bubble', 'Tool Bubble', 'Workflow Bubble', 'Template']:
        count = len(inventory[bubble_type])
        if count > 0:
            with_tests = sum(1 for b in inventory[bubble_type] if b['has_tests'])
            print(f"{bubble_type:20s}: {count:3d} total | {with_tests:3d} tested | {count-with_tests:3d} need tests")

    # Priority list - bubbles without tests, sorted by operation count
    print("\n" + "=" * 100)
    print("🎯 PRIORITY TESTING LIST (Bubbles without tests, sorted by complexity)")
    print("=" * 100)
    print()

    priority_list = []
    for bubble_type in ['Service Bubble', 'Tool Bubble', 'Workflow Bubble']:
        for bubble in inventory[bubble_type]:
            if not bubble['has_tests']:
                priority_list.append(bubble)

    priority_list.sort(key=lambda x: x['operations'], reverse=True)

    for i, bubble in enumerate(priority_list, 1):
        print(f"{i:3d}. {bubble['operations']:3d} ops | {bubble['name']:40s} | {bubble['path']}")

    # Save to JSON
    output_file = r"C:\Users\mmeadow\Documents\OpenEvolve\Frontend\bubble_inventory.json"
    with open(output_file, 'w') as f:
        json.dump(inventory, f, indent=2)

    print(f"\n💾 Inventory saved to: {output_file}")
    print("\n✅ Analysis complete!")

if __name__ == '__main__':
    main()
