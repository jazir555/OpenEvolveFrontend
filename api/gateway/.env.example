# API Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
LOG_LEVEL=info

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clerk JWT Configuration (optional, for BubbleLab UI tokens)
# Example issuer: https://your-instance.clerk.accounts.dev
CLERK_ISSUER=
# Override if you want a custom JWKS URL instead of using the issuer.
CLERK_JWKS_URL=
# Optional audience claim (only validate if set)
CLERK_AUDIENCE=
# JWKS cache TTL in seconds
CLERK_JWKS_CACHE_TTL_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database Configuration (for user management)
DATABASE_URL=sqlite:///./openevolve.db

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Evolution Orchestrator
EVOLUTION_ORCHESTRATOR_URL=http://localhost:8003/evolve
