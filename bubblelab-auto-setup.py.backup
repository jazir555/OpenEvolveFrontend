# =============================================================================
# ANSI Color Codes for Beautiful Output
# =============================================================================
class Colors:
    """ANSI color codes for terminal output"""
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKCYAN = '\033[96m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'

# =============================================================================
# Logger Class
# =============================================================================
class Logger:
    """Beautiful logging with colors and emojis"""

    @staticmethod
    def header(text: str):
        """Print header"""
        print(f"\n{Colors.HEADER}{Colors.BOLD}{'='*80}{Colors.ENDC}")
        print(f"{Colors.HEADER}{Colors.BOLD}{text.center(80)}{Colors.ENDC}")
        print(f"{Colors.HEADER}{Colors.BOLD}{'='*80}{Colors.ENDC}\n")

    @staticmethod
    def section(text: str):
        """Print section header"""
        print(f"\n{Colors.OKCYAN}{Colors.BOLD}▶ {text}{Colors.ENDC}")
        print(f"{Colors.OKCYAN}{'─'*80}{Colors.ENDC}")

    @staticmethod
    def success(text: str):
        """Print success message"""
        print(f"{Colors.OKGREEN}✅ {text}{Colors.ENDC}")

    @staticmethod
    def error(text: str):
        """Print error message"""
        print(f"{Colors.FAIL}❌ {text}{Colors.ENDC}")

    @staticmethod
    def warning(text: str):
        """Print warning message"""
        print(f"{Colors.WARNING}⚠️  {text}{Colors.ENDC}")

    @staticmethod
    def info(text: str):
        """Print info message"""
        print(f"ℹ️  {text}")

    @staticmethod
    def step(step_num: int, total: int, text: str):
        """Print step progress"""
        print(f"\n{Colors.OKBLUE}[{step_num}/{total}] {Colors.BOLD}{text}{Colors.ENDC}")

    @staticmethod
    def detail(text: str):
        """Print detailed info"""
        print(f"    {text}")

    @staticmethod
    def debug(text: str):
        """Print debug message (to log only)"""
        logging.debug(text)

# =============================================================================
# File Lock Manager - Prevent Concurrent Execution
# =============================================================================
class FileLock:
    """Prevents concurrent execution of setup script"""

    def __init__(self, lock_file: str = '.bubblelab-setup.lock'):
        self.lock_file = lock_file
        self.lock_handle = None

    def __enter__(self):
        """Acquire lock"""
        try:
            self.lock_handle = open(self.lock_file, 'w')
            fcntl.flock(self.lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            # Write PID
            self.lock_handle.write(str(os.getpid()))
            self.lock_handle.flush()
            Logger.detail(f"Acquired setup lock (PID: {os.getpid()})")
            return self
        except IOError:
            Logger.error("Setup is already running in another process")
            Logger.info("If this is incorrect, delete .bubblelab-setup.lock and try again")
            sys.exit(1)

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Release lock"""
        if self.lock_handle:
            fcntl.flock(self.lock_handle.fileno(), fcntl.LOCK_UN)
            self.lock_handle.close()
        try:
            os.remove(self.lock_file)
        except (FileNotFoundError, PermissionError):
            pass
        Logger.detail("Released setup lock")

# =============================================================================
# Rollback Manager - Clean Up on Failure
# =============================================================================
class RollbackManager:
    """Manages rollback operations for failed setup steps"""

    def __init__(self):
        self.actions: List[Tuple[str, Callable]] = []
        self.committed = False
        self.logger = logging.getLogger('RollbackManager')

    def register(self, operation: str, rollback_fn: Callable):
        """Register a rollback action for an operation"""
        self.actions.append((operation, rollback_fn))
        self.logger.debug(f"Registered rollback for: {operation}")

    def commit(self):
        """Clear all rollback actions on success"""
        self.actions.clear()
        self.committed = True
        self.logger.debug("All operations committed, rollbacks cleared")

    def rollback(self):
        """Execute all rollback operations in reverse order"""
        if not self.actions:
            return

        Logger.warning("\n🔄 Rolling back failed setup changes...")
        self.logger.info(f"Executing {len(self.actions)} rollback operations")

        # Execute in reverse order (LIFO)
        for operation, rollback_fn in reversed(self.actions):
            try:
                Logger.detail(f"Rolling back: {operation}")
                rollback_fn()
                Logger.success(f"✓ Rolled back: {operation}")
            except Exception as e:
                Logger.error(f"✗ Rollback failed for {operation}: {e}")
                self.logger.error(f"Rollback error: {e}", exc_info=True)

        Logger.warning("⚠️  Rollback complete. Some files may remain.")

# =============================================================================
# Backup Manager - Preserve Existing Files
# =============================================================================
class BackupManager:
    """Creates backups of files before modification"""

    def __init__(self, base_dir: Path):
        self.base_dir = base_dir
        self.backups_created = []
        self.backup_dir = base_dir / '.bubblelab-backups' / datetime.now().strftime('%Y%m%d_%H%M%S')
        self.logger = logging.getLogger('BackupManager')

    def create_backup_dir(self):
        """Create backup directory"""
        try:
            self.backup_dir.mkdir(parents=True, exist_ok=True)
            Logger.detail(f"Backup directory: {self.backup_dir}")
        except OSError as e:
            Logger.error(f"Cannot create backup directory: {e}")
            raise

    def backup_file(self, file_path: Path) -> Optional[Path]:
        """Backup a single file if it exists"""
        if not file_path.exists():
            self.logger.debug(f"File does not exist, skipping backup: {file_path}")
            return None

        try:
            # Create backup directory if needed
            self.create_backup_dir()

            # Create backup path
            backup_path = self.backup_dir / file_path.name

            # Copy file
            shutil.copy2(file_path, backup_path)
            self.backups_created.append(backup_path)
            Logger.detail(f"Backed up: {file_path.name}")
            self.logger.info(f"Backed up {file_path} to {backup_path}")
            return backup_path
        except (OSError, shutil.Error) as e:
            Logger.error(f"Failed to backup {file_path.name}: {e}")
            self.logger.error(f"Backup error: {e}", exc_info=True)
            return None

    def backup_directory(self, dir_path: Path) -> Optional[Path]:
        """Backup an entire directory if it exists"""
        if not dir_path.exists():
            self.logger.debug(f"Directory does not exist, skipping backup: {dir_path}")
            return None

        try:
            # Create backup directory
            self.create_backup_dir()

            # Create backup path
            backup_path = self.backup_dir / dir_path.name

            # Copy directory
            if backup_path.exists():
                shutil.rmtree(backup_path)
            shutil.copytree(dir_path, backup_path)
            self.backups_created.append(backup_path)
            Logger.detail(f"Backed up directory: {dir_path.name}")
            self.logger.info(f"Backed up {dir_path} to {backup_path}")
            return backup_path
        except (OSError, shutil.Error) as e:
            Logger.error(f"Failed to backup {dir_path.name}: {e}")
            self.logger.error(f"Backup error: {e}", exc_info=True)
            return None

    def backup_config_files(self):
        """Backup all important configuration files"""
        Logger.section("Backing Up Existing Files")

        files_to_backup = [
            self.base_dir / 'bubblelab-config.yaml',
            self.base_dir / '.env',
        ]

        dirs_to_backup = [
            self.base_dir / 'bubblelab-workflows',
        ]

        for file_path in files_to_backup:
            self.backup_file(file_path)

        for dir_path in dirs_to_backup:
            self.backup_directory(dir_path)

        if self.backups_created:
            Logger.success(f"✓ Created {len(self.backups_created)} backups")
        else:
            Logger.info("No existing files to backup")

# =============================================================================
# Resource Validator - Check System Resources
# =============================================================================
class ResourceValidator:
    """Validates system resources are sufficient"""

    # Minimum requirements
    MIN_DISK_GB = 5
    MIN_MEMORY_GB = 2

    def __init__(self):
        self.logger = logging.getLogger('ResourceValidator')

    def check_disk_space(self, path: Path = None) -> Tuple[bool, str]:
        """Check available disk space"""
        path = path or Path.cwd()
        try:
            usage = shutil.disk_usage(path)
            free_gb = usage.free / (1024 ** 3)

            if free_gb >= self.MIN_DISK_GB:
                Logger.success(f"✓ Disk space: {free_gb:.2f} GB free")
                return True, f"{free_gb:.2f} GB free"
            else:
                Logger.error(f"✗ Insufficient disk space: {free_gb:.2f} GB free (need {self.MIN_DISK_GB} GB)")
                return False, f"Need {self.MIN_DISK_GB} GB, have {free_gb:.2f} GB"
        except OSError as e:
            Logger.error(f"Cannot check disk space: {e}")
            return False, f"Error checking disk: {e}"

    def check_memory(self) -> Tuple[bool, str]:
        """Check available memory"""
        if not HAS_PSUTIL:
            Logger.warning("⚠️  Cannot check memory (psutil not installed)")
            return True, "Memory check skipped"

        try:
            mem = psutil.virtual_memory()
            available_gb = mem.available / (1024 ** 3)

            if available_gb >= self.MIN_MEMORY_GB:
                Logger.success(f"✓ Memory: {available_gb:.2f} GB available")
                return True, f"{available_gb:.2f} GB available"
            else:
                Logger.error(f"✗ Insufficient memory: {available_gb:.2f} GB available (need {self.MIN_MEMORY_GB} GB)")
                return False, f"Need {self.MIN_MEMORY_GB} GB, have {available_gb:.2f} GB"
        except Exception as e:
            Logger.warning(f"⚠️  Cannot check memory: {e}")
            return True, "Memory check skipped"

    def validate(self) -> bool:
        """Run all resource checks"""
        Logger.section("Validating System Resources")

        disk_ok, disk_msg = self.check_disk_space()
        mem_ok, mem_msg = self.check_memory()

        all_ok = disk_ok and mem_ok

        if all_ok:
            Logger.success("\n✨ System resources sufficient")
        else:
            Logger.error("\n💥 Insufficient system resources")

        return all_ok

# =============================================================================
# Network Validator - Check Connectivity
# =============================================================================
class NetworkValidator:
    """Validates network connectivity"""

    def __init__(self):
        self.logger = logging.getLogger('NetworkValidator')

    def check_dns_resolution(self, hostname: str) -> Tuple[bool, str]:
        """Check DNS resolution"""
        try:
            socket.gethostbyname(hostname)
            Logger.success(f"✓ DNS resolution: {hostname}")
            return True, f"{hostname} resolves"
        except socket.gaierror as e:
            Logger.error(f"✗ DNS resolution failed for {hostname}: {e}")
            return False, f"DNS failed: {e}"

    def check_tcp_connection(self, host: str, port: int, timeout: float = 5.0) -> Tuple[bool, str]:
        """Check TCP connection"""
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            result = sock.connect_ex((host, port))
            sock.close()

            if result == 0:
                Logger.success(f"✓ TCP connection: {host}:{port}")
                return True, f"{host}:{port} reachable"
            else:
                Logger.error(f"✗ TCP connection failed: {host}:{port}")
                return False, f"{host}:{port} unreachable"
        except socket.error as e:
            Logger.error(f"✗ TCP connection error: {e}")
            return False, f"Connection error: {e}"

    def check_http_url(self, url: str, timeout: float = 10.0) -> Tuple[bool, str]:
        """Check HTTP/HTTPS URL"""
        try:
            import requests
            response = requests.get(url, timeout=timeout)
            if response.status_code < 400:
                Logger.success(f"✓ HTTP check: {url}")
                return True, f"{url} reachable (status {response.status_code})"
            else:
                Logger.warning(f"⚠️  HTTP check: {url} (status {response.status_code})")
                return False, f"HTTP error {response.status_code}"
        except requests.exceptions.RequestException as e:
            Logger.error(f"✗ HTTP check failed for {url}: {e}")
            return False, f"HTTP error: {e}"
        except ImportError:
            Logger.warning("⚠️  Cannot check HTTP (requests not installed)")
            return True, "HTTP check skipped"

    def validate_url(self, url: str) -> bool:
        """Validate a URL is reachable"""
        Logger.section("Validating Network Connectivity")

        parsed = urlparse(url)
        hostname = parsed.hostname or parsed.path

        # Check DNS
        dns_ok, dns_msg = self.check_dns_resolution(hostname)

        # Check TCP if port specified
        tcp_ok = True
        if parsed.port:
            tcp_ok, tcp_msg = self.check_tcp_connection(hostname, parsed.port)

        # Check HTTP if http/https
        http_ok = True
        if parsed.scheme in ('http', 'https'):
            http_ok, http_msg = self.check_http_url(url)

        all_ok = dns_ok and tcp_ok and http_ok

        if all_ok:
            Logger.success("\n✨ Network connectivity validated")
        else:
            Logger.error("\n💥 Network connectivity issues detected")

        return all_ok

# =============================================================================
# Service Health Checker
# =============================================================================
class ServiceHealthChecker:
    """Checks BubbleLab service health"""

    def __init__(self, base_url: str, api_key: str = None):
        self.base_url = base_url.rstrip('/')
        self.api_key = api_key
        self.logger = logging.getLogger('ServiceHealthChecker')

    def check_health_endpoint(self) -> Tuple[bool, Dict]:
        """Check /health endpoint"""
        try:
            import requests
            headers = {}
            if self.api_key:
                headers['Authorization'] = f'Bearer {self.api_key}'

            response = requests.get(
                f"{self.base_url}/health",
                headers=headers,
                timeout=10
            )

            if response.status_code == 200:
                data = response.json()
                Logger.success(f"✓ Health check passed: {data.get('status', 'OK')}")
                return True, data
            else:
                Logger.warning(f"⚠️  Health check returned status {response.status_code}")
                return False, {'status': 'error', 'code': response.status_code}
        except requests.exceptions.RequestException as e:
            Logger.error(f"✗ Health check failed: {e}")
            return False, {'status': 'error', 'message': str(e)}
        except ImportError:
            Logger.warning("⚠️  Cannot check health (requests not installed)")
            return True, {'status': 'skipped'}

    def check_database_connectivity(self) -> Tuple[bool, str]:
        """Check database connectivity"""
        # This would check if BubbleLab can connect to its database
        # For now, we'll just check if the API is responsive
        try:
            import requests
            headers = {}
            if self.api_key:
                headers['Authorization'] = f'Bearer {self.api_key}'

            # Try a lightweight API call
            response = requests.get(
                f"{self.base_url}/",
                headers=headers,
                timeout=10
            )

            if response.status_code < 500:
                Logger.success("✓ API responsive (database likely connected)")
                return True, "API responsive"
            else:
                Logger.warning("⚠️  API returning errors (database may be disconnected)")
                return False, "API errors"
        except Exception as e:
            Logger.warning(f"⚠️  Cannot verify database: {e}")
            return True, "Database check skipped"

    def validate(self) -> bool:
        """Run all health checks"""
        Logger.section("Checking BubbleLab Service Health")

        health_ok, health_data = self.check_health_endpoint()
        db_ok, db_msg = self.check_database_connectivity()

        all_ok = health_ok and db_ok

        if all_ok:
            Logger.success("\n✨ Service health verified")
        else:
            Logger.warning("\n⚠️  Service health issues detected")

        return all_ok

# =============================================================================
# Environment Validator
# =============================================================================
class EnvironmentValidator:
    """Validates the runtime environment"""

    def __init__(self):
        self.errors = []
        self.warnings = []

    def validate_python_version(self) -> bool:
        """Check Python version >= 3.10"""
        Logger.section("Validating Python Version")
        version = sys.version_info
        version_str = f"{version.major}.{version.minor}.{version.micro}"

        if version.major == 3 and version.minor >= 10:
            Logger.success(f"Python {version_str} (>= 3.10 required)")
            return True
        else:
            Logger.error(f"Python {version_str} found (>= 3.10 required)")
            self.errors.append(f"Python version too old: {version_str}")
            return False

    def validate_pip(self) -> bool:
        """Check if pip is available"""
        try:
            subprocess.run(
                [sys.executable, '-m', 'pip', '--version'],
                capture_output=True,
                check=True
            )
            Logger.success("pip is available")
            return True
        except subprocess.CalledProcessError as e:
            Logger.error(f"pip not available: {e}")
            self.errors.append("pip not available")
            return False
        except FileNotFoundError as e:
            Logger.error(f"Python executable not found: {e}")
            self.errors.append("Python executable not found")
            return False

    def check_directory_writable(self, directory: Path) -> bool:
        """Check if directory is writable"""
        try:
            test_file = directory / '.write_test'
            test_file.touch()
            test_file.unlink()
            return True
        except PermissionError as e:
            Logger.error(f"Directory not writable (permission denied): {directory}")
            self.errors.append(f"Cannot write to {directory} (permission denied)")
            return False
        except OSError as e:
            Logger.error(f"Directory not writable: {directory} - {e}")
            self.errors.append(f"Cannot write to {directory}: {e}")
            return False

    def validate(self) -> Tuple[bool, List[str], List[str]]:
        """Run all validations"""
        Logger.header("ENVIRONMENT VALIDATION")
        all_valid = True

        all_valid &= self.validate_python_version()
        all_valid &= self.validate_pip()
        all_valid &= self.check_directory_writable(Path.cwd())

        if all_valid:
            Logger.success("\n✨ Environment validation PASSED")
        else:
            Logger.error("\n💥 Environment validation FAILED")

        return all_valid, self.errors, self.warnings

# =============================================================================
# Dependency Installer
# =============================================================================
class DependencyInstaller:
    """Installs all required dependencies"""

    REQUIRED_PACKAGES = [
        'requests>=2.31.0',
        'pyyaml>=6.0.0',
        'python-dotenv>=1.0.0',
    ]

    def __init__(self, rollback_manager: RollbackManager = None):
        self.installed = []
        self.failed = []
        self.rollback_manager = rollback_manager
        self.logger = logging.getLogger('DependencyInstaller')

    def install_package(self, package: str) -> bool:
        """Install a single package"""
        try:
            Logger.detail(f"Installing {package}...")
            subprocess.run(
                [sys.executable, '-m', 'pip', 'install', '-q', package],
                check=True,
                capture_output=True,
                timeout=120
            )
            Logger.success(f"✓ {package}")
            self.installed.append(package)

            # Register rollback
            if self.rollback_manager:
                def rollback():
                    try:
                        subprocess.run(
                            [sys.executable, '-m', 'pip', 'uninstall', '-y', package],
                            check=True,
                            capture_output=True,
                            timeout=60
                        )
                    except subprocess.CalledProcessError:
                        pass  # Ignore rollback failures
                self.rollback_manager.register(f"uninstall {package}", rollback)

            return True
        except subprocess.TimeoutExpired as e:
            Logger.error(f"✗ {package} (timeout)")
            self.failed.append(package)
            self.logger.error(f"Timeout installing {package}")
            return False
        except subprocess.CalledProcessError as e:
            Logger.error(f"✗ {package} (installation failed)")
            self.failed.append(package)
            self.logger.error(f"Failed to install {package}: {e}")
            return False
        except FileNotFoundError as e:
            Logger.error(f"✗ {package} (pip not found)")
            self.failed.append(package)
            self.logger.error(f"pip not found: {e}")
            return False

    def install_all(self) -> bool:
        """Install all required packages"""
        Logger.section("Installing Dependencies")

        all_success = True
        for package in self.REQUIRED_PACKAGES:
            success = self.install_package(package)
            all_success &= success

        if all_success:
            Logger.success(f"\n✨ All {len(self.installed)} packages installed successfully")
        else:
            Logger.warning(f"\n⚠️  {len(self.installed)} installed, {len(self.failed)} failed")

        return all_success

# =============================================================================
# Directory Structure Creator
# =============================================================================
class DirectoryCreator:
    """Creates the complete directory structure"""

    DIRECTORIES = [
        'bubblelab-workflows',
        'bubblelab-workflows/dev',
        'bubblelab-workflows/prod',
        'bubblelab-templates',
        'bubblelab-exports',
        'bubblelab-backups',
        'bubblelab-tests',
        'bubblelab-config',
    ]

    def __init__(self, base_dir: Path = None, rollback_manager: RollbackManager = None):
        self.base_dir = base_dir or Path.cwd()
        self.created = []
        self.existing = []
        self.rollback_manager = rollback_manager
        self.logger = logging.getLogger('DirectoryCreator')

    def create_directory(self, directory: str) -> bool:
        """Create a single directory"""
        path = self.base_dir / directory
        try:
            if path.exists():
                Logger.detail(f"✓ {directory} (already exists)")
                self.existing.append(directory)
                return True
            else:
                path.mkdir(parents=True, exist_ok=True)
                Logger.success(f"✓ {directory} (created)")
                self.created.append(directory)

                # Register rollback
                if self.rollback_manager:
                    def rollback():
                        try:
                            if path.exists():
                                path.rmdir()
                        except OSError:
                            pass  # Directory not empty, ignore
                    self.rollback_manager.register(f"remove directory {directory}", rollback)

                return True
        except PermissionError as e:
            Logger.error(f"✗ {directory} (permission denied)")
            self.logger.error(f"Permission denied creating {directory}: {e}")
            return False
        except OSError as e:
            Logger.error(f"✗ {directory} ({e})")
            self.logger.error(f"Failed to create {directory}: {e}")
            return False

    def create_all(self) -> bool:
        """Create all directories"""
        Logger.section("Creating Directory Structure")

        all_success = True
        for directory in self.DIRECTORIES:
            success = self.create_directory(directory)
            all_success &= success

        if all_success:
            Logger.success(f"\n✨ Directory structure ready")
            Logger.detail(f"  Created: {len(self.created)} directories")
            Logger.detail(f"  Existing: {len(self.existing)} directories")

        return all_success

# =============================================================================
# BubbleLab API Client (Extended)
# =============================================================================
class BubbleLabClient:
    """Extended BubbleLab API client with validation"""

    def __init__(self, base_url: str, api_key: str):
        self.base_url = base_url.rstrip('/')
        self.api_key = api_key
        self.session = None

        # Import requests here
        try:
            import requests
            self.session = requests.Session()
            self.session.headers.update({
                'Content-Type': 'application/json',
                'Authorization': f'Bearer {api_key}'
            })
        except ImportError:
            raise ImportError("requests package not installed")

    def _request(self, method: str, endpoint: str, **kwargs) -> Dict:
        """Make API request"""
        url = f"{self.base_url}{endpoint}"
        try:
            response = self.session.request(method, url, timeout=30, **kwargs)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            raise Exception(f"API request failed: {e}")

    def test_connection(self) -> Tuple[bool, str]:
        """Test API connectivity"""
        try:
            # Try to list flows (lightweight endpoint)
            self._request('GET', '/bubble-flow?limit=1')
            return True, "Connection successful"
        except Exception as e:
            return False, str(e)

    def get_system_status(self) -> Dict:
        """Get BubbleLab system status"""
        try:
            return self._request('GET', '/')
        except:
            return {}

    def list_credentials(self) -> List[Dict]:
        """List all credentials"""
        try:
            result = self._request('GET', '/credentials')
            return result.get('credentials', [])
        except:
            return []

    def create_credential(self, name: str, cred_type: str, value: str, description: str = "") -> Dict:
        """Create a credential"""
        return self._request('POST', '/credentials', json={
            'name': name,
            'type': cred_type,
            'value': value,
            'description': description
        })

# =============================================================================
# Configuration Generator
# =============================================================================
class ConfigurationGenerator:
    """Generates complete configuration files"""

    def __init__(self, base_url: str, api_key: str):
        self.base_url = base_url
        self.api_key = api_key

    def generate_yaml_config(self) -> Dict:
        """Generate YAML configuration"""
        return {
            'base_url': self.base_url,
            'api_key': self.api_key,
            'workflows_dir': './bubblelab-workflows',
            'templates_dir': './bubblelab-templates',
            'exports_dir': './bubblelab-exports',
            'backups_dir': './bubblelab-backups',
            'tests_dir': './bubblelab-tests',
            'environments': {
                'development': {
                    'api_url': 'http://localhost:8000',
                    'qdrant_url': 'http://localhost:6333',
                    'postgres_url': 'postgresql://postgres:password@localhost:5432/openevolve',
                    'redis_url': 'redis://localhost:6379',
                    'slack_channel': '#openevolve-dev'
                },
                'production': {
                    'api_url': self.base_url,
                    'qdrant_url': 'https://qdrant.openevolve.com',
                    'postgres_url': 'postgresql://user:pass@prod-db:5432/openevolve',
                    'redis_url': 'redis://prod-redis:6379',
                    'slack_channel': '#openevolve-alerts'
                }
            }
        }

    def generate_env_file(self) -> str:
        """Generate .env file content"""
        return f"""# BubbleLab Configuration
BUBBLELAB_BASE_URL={self.base_url}
BUBBLELAB_API_KEY={self.api_key}

# OpenEvolve Services
QDRANT_URL=http://localhost:6333
POSTGRES_URL=postgresql://postgres:password@localhost:5432/openevolve
REDIS_URL=redis://localhost:6379

# Slack (Optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#openevolve

# AI Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

"""

    def generate_gitignore(self) -> str:
        """Generate .gitignore content"""
        return """# BubbleLab
bubblelab-config.yaml
.env
bubblelab-backups/
bubblelab-exports/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
"""

    def generate_example_workflow(self) -> str:
        """Generate example workflow"""
        return """import {z} from 'zod';
import {BubbleFlow} from '@bubblelab/bubble-core';
import {PostgreSQLBubble} from '@bubblelab/bubble-core';
import {SlackBubble} from '@bubblelab/bubble-core';

export interface Output {
  status: string;
  records_count: number;
  message: string;
}

export class HealthCheckWorkflow extends BubbleFlow<'schedule/cron'> {
  readonly cronSchedule = '*/5 * * * *'; // Every 5 minutes

  async handle(): Promise<Output> {
    // Check PostgreSQL health
    const db = new PostgreSQLBubble({
      query: 'SELECT COUNT(*) as count FROM users WHERE created_at > NOW() - INTERVAL \'1 hour\''
    });

    const dbResult = await db.action();
    const count = dbResult.data.rows[0].count;

    // Send notification if threshold exceeded
    if (count > 100) {
      const slack = new SlackBubble({
        channel: '#alerts',
        text: `⚠️  High user registration rate: ${count} users in last hour`
      });

      await slack.action();
    }

    return {
      status: 'healthy',
      records_count: count,
      message: 'Health check completed'
    };
  }
}
"""

    def save_all(self, base_dir: Path) -> bool:
        """Save all configuration files"""
        Logger.section("Generating Configuration Files")

        try:
            # Save YAML config
            config_file = base_dir / 'bubblelab-config.yaml'
            with open(config_file, 'w') as f:
                yaml.dump(self.generate_yaml_config(), f, default_flow_style=False)
            Logger.success("✓ bubblelab-config.yaml")

            # Save .env
            env_file = base_dir / '.env'
            with open(env_file, 'w') as f:
                f.write(self.generate_env_file())
            Logger.success("✓ .env")

            # Save .gitignore
            gitignore_file = base_dir / '.gitignore'
            with open(gitignore_file, 'w') as f:
                f.write(self.generate_gitignore())
            Logger.success("✓ .gitignore")

            # Save example workflow
            workflow_file = base_dir / 'bubblelab-workflows' / 'health-check.ts'
            with open(workflow_file, 'w') as f:
                f.write(self.generate_example_workflow())
            Logger.success("✓ bubblelab-workflows/health-check.ts (example)")

            return True
        except Exception as e:
            Logger.error(f"Failed to generate configurations: {e}")
            return False

# =============================================================================
# Setup Orchestrator
# =============================================================================
class SetupOrchestrator:
    """Main setup orchestrator with production-grade reliability"""

    def __init__(self, api_url: str = None, api_key: str = None, skip_tests: bool = False):
        self.api_url = api_url or 'http://localhost:3001'
        self.api_key = api_key or os.environ.get('BUBBLELAB_API_KEY')
        self.skip_tests = skip_tests
        self.start_time = None
        self.rollback_manager = RollbackManager()
        self.backup_manager = None
        self.logger = self._setup_logging()
        self.results = {
            'file_lock': False,
            'resource_check': False,
            'validation': False,
            'backup': False,
            'dependencies': False,
            'directories': False,
            'configuration': False,
            'network': False,
            'service_health': False,
            'tests': False
        }

    def _setup_logging(self) -> logging.Logger:
        """Setup detailed logging to file"""
        log_dir = Path.cwd() / '.bubblelab-logs'
        log_dir.mkdir(exist_ok=True)

        log_file = log_dir / f'setup_{datetime.now().strftime("%Y%m%d_%H%M%S")}.log'

        logging.basicConfig(
            level=logging.DEBUG,
            format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
            handlers=[
                logging.FileHandler(log_file),
                logging.StreamHandler()
            ]
        )

        logger = logging.getLogger('SetupOrchestrator')
        logger.info(f"Logging to: {log_file}")
        return logger

    def run(self) -> bool:
        """Run complete setup with all reliability features"""
        self.start_time = time.time()
        Logger.header("BUBBLELAB COMPLETE AUTOMATED SETUP - PRODUCTION-GRADE")

        # Use file lock to prevent concurrent execution
        with FileLock():
            try:
                # Step 1: Check System Resources
                Logger.step(1, 10, "Checking System Resources")
                resource_validator = ResourceValidator()
                self.results['resource_check'] = resource_validator.validate()

                if not self.results['resource_check']:
                    Logger.error("\n❌ Insufficient system resources. Please free up resources and try again.")
                    self.print_summary()
                    return False

                # Step 2: Validate Environment
                Logger.step(2, 10, "Validating Environment")
                validator = EnvironmentValidator()
                valid, errors, warnings = validator.validate()
                self.results['validation'] = valid

                if not valid:
                    Logger.error("\n❌ Environment validation failed. Please fix the errors above.")
                    self.print_summary()
                    return False

                # Step 3: Backup Existing Files
                Logger.step(3, 10, "Backing Up Existing Files")
                self.backup_manager = BackupManager(Path.cwd())
                self.backup_manager.backup_config_files()
                self.results['backup'] = True  # Backup is optional, don't fail on errors

                # Step 4: Install Dependencies
                Logger.step(4, 10, "Installing Dependencies")
                installer = DependencyInstaller(self.rollback_manager)
                self.results['dependencies'] = installer.install_all()

                if not self.results['dependencies']:
                    Logger.warning("\n⚠️  Some dependencies failed to install.")
                    response = input("Continue anyway? (y/N): ").strip().lower()
                    if response != 'y':
                        Logger.info("Setup cancelled by user")
                        self.rollback_manager.rollback()
                        self.print_summary()
                        return False

                # Step 5: Create Directory Structure
                Logger.step(5, 10, "Creating Directory Structure")
                creator = DirectoryCreator(rollback_manager=self.rollback_manager)
                self.results['directories'] = creator.create_all()

                if not self.results['directories']:
                    Logger.error("\n❌ Failed to create directory structure")
                    self.rollback_manager.rollback()
                    self.print_summary()
                    return False

                # Step 6: Get API Credentials
                Logger.step(6, 10, "Configuring API Credentials")
                if not self.api_key:
                    Logger.warning("No API key provided via --api-key or BUBBLELAB_API_KEY env var")
                    Logger.info("You'll need to add it later to bubblelab-config.yaml")
                    self.api_key = "YOUR_API_KEY_HERE"

                # Step 7: Generate Configuration Files
                Logger.step(7, 10, "Generating Configuration Files")
                generator = ConfigurationGenerator(self.api_url, self.api_key)
                self.results['configuration'] = generator.save_all(Path.cwd())

                if not self.results['configuration']:
                    Logger.error("\n❌ Failed to generate configuration files")
                    self.rollback_manager.rollback()
                    self.print_summary()
                    return False

                # Step 8: Validate Network Connectivity
                Logger.step(8, 10, "Validating Network Connectivity")
                network_validator = NetworkValidator()
                self.results['network'] = network_validator.validate_url(self.api_url)

                if not self.results['network']:
                    Logger.warning("\n⚠️  Network connectivity issues detected")
                    response = input("Continue anyway? (y/N): ").strip().lower()
                    if response != 'y':
                        Logger.info("Setup cancelled by user")
                        self.rollback_manager.rollback()
                        self.print_summary()
                        return False

                # Step 9: Check Service Health (if API key provided)
                Logger.step(9, 10, "Checking BubbleLab Service Health")
                if self.api_key and self.api_key != "YOUR_API_KEY_HERE":
                    try:
                        health_checker = ServiceHealthChecker(self.api_url, self.api_key)
                        self.results['service_health'] = health_checker.validate()
                    except ImportError:
                        Logger.warning("⚠️  Cannot check service health (requests not installed)")
                        self.results['service_health'] = None
                else:
                    Logger.info("Skipping service health check (no API key provided)")
                    self.results['service_health'] = None

                # Step 10: Run Tests (unless skipped)
                if not self.skip_tests:
                    Logger.step(10, 10, "Running Validation Tests")
                    self.results['tests'] = self.run_tests()
                else:
                    Logger.info("Skipping tests (--skip-tests flag)")
                    self.results['tests'] = None

                # Commit changes - all successful, clear rollbacks
                self.rollback_manager.commit()

                # Print Summary
                self.print_summary()

                # Return success if all critical steps passed
                critical_success = (
                    self.results['resource_check'] and
                    self.results['validation'] and
                    self.results['directories'] and
                    self.results['configuration']
                )

                if critical_success:
                    Logger.success("\n🎉 SETUP COMPLETE!")
                    self.print_next_steps()
                else:
                    Logger.error("\n💥 SETUP INCOMPLETE")
                    Logger.info("Please fix the errors above and run setup again")

                return critical_success

            except KeyboardInterrupt:
                Logger.warning("\n\n⚠️  Setup interrupted by user")
                self.rollback_manager.rollback()
                self.print_summary()
                return False
            except Exception as e:
                Logger.error(f"\n\n💥 Fatal error during setup: {e}")
                self.logger.error(f"Fatal error: {e}", exc_info=True)
                Logger.detail("See log file for full error details")
                self.rollback_manager.rollback()
                self.print_summary()
                return False

    def run_tests(self) -> bool:
        """Run validation tests"""
        tests_passed = True

        # Test 1: Config file exists and is valid
        Logger.detail("Testing configuration file...")
        try:
            config_file = Path.cwd() / 'bubblelab-config.yaml'
            if config_file.exists():
                with open(config_file, 'r') as f:
                    config = yaml.safe_load(f)
                    if 'base_url' in config and 'api_key' in config:
                        Logger.success("✓ Configuration file valid")
                    else:
                        Logger.error("✗ Configuration file missing required fields")
                        tests_passed = False
            else:
                Logger.error("✗ Configuration file not found")
                tests_passed = False
        except yaml.YAMLError as e:
            Logger.error(f"✗ Configuration test failed (YAML error): {e}")
            self.logger.error(f"YAML error: {e}", exc_info=True)
            tests_passed = False
        except IOError as e:
            Logger.error(f"✗ Configuration test failed (IO error): {e}")
            self.logger.error(f"IO error: {e}", exc_info=True)
            tests_passed = False

        # Test 2: Directories exist
        Logger.detail("Testing directory structure...")
        required_dirs = ['bubblelab-workflows', 'bubblelab-exports', 'bubblelab-backups']
        for dir_name in required_dirs:
            dir_path = Path.cwd() / dir_name
            if dir_path.exists():
                Logger.success(f"✓ {dir_name}/ exists")
            else:
                Logger.error(f"✗ {dir_name}/ missing")
                tests_passed = False

        # Test 3: Python packages importable
        Logger.detail("Testing Python packages...")
        for package in ['yaml', 'requests']:
            try:
                __import__(package)
                Logger.success(f"✓ {package} importable")
            except ImportError as e:
                Logger.error(f"✗ {package} not importable: {e}")
                self.logger.error(f"Import error for {package}: {e}")
                tests_passed = False

        if tests_passed:
            Logger.success("\n✓ All tests passed")
        else:
            Logger.warning("\n⚠️  Some tests failed")

        return tests_passed

    def print_summary(self):
        """Print setup summary"""
        elapsed = time.time() - self.start_time

        Logger.header("SETUP SUMMARY")

        print(f"Time elapsed: {elapsed:.2f} seconds\n")

        print("Results:")
        for step, result in self.results.items():
            if result is True:
                Logger.success(f"  ✓ {step}")
            elif result is False:
                Logger.error(f"  ✗ {step}")
            else:
                Logger.warning(f"  ○ {step} (skipped)")

        # Print backup location if created
        if self.backup_manager and self.backup_manager.backups_created:
            Logger.info(f"\nBackups saved to: {self.backup_manager.backup_dir}")
        Logger.info(f"\nFull log: .bubblelab-logs/setup_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log")

    def print_next_steps(self):
        """Print next steps"""
        Logger.section("Next Steps")

        steps = [
            "1. Review configuration in bubblelab-config.yaml",
            "2. Add your API key if not already set",
            "3. Configure credentials in BubbleLab dashboard or via API",
            "4. Add your workflow files to bubblelab-workflows/",
            "5. Run: python bubblelab-automation.py deploy",
            "6. Monitor with: python bubblelab-automation.py monitor --flow-name 'Your Workflow'",
            "",
            "Quick Start Commands:",
            "  python bubblelab-automation.py list              # List all workflows",
            "  python bubblelab-automation.py status            # Check system status",
            "  python bubblelab-automation.py generate \\        # Generate with AI",
            "    --prompt 'Monitor Qdrant health' \\",
            "    --name 'Qdrant Monitor'",
            "",
            "Documentation:",
            "  - docs/BUBBLELAB_AUTOMATION_GUIDE.md     # Complete guide",
            "  - docs/BUBBLELAB_SCRIPTING_GUIDE.md      # API reference",
            "  - docs/BUBBLELAB_AUTOMATION_README.md    # Quick reference"
        ]

        for step in steps:
            print(f"  {step}")

# =============================================================================
# Main Entry Point
# =============================================================================
def main():
    """Main entry point with proper exception handling"""
    parser = argparse.ArgumentParser(
        description='BubbleLab Complete Automated Setup (Production-Grade)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Interactive setup (default)
  python bubblelab-auto-setup.py

  # Specify API URL and key
  python bubblelab-auto-setup.py --api-url http://localhost:3001 --api-key your_key

  # Skip validation tests (faster)
  python bubblelab-auto-setup.py --skip-tests

  # Production setup
  python bubblelab-auto-setup.py --api-url https://api.bubblelab.io --api-key prod_key

Reliability Features:
  - File locking to prevent concurrent execution
  - Automatic rollback on failure
  - Backup of existing configuration files
  - System resource validation (disk, memory)
  - Network connectivity checks
  - Service health validation
  - Detailed logging to .bubblelab-logs/
        """
    )

    parser.add_argument(
        '--api-url',
        help='BubbleLab API URL (default: http://localhost:3001)'
    )
    parser.add_argument(
        '--api-key',
        help='BubbleLab API Key (or set BUBBLELAB_API_KEY env var)'
    )
    parser.add_argument(
        '--skip-tests',
        action='store_true',
        help='Skip validation tests (faster setup)'
    )
    parser.add_argument(
        '--version',
        action='version',
        version='BubbleLab Auto Setup v3.0.0 (Production-Grade)'
    )

    args = parser.parse_args()

    # Run setup
    orchestrator = SetupOrchestrator(
        api_url=args.api_url,
        api_key=args.api_key,
        skip_tests=args.skip_tests
    )

    success = orchestrator.run()
    sys.exit(0 if success else 1)

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        Logger.warning("\n\n⚠️  Setup interrupted by user")
        sys.exit(130)
    except MemoryError:
        Logger.error("\n\n💥 Fatal error: Out of memory")
        Logger.info("Please free up memory and try again")
        sys.exit(1)
    except PermissionError as e:
        Logger.error(f"\n\n💥 Fatal error: Permission denied - {e}")
        Logger.info("Please check file permissions and run with appropriate privileges")
        sys.exit(1)
    except OSError as e:
        Logger.error(f"\n\n💥 Fatal error: System error - {e}")
        Logger.info("Please check disk space and file system")
        sys.exit(1)
    except Exception as e:
        Logger.error(f"\n\n💥 Fatal error: {e}")
        import traceback
        Logger.detail(traceback.format_exc())
        sys.exit(1)
