"""
BubbleLabs Node Registry

Central registry for all OpenEvolve nodes integrated with BubbleLabs.
"""

from typing import Dict, Type, Optional
from .base_node import BubbleLabsNode, NodeExecutionError


class NodeRegistry:
    """
    Registry for managing available node types.

    Provides factory methods for creating nodes and discovering
    available node types.
    """

    _nodes: Dict[str, Type[BubbleLabsNode]] = {}

    @classmethod
    def register(cls, node_type: str, node_class: Type[BubbleLabsNode]):
        """
        Register a node type.

        Args:
            node_type: Unique identifier for the node type
            node_class: Node class (must inherit from BubbleLabsNode)
        """
        if not issubclass(node_class, BubbleLabsNode):
            raise TypeError(f"{node_class} must inherit from BubbleLabsNode")

        cls._nodes[node_type] = node_class

    @classmethod
    def unregister(cls, node_type: str):
        """Unregister a node type"""
        if node_type in cls._nodes:
            del cls._nodes[node_type]

    @classmethod
    def get(cls, node_type: str, config: Optional[Dict] = None) -> BubbleLabsNode:
        """
        Create a node instance.

        Args:
            node_type: Type of node to create
            config: Node configuration

        Returns:
            Node instance

        Raises:
            ValueError: If node type is not registered
        """
        node_class = cls._nodes.get(node_type)
        if not node_class:
            available = ', '.join(cls._nodes.keys())
            raise ValueError(
                f"Unknown node type: {node_type}. "
                f"Available types: {available}"
            )

        try:
            return node_class(config)
        except Exception as e:
            raise ValueError(f"Failed to instantiate node {node_type}: {str(e)}")

    @classmethod
    def get_with_timeout(cls, node_type: str, config: Optional[Dict] = None, timeout_seconds: int = 10) -> BubbleLabsNode:
        """
        Create a node instance with timeout protection.

        Args:
            node_type: Type of node to create
            config: Node configuration
            timeout_seconds: Maximum time to wait for instantiation

        Returns:
            Node instance

        Raises:
            ValueError: If node type is not registered or instantiation fails
        """
        import threading

        result = [None]
        exception = [None]

        def target():
            try:
                node_instance = cls.get(node_type, config)
                result[0] = node_instance
            except Exception as e:
                exception[0] = e

        thread = threading.Thread(target=target)
        thread.daemon = True
        thread.start()
        thread.join(timeout_seconds)

        if thread.is_alive():
            raise ValueError(f"Node instantiation timed out after {timeout_seconds} seconds: {node_type}")

        if exception[0]:
            raise exception[0]

        return result[0]

    @classmethod
    def list_nodes(cls) -> Dict[str, Type[BubbleLabsNode]]:
        """Get all registered node types"""
        return cls._nodes.copy()

    @classmethod
    def get_node_info(cls, node_type: str) -> Dict:
        """
        Get information about a node type.

        Returns:
            Dict with display_name, description, icon, category, etc.
        """
        node_class = cls._nodes.get(node_type)
        if not node_class:
            raise ValueError(f"Unknown node type: {node_type}")

        try:
            # Create temporary instance to get metadata
            temp_instance = node_class()

            return {
                'type': node_type,
                'display_name': temp_instance.get_display_name(),
                'description': temp_instance.get_description(),
                'icon': temp_instance.get_icon(),
                'category': temp_instance.get_category(),
                'version': temp_instance.get_version(),
                'parameter_schema': temp_instance.get_parameter_schema()
            }
        except Exception as e:
            # Return basic info even if instantiation fails
            return {
                'type': node_type,
                'display_name': getattr(node_class, 'DISPLAY_NAME', node_type),
                'description': getattr(node_class, 'DESCRIPTION', 'No description available'),
                'icon': getattr(node_class, 'ICON', 'default-node'),
                'category': getattr(node_class, 'CATEGORY', 'general'),
                'version': getattr(node_class, 'VERSION', '1.0.0'),
                'parameter_schema': {},
                'error': f"Could not instantiate node for full info: {str(e)}"
            }

    @classmethod
    def list_all_info(cls) -> Dict[str, Dict]:
        """Get information about all registered nodes"""
        return {
            node_type: cls.get_node_info(node_type)
            for node_type in cls._nodes
        }

    @classmethod
    def check_health(cls) -> Dict[str, Dict[str, bool]]:
        """Check health of all registered nodes"""
        health_report = {}
        for node_type in cls._nodes:
            try:
                # Create a temporary instance to check health
                temp_instance = cls._nodes[node_type]()
                is_healthy = temp_instance.is_healthy()
                health_report[node_type] = {'healthy': is_healthy}
            except Exception as e:
                health_report[node_type] = {'healthy': False, 'error': str(e)}
        return health_report


# Convenience functions
def register_node(node_type: str, node_class: Type[BubbleLabsNode]):
    """Register a node type (convenience function)"""
    try:
        NodeRegistry.register(node_type, node_class)
    except Exception as e:
        import logging
        logging.getLogger(__name__).error(f"Failed to register node {node_type}: {e}")
        raise


def get_node(node_type: str, config: Optional[Dict] = None) -> BubbleLabsNode:
    """Create a node instance (convenience function)"""
    try:
        return NodeRegistry.get(node_type, config)
    except Exception as e:
        import logging
        logger = logging.getLogger(__name__)
        logger.error(f"Failed to get node {node_type}: {e}")
        raise


def get_node_with_timeout(node_type: str, config: Optional[Dict] = None, timeout_seconds: int = 10) -> BubbleLabsNode:
    """Create a node instance with timeout protection (convenience function)"""
    try:
        return NodeRegistry.get_with_timeout(node_type, config, timeout_seconds)
    except Exception as e:
        import logging
        logger = logging.getLogger(__name__)
        logger.error(f"Failed to get node with timeout {node_type}: {e}")
        raise


def list_nodes() -> Dict[str, Type[BubbleLabsNode]]:
    """List all registered nodes (convenience function)"""
    try:
        return NodeRegistry.list_nodes()
    except Exception as e:
        import logging
        logger = logging.getLogger(__name__)
        logger.error(f"Failed to list nodes: {e}")
        return {}


def check_nodes_health() -> Dict[str, Dict[str, bool]]:
    """Check health of all registered nodes (convenience function)"""
    try:
        return NodeRegistry.check_health()
    except Exception as e:
        import logging
        logger = logging.getLogger(__name__)
        logger.error(f"Failed to check node health: {e}")
        return {}


# Auto-import and register node implementations
# All 8 nodes are now implemented!

def _register_nodes_safely():
    """Safely register all available nodes with error handling."""
    import logging
    logger = logging.getLogger(__name__)

    node_registrations = [
        ('decomposition', '.decomposition_node', 'DecompositionNode'),
        ('subproblem', '.subproblem_node', 'SubProblemNode'),
        ('gauntlet', '.gauntlet_node', 'GauntletNode'),
        ('solution', '.solution_node', 'SolutionNode'),
        ('verification', '.verification_node', 'VerificationNode'),
        ('assembly', '.assembly_node', 'AssemblyNode'),
        ('output', '.output_node', 'OutputNode'),
        ('knowledge_extraction', '.knowledge_extraction_node', 'KnowledgeExtractionNode'),
    ]

    registered_count = 0

    for node_type, module_path, class_name in node_registrations:
        try:
            # Import the module
            module = __import__(module_path, fromlist=[class_name], level=1)

            # Get the class from the module
            node_class = getattr(module, class_name)

            # Register the node
            NodeRegistry.register(node_type, node_class)
            registered_count += 1

            logger.info(f"Successfully registered node: {node_type}")

        except ImportError as e:
            logger.warning(f"Could not import {class_name} from {module_path}: {e}")
        except AttributeError as e:
            logger.warning(f"Could not find {class_name} in {module_path}: {e}")
        except Exception as e:
            logger.error(f"Error registering {node_type} node: {e}")

    logger.info(f"Node registration completed: {registered_count}/{len(node_registrations)} nodes registered")

# Register nodes safely
_register_nodes_safely()


__all__ = [
    'BubbleLabsNode',
    'NodeExecutionError',
    'NodeRegistry',
    'register_node',
    'get_node',
    'get_node_with_timeout',
    'list_nodes',
    'check_nodes_health',
]

