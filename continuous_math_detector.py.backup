"""
Continuous Mathematics Detector for LeanAide

This module implements detection and classification of continuous mathematics
problems in natural language and mathematical notation, including:
- ODEs (Ordinary Differential Equations)
- PDEs (Partial Differential Equations)
- DAEs (Differential-Algebraic Equations)
- SDEs (Stochastic Differential Equations)
- Integrals and derivatives

Author: OpenEvolve
Created: 2026-01-09
Phase: 2 - LeanAide Enhancement (Task B.1)
"""

import re
import logging
from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Dict, List, Optional, Tuple, Union
import sympy as sp
from sympy.parsing.sympy_parser import parse_expr

# Configure logging
logger = logging.getLogger(__name__)


# ============================================================================
# Enumerations and Data Structures
# ============================================================================

class MathType(Enum):
    """Types of continuous mathematics"""
    ODE = "ordinary_differential_equation"
    PDE = "partial_differential_equation"
    DAE = "differential_algebraic_equation"
    SDE = "stochastic_differential_equation"
    INTEGRAL = "integral"
    DERIVATIVE = "derivative"
    LIMIT = "limit"
    SERIES = "series"
    UNKNOWN = "unknown_math_type"


class ProblemType(Enum):
    """Classification of differential equation problems"""
    INITIAL_VALUE = "initial_value_problem"
    BOUNDARY_VALUE = "boundary_value_problem"
    INITIAL_BOUNDARY_VALUE = "initial_boundary_value_problem"
    EIGENVALUE = "eigenvalue_problem"
    CONTROL = "control_problem"
    OPTIMIZATION = "optimization_problem"
    UNKNOWN = "unknown_problem_type"


class ScientificDomain(Enum):
    """Scientific domains for math problems"""
    PHYSICS = "physics"
    CHEMISTRY = "chemistry"
    BIOLOGY = "biology"
    ENGINEERING = "engineering"
    ECONOMICS = "economics"
    GENERAL = "general"


@dataclass
class MathDetectionResult:
    """Result of mathematics detection and classification"""
    math_type: MathType
    problem_type: ProblemType
    domain: ScientificDomain
    confidence: float  # 0.0 to 1.0
    equations: List[str] = field(default_factory=list)
    variables: List[str] = field(default_factory=list)
    notation: str = ""  # LaTeX or SymPy notation detected
    keywords: List[str] = field(default_factory=list)
    metadata: Dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "math_type": self.math_type.value,
            "problem_type": self.problem_type.value,
            "domain": self.domain.value,
            "confidence": self.confidence,
            "equations": self.equations,
            "variables": self.variables,
            "notation": self.notation,
            "keywords": self.keywords,
            "metadata": self.metadata
        }


# ============================================================================
# Continuous Mathematics Detector
# ============================================================================

class ContinuousMathDetector:
    """
    Detects and classifies continuous mathematics in natural language
    and mathematical notation.

    Features:
    - Detect ODEs, PDEs, DAEs, SDEs
    - Recognize integrals, derivatives, limits
    - Identify mathematical notation (LaTeX, SymPy)
    - Classify problem types (IVP, BVP, etc.)
    - Detect scientific domain
    """

    def __init__(self):
        """Initialize the continuous math detector"""
        self._init_ode_patterns()
        self._init_pde_patterns()
        self._init_dae_patterns()
        self._init_sde_patterns()
        self._init_integral_patterns()
        self._init_derivative_patterns()
        self._init_domain_keywords()

    def _init_ode_patterns(self):
        """Initialize ODE detection patterns"""
        self.ode_patterns = [
            # Common ODE patterns
            r"\byt*y'\s*\([^)]*\)",  # y'(...)
            r"\byt*y''\s*\([^)]*\)",  # y''(...)
            r"\bdy/dx\b",
            r"\bd\d*y/\bdx\^\d+\b",  # d^n y/dx^n
            r"\bd\s*y\s*/\s*dt\b",
            # Words indicating ODE
            r"\bordinary differential equation\b",
            r"\bODE\b",
            r"\binitial value problem\b",
            r"\bIVP\b",
            r"\bboundary value problem\b",
            r"\bBVP\b",
            # Named ODEs
            r"\bBessel equation\b",
            r"\bLegendre equation\b",
            r"\bHermite equation\b",
            r"\bLaguerre equation\b",
            r"\bAiry equation\b",
            r"\bvan der Pol equation\b",
            r"\bDuffing equation\b",
            r"\bRiccati equation\b",
            r"\bEuler equation\b",
            r"\bCauchy-Euler equation\b",
        ]

    def _init_pde_patterns(self):
        """Initialize PDE detection patterns"""
        self.pde_patterns = [
            # Partial derivative notation
            r"\b∂\w+/∂\w+\b",
            r"\bpartial\b.*\bpartial\b",
            r"\bpde\b",
            r"\bpartial differential equation\b",
            r"\bheat equation\b",
            r"\bwave equation\b",
            r"\bLaplace equation\b",
            r"\bPoisson equation\b",
            r"\bSchrödinger equation\b",
            r"\bSchrodinger equation\b",
            r"\bNavier-Stokes equation\b",
            r"\bKorteweg-de Vries equation\b",
            r"\bKdV equation\b",
            r"\bdiffusion equation\b",
        ]

    def _init_dae_patterns(self):
        """Initialize DAE detection patterns"""
        self.dae_patterns = [
            r"\bdifferential-algebraic equation\b",
            r"\bDAE\b",
            r"\balgebraic constraint\b",
            r"\bindex\b.*\bdifferential\b",
            r"\bsingular\b.*\bmass matrix\b",
        ]

    def _init_sde_patterns(self):
        """Initialize SDE detection patterns"""
        self.sde_patterns = [
            r"\bstochastic differential equation\b",
            r"\bSDE\b",
            r"\bWiener process\b",
            r"\bBrownian motion\b",
            r"\bito integral\b",
            r"\bStratonovich integral\b",
            r"\bdW\b.*\bdifferential\b",
            r"\blangevin equation\b",
            r"\bgeometric Brownian motion\b",
        ]

    def _init_integral_patterns(self):
        """Initialize integral detection patterns"""
        self.integral_patterns = [
            # LaTeX integral notation
            r"\\int[^{]*\{[^}]*\}",
            r"\\int[^{]*_\{[^}]*\}\^\{[^}]*\}",
            r"\\iint[^{]*\{[^}]*\}",
            r"\\iiint[^{]*\{[^}]*\}",
            # Words
            r"\bintegral\b",
            r"\bdouble integral\b",
            r"\btriple integral\b",
            r"\bline integral\b",
            r"\bsurface integral\b",
            r"\bvolume integral\b",
            r"\bdefinite integral\b",
            r"\bindefinite integral\b",
            r"\bantiderivative\b",
            r"\barea under the curve\b",
        ]

    def _init_derivative_patterns(self):
        """Initialize derivative detection patterns"""
        self.derivative_patterns = [
            # Derivative notation
            r"\bdy/dx\b",
            r"\bf'\([^)]*\)",
            r"\bf''\([^)]*\)",
            r"\bpartial\b.*\bpartial\b",
            r"\b∂\w+/∂\w+\b",
            # Words
            r"\bderivative\b",
            r"\bdifferentiat\b",
            r"\brate of change\b",
            r"\bgradient\b",
            r"\btangent\b",
            r"\bvelocity\b",
            r"\bacceleration\b",
        ]

    def _init_domain_keywords(self):
        """Initialize domain-specific keyword mappings"""
        self.domain_keywords = {
            ScientificDomain.PHYSICS: [
                "force", "energy", "momentum", "velocity", "acceleration",
                "quantum", "relativity", "electromagnetic", "mechanics",
                "dynamics", "kinetics", "thermodynamics", "optics",
                "Newton", "Lagrangian", "Hamiltonian", "Maxwell"
            ],
            ScientificDomain.CHEMISTRY: [
                "reaction", "concentration", "rate", "catalyst", "kinetics",
                "molecule", "atomic", "molecular", "chemical", "equilibrium",
                "diffusion", "transport", "reaction rate", " Arrhenius"
            ],
            ScientificDomain.BIOLOGY: [
                "population", "growth", "decay", "predator", "prey",
                "epidemic", "spread", "infection", "bacteria", "virus",
                "Lotka-Volterra", "SIR model", "logistic", "Michaelis-Menten"
            ],
            ScientificDomain.ENGINEERING: [
                "control", "feedback", "stability", "signal", "system",
                "filter", "circuit", "voltage", "current", "power",
                "control theory", "transfer function", "frequency response"
            ],
            ScientificDomain.ECONOMICS: [
                "price", "stock", "option", "Black-Scholes", "volatility",
                "interest rate", "inflation", "demand", "supply",
                "utility", "consumption", "investment"
            ]
        }

    # ==========================================================================
    # Main Detection Methods
    # ==========================================================================

    def detect(self, text: str) -> MathDetectionResult:
        """
        Detect and classify continuous mathematics in text.

        Args:
            text: Input text (natural language or mathematical notation)

        Returns:
            MathDetectionResult with classification and confidence
        """
        # Prepare text
        text_clean = text.strip()

        # Detect math type
        math_type, math_confidence = self._detect_math_type(text_clean)

        # Detect problem type
        problem_type, problem_confidence = self._detect_problem_type(text_clean)

        # Detect scientific domain
        domain, domain_confidence = self._detect_domain(text_clean)

        # Extract equations
        equations = self._extract_equations(text_clean)

        # Extract variables
        variables = self._extract_variables(text_clean, equations)

        # Extract notation
        notation = self._extract_notation(text_clean, equations)

        # Extract keywords
        keywords = self._extract_keywords(text_clean)

        # Calculate overall confidence
        overall_confidence = (math_confidence + problem_confidence + domain_confidence) / 3

        return MathDetectionResult(
            math_type=math_type,
            problem_type=problem_type,
            domain=domain,
            confidence=overall_confidence,
            equations=equations,
            variables=variables,
            notation=notation,
            keywords=keywords,
            metadata={
                "math_confidence": math_confidence,
                "problem_confidence": problem_confidence,
                "domain_confidence": domain_confidence
            }
        )

    def _detect_math_type(self, text: str) -> Tuple[MathType, float]:
        """
        Detect the type of continuous mathematics.

        Args:
            text: Input text

        Returns:
            Tuple of (MathType, confidence)
        """
        text_lower = text.lower()

        # Check for ODE
        if any(re.search(pattern, text, re.IGNORECASE) for pattern in self.ode_patterns):
            # Also check if it's not a PDE
            if not any(re.search(p, text, re.IGNORECASE) for p in self.pde_patterns):
                return (MathType.ODE, 0.85)
            return (MathType.ODE, 0.7)  # Could be both ODE and PDE

        # Check for PDE
        if any(re.search(pattern, text, re.IGNORECASE) for pattern in self.pde_patterns):
            return (MathType.PDE, 0.85)

        # Check for SDE
        if any(re.search(pattern, text, re.IGNORECASE) for pattern in self.sde_patterns):
            return (MathType.SDE, 0.85)

        # Check for DAE
        if any(re.search(pattern, text, re.IGNORECASE) for pattern in self.dae_patterns):
            return (MathType.DAE, 0.80)

        # Check for integral
        if any(re.search(pattern, text, re.IGNORECASE) for pattern in self.integral_patterns):
            return (MathType.INTEGRAL, 0.80)

        # Check for derivative
        if any(re.search(pattern, text, re.IGNORECASE) for pattern in self.derivative_patterns):
            return (MathType.DERIVATIVE, 0.75)

        # Check for limit
        if r"\blimit\b" in text_lower or r"\lim" in text or r"\to" in text:
            return (MathType.LIMIT, 0.70)

        # Check for series
        if r"\bseries\b" in text_lower or r"\sum\b" in text or r"Σ" in text:
            return (MathType.SERIES, 0.70)

        return (MathType.UNKNOWN, 0.0)

    def _detect_problem_type(self, text: str) -> Tuple[ProblemType, float]:
        """
        Detect the type of problem (IVP, BVP, etc.).

        Args:
            text: Input text

        Returns:
            Tuple of (ProblemType, confidence)
        """
        text_lower = text.lower()

        # Check for initial value problem
        ivp_keywords = ["initial", "initial condition", "y(0)", "y\\(0\\)", "at t=0"]
        if any(keyword in text_lower or keyword in text for keyword in ivp_keywords):
            return (ProblemType.INITIAL_VALUE, 0.80)

        # Check for boundary value problem
        bvp_keywords = ["boundary", "boundary condition", "at x=", "y(0)", "y(L)"]
        if any(keyword in text_lower or keyword in text for keyword in bvp_keywords):
            return (ProblemType.BOUNDARY_VALUE, 0.80)

        # Check for initial-boundary value problem
        if "initial" in text_lower and "boundary" in text_lower:
            return (ProblemType.INITIAL_BOUNDARY_VALUE, 0.85)

        # Check for eigenvalue problem
        eigenvalue_keywords = ["eigenvalue", "eigen value", "eigenfunction", "characteristic equation"]
        if any(keyword in text_lower for keyword in eigenvalue_keywords):
            return (ProblemType.EIGENVALUE, 0.80)

        # Check for control problem
        control_keywords = ["control", "feedback", "stabilize", "regulator"]
        if any(keyword in text_lower for keyword in control_keywords):
            return (ProblemType.CONTROL, 0.70)

        # Check for optimization problem
        optimization_keywords = ["minimize", "maximize", "optimize", "optimal"]
        if any(keyword in text_lower for keyword in optimization_keywords):
            return (ProblemType.OPTIMIZATION, 0.70)

        return (ProblemType.UNKNOWN, 0.0)

    def _detect_domain(self, text: str) -> Tuple[ScientificDomain, float]:
        """
        Detect the scientific domain.

        Args:
            text: Input text

        Returns:
            Tuple of (ScientificDomain, confidence)
        """
        text_lower = text.lower()

        domain_scores = {}
        for domain, keywords in self.domain_keywords.items():
            score = sum(1 for keyword in keywords if keyword.lower() in text_lower)
            if score > 0:
                domain_scores[domain] = score / len(keywords)

        if domain_scores:
            best_domain = max(domain_scores, key=domain_scores.get)
            confidence = min(domain_scores[best_domain] * 2, 1.0)  # Scale to [0, 1]
            return (best_domain, confidence)

        return (ScientificDomain.GENERAL, 0.0)

    def _extract_equations(self, text: str) -> List[str]:
        """
        Extract mathematical equations from text.

        Args:
            text: Input text

        Returns:
            List of equation strings
        """
        equations = []

        # Extract LaTeX equations
        latex_equations = re.findall(r'\$\$[^$]+\$\$', text)
        equations.extend(latex_equations)

        # Extract inline math
        inline_math = re.findall(r'\$[^$]+\$', text)
        equations.extend(inline_math)

        # Extract equations with = sign
        # Look for patterns like "dy/dx = f(x,y)" or "y' = ..."
        equation_patterns = [
            r"[a-zA-Z]'?\s*=\s*[^.!?]+(?=[.!?]|$)",
            r"\bd[a-z]*\s*/\s*d[a-z]+\s*=\s*[^.!?]+(?=[.!?]|$)",
            r"[a-zA-Z]\s*\^\s*\d+\s*=\s*[^.!?]+(?=[.!?]|$)",
        ]

        for pattern in equation_patterns:
            matches = re.findall(pattern, text, re.MULTILINE)
            equations.extend([m.strip() for m in matches if m.strip()])

        return list(set(equations))  # Remove duplicates

    def _extract_variables(self, text: str, equations: List[str]) -> List[str]:
        """
        Extract variable names from text and equations.

        Args:
            text: Input text
            equations: List of equations

        Returns:
            List of variable names
        """
        variables = set()

        # Common math variables
        math_vars = ['x', 'y', 'z', 't', 'u', 'v', 'w', 'f', 'g', 'h']
        for var in math_vars:
            if re.search(r'\b' + var + r'\b', text):
                variables.add(var)

        # Extract from equations
        for eq in equations:
            # Try to parse with sympy
            try:
                expr = parse_expr(eq)
                variables.update(expr.free_symbols)
            except:
                # Fallback to regex
                for var in math_vars:
                    if var in eq:
                        variables.add(var)

        return sorted(list(variables))

    def _extract_notation(self, text: str, equations: List[str]) -> str:
        """
        Determine the mathematical notation used.

        Args:
            text: Input text
            equations: List of equations

        Returns:
            Notation type
        """
        # Check for LaTeX
        latex_indicators = ['\\', '\\frac', '\\int', '\\sum', '\\partial', 'begin{equation}']
        if any(indicator in text for indicator in latex_indicators):
            return "LaTeX"

        # Check for SymPy/Python notation
        sympy_indicators = ['**', 'sqrt(', 'exp(', 'sin(', 'cos(', 'Derivative(', 'symbols(']
        if any(indicator in text for indicator in sympy_indicators):
            return "SymPy"

        # Check for standard math notation
        if equations:
            return "Standard"

        return "Natural Language"

    def _extract_keywords(self, text: str) -> List[str]:
        """
        Extract relevant mathematical keywords from text.

        Args:
            text: Input text

        Returns:
            List of keywords
        """
        keywords = []

        # Math operation keywords
        math_keywords = [
            "differentiate", "integrate", "solve", "prove", "verify",
            "limit", "series", "expand", "simplify", "factor",
            "derivative", "integral", "differential", "equation"
        ]

        text_lower = text.lower()
        for keyword in math_keywords:
            if keyword in text_lower:
                keywords.append(keyword)

        return sorted(list(set(keywords)))

    # ==========================================================================
    # Specialized Detection Methods
    # ==========================================================================

    def detect_ode(self, text: str) -> MathDetectionResult:
        """
        Specifically detect ODEs (Ordinary Differential Equations).

        Args:
            text: Input text

        Returns:
            MathDetectionResult with ODE classification
        """
        result = self.detect(text)

        # Override math type if ODE patterns detected
        if any(re.search(p, text, re.IGNORECASE) for p in self.ode_patterns):
            result.math_type = MathType.ODE
            result.confidence = max(result.confidence, 0.8)

        return result

    def detect_pde(self, text: str) -> MathDetectionResult:
        """
        Specifically detect PDEs (Partial Differential Equations).

        Args:
            text: Input text

        Returns:
            MathDetectionResult with PDE classification
        """
        result = self.detect(text)

        # Override math type if PDE patterns detected
        if any(re.search(p, text, re.IGNORECASE) for p in self.pde_patterns):
            result.math_type = MathType.PDE
            result.confidence = max(result.confidence, 0.8)

        return result

    def detect_dae(self, text: str) -> MathDetectionResult:
        """
        Specifically detect DAEs (Differential-Algebraic Equations).

        Args:
            text: Input text

        Returns:
            MathDetectionResult with DAE classification
        """
        result = self.detect(text)

        # Override math type if DAE patterns detected
        if any(re.search(p, text, re.IGNORECASE) for p in self.dae_patterns):
            result.math_type = MathType.DAE
            result.confidence = max(result.confidence, 0.8)

        return result

    def detect_sde(self, text: str) -> MathDetectionResult:
        """
        Specifically detect SDEs (Stochastic Differential Equations).

        Args:
            text: Input text

        Returns:
            MathDetectionResult with SDE classification
        """
        result = self.detect(text)

        # Override math type if SDE patterns detected
        if any(re.search(p, text, re.IGNORECASE) for p in self.sde_patterns):
            result.math_type = MathType.SDE
            result.confidence = max(result.confidence, 0.8)

        return result

    def detect_integral(self, text: str) -> MathDetectionResult:
        """
        Specifically detect integrals.

        Args:
            text: Input text

        Returns:
            MathDetectionResult with integral classification
        """
        result = self.detect(text)

        # Override math type if integral patterns detected
        if any(re.search(p, text, re.IGNORECASE) for p in self.integral_patterns):
            result.math_type = MathType.INTEGRAL
            result.confidence = max(result.confidence, 0.8)

        return result

    def detect_derivative(self, text: str) -> MathDetectionResult:
        """
        Specifically detect derivatives.

        Args:
            text: Input text

        Returns:
            MathDetectionResult with derivative classification
        """
        result = self.detect(text)

        # Override math type if derivative patterns detected
        if any(re.search(p, text, re.IGNORECASE) for p in self.derivative_patterns):
            result.math_type = MathType.DERIVATIVE
            result.confidence = max(result.confidence, 0.8)

        return result


# ============================================================================
# Convenience Functions
# ============================================================================

def detect_continuous_math(text: str) -> MathDetectionResult:
    """
    Convenience function to detect continuous mathematics in text.

    Args:
        text: Input text

    Returns:
        MathDetectionResult with classification
    """
    detector = ContinuousMathDetector()
    return detector.detect(text)


def is_ode(text: str) -> bool:
    """Check if text describes an ODE"""
    detector = ContinuousMathDetector()
    result = detector.detect_ode(text)
    return result.math_type == MathType.ODE and result.confidence > 0.5


def is_pde(text: str) -> bool:
    """Check if text describes a PDE"""
    detector = ContinuousMathDetector()
    result = detector.detect_pde(text)
    return result.math_type == MathType.PDE and result.confidence > 0.5


def is_dae(text: str) -> bool:
    """Check if text describes a DAE"""
    detector = ContinuousMathDetector()
    result = detector.detect_dae(text)
    return result.math_type == MathType.DAE and result.confidence > 0.5


def is_sde(text: str) -> bool:
    """Check if text describes an SDE"""
    detector = ContinuousMathDetector()
    result = detector.detect_sde(text)
    return result.math_type == MathType.SDE and result.confidence > 0.5


def is_integral(text: str) -> bool:
    """Check if text describes an integral"""
    detector = ContinuousMathDetector()
    result = detector.detect_integral(text)
    return result.math_type == MathType.INTEGRAL and result.confidence > 0.5


def is_derivative(text: str) -> bool:
    """Check if text describes a derivative"""
    detector = ContinuousMathDetector()
    result = detector.detect_derivative(text)
    return result.math_type == MathType.DERIVATIVE and result.confidence > 0.5


# ============================================================================
# Main Entry Point
# ============================================================================

if __name__ == "__main__":
    # Example usage
    detector = ContinuousMathDetector()

    # Test cases
    test_cases = [
        "Solve the ODE dy/dx = x^2 + y with initial condition y(0) = 1",
        "Find the solution to the heat equation ∂u/∂t = ∂²u/∂x²",
        "Calculate the integral of x^2 from 0 to 1",
        "Solve the stochastic differential equation dX = μX dt + σX dW",
        "Find the derivative of f(x) = x^3 + 2x"
    ]

    print("Continuous Mathematics Detection Examples:")
    print("=" * 80)

    for i, test in enumerate(test_cases, 1):
        print(f"\nTest {i}: {test}")
        result = detector.detect(test)
        print(f"  Math Type: {result.math_type.value}")
        print(f"  Problem Type: {result.problem_type.value}")
        print(f"  Domain: {result.domain.value}")
        print(f"  Confidence: {result.confidence:.2f}")
        print(f"  Equations: {result.equations}")
        print(f"  Variables: {result.variables}")
