# BubbleLab + OpenEvolve integration environment template.
# Copy to `.env` and adjust as needed before running `docker compose up`.

# --- OpenEvolve API service (docker compose) ---
OPENEVOLVE_API_PORT=8000
OPENEVOLVE_API_URL=http://localhost:8000
OPENEVOLVE_BASE_URL=http://localhost:8000

# LLM provider configuration (optional; the API uses an offline mock
# backend when these are left empty, so no API keys are required to boot).
OPENEVOLVE_LLM_PROVIDER=openai
OPENEVOLVE_LLM_MODEL=gpt-4
OPENEVOLVE_LLM_BASE_URL=https://api.openai.com/v1
OPENEVOLVE_LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OPENEVOLVE_MAX_WORKERS=5
OPENEVOLVE_EXECUTION_TIMEOUT=300
OPENEVOLVE_LOG_LEVEL=INFO

# --- LeanAide proxy target (external service) ---
LEANAIDE_API_URL=http://localhost:7654
