# LoongFlow API Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED - Service will not start without these
# ============================================================================

# API key for your LLM provider (OpenAI, Anthropic, etc.)
LOONGFLOW_LLM_API_KEY=your-api-key-here

# ============================================================================
# OPTIONAL - Have sensible defaults
# ============================================================================

# API Server Configuration
LOONGFLOW_API_HOST=0.0.0.0
LOONGFLOW_API_PORT=8000
LOONGFLOW_API_WORKERS=1

# LLM Configuration
LOONGFLOW_LLM_URL=https://api.openai.com/v1
LOONGFLOW_LLM_MODEL=gpt-4
LOONGFLOW_LLM_TEMPERATURE=0.7
LOONGFLOW_LLM_MAX_TOKENS=2000

# Checkpointing
LOONGFLOW_ENABLE_CHECKPOINTING=true
LOONGFLOW_CHECKPOINT_DIR=/app/checkpoints

# Evaluator Configuration
LOONGFLOW_EVAL_TIMEOUT=300

# Logging
LOONGFLOW_LOG_LEVEL=INFO
