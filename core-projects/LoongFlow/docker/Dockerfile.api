# Dockerfile for LoongFlow API Server
#
# Following CLAUDE.md principles:
# - Law of Configuration Explicitness: All config via env vars
# - Law of Runtime Truth: Health checks verify actual API functionality
# - Minimal base image for security and performance

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=UTC

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster package installation
RUN pip install --no-cache-dir uv

# Copy package configuration
COPY pyproject.toml uv.lock ./

# Install dependencies using uv (faster than pip)
RUN uv pip install --system -e .

# Install API-specific dependencies
RUN uv pip install --system \
    fastapi>=0.104.0 \
    uvicorn[standard]>=0.24.0 \
    pydantic>=2.0.0 \
    pyyaml>=6.0

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/checkpoints /app/logs /app/data

# Create non-root user for running the application
RUN useradd -m -u 1000 -s /bin/bash loongflow && \
    chown -R loongflow:loongflow /app

# Switch to non-root user
USER loongflow

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

# Run the API server
CMD ["python", "api_server.py"]
