{
  "name": "datapizza-bubblelab-plugin",
  "version": "1.0.0",
  "description": "Datapizza Data Processing Plugin for BubbleLabs - Standalone plugin for data pipeline processing and querying",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run src/tests/contract",
    "lint": "eslint . --ext .ts,.tsx",
    "prepare": "husky install"
  },
  "keywords": [
    "bubblelabs",
    "datapizza",
    "plugin",
    "data-processing",
    "pipeline",
    "querying",
    "data-management",
    "etl",
    "data-transformation",
    "semantic-search"
  ],
  "author": "OpenEvolve",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.300.0",
    "react-toastify": "^9.1.3",
    "zustand": "^4.4.0",
    "react-hook-form": "^7.45.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.30.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openevolve/datapizza-bubblelab-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/openevolve/datapizza-bubblelab-plugin/issues"
  },
  "homepage": "https://github.com/openevolve/datapizza-bubblelab-plugin#readme",
  "bubblelabs": {
    "pluginType": "integration",
    "displayName": "Datapizza Data Processing",
    "description": "Adds data pipeline processing and querying capabilities using Datapizza",
    "category": "Data & AI",
    "icon": "datapizza.svg",
    "configurable": true,
    "version": "1.0.0",
    "minBubbleLabsVersion": "1.0.0",
    "author": "OpenEvolve",
    "website": "https://openevolve.com"
  }
}