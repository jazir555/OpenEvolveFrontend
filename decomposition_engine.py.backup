def calculate_functional_weight(analyzed_context) -> float:
    """
    Calculate weight for functional decomposition strategy.

    Higher weight when:
    - Problem has clear functional boundaries
    - Multiple distinct components/modules
    - Clear separation of concerns

    Args:
        analyzed_context: Problem analysis results (can be ProblemDefinition or dict)

    Returns:
        Float between 0.0 and 1.0
    """
    weight = 0.0
    reasoning = []

    # Extract problem characteristics
    if isinstance(analyzed_context, ProblemDefinition):
        problem = analyzed_context
        description = problem.description.lower()
        title = problem.title.lower()
        problem_type = problem.problem_type.value if problem.problem_type else ""
        complexity = problem.complexity_score.overall_complexity if problem.complexity_score else 5.0
    elif isinstance(analyzed_context, dict):
        problem = analyzed_context.get('problem')
        if problem:
            description = problem.description.lower() if hasattr(problem, 'description') else ""
            title = problem.title.lower() if hasattr(problem, 'title') else ""
            problem_type = problem.problem_type.value if hasattr(problem, 'problem_type') and problem.problem_type else ""
            complexity = problem.complexity_score.overall_complexity if hasattr(problem, 'complexity_score') and problem.complexity_score else 5.0
        else:
            description = str(analyzed_context.get('description', '')).lower()
            title = str(analyzed_context.get('title', '')).lower()
            problem_type = analyzed_context.get('problem_type', '')
            complexity = analyzed_context.get('complexity', 5.0)
    else:
        logger.warning(f"Unexpected analyzed_context type in calculate_functional_weight: {type(analyzed_context)}")
        return 0.3

    # Check for functional decomposition indicators
    functional_keywords = [
        'component', 'module', 'system', 'feature', 'functionality',
        'interface', 'service', 'subsystem', 'separate', 'distinct',
        'independent', 'loosely coupled', 'microservice', 'layer'
    ]

    # Keyword presence (0-40 points)
    text = title + ' ' + description
    keyword_count = sum(1 for kw in functional_keywords if kw in text)
    keyword_score = min(0.4, keyword_count * 0.05)
    weight += keyword_score
    if keyword_count > 0:
        reasoning.append(f"Found {keyword_count} functional keywords")

    # Problem type alignment (0-30 points)
    functional_types = ['implementation', 'integration', 'architecture']
    if any(pt in problem_type.lower() for pt in functional_types):
        weight += 0.3
        reasoning.append(f"Problem type '{problem_type}' aligns with functional decomposition")

    # Complexity suitability (0-20 points)
    # Functional decomposition works best for medium-complexity problems (5-8)
    if 5.0 <= complexity <= 8.0:
        weight += 0.2
        reasoning.append(f"Complexity {complexity:.1f} is suitable for functional decomposition")
    elif complexity < 5.0:
        weight += 0.1
        reasoning.append("Lower complexity may benefit from functional decomposition")

    # Constraint checking (0-10 points)
    if isinstance(analyzed_context, ProblemDefinition) and analyzed_context.constraints:
        sep_concerns = sum(1 for c in analyzed_context.constraints
                          if 'separate' in c.description.lower() or
                          'independent' in c.description.lower() or
                          'modular' in c.description.lower())
        if sep_concerns > 0:
            weight += min(0.1, sep_concerns * 0.03)
            reasoning.append(f"Found {sep_concerns} constraints emphasizing separation")

    # Normalize to 0.0-1.0
    weight = max(0.0, min(1.0, weight))

    if reasoning:
        logger.debug(f"Functional weight calculation: {weight:.2f} - {'; '.join(reasoning)}")
    else:
        logger.debug(f"Functional weight calculation: {weight:.2f} - No strong indicators found")

    return weight


def calculate_temporal_weight(analyzed_context) -> float:
    """
    Calculate weight for temporal decomposition strategy.

    Higher weight when:
    - Problem has natural time phases
    - Clear milestone sequence
    - Temporal dependencies present

    Args:
        analyzed_context: Problem analysis results

    Returns:
        Float between 0.0 and 1.0
    """
    weight = 0.0
    reasoning = []

    # Extract problem characteristics
    if isinstance(analyzed_context, ProblemDefinition):
        problem = analyzed_context
        description = problem.description.lower()
        title = problem.title.lower()
        problem_type = problem.problem_type.value if problem.problem_type else ""
    elif isinstance(analyzed_context, dict):
        problem = analyzed_context.get('problem')
        if problem:
            description = problem.description.lower() if hasattr(problem, 'description') else ""
            title = problem.title.lower() if hasattr(problem, 'title') else ""
            problem_type = problem.problem_type.value if hasattr(problem, 'problem_type') and problem.problem_type else ""
        else:
            description = str(analyzed_context.get('description', '')).lower()
            title = str(analyzed_context.get('title', '')).lower()
            problem_type = analyzed_context.get('problem_type', '')
    else:
        logger.warning(f"Unexpected analyzed_context type in calculate_temporal_weight: {type(analyzed_context)}")
        return 0.3

    # Check for temporal decomposition indicators
    temporal_keywords = [
        'phase', 'stage', 'step', 'milestone', 'timeline', 'schedule',
        'sequential', 'iterative', 'incremental', 'deadline', 'period',
        'first', 'then', 'next', 'finally', 'roadmap', 'sprint'
    ]

    # Keyword presence (0-40 points)
    text = title + ' ' + description
    keyword_count = sum(1 for kw in temporal_keywords if kw in text)
    keyword_score = min(0.4, keyword_count * 0.05)
    weight += keyword_score
    if keyword_count > 0:
        reasoning.append(f"Found {keyword_count} temporal keywords")

    # Problem type alignment (0-30 points)
    temporal_types = ['research', 'planning', 'process', 'workflow']
    if any(pt in problem_type.lower() for pt in temporal_types):
        weight += 0.3
        reasoning.append(f"Problem type '{problem_type}' aligns with temporal decomposition")

    # Sequence indicators (0-20 points)
    sequence_patterns = [
        r'\bfirst\b.*\bthen\b', r'\bstep\s+\d+', r'\bphase\s+\d+',
        r'\bpart\s+\d+', r'\bmilestone\s+\d+'
    ]
    import re
    sequence_count = sum(1 for pattern in sequence_patterns if re.search(pattern, text, re.IGNORECASE))
    if sequence_count > 0:
        weight += min(0.2, sequence_count * 0.07)
        reasoning.append(f"Found {sequence_count} sequence patterns")

    # Time-related terms (0-10 points)
    time_terms = ['deadline', 'timeline', 'schedule', 'delivery', 'deployment']
    time_count = sum(1 for term in time_terms if term in text)
    if time_count > 0:
        weight += min(0.1, time_count * 0.03)
        reasoning.append(f"Found {time_count} time-related terms")

    # Normalize to 0.0-1.0
    weight = max(0.0, min(1.0, weight))

    if reasoning:
        logger.debug(f"Temporal weight calculation: {weight:.2f} - {'; '.join(reasoning)}")
    else:
        logger.debug(f"Temporal weight calculation: {weight:.2f} - No strong indicators found")

    return weight


def calculate_risk_weight(analyzed_context) -> float:
    """
    Calculate weight for risk-based decomposition strategy.

    Higher weight when:
    - High risk factors identified
    - Risk mitigation is critical
    - Failure has severe consequences

    Args:
        analyzed_context: Problem analysis results

    Returns:
        Float between 0.0 and 1.0
    """
    weight = 0.0
    reasoning = []

    # Extract problem characteristics
    if isinstance(analyzed_context, ProblemDefinition):
        problem = analyzed_context
        description = problem.description.lower()
        title = problem.title.lower()
        complexity = problem.complexity_score.overall_complexity if problem.complexity_score else 5.0
        constraints = problem.constraints if hasattr(problem, 'constraints') else []
    elif isinstance(analyzed_context, dict):
        problem = analyzed_context.get('problem')
        if problem:
            description = problem.description.lower() if hasattr(problem, 'description') else ""
            title = problem.title.lower() if hasattr(problem, 'title') else ""
            complexity = problem.complexity_score.overall_complexity if hasattr(problem, 'complexity_score') and problem.complexity_score else 5.0
            constraints = problem.constraints if hasattr(problem, 'constraints') else []
        else:
            description = str(analyzed_context.get('description', '')).lower()
            title = str(analyzed_context.get('title', '')).lower()
            complexity = analyzed_context.get('complexity', 5.0)
            constraints = []
    else:
        logger.warning(f"Unexpected analyzed_context type in calculate_risk_weight: {type(analyzed_context)}")
        return 0.3

    # Check for risk-related keywords
    risk_keywords = [
        'risk', 'critical', 'danger', 'failure', 'security', 'safety',
        'hazard', 'mitigation', 'contingency', 'reliability', 'robust',
        'vulnerable', 'threat', 'attack', 'compliance', 'regulation'
    ]

    # Keyword presence (0-30 points)
    text = title + ' ' + description
    keyword_count = sum(1 for kw in risk_keywords if kw in text)
    keyword_score = min(0.3, keyword_count * 0.05)
    weight += keyword_score
    if keyword_count > 0:
        reasoning.append(f"Found {keyword_count} risk-related keywords")

    # Complexity factor (0-25 points)
    # Higher complexity problems often benefit from risk-based decomposition
    if complexity >= 8.0:
        weight += 0.25
        reasoning.append(f"High complexity ({complexity:.1f}) suggests risk-based decomposition")
    elif complexity >= 6.0:
        weight += 0.15
        reasoning.append(f"Moderate-high complexity ({complexity:.1f}) may benefit from risk-based approach")

    # Constraint severity (0-25 points)
    if constraints:
        high_severity_count = sum(1 for c in constraints
                                  if hasattr(c, 'severity') and
                                  c.severity in ['critical', 'high'])
        if high_severity_count > 0:
            weight += min(0.25, high_severity_count * 0.1)
            reasoning.append(f"Found {high_severity_count} high-severity constraints")

    # Domain risk factors (0-20 points)
    high_risk_domains = ['security', 'healthcare', 'finance', 'safety', 'aerospace']
    if isinstance(analyzed_context, ProblemDefinition):
        domain = analyzed_context.domain_context.domain.lower() if hasattr(analyzed_context.domain_context, 'domain') else ""
    elif isinstance(analyzed_context, dict):
        domain = str(analyzed_context.get('domain', '')).lower()
    else:
        domain = ""

    if any(risk_domain in domain for risk_domain in high_risk_domains):
        weight += 0.2
        reasoning.append(f"Domain '{domain}' has high risk factors")

    # Normalize to 0.0-1.0
    weight = max(0.0, min(1.0, weight))

    if reasoning:
        logger.debug(f"Risk weight calculation: {weight:.2f} - {'; '.join(reasoning)}")
    else:
        logger.debug(f"Risk weight calculation: {weight:.2f} - No strong indicators found")

    return weight


def calculate_value_weight(analyzed_context) -> float:
    """
    Calculate weight for value-based decomposition strategy.

    Higher weight when:
    - Business value varies across components
    - Early value delivery important
    - Stakeholder priorities clear

    Args:
        analyzed_context: Problem analysis results

    Returns:
        Float between 0.0 and 1.0
    """
    weight = 0.0
    reasoning = []

    # Extract problem characteristics
    if isinstance(analyzed_context, ProblemDefinition):
        problem = analyzed_context
        description = problem.description.lower()
        title = problem.title.lower()
        problem_type = problem.problem_type.value if problem.problem_type else ""
    elif isinstance(analyzed_context, dict):
        problem = analyzed_context.get('problem')
        if problem:
            description = problem.description.lower() if hasattr(problem, 'description') else ""
            title = problem.title.lower() if hasattr(problem, 'title') else ""
            problem_type = problem.problem_type.value if hasattr(problem, 'problem_type') and problem.problem_type else ""
        else:
            description = str(analyzed_context.get('description', '')).lower()
            title = str(analyzed_context.get('title', '')).lower()
            problem_type = analyzed_context.get('problem_type', '')
    else:
        logger.warning(f"Unexpected analyzed_context type in calculate_value_weight: {type(analyzed_context)}")
        return 0.3

    # Check for value-related keywords
    value_keywords = [
        'value', 'priority', 'business', 'stakeholder', 'roi', 'benefit',
        'investment', 'customer', 'user', 'market', 'revenue', 'profit',
        'impact', 'outcome', 'deliverable', 'milestone', 'mvp'
    ]

    # Keyword presence (0-35 points)
    text = title + ' ' + description
    keyword_count = sum(1 for kw in value_keywords if kw in text)
    keyword_score = min(0.35, keyword_count * 0.04)
    weight += keyword_score
    if keyword_count > 0:
        reasoning.append(f"Found {keyword_count} value-related keywords")

    # Problem type alignment (0-30 points)
    value_types = ['implementation', 'integration', 'optimization', 'enhancement']
    if any(pt in problem_type.lower() for pt in value_types):
        weight += 0.3
        reasoning.append(f"Problem type '{problem_type}' aligns with value-based decomposition")

    # Priority indicators (0-20 points)
    priority_patterns = [
        r'\bhigh\s+priority\b', r'\bcritical\b.*\bvalue\b',
        r'\bfirst\b.*\bdeliver\b', r'\bearly\b.*\bwin\b'
    ]
    import re
    priority_count = sum(1 for pattern in priority_patterns if re.search(pattern, text, re.IGNORECASE))
    if priority_count > 0:
        weight += min(0.2, priority_count * 0.1)
        reasoning.append(f"Found {priority_count} priority/delivery patterns")

    # Stakeholder mentions (0-15 points)
    stakeholder_terms = ['stakeholder', 'customer', 'user', 'business', 'client']
    stakeholder_count = sum(1 for term in stakeholder_terms if term in text)
    if stakeholder_count > 0:
        weight += min(0.15, stakeholder_count * 0.05)
        reasoning.append(f"Found {stakeholder_count} stakeholder-related terms")

    # Normalize to 0.0-1.0
    weight = max(0.0, min(1.0, weight))

    if reasoning:
        logger.debug(f"Value weight calculation: {weight:.2f} - {'; '.join(reasoning)}")
    else:
        logger.debug(f"Value weight calculation: {weight:.2f} - No strong indicators found")

    return weight


def calculate_technical_weight(analyzed_context) -> float:
    """
    Calculate weight for technical dependency decomposition strategy.

    Higher weight when:
    - Strong technical dependencies
    - Infrastructure requirements
    - Foundation must be built first

    Args:
        analyzed_context: Problem analysis results

    Returns:
        Float between 0.0 and 1.0
    """
    weight = 0.0
    reasoning = []

    # Extract problem characteristics
    if isinstance(analyzed_context, ProblemDefinition):
        problem = analyzed_context
        description = problem.description.lower()
        title = problem.title.lower()
        problem_type = problem.problem_type.value if problem.problem_type else ""
        domain = problem.domain_context.domain.lower() if hasattr(problem.domain_context, 'domain') else ""
    elif isinstance(analyzed_context, dict):
        problem = analyzed_context.get('problem')
        if problem:
            description = problem.description.lower() if hasattr(problem, 'description') else ""
            title = problem.title.lower() if hasattr(problem, 'title') else ""
            problem_type = problem.problem_type.value if hasattr(problem, 'problem_type') and problem.problem_type else ""
            domain = problem.domain_context.domain.lower() if hasattr(problem, 'domain_context') and hasattr(problem.domain_context, 'domain') else ""
        else:
            description = str(analyzed_context.get('description', '')).lower()
            title = str(analyzed_context.get('title', '')).lower()
            problem_type = analyzed_context.get('problem_type', '')
            domain = str(analyzed_context.get('domain', '')).lower()
    else:
        logger.warning(f"Unexpected analyzed_context type in calculate_technical_weight: {type(analyzed_context)}")
        return 0.3

    # Check for technical dependency keywords
    technical_keywords = [
        'infrastructure', 'database', 'api', 'interface', 'architecture',
        'framework', 'platform', 'dependency', 'integration', 'system',
        'backend', 'frontend', 'network', 'service', 'microservice',
        'foundation', 'infrastructure', 'library', 'component'
    ]

    # Keyword presence (0-35 points)
    text = title + ' ' + description + ' ' + domain
    keyword_count = sum(1 for kw in technical_keywords if kw in text)
    keyword_score = min(0.35, keyword_count * 0.04)
    weight += keyword_score
    if keyword_count > 0:
        reasoning.append(f"Found {keyword_count} technical dependency keywords")

    # Problem type alignment (0-30 points)
    technical_types = ['implementation', 'integration', 'architecture', 'infrastructure']
    if any(pt in problem_type.lower() for pt in technical_types):
        weight += 0.3
        reasoning.append(f"Problem type '{problem_type}' aligns with technical dependency decomposition")

    # Domain alignment (0-20 points)
    technical_domains = ['software', 'engineering', 'infrastructure', 'devops', 'cloud']
    if any(tech_domain in domain for tech_domain in technical_domains):
        weight += 0.2
        reasoning.append(f"Domain '{domain}' suggests technical dependencies")

    # Dependency indicators (0-15 points)
    dependency_patterns = [
        r'\bdepends\s+on\b', r'\brequires\b', r'\bbuilds?\s+on\b',
        r'\bfoundation\b', r'\blayer\b', r'\btier\b'
    ]
    import re
    dependency_count = sum(1 for pattern in dependency_patterns if re.search(pattern, text, re.IGNORECASE))
    if dependency_count > 0:
        weight += min(0.15, dependency_count * 0.05)
        reasoning.append(f"Found {dependency_count} dependency indicators")

    # Normalize to 0.0-1.0
    weight = max(0.0, min(1.0, weight))

    if reasoning:
        logger.debug(f"Technical weight calculation: {weight:.2f} - {'; '.join(reasoning)}")
    else:
        logger.debug(f"Technical weight calculation: {weight:.2f} - No strong indicators found")

    return weight


def select_decomposition_strategy_v2(problem: ProblemDefinition,
                                     analyzed_context=None) -> str:
    """
    Intelligently select decomposition strategy based on problem characteristics.

    This is the v2 implementation that uses weight calculations instead of LLM.
    It provides deterministic, fast, and explainable strategy selection.

    Algorithm:
    1. Calculate weights for all strategies
    2. Find max weight strategy
    3. If max weight > 0.6, use that strategy
    4. Otherwise, use hybrid combining top 2-3 strategies

    Args:
        problem: The problem to select a strategy for
        analyzed_context: Optional pre-analyzed context (uses problem if not provided)

    Returns:
        Strategy name (e.g., 'functional', 'hybrid_functional_temporal')

    Examples:
        >>> strategy = select_decomposition_strategy_v2(problem)
        >>> print(strategy)
        'functional'

        >>> strategy = select_decomposition_strategy_v2(complex_problem)
        >>> print(strategy)
        'hybrid_functional_technical'
    """
    logger.info(f"Selecting decomposition strategy for problem: {problem.id}")

    # Use problem if analyzed_context not provided
    if analyzed_context is None:
        analyzed_context = problem

    # Calculate weights for all strategies
    weights = {
        'functional': calculate_functional_weight(analyzed_context),
        'temporal': calculate_temporal_weight(analyzed_context),
        'risk_based': calculate_risk_weight(analyzed_context),
        'value_based': calculate_value_weight(analyzed_context),
        'technical': calculate_technical_weight(analyzed_context)
    }

    # Log all weights for transparency
    logger.info("Strategy weights:")
    for strategy, weight in sorted(weights.items(), key=lambda x: x[1], reverse=True):
        logger.info(f"  {strategy}: {weight:.3f}")

    # Find strategy with highest weight
    max_weight_strategy = max(weights, key=weights.get)
    max_weight = weights[max_weight_strategy]

    # Apply threshold logic
    if max_weight > 0.6:
        # Strong preference - use single strategy
        # Map to existing strategy names
        strategy_mapping = {
            'functional': 'semantic',  # Functional maps to semantic
            'temporal': 'semantic',    # Temporal uses semantic decomposition
            'risk_based': 'complexity',  # Risk-based uses complexity
            'value_based': 'semantic',   # Value-based uses semantic
            'technical': 'dependency'    # Technical uses dependency
        }

        selected_strategy = strategy_mapping.get(max_weight_strategy, 'hybrid')
        logger.info(f"Selected single strategy: {selected_strategy} (from {max_weight_strategy}, weight: {max_weight:.3f})")
        return selected_strategy
    else:
        # No strong preference - use hybrid approach
        sorted_weights = sorted(weights.items(), key=lambda x: x[1], reverse=True)

        # Get top 2-3 strategies with weight > 0.3
        top_strategies = [strategy for strategy, weight in sorted_weights[:3] if weight > 0.3]

        if len(top_strategies) < 2:
            # If only one strategy above 0.3, just use hybrid
            logger.info("No strong secondary strategy found, using general hybrid")
            return 'hybrid'

        # Map to internal strategy names
        strategy_mapping = {
            'functional': 'semantic',
            'temporal': 'semantic',
            'risk_based': 'complexity',
            'value_based': 'semantic',
            'technical': 'dependency'
        }

        mapped_strategies = [strategy_mapping.get(s, 'semantic') for s in top_strategies]
        # Remove duplicates while preserving order
        unique_strategies = list(dict.fromkeys(mapped_strategies))

        if len(unique_strategies) == 1:
            selected_strategy = unique_strategies[0]
            logger.info(f"All top strategies map to same implementation: {selected_strategy}")
            return selected_strategy

        # For now, return 'hybrid' if we'd have a complex hybrid
        # Full hybrid strategy support would require implementing strategy combinations
        logger.info(f"Multiple strategies identified: {unique_strategies}, using hybrid")
        return 'hybrid'


class DecompositionEngine:
    """Orchestrates problem decomposition using multiple strategies."""

    def __init__(self, problem_analyzer: Optional[ProblemAnalyzer] = None, knowledge_manager: Optional[KnowledgeManager] = None,
                 use_intelligent_selection: bool = True, team_assignment_engine: Optional['TeamAssignmentEngine'] = None,
                 enable_advanced_dependency_analysis: bool = True, use_resource_estimation: bool = True,
                 use_problem_classification: bool = True, use_semantic_analysis: bool = True):
        """
        Initialize decomposition engine.

        Args:
            problem_analyzer: Optional ProblemAnalyzer instance
            knowledge_manager: Optional KnowledgeManager instance
            use_intelligent_selection: Whether to use v2 intelligent selection (default: True)
            team_assignment_engine: Optional TeamAssignmentEngine for intelligent team assignment
            enable_advanced_dependency_analysis: Whether to use advanced dependency analysis (default: True)
            use_resource_estimation: Whether to use automatic resource estimation (default: True)
            use_problem_classification: Whether to use automatic problem classification (default: True)
            use_semantic_analysis: Whether to use enhanced semantic analysis (default: True)
        """
        self.strategies: Dict[str, DecompositionStrategyBase] = {
            'semantic': SemanticDecomposition(),
            'dependency': DependencyDecomposition(),
            'complexity': ComplexityDecomposition(),
            'hybrid': HybridDecomposition(),
            'research': ResearchDecomposition(),
            'functional': FunctionalDecomposition(),
            'temporal': TemporalDecomposition(),
            'risk_based': RiskBasedDecomposition(),
            'value_based': ValueBasedDecomposition(),
            'technical_dependency': TechnicalDependencyDecomposition()
        }
        self.problem_analyzer = problem_analyzer or ProblemAnalyzer()
        self.knowledge_manager = knowledge_manager or KnowledgeManager()
        self.use_intelligent_selection = use_intelligent_selection
        self.team_assignment_engine = team_assignment_engine
        self.enable_advanced_dependency_analysis = enable_advanced_dependency_analysis
        self.use_resource_estimation = use_resource_estimation
        self.use_problem_classification = use_problem_classification
        self.use_semantic_analysis = use_semantic_analysis
        self.logger = logging.getLogger(__name__)

        # Initialize DependencyAnalyzer if enabled and available
        self.dependency_analyzer = None
        if enable_advanced_dependency_analysis and DEPENDENCY_ANALYZER_AVAILABLE:
            try:
                self.dependency_analyzer = DependencyAnalyzer()
                self.logger.info("Advanced dependency analysis enabled")
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Failed to initialize DependencyAnalyzer: {e}. Advanced analysis disabled.")

        # Initialize ResourceEstimationEngine if enabled and available
        self.resource_estimation_engine = None
        if use_resource_estimation:
            try:
                from resource_estimation_engine import ResourceEstimationEngine
                self.resource_estimation_engine = ResourceEstimationEngine()
                self.logger.info("Automatic resource estimation enabled")
            except ImportError:
                self.logger.warning("ResourceEstimationEngine not available. Automatic resource estimation disabled.")
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Failed to initialize ResourceEstimationEngine: {e}. Automatic resource estimation disabled.")

        # Initialize ProblemClassifier if enabled
        self.problem_classifier = None
        if use_problem_classification:
            try:
                from problem_classifier import ProblemClassifier
                self.problem_classifier = ProblemClassifier()
                self.logger.info("Automatic problem classification enabled")
            except ImportError:
                self.logger.warning("ProblemClassifier not available. Automatic problem classification disabled.")
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Failed to initialize ProblemClassifier: {e}. Automatic problem classification disabled.")

        # Initialize SemanticAnalyzer if enabled
        self.semantic_analyzer = None
        if use_semantic_analysis:
            try:
                self.semantic_analyzer = SemanticAnalyzer()
                self.logger.info("Enhanced semantic analysis enabled")
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Failed to initialize SemanticAnalyzer: {e}. Semantic analysis disabled.")
    
    @with_error_handling(severity=ErrorSeverity.CRITICAL, fallback=lambda problem, strategy, assign_teams, teams, use_semantic: DecompositionPlan(
        id=generate_id("plan"),
        problem_id=problem.id,
        strategy=DecompositionStrategy.HYBRID,
        sub_problems=[],
        dependency_graph=DependencyGraph(nodes={}, edges={}),
        validation_checkpoints=[],
        quality_scores=QualityScores(overall_score=0.0, meets_thresholds=False),
        confidence_level=0.0,
        created_by="decomposition_engine_error",
        error_message="Decomposition failed"
    ))
    def decompose(self, problem: ProblemDefinition, strategy: Optional[str] = None,
                 assign_teams: bool = False, teams: Optional[List] = None,
                 use_semantic_analysis: Optional[bool] = None) -> DecompositionPlan:
        """
        Decomposes problem using optimal strategy.

        Args:
            problem: The problem to decompose
            strategy: Optional strategy name (auto-selected if not provided)
            assign_teams: If True, assign teams to sub-problems using TeamAssignmentEngine
            teams: Optional list of available teams (required if assign_teams=True)
            use_semantic_analysis: If True, use enhanced semantic analysis (overrides engine default)

        Returns:
            DecompositionPlan with sub-problems, dependencies, execution order
        """
        self.logger.info(f"Decomposing problem: {problem.id}")

        # Determine whether to use semantic analysis
        should_use_semantic = use_semantic_analysis if use_semantic_analysis is not None else self.use_semantic_analysis

        # Build enhanced domain context if semantic analysis is enabled
        enhanced_domain_context = None
        if should_use_semantic and self.semantic_analyzer:
            try:
                self.logger.info("Building enhanced domain context with semantic analysis")
                enhanced_domain_context = self.semantic_analyzer.build_enhanced_domain_context(
                    problem,
                    problem.domain_context
                )
                self.logger.info(
                    f"Enhanced domain context created: "
                    f"{len(enhanced_domain_context.key_concepts)} concepts, "
                    f"{len(enhanced_domain_context.semantic_clusters)} clusters, "
                    f"confidence: {enhanced_domain_context.confidence_score:.2f}"
                )

                # Store enhanced context in problem metadata for downstream use
                if not problem.metadata:
                    problem.metadata = {}
                problem.metadata['enhanced_domain_context'] = enhanced_domain_context.to_dict()

                # Use semantic analysis to inform strategy selection if not provided
                if not strategy and enhanced_domain_context.typical_decomposition_approach:
                    suggested_strategy = enhanced_domain_context.typical_decomposition_approach
                    if suggested_strategy in self.strategies:
                        self.logger.info(f"Using semantic analysis suggested strategy: {suggested_strategy}")
                        strategy = suggested_strategy

            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Semantic analysis failed: {e}. Continuing without semantic enhancement.", exc_info=True)

        # Apply automatic problem classification if enabled
        problem_classification = None
        if self.problem_classifier and self.use_problem_classification:
            try:
                problem_classification = self.problem_classifier.classify_problem(problem)
                self.logger.info(
                    f"Problem classified as {problem_classification.primary_type.value} "
                    f"with confidence {problem_classification.confidence:.2f} "
                    f"using {problem_classification.classification_method} method"
                )

                # Store classification in problem metadata for reference
                if not problem.metadata:
                    problem.metadata = {}
                problem.metadata['problem_classification'] = problem_classification.to_dict()

                # Update problem type if classification confidence is high (>0.7)
                # and current type is different from classified type
                if problem_classification.confidence > 0.7:
                    if problem.problem_type != problem_classification.primary_type:
                        self.logger.info(
                            f"Updating problem type from {problem.problem_type.value} "
                            f"to {problem_classification.primary_type.value} "
                            f"(confidence: {problem_classification.confidence:.2f})"
                        )
                        problem.problem_type = problem_classification.primary_type

                # Use classification to influence strategy selection if strategy not provided
                if not strategy and problem_classification.suggested_strategies:
                    # Use the first suggested strategy
                    suggested_strategy = problem_classification.suggested_strategies[0]
                    if suggested_strategy in self.strategies:
                        self.logger.info(f"Using classification-suggested strategy: {suggested_strategy}")
                        strategy = suggested_strategy

            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Problem classification failed: {e}. Continuing without classification.", exc_info=True)

        # Select strategy if not provided
        if not strategy:
            strategy = self.select_strategy(problem)

        self.logger.info(f"Using strategy: {strategy}")

        # Get strategy instance
        strategy_instance = self.strategies.get(strategy)
        if not strategy_instance:
            raise ValueError(f"Unknown strategy: {strategy}")

        # Generate sub-problems
        sub_problems = strategy_instance.decompose(problem)

        # Apply automatic resource estimation if enabled
        if self.resource_estimation_engine:
            try:
                for sp in sub_problems:
                    # Estimate resources using the sub-problem's complexity
                    sp.estimated_resources = self.resource_estimation_engine.estimate_resources(
                        sub_problem=sp,
                        domain=problem.domain_context.domain
                    )
                self.logger.info(f"Automatic resource estimation applied to {len(sub_problems)} sub-problems")
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Resource estimation failed: {e}. Continuing without estimation.", exc_info=True)

        # Build dependency graph
        dependency_graph = self._build_dependency_graph(sub_problems)

        # Perform advanced dependency analysis if enabled
        dependency_analysis = None
        if self.dependency_analyzer:
            try:
                dependency_analysis = analyze_dependency_graph(sub_problems, self.dependency_analyzer)
                self.logger.info(
                    f"Advanced dependency analysis complete: "
                    f"{dependency_analysis['summary']['num_cycles']} cycles, "
                    f"{dependency_analysis['summary']['estimated_speedup']}x speedup potential"
                )
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.warning(f"Advanced dependency analysis failed: {e}", exc_info=True)

        # Create quality scores (initial assessment with advanced analysis if available)
        quality_scores = self._assess_quality(problem, sub_problems, dependency_analysis)

        # Create decomposition plan
        plan = DecompositionPlan(
            id=generate_id("plan"),
            problem_id=problem.id,
            strategy=DecompositionStrategy(strategy),
            sub_problems=sub_problems,
            dependency_graph=dependency_graph,
            validation_checkpoints=[],
            quality_scores=quality_scores,
            confidence_level=0.8,  # Initial confidence
            created_by="decomposition_engine"
        )

        # Store dependency analysis in plan metadata if available
        if dependency_analysis:
            if not plan.metadata:
                plan.metadata = {}
            plan.metadata['dependency_analysis'] = dependency_analysis
            plan.metadata['has_advanced_dependency_analysis'] = True

        # Store problem classification in plan metadata if available
        if problem_classification:
            if not plan.metadata:
                plan.metadata = {}
            plan.metadata['problem_classification'] = problem_classification.to_dict()
            plan.metadata['classification_confidence'] = problem_classification.confidence
            plan.metadata['classification_method'] = problem_classification.classification_method
            self.logger.debug(
                f"Stored problem classification in plan metadata: "
                f"{problem_classification.primary_type.value} "
                f"(confidence: {problem_classification.confidence:.2f})"
            )

        # Store semantic analysis in plan metadata if available
        if enhanced_domain_context:
            if not plan.metadata:
                plan.metadata = {}
            plan.metadata['semantic_analysis'] = {
                'key_concepts': enhanced_domain_context.key_concepts,
                'concept_relationships': enhanced_domain_context.concept_relationships,
                'semantic_clusters': enhanced_domain_context.semantic_clusters,
                'num_concepts': len(enhanced_domain_context.key_concepts),
                'num_clusters': len(enhanced_domain_context.semantic_clusters),
                'domain_complexity': enhanced_domain_context.domain_complexity,
                'abstraction_level': enhanced_domain_context.abstraction_level,
                'confidence_score': enhanced_domain_context.confidence_score
            }
            self.logger.debug(
                f"Stored semantic analysis in plan metadata: "
                f"{len(enhanced_domain_context.key_concepts)} concepts, "
                f"{len(enhanced_domain_context.semantic_clusters)} clusters"
            )

        # Assign teams if requested
        if assign_teams:
            if not TEAM_ASSIGNMENT_AVAILABLE:
                self.logger.warning(
                    "Team assignment requested but TeamAssignmentEngine is not available. "
                    "Skipping team assignment."
                )
            elif not self.team_assignment_engine:
                self.logger.warning(
                    "Team assignment requested but no TeamAssignmentEngine provided. "
                    "Skipping team assignment."
                )
            elif not teams:
                self.logger.warning(
                    "Team assignment requested but no teams provided. "
                    "Skipping team assignment."
                )
            else:
                try:
                    plan = self.team_assignment_engine.assign_teams_to_plan(plan, teams)
                    self.logger.info(f"Assigned teams to {len(sub_problems)} sub-problems")
                except Exception as e:  # TODO: Catch specific exception instead of Exception
                    self.logger.error(f"Failed to assign teams: {e}", exc_info=True)

        self.logger.info(f"Decomposition complete: {len(sub_problems)} sub-problems created")
        return plan
    
    def select_strategy_intelligent(self, problem: ProblemDefinition) -> str:
        """
        Chooses optimal decomposition strategy using intelligent v2 algorithm.

        This method uses the weight-based algorithm which is:
        - Deterministic (same input = same output)
        - Fast (no LLM calls)
        - Explainable (clear reasoning)
        - Accurate (based on problem characteristics)

        Args:
            problem: The problem to analyze

        Returns:
            Strategy name
        """
        self.logger.info("Using intelligent strategy selection (v2)")
        try:
            strategy = select_decomposition_strategy_v2(problem)
            if strategy in self.strategies:
                self.logger.info(f"Intelligent selection chose: {strategy}")
                return strategy
            else:
                self.logger.warning(f"Intelligent selection returned unknown strategy: {strategy}. Using hybrid.")
                return "hybrid"
        except Exception as e:  # TODO: Catch specific exception instead of Exception
            self.logger.error(f"Intelligent strategy selection failed: {e}. Falling back to hybrid.", exc_info=True)
            return "hybrid"

    @with_error_handling(severity=ErrorSeverity.HIGH, fallback=lambda problem: "hybrid")
    def select_strategy(self, problem: ProblemDefinition, use_llm: bool = False) -> str:
        """
        Chooses optimal decomposition strategy.

        By default uses intelligent v2 algorithm (weight-based, deterministic).
        Optionally can use LLM-based selection (slower, but more nuanced).

        Args:
            problem: The problem to analyze
            use_llm: If True, use LLM-based selection (default: False)

        Returns:
            Strategy name

        Raises:
            RuntimeError: If LLM-based strategy selection fails and use_llm=True
        """
        # Use intelligent v2 selection by default
        if self.use_intelligent_selection and not use_llm:
            return self.select_strategy_intelligent(problem)

        # Fall back to LLM-based selection (legacy method)
        global OpenEvolveClient, OPENEVOLVE_AVAILABLE
        if OPENEVOLVE_AVAILABLE:
            try:
                client = OpenEvolveClient()
                strategy = self._select_strategy_with_llm(problem, client)
                if strategy in self.strategies:
                    self.logger.info(f"LLM selected strategy: {strategy}")
                    return strategy
                else:
                    self.logger.warning(f"LLM returned an unknown strategy: {strategy}. Falling back to hybrid.")
                    return "hybrid"
            except Exception as e:  # TODO: Catch specific exception instead of Exception
                self.logger.error(f"Failed to instantiate OpenEvolve client for strategy selection or LLM call failed: {e}", exc_info=True)
                self.logger.warning("Falling back to hybrid strategy due to OpenEvolve client issue.")
                return "hybrid"
        else:
            self.logger.warning("OpenEvolve client not available for strategy selection. Using intelligent selection.")
            return self.select_strategy_intelligent(problem)
    
    def _select_strategy_with_llm(self, problem: ProblemDefinition, client) -> str:
        """Use LLM to select optimal decomposition strategy."""
        prompt = f"""You are an expert in problem decomposition strategies. Select the BEST strategy for this problem.

PROBLEM:
Title: {problem.title}
Description: {problem.description}
Domain: {problem.domain_context.domain}
Type: {problem.problem_type.value}
Complexity: {problem.complexity_score.overall_complexity}/10
Constraints: {len(problem.constraints)}

AVAILABLE STRATEGIES:

1. SEMANTIC: Decomposes based on semantic concepts and natural boundaries
   - Best for: Problems with distinct conceptual phases or components
   - Strengths: Natural, intuitive decomposition
   - Use when: Problem has clear conceptual structure

2. DEPENDENCY: Decomposes based on prerequisite relationships
   - Best for: Problems with strong sequential dependencies
   - Strengths: Clear execution order, manages dependencies
   - Use when: Many interdependencies between components

3. COMPLEXITY: Decomposes to balance cognitive load
   - Best for: Very complex problems that need simplification
   - Strengths: Ensures manageable sub-problem complexity
   - Use when: Overall complexity > 7.5/10

4. HYBRID: Combines multiple strategies adaptively
   - Best for: Complex problems needing multiple perspectives
   - Strengths: Most sophisticated, handles complex cases
   - Use when: Problem has multiple challenging aspects

SELECTION CRITERIA:
- Problem complexity and structure
- Dependency relationships
- Domain characteristics
- Constraint complexity

Respond with ONLY ONE WORD - the strategy name:
semantic OR dependency OR complexity OR hybrid

Your selection:"""
        
        result = client.evolve(
            content=prompt,
            evolution_mode="standard",
            content_type="analysis",
            max_iterations=1,
            temperature=0.2,  # Low temperature for consistent selection
            max_tokens=50
        )
        
        if result.success and result.best_code:
            strategy = result.best_code.strip().lower()
            # Validate it's a known strategy
            if strategy in ['semantic', 'dependency', 'complexity', 'hybrid']:
                return strategy
        
        raise RuntimeError("LLM failed to select a valid strategy.")
    

    
    def _build_dependency_graph(self, sub_problems: List[SubProblem]) -> DependencyGraph:
        """Build dependency graph from sub-problems."""
        nodes = {sp.id: sp for sp in sub_problems}
        edges = {sp.id: sp.dependencies for sp in sub_problems}
        
        # Calculate execution order (topological sort)
        execution_order = self._topological_sort(sub_problems)
        
        return DependencyGraph(
            nodes=nodes,
            edges=edges,
            critical_path=[],  # Will be calculated by DependencyManager
            parallel_groups=[],  # Will be calculated by DependencyManager
            execution_order=execution_order
        )
    
    def _topological_sort(self, sub_problems: List[SubProblem]) -> List[str]:
        """Simple topological sort for execution order."""
        # Build adjacency list
        in_degree = {sp.id: len(sp.dependencies) for sp in sub_problems}
        
        # Find nodes with no dependencies
        queue = [sp.id for sp in sub_problems if len(sp.dependencies) == 0]
        result = []
        
        while queue:
            node = queue.pop(0)
            result.append(node)
            
            # Find nodes that depend on this node
            for sp in sub_problems:
                if node in sp.dependencies:
                    in_degree[sp.id] -= 1
                    if in_degree[sp.id] == 0:
                        queue.append(sp.id)
        
        return result
    
    def _assess_quality(
        self,
        problem: ProblemDefinition,
        sub_problems: List[SubProblem],
        dependency_analysis: Optional[Dict[str, Any]] = None
    ) -> QualityScores:
        """
        Assess initial quality of decomposition.

        Args:
            problem: The parent problem
            sub_problems: List of sub-problems to assess
            dependency_analysis: Optional advanced dependency analysis results

        Returns:
            QualityScores with detailed assessment
        """
        from datetime import datetime

        if not sub_problems:
            return QualityScores(
                coherence_score=0.0,
                completeness_score=0.0,
                feasibility_score=0.0,
                integration_score=0.0,
                overall_score=0.0,
                meets_thresholds=False,
                details={"error": "No sub-problems generated"},
                timestamp=datetime.now()
            )

        def _clamp(value: float, low: float = 0.0, high: float = 1.0) -> float:
            return max(low, min(high, value))

        sub_problem_count = len(sub_problems)
        sub_problem_ids = {sp.id for sp in sub_problems}
        total_dependencies = sum(len(sp.dependencies) for sp in sub_problems)
        missing_dependencies = sum(
            1 for sp in sub_problems for dep in sp.dependencies if dep not in sub_problem_ids
        )
        self_dependencies = sum(
            1 for sp in sub_problems for dep in sp.dependencies if dep == sp.id
        )

        # Use advanced dependency analysis if available
        if dependency_analysis:
            has_cycles = dependency_analysis['summary']['has_cycles']
            num_cycles = dependency_analysis['summary']['num_cycles']
            critical_path_length = dependency_analysis['critical_path'].get('critical_path_length', 0)
            estimated_speedup = dependency_analysis['summary'].get('estimated_speedup', 1.0)
            is_valid = dependency_analysis['summary'].get('is_valid', True)
        else:
            execution_order = self._topological_sort(sub_problems)
            has_cycles = len(execution_order) < sub_problem_count
            num_cycles = 0
            critical_path_length = 0
            estimated_speedup = 1.0
            is_valid = True

        # Coherence: dependency validity, acyclic graph, and description uniqueness.
        dependency_validity = 1.0 - (missing_dependencies / max(1, total_dependencies))
        dependency_validity = _clamp(dependency_validity)

        # Cycle detection penalty (more severe with advanced analysis)
        if dependency_analysis:
            # Advanced analysis: penalize based on number of cycles
            cycle_penalty = min(0.5, num_cycles * 0.15) if has_cycles else 0.0
        else:
            # Basic analysis: simple binary penalty
            cycle_penalty = 0.2 if has_cycles else 0.0

        self_dep_penalty = min(0.2, self_dependencies / max(1, total_dependencies)) if total_dependencies else 0.0

        # Validation penalty from advanced analysis
        validation_penalty = 0.0
        if dependency_analysis and not is_valid:
            validation_penalty = 0.1

        description_tokens = [
            set(re.findall(r"\w+", sp.description.lower())) for sp in sub_problems
        ]
        similarity_scores = []
        for idx, tokens in enumerate(description_tokens):
            for jdx in range(idx + 1, len(description_tokens)):
                other = description_tokens[jdx]
                if tokens and other:
                    similarity = len(tokens & other) / max(1, len(tokens | other))
                    similarity_scores.append(similarity)
        average_similarity = sum(similarity_scores) / len(similarity_scores) if similarity_scores else 0.0
        redundancy_penalty = min(0.2, average_similarity)

        coherence = _clamp(0.9 * dependency_validity - cycle_penalty - self_dep_penalty - redundancy_penalty - validation_penalty)

        # Completeness: align sub-problem count with overall complexity and coverage.
        complexity = problem.complexity_score.overall_complexity if problem.complexity_score else 5.0
        if complexity <= 3.0:
            expected_min, expected_max = 2, 4
        elif complexity <= 6.0:
            expected_min, expected_max = 3, 7
        else:
            expected_min, expected_max = 5, 12

        if sub_problem_count < expected_min:
            completeness = _clamp(sub_problem_count / max(1, expected_min))
        elif sub_problem_count > expected_max:
            completeness = _clamp(expected_max / max(1, sub_problem_count))
        else:
            completeness = 1.0

        empty_descriptions = sum(1 for sp in sub_problems if not sp.description.strip())
        completeness = _clamp(completeness - (empty_descriptions / max(1, sub_problem_count)) * 0.3)

        # Feasibility: ensure complexity aligns with available resources and configuration richness.
        complexity_scores = [
            sp.complexity_score.overall_complexity if sp.complexity_score.overall_complexity else 5
            for sp in sub_problems
        ]
        avg_complexity = sum(complexity_scores) / max(1, len(complexity_scores))
        max_allowed = problem.resources_available.get("max_subproblem_complexity") or problem.resources_available.get("max_complexity")
        feasibility_penalty = 0.0
        if max_allowed:
            feasibility_penalty += max(0.0, (avg_complexity - max_allowed) / max_allowed)

        missing_requirements = sum(
            1 for sp in sub_problems if not sp.description or not sp.description.strip()
        )
        feasibility_penalty += (missing_requirements / max(1, sub_problem_count)) * 0.2

        feasibility = _clamp(1.0 - feasibility_penalty)

        # Integration: ensure dependencies connect sub-problems and outputs are defined.
        dependency_density = total_dependencies / max(1, sub_problem_count * (sub_problem_count - 1))
        integration = 0.5 + min(0.5, dependency_density * 2.0)

        # Add parallelization bonus if advanced analysis available
        parallelization_bonus = 0.0
        if dependency_analysis and estimated_speedup > 1.0:
            # Bonus for parallelization potential (max 0.1)
            parallelization_bonus = min(0.1, (estimated_speedup - 1.0) / estimated_speedup * 0.1)

        # Critical path penalty (longer critical path = lower score)
        critical_path_penalty = 0.0
        if dependency_analysis and critical_path_length > 0:
            # Penalize very long critical paths (max 0.05)
            critical_path_ratio = critical_path_length / max(1, sub_problem_count)
            critical_path_penalty = max(0.0, (critical_path_ratio - 0.5) * 0.1)

        # Note: dependency_outputs check removed - field doesn't exist in SubProblem model
        # All sub-problems with dependencies are assumed to produce appropriate outputs
        integration = _clamp(integration + parallelization_bonus - critical_path_penalty)

        overall = _clamp((coherence + completeness + feasibility + integration) / 4.0)

        # Build details dictionary
        details = {
            "method": "heuristic_assessment",
            "dependency_validity": dependency_validity,
            "has_cycles": has_cycles,
            "average_similarity": average_similarity,
            "expected_sub_problem_range": [expected_min, expected_max],
            "average_complexity": avg_complexity,
            "missing_dependencies": missing_dependencies,
            "self_dependencies": self_dependencies,
            "missing_requirements": missing_requirements,
        }

        # Add advanced analysis details if available
        if dependency_analysis:
            details.update({
                "advanced_dependency_analysis": True,
                "num_cycles": num_cycles,
                "critical_path_length": critical_path_length,
                "estimated_speedup": estimated_speedup,
                "parallelization_bonus": parallelization_bonus,
                "critical_path_penalty": critical_path_penalty,
                "is_valid": is_valid
            })

        return QualityScores(
            coherence_score=coherence,
            completeness_score=completeness,
            feasibility_score=feasibility,
            integration_score=integration,
            overall_score=overall,
            meets_thresholds=overall >= 0.8,
            details=details,
            timestamp=datetime.now()
        )


    def _assess_quality_enhanced(self,
                                problem: ProblemDefinition,
                                sub_problems: List[SubProblem]) -> 'EnhancedQualityScores':
        """
        Enhanced multi-dimensional quality assessment.

        Assesses 5 dimensions:
        - Completeness: All aspects addressed
        - Consistency: No contradictions, stakeholder alignment
        - Feasibility: Realistic with resources
        - Dependencies: Valid, no cycles
        - Balance: Complexity/evenness distributed

        Returns EnhancedQualityScores with detailed breakdowns and recommendations.
        """
        from sovereign_data_models import EnhancedQualityScores
        from datetime import datetime

        if not sub_problems:
            return EnhancedQualityScores(
                overall_score=0.0,
                meets_thresholds=False,
                completeness_score=0.0,
                consistency_score=0.0,
                feasibility_score=0.0,
                dependency_score=0.0,
                balance_score=0.0,
                completeness_details={"error": "No sub-problems generated"},
                consistency_details={"error": "No sub-problems generated"},
                feasibility_details={"error": "No sub-problems generated"},
                dependency_details={"error": "No sub-problems generated"},
                balance_details={"error": "No sub-problems generated"},
                improvement_recommendations=["Generate sub-problems first"],
                critical_issues=["No sub-problems to assess"],
                validation_checkpoints=[],
                timestamp=datetime.now()
            )

        # Assess each dimension
        completeness_score, completeness_details = self._assess_completeness(problem, sub_problems)
        consistency_score, consistency_details = self._assess_consistency(problem, sub_problems)
        feasibility_score, feasibility_details = self._assess_feasibility(problem, sub_problems)
        dependency_score, dependency_details = self._assess_dependency_validity(problem, sub_problems)
        balance_score, balance_details = self._assess_balance(problem, sub_problems)

        # Calculate overall score (weighted average)
        weights = {
            'completeness': 0.25,
            'consistency': 0.20,
            'feasibility': 0.25,
            'dependency': 0.15,
            'balance': 0.15
        }

        overall_score = (
            completeness_score * weights['completeness'] +
            consistency_score * weights['consistency'] +
            feasibility_score * weights['feasibility'] +
            dependency_score * weights['dependency'] +
            balance_score * weights['balance']
        )

        # Check if meets thresholds
        threshold = 0.7  # Configurable
        meets_thresholds = overall_score >= threshold

        # Collect recommendations and issues
        improvement_recommendations = []
        critical_issues = []

        for name, score_val, details in [
            ("Completeness", completeness_score, completeness_details),
            ("Consistency", consistency_score, consistency_details),
            ("Feasibility", feasibility_score, feasibility_details),
            ("Dependency", dependency_score, dependency_details),
            ("Balance", balance_score, balance_details)
        ]:
            if score_val < threshold:
                improvement_recommendations.extend(details.get('recommendations', []))
                if score_val < 0.5:
                    critical_issues.append(f"{name} score critically low ({score_val:.2f})")

        # Validation checkpoints
        validation_checkpoints = [
            f"Completeness assessment: {completeness_score:.2f}",
            f"Consistency assessment: {consistency_score:.2f}",
            f"Feasibility assessment: {feasibility_score:.2f}",
            f"Dependency validation: {dependency_score:.2f}",
            f"Balance assessment: {balance_score:.2f}",
            f"Overall quality: {overall_score:.2f}"
        ]

        return EnhancedQualityScores(
            overall_score=round(overall_score, 3),
            meets_thresholds=meets_thresholds,
            completeness_score=round(completeness_score, 3),
            consistency_score=round(consistency_score, 3),
            feasibility_score=round(feasibility_score, 3),
            dependency_score=round(dependency_score, 3),
            balance_score=round(balance_score, 3),
            completeness_details=completeness_details,
            consistency_details=consistency_details,
            feasibility_details=feasibility_details,
            dependency_details=dependency_details,
            balance_details=balance_details,
            improvement_recommendations=improvement_recommendations[:10],  # Top 10
            critical_issues=critical_issues[:5],  # Top 5
            validation_checkpoints=validation_checkpoints,
            timestamp=datetime.now()
        )

    def _assess_completeness(self,
                            problem: ProblemDefinition,
                            sub_problems: List[SubProblem]) -> Tuple[float, Dict[str, Any]]:
        """
        Assess if decomposition covers all problem aspects.

        Checks:
        - All success criteria addressed
        - All stakeholder needs covered
        - No missing critical components
        - Alignment with problem scope

        Returns: (score, details_dict)
        """
        details = {
            'checks_performed': [],
            'issues_found': [],
            'recommendations': []
        }

        score = 1.0
        sub_problem_count = len(sub_problems)

        # Check 1: Success criteria coverage
        if problem.success_criteria:
            criteria_coverage = set()
            for sp in sub_problems:
                # Extract keywords from success criteria
                for sc in problem.success_criteria:
                    criteria_keywords = set(sc.description.lower().split())
                    sp_keywords = set(sp.description.lower().split())
                    if criteria_keywords & sp_keywords:  # Intersection
                        criteria_coverage.add(sc.description)

            coverage_ratio = len(criteria_coverage) / max(1, len(problem.success_criteria))
            details['checks_performed'].append(f"Success criteria coverage: {coverage_ratio:.2%}")
            if coverage_ratio < 0.8:
                score -= 0.15 * (1.0 - coverage_ratio)
                details['issues_found'].append(f"Only {coverage_ratio:.0%} of success criteria covered")
                details['recommendations'].append("Ensure all success criteria are explicitly addressed in sub-problems")

        # Check 2: Problem complexity alignment
        complexity = problem.complexity_score.overall_complexity if problem.complexity_score else 5.0

        if complexity <= 3.0:
            expected_min, expected_max = 2, 4
        elif complexity <= 6.0:
            expected_min, expected_max = 3, 7
        else:
            expected_min, expected_max = 5, 12

        if sub_problem_count < expected_min:
            penalty = (expected_min - sub_problem_count) / expected_min * 0.3
            score -= penalty
            details['issues_found'].append(f"Too few sub-problems ({sub_problem_count} < {expected_min})")
            details['recommendations'].append(f"Decompose into at least {expected_min} sub-problems for this complexity")
        elif sub_problem_count > expected_max:
            penalty = (sub_problem_count - expected_max) / sub_problem_count * 0.2
            score -= penalty
            details['issues_found'].append(f"Too many sub-problems ({sub_problem_count} > {expected_max})")
            details['recommendations'].append(f"Consolidate to {expected_max} or fewer sub-problems")

        details['checks_performed'].append(f"Sub-problem count: {sub_problem_count} (expected: {expected_min}-{expected_max})")

        # Check 3: Stakeholder needs coverage
        if problem.stakeholders:
            stakeholder_coverage = set()
            for sp in sub_problems:
                for stakeholder in problem.stakeholders:
                    if stakeholder.lower() in sp.description.lower():
                        stakeholder_coverage.add(stakeholder)

            coverage_ratio = len(stakeholder_coverage) / max(1, len(problem.stakeholders))
            details['checks_performed'].append(f"Stakeholder coverage: {coverage_ratio:.2%}")
            if coverage_ratio < 0.7:
                score -= 0.1 * (1.0 - coverage_ratio)
                details['issues_found'].append(f"Only {coverage_ratio:.0%} of stakeholders addressed")
                details['recommendations'].append("Ensure all stakeholders' needs are considered")

        # Check 4: Empty or minimal descriptions
        empty_count = sum(1 for sp in sub_problems if not sp.description or len(sp.description.strip()) < 20)
        if empty_count > 0:
            penalty = (empty_count / sub_problem_count) * 0.3
            score -= penalty
            details['issues_found'].append(f"{empty_count} sub-problems have minimal descriptions")
            details['recommendations'].append("Provide detailed descriptions for all sub-problems")

        # Check 5: Domain coverage
        if problem.domain_context:
            domain_mentioned = sum(
                1 for sp in sub_problems
                if problem.domain_context.domain.lower() in sp.description.lower()
            )
            domain_coverage = domain_mentioned / sub_problem_count
            details['checks_performed'].append(f"Domain coverage: {domain_coverage:.2%}")
            if domain_coverage < 0.5:
                score -= 0.05
                details['recommendations'].append("Ensure domain context is reflected in sub-problems")

        score = max(0.0, min(1.0, score))
        details['final_score'] = round(score, 3)

        return score, details

    def _assess_consistency(self,
                           problem: ProblemDefinition,
                           sub_problems: List[SubProblem]) -> Tuple[float, Dict[str, Any]]:
        """
        Assess internal consistency of decomposition.

        Checks:
        - No contradictions between sub-problems
        - Aligned with stakeholder needs
        - Coherent terminology
        - Consistent approach

        Returns: (score, details_dict)
        """
        details = {
            'checks_performed': [],
            'issues_found': [],
            'recommendations': []
        }

        score = 1.0

        # Check 1: Terminology consistency
        all_terms = set()
        for sp in sub_problems:
            words = re.findall(r'\b[A-Z][a-z]+\b', sp.description)  # Capitalized terms
            all_terms.update(words)

        # Check for conflicting approaches
        approaches = []
        for sp in sub_problems:
            if 'implement' in sp.description.lower():
                approaches.append('implementation')
            if 'analyze' in sp.description.lower():
                approaches.append('analysis')
            if 'research' in sp.description.lower():
                approaches.append('research')
            if 'design' in sp.description.lower():
                approaches.append('design')

        if len(set(approaches)) > 4:
            score -= 0.1
            details['issues_found'].append("Mixed approaches may indicate inconsistency")
            details['recommendations'].append("Ensure sub-problems follow a coherent methodology")

        details['checks_performed'].append(f"Approaches identified: {set(approaches)}")

        # Check 2: Contradiction detection (simple heuristic)
        # Look for antonym pairs
        antonym_pairs = [
            ('increase', 'decrease'),
            ('add', 'remove'),
            ('create', 'delete'),
            ('enable', 'disable'),
            ('optimize', 'simplify')
        ]

        for antonym1, antonym2 in antonym_pairs:
            has_antonym1 = any(antonym1 in sp.description.lower() for sp in sub_problems)
            has_antonym2 = any(antonym2 in sp.description.lower() for sp in sub_problems)
            if has_antonym1 and has_antonym2:
                # This might be OK if in different sub-problems, but flag it
                details['checks_performed'].append(f"Found antonyms: {antonym1}/{antonym2}")

        # Check 3: Stakeholder alignment
        if problem.stakeholders:
            misaligned = []
            for sp in sub_problems:
                mentions_stakeholder = any(
                    stakeholder.lower() in sp.description.lower()
                    for stakeholder in problem.stakeholders
                )
                if not mentions_stakeholder and sp.priority >= 8:
                    misaligned.append(sp.id)

            if misaligned:
                penalty = len(misaligned) / len(sub_problems) * 0.2
                score -= penalty
                details['issues_found'].append(f"{len(misaligned)} high-priority sub-problems don't mention stakeholders")
                details['recommendations'].append("Align high-priority sub-problems with stakeholder needs")

        # Check 4: Constraint consistency
        for constraint in problem.constraints[:3]:  # Check first 3 constraints
            constraint_addressed = any(
                constraint.description.lower() in sp.description.lower() or
                any(sp_constraint.description.lower() in constraint.description.lower()
                    for sp_constraint in sp.constraints)
                for sp in sub_problems
            )
            if not constraint_addressed:
                score -= 0.05
                details['issues_found'].append(f"Constraint not addressed: {constraint.description[:50]}...")

        # Check 5: Priority distribution consistency
        priorities = [sp.priority for sp in sub_problems]
        if priorities:
            avg_priority = sum(priorities) / len(priorities)
            if avg_priority > 8:
                details['recommendations'].append("Most sub-problems marked high priority - consider re-prioritizing")
            elif avg_priority < 3:
                details['recommendations'].append("Most sub-problems marked low priority - review priorities")

        details['checks_performed'].append(f"Average priority: {avg_priority:.1f}")

        # Check 6: Type distribution
        type_counts = {}
        for sp in sub_problems:
            sp_type = sp.type.value if hasattr(sp.type, 'value') else str(sp.type)
            type_counts[sp_type] = type_counts.get(sp_type, 0) + 1

        if len(type_counts) == 1:
            details['recommendations'].append("All sub-problems are same type - consider variety")
        elif len(type_counts) > 5:
            details['recommendations'].append("Too many different types - consider consolidation")

        details['checks_performed'].append(f"Type distribution: {type_counts}")

        score = max(0.0, min(1.0, score))
        details['final_score'] = round(score, 3)

        return score, details

    def _assess_feasibility(self,
                           problem: ProblemDefinition,
                           sub_problems: List[SubProblem]) -> Tuple[float, Dict[str, Any]]:
        """
        Assess if decomposition is feasible with resources.

        Checks:
        - Time estimates realistic
        - Technical feasibility
        - Resource availability
        - Budget constraints

        Returns: (score, details_dict)
        """
        details = {
            'checks_performed': [],
            'issues_found': [],
            'recommendations': []
        }

        score = 1.0

        # Check 1: Complexity vs resources
        complexity_scores = [
            sp.complexity_score.overall_complexity if sp.complexity_score else 5
            for sp in sub_problems
        ]
        avg_complexity = sum(complexity_scores) / max(1, len(complexity_scores))
        max_complexity = max(complexity_scores) if complexity_scores else 5

        details['checks_performed'].append(f"Average complexity: {avg_complexity:.1f}/10")
        details['checks_performed'].append(f"Max complexity: {max_complexity:.1f}/10")

        # Check against resource constraints
        max_allowed = problem.resources_available.get("max_subproblem_complexity") or \
                     problem.resources_available.get("max_complexity", 10)

        if max_complexity > max_allowed:
            penalty = (max_complexity - max_allowed) / max_allowed * 0.3
            score -= penalty
            details['issues_found'].append(f"Sub-problem complexity ({max_complexity:.1f}) exceeds limit ({max_allowed})")
            details['recommendations'].append(f"Break down sub-problems with complexity > {max_allowed}")

        # Check 2: Effort estimates
        efforts = [sp.effort_hours for sp in sub_problems if sp.effort_hours]
        if efforts:
            total_effort = sum(efforts)
            avg_effort = total_effort / len(efforts)

            details['checks_performed'].append(f"Total effort: {total_effort:.0f} hours")
            details['checks_performed'].append(f"Average effort: {avg_effort:.0f} hours")

            # Check if any single sub-problem is too large
            max_effort = max(efforts)
            if max_effort > 80:  # More than 2 weeks
                score -= 0.15
                details['issues_found'].append(f"Sub-problem requires {max_effort:.0f} hours - too large")
                details['recommendations'].append("Break down large sub-problems (>80 hours)")

            # Check if total effort is reasonable
            max_total_effort = problem.resources_available.get("max_total_effort", 1000)
            if total_effort > max_total_effort:
                penalty = (total_effort - max_total_effort) / max_total_effort * 0.2
                score -= penalty
                details['issues_found'].append(f"Total effort ({total_effort:.0f}h) exceeds limit ({max_total_effort}h)")
                details['recommendations'].append("Reduce scope or increase resources")

        # Check 3: Resource availability
        required_resources = set()
        for sp in sub_problems:
            if sp.required_skills:
                required_resources.update(sp.required_skills)

        available_resources = set(problem.resources_available.get("skills", []))
        missing_resources = required_resources - available_resources

        if missing_resources:
            penalty = len(missing_resources) / max(1, len(required_resources)) * 0.2
            score -= penalty
            details['issues_found'].append(f"Missing required skills: {missing_resources}")
            details['recommendations'].append("Ensure required skills are available or plan for training")

        details['checks_performed'].append(f"Required skills: {required_resources}")

        # Check 4: Technical feasibility indicators
        low_feasibility = 0
        for sp in sub_problems:
            desc_lower = sp.description.lower()

            # Red flags for feasibility
            if any(term in desc_lower for term in ['revolutionary', 'paradigm shift', 'breakthrough']):
                low_feasibility += 1

            # Green flags for feasibility
            if any(term in desc_lower for term in ['prototype', 'mvp', 'poc', 'pilot']):
                # This is good - incremental approach
                pass

        if low_feasibility > 0:
            penalty = (low_feasibility / len(sub_problems)) * 0.1
            score -= penalty
            details['issues_found'].append(f"{low_feasibility} sub-problems may be technically ambitious")
            details['recommendations'].append("Consider incremental/iterative approaches for ambitious goals")

        # Check 5: Constraint realism
        for constraint in problem.constraints:
            if hasattr(constraint, 'severity') and constraint.severity and hasattr(constraint.severity, 'value'):
                if constraint.severity.value == 'critical':
                    # Critical constraints should have realistic implementation
                    details['checks_performed'].append(f"Critical constraint: {constraint.description[:50]}...")

        score = max(0.0, min(1.0, score))
        details['final_score'] = round(score, 3)

        return score, details

    def _assess_dependency_validity(self,
                                   problem: ProblemDefinition,
                                   sub_problems: List[SubProblem]) -> Tuple[float, Dict[str, Any]]:
        """
        Assess if dependencies are valid.

        Checks:
        - No circular dependencies
        - Dependency references exist
        - Critical path reasonable
        - Execution order logical

        Returns: (score, details_dict)
        """
        details = {
            'checks_performed': [],
            'issues_found': [],
            'recommendations': []
        }

        score = 1.0

        if not sub_problems:
            return 0.0, details

        # Check 1: Build dependency graph
        sub_problem_ids = {sp.id for sp in sub_problems}
        total_dependencies = sum(len(sp.dependencies) for sp in sub_problems)

        details['checks_performed'].append(f"Total dependencies: {total_dependencies}")
        details['checks_performed'].append(f"Sub-problems: {len(sub_problems)}")

        # Check 2: Missing dependencies
        missing_deps = []
        for sp in sub_problems:
            for dep in sp.dependencies:
                if dep not in sub_problem_ids:
                    missing_deps.append((sp.id, dep))

        if missing_deps:
            penalty = len(missing_deps) / max(1, total_dependencies) * 0.4
            score -= penalty
            details['issues_found'].append(f"{len(missing_deps)} missing dependency references")
            details['recommendations'].append("Fix all missing dependency references")

        # Check 3: Self-dependencies
        self_deps = [sp.id for sp in sub_problems if sp.id in sp.dependencies]
        if self_deps:
            penalty = len(self_deps) / len(sub_problems) * 0.3
            score -= penalty
            details['issues_found'].append(f"{len(self_deps)} sub-problems depend on themselves")
            details['recommendations'].append("Remove self-dependencies")

        # Check 4: Circular dependencies
        execution_order = self._topological_sort(sub_problems)
        has_cycles = len(execution_order) < len(sub_problems)

        if has_cycles:
            score -= 0.4
            details['issues_found'].append("Circular dependencies detected")
            details['recommendations'].append("Break circular dependencies to enable execution")

        # Check 5: Dependency density (should be balanced)
        if len(sub_problems) > 1:
            max_possible_deps = len(sub_problems) * (len(sub_problems) - 1)
            dependency_density = total_dependencies / max_possible_deps if max_possible_deps > 0 else 0

            details['checks_performed'].append(f"Dependency density: {dependency_density:.2%}")

            if dependency_density > 0.7:
                score -= 0.1
                details['issues_found'].append("Very high dependency density - may indicate over-coupling")
                details['recommendations'].append("Consider reducing dependencies for better parallelization")
            elif dependency_density < 0.1 and len(sub_problems) > 3:
                details['recommendations'].append("Very low dependency density - consider if sub-problems are coordinated")

        # Check 6: Critical path analysis
        if total_dependencies > 0 and not has_cycles:
            # Identify longest path (simplified)
            levels = {}
            for sp_id in execution_order:
                # Count how many dependencies this sub-problem has (directly + indirectly)
                sp = next(sp for sp in sub_problems if sp.id == sp_id)
                level = 0
                to_check = list(sp.dependencies)
                checked = set()

                while to_check:
                    dep_id = to_check.pop(0)
                    if dep_id in checked:
                        continue
                    checked.add(dep_id)

                    level += 1
                    dep_sp = next((sp for sp in sub_problems if sp.id == dep_id), None)
                    if dep_sp:
                        to_check.extend(dep_sp.dependencies)

                levels[sp_id] = level

            max_level = max(levels.values()) if levels else 0
            details['checks_performed'].append(f"Max dependency depth: {max_level}")

            if max_level > len(sub_problems) / 2:
                details['recommendations'].append("Deep dependency chain - may slow down execution")

        # Check 7: Orphan sub-problems (no dependencies and no dependents)
        if len(sub_problems) > 1:
            isolated = []
            for sp in sub_problems:
                # No dependencies
                no_deps = len(sp.dependencies) == 0
                # Nothing depends on this
                no_dependents = all(sp.id not in other_sp.dependencies for other_sp in sub_problems)

                if no_deps and no_dependents and len(sub_problems) > 1:
                    isolated.append(sp.id)

            if isolated:
                details['checks_performed'].append(f"Isolated sub-problems: {len(isolated)}")
                if len(isolated) > len(sub_problems) / 2:
                    details['recommendations'].append("Many isolated sub-problems - consider if they form a coherent solution")

        score = max(0.0, min(1.0, score))
        details['final_score'] = round(score, 3)

        return score, details

    def _assess_balance(self,
                       problem: ProblemDefinition,
                       sub_problems: List[SubProblem]) -> Tuple[float, Dict[str, Any]]:
        """
        Assess if complexity/effect is evenly distributed.

        Checks:
        - No sub-problem >30% complexity
        - Effort distributed
        - Risk distributed
        - Value distributed

        Returns: (score, details_dict)
        """
        details = {
            'checks_performed': [],
            'issues_found': [],
            'recommendations': []
        }

        score = 1.0

        if not sub_problems:
            return 0.0, details

        # Check 1: Complexity distribution
        complexity_scores = [
            sp.complexity_score.overall_complexity if sp.complexity_score else 5
            for sp in sub_problems
        ]
        total_complexity = sum(complexity_scores)

        if total_complexity > 0:
            complexity_ratios = [cs / total_complexity for cs in complexity_scores]
            max_complexity_ratio = max(complexity_ratios)

            details['checks_performed'].append(f"Max complexity ratio: {max_complexity_ratio:.2%}")

            # Check if any sub-problem > 30% of total complexity
            if max_complexity_ratio > 0.30:
                penalty = (max_complexity_ratio - 0.30) / 0.30 * 0.3
                score -= penalty
                details['issues_found'].append(f"Sub-problem with {max_complexity_ratio:.1%} of complexity (limit: 30%)")
                details['recommendations'].append("Redistribute complexity more evenly across sub-problems")

        # Check 2: Effort distribution
        efforts = [sp.effort_hours for sp in sub_problems if sp.effort_hours]
        if efforts:
            total_effort = sum(efforts)
            effort_ratios = [e / total_effort for e in efforts]
            max_effort_ratio = max(effort_ratios)

            details['checks_performed'].append(f"Max effort ratio: {max_effort_ratio:.2%}")

            if max_effort_ratio > 0.40:
                penalty = (max_effort_ratio - 0.40) / 0.40 * 0.2
                score -= penalty
                details['issues_found'].append(f"Sub-problem with {max_effort_ratio:.1%} of effort")
                details['recommendations'].append("Balance effort more evenly across sub-problems")

            # Check coefficient of variation (standard deviation / mean)
            if len(efforts) > 1:
                mean_effort = sum(efforts) / len(efforts)
                variance = sum((e - mean_effort) ** 2 for e in efforts) / len(efforts)
                std_dev = variance ** 0.5
                cv = std_dev / mean_effort if mean_effort > 0 else 0

                details['checks_performed'].append(f"Effort variation (CV): {cv:.2f}")

                if cv > 1.0:  # High variation
                    score -= 0.1
                    details['issues_found'].append(f"High effort variation (CV={cv:.2f})")
                    details['recommendations'].append("Standardize sub-problem sizes for better predictability")

        # Check 3: Priority distribution
        priorities = [sp.priority for sp in sub_problems]
        if priorities:
            high_priority_count = sum(1 for p in priorities if p >= 8)
            low_priority_count = sum(1 for p in priorities if p <= 3)

            details['checks_performed'].append(f"High priority: {high_priority_count}/{len(priorities)}")
            details['checks_performed'].append(f"Low priority: {low_priority_count}/{len(priorities)}")

            if high_priority_count == len(priorities):
                details['recommendations'].append("All sub-problems marked high priority - differentiation needed")
            elif low_priority_count == len(priorities):
                details['recommendations'].append("All sub-problems marked low priority - review prioritization")

        # Check 4: Type balance
        type_counts = {}
        for sp in sub_problems:
            sp_type = sp.type.value if hasattr(sp.type, 'value') else str(sp.type)
            type_counts[sp_type] = type_counts.get(sp_type, 0) + 1

        if len(type_counts) > 0:
            max_type_count = max(type_counts.values())
            max_type_ratio = max_type_count / len(sub_problems)

            details['checks_performed'].append(f"Type distribution: {type_counts}")

            if max_type_ratio > 0.7 and len(sub_problems) > 2:
                details['recommendations'].append(f"Dominated by one type ({max_type_ratio:.0%} same type)")

        # Check 5: Risk distribution (based on constraints)
        constraint_counts = [len(sp.constraints) for sp in sub_problems]
        if constraint_counts:
            avg_constraints = sum(constraint_counts) / len(constraint_counts)
            max_constraints = max(constraint_counts)

            details['checks_performed'].append(f"Average constraints: {avg_constraints:.1f}")
            details['checks_performed'].append(f"Max constraints: {max_constraints}")

            if max_constraints > avg_constraints * 3:
                details['issues_found'].append(f"Sub-problem with {max_constraints} constraints (high complexity)")
                details['recommendations'].append("Consider simplifying over-constrained sub-problems")

        # Check 6: Description length balance
        desc_lengths = [len(sp.description) for sp in sub_problems]
        if desc_lengths:
            avg_length = sum(desc_lengths) / len(desc_lengths)
            max_length = max(desc_lengths)

            if max_length > avg_length * 3:
                details['recommendations'].append("High variation in description detail - standardize detail level")

        score = max(0.0, min(1.0, score))
        details['final_score'] = round(score, 3)

        return score, details

    def decompose_and_solve(
        self,
        problem: ProblemDefinition,
        solve_sub_problems: bool = True,
        assemble_solution: bool = True,
        assembly_strategy: str = "hierarchical",
        validate_solution: bool = True
    ) -> 'DecompositionResult':
        """
        Complete end-to-end decomposition AND solution assembly.

        This is the missing piece - full workflow from problem to integrated solution.

        Args:
            problem: The problem to decompose and solve
            solve_sub_problems: If True, solve sub-problems (default: True)
            assemble_solution: If True, assemble final solution (default: True)
            assembly_strategy: Strategy for assembly: "hierarchical", "linear", "parallel", "adaptive"
            validate_solution: If True, validate integrated solution (default: True)

        Returns:
            DecompositionResult containing plan, sub_solutions, and integrated_solution

        Example:
            >>> engine = DecompositionEngine()
            >>> result = engine.decompose_and_solve(problem)
            >>> print(result.integrated_solution.assembled_content)
        """
        from problem_recomposition import SolutionAssembler
        from final_solution import SolutionValidator
        # MIGRATION: SolutionAttempt moved from sovereign_data_models to crewai_state_management
        try:
            from sovereign_data_models import DecompositionResult, SolutionAttempt, generate_id
        except ImportError:
            from crewai_state_management import SolutionAttempt
            try:
                from sovereign_data_models import DecompositionResult, generate_id
            except ImportError:
                # DecompositionResult might still be in sovereign_data_models
                try:
                    from sovereign_data_models import DecompositionResult
                except ImportError:
                    DecompositionResult = None
                # Fallback: use uuid for generate_id
                def generate_id(prefix: str = "") -> str:
                    """Generate a unique ID with optional prefix."""
                    import uuid
                    unique_id = str(uuid.uuid4())[:8]
                    return f"{prefix}_{unique_id}" if prefix else unique_id

        self.logger.info(f"Starting end-to-end decompose_and_solve for problem: {problem.id}")

        # Step 1: Decompose the problem
        self.logger.info("Step 1: Decomposing problem...")
        plan = self.decompose(problem)
        self.logger.info(f"Decomposition complete: {len(plan.sub_problems)} sub-problems created")

        # Step 2: Solve sub-problems (if requested)
        sub_solutions = {}
        if solve_sub_problems:
            self.logger.info("Step 2: Solving sub-problems...")
            sub_solutions = self._solve_sub_problems(plan, problem)
            self.logger.info(f"Sub-problem solving complete: {len(sub_solutions)} solutions generated")

        # Step 3: Assemble final solution (if requested and we have sub_solutions)
        integrated = None
        if assemble_solution and sub_solutions:
            self.logger.info(f"Step 3: Assembling final solution using strategy: {assembly_strategy}")

            # Create assembler
            assembler = SolutionAssembler()

            # Assemble solution
            integrated = assembler.assemble_solution(
                plan,
                sub_solutions,
                assembly_strategy=assembly_strategy
            )

            self.logger.info(f"Solution assembly complete: {integrated.solution_id}")

            # Step 4: Validate solution (if requested)
            if validate_solution:
                self.logger.info("Step 4: Validating integrated solution...")
                validator = SolutionValidator()
                validation_results = validator.validate_solution(integrated, problem)

                passed_count = sum(1 for v in validation_results if v.passed)
                self.logger.info(f"Validation complete: {passed_count}/{len(validation_results)} checks passed")

        # Create result
        result = DecompositionResult(
            decomposition_plan=plan,
            sub_solutions=sub_solutions,
            integrated_solution=integrated,
            metadata={
                'workflow_timestamp': datetime.now().isoformat(),
                'solve_sub_problems': solve_sub_problems,
                'assemble_solution': assemble_solution,
                'assembly_strategy': assembly_strategy,
                'validate_solution': validate_solution,
                'num_sub_problems': len(plan.sub_problems),
                'num_sub_solutions': len(sub_solutions),
                'solution_assembled': integrated is not None
            }
        )

        self.logger.info(f"End-to-end decompose_and_solve complete for problem: {problem.id}")
        return result

    def _solve_sub_problems(
        self,
        plan: DecompositionPlan,
        problem: ProblemDefinition
    ) -> Dict[str, SolutionAttempt]:
        """
        Solve all sub-problems in the decomposition plan.

        This is a placeholder implementation that generates mock solutions.
        In production, this would:
        - Assign to appropriate teams/agents
        - Execute the solving process
        - Collect and validate results

        Args:
            plan: The decomposition plan with sub-problems
            problem: The original problem (for context)

        Returns:
            Dict mapping sub_problem_id -> SolutionAttempt
        """
        # SolutionAttempt already imported at top

        sub_solutions = {}

        for sub_problem in plan.sub_problems:
            # Generate a solution attempt based on sub-problem characteristics
            # Determine approach based on sub-problem type and requirements
            approach = f"solution_for_{sub_problem.type.value if hasattr(sub_problem, 'type') and sub_problem.type else 'general'}"

            # Generate solution content based on sub-problem details
            solution_parts = []
            solution_parts.append(f"Solving: {sub_problem.title}")
            solution_parts.append("")
            solution_parts.append(f"Description: {sub_problem.description}")

            if sub_problem.requirements:
                solution_parts.append("")
                solution_parts.append("Requirements:")
                for req in sub_problem.requirements[:3]:  # Limit to first 3 requirements
                    solution_parts.append(f"- {req}")

            if sub_problem.constraints:
                solution_parts.append("")
                solution_parts.append("Constraints:")
                for constraint in sub_problem.constraints[:3]:  # Limit to first 3 constraints
                    solution_parts.append(f"- {constraint}")

            solution_parts.append("")
            solution_parts.append("# Implementation approach")
            solution_parts.append(f"1. Analyze the {sub_problem.type.value if hasattr(sub_problem, 'type') and sub_problem.type else 'problem'} requirements")
            solution_parts.append(f"2. Apply appropriate {sub_problem.type.value if hasattr(sub_problem, 'type') and sub_problem.type else 'solution'} methodology")
            solution_parts.append(f"3. Validate against constraints: {', '.join(sub_problem.constraints[:2]) if sub_problem.constraints else 'None'}")

            solution_content = "\n".join(solution_parts)

            # Calculate confidence based on problem complexity and available information
            complexity_factor = min(0.95, 0.6 + (len(sub_problem.description) * 0.001))
            requirements_factor = min(0.9, 0.7 + (len(sub_problem.requirements) * 0.05) if sub_problem.requirements else 0.5)
            constraint_factor = max(0.5, 0.8 - (len(sub_problem.constraints) * 0.05) if sub_problem.constraints else 0.7)

            confidence_score = (complexity_factor + requirements_factor + constraint_factor) / 3.0

            solution_attempt = SolutionAttempt(
                id=generate_id("solution_attempt"),
                sub_problem_id=sub_problem.id,
                approach=approach,
                solution_content=solution_content,
                team_id=f"team_for_{sub_problem.type.value.lower() if hasattr(sub_problem, 'type') and sub_problem.type else 'general'}",
                confidence_score=confidence_score,
                status="completed"
            )

            sub_solutions[sub_problem.id] = solution_attempt

        return sub_solutions

    # ========================================================================
    # CUSTOM STRATEGY SUPPORT - Progress Visualization & Custom Strategies
    # ========================================================================

    def register_custom_strategy(
        self,
        strategy: DecompositionStrategyBase
    ):
        """
        Register custom strategy with engine.

        Makes strategy available for use in decomposition.

        Args:
            strategy: Custom decomposition strategy instance
        """
        strategy_name = strategy.get_strategy_name()

        # Check if strategy already exists
        if strategy_name in self.strategies:
            self.logger.warning(f"Strategy '{strategy_name}' already registered. Overwriting.")

        # Register strategy
        self.strategies[strategy_name] = strategy
        self.logger.info(f"Registered custom strategy: {strategy_name}")

        # Update total strategy count
        self.logger.info(f"Total strategies available: {len(self.strategies)}")

    def unregister_strategy(
        self,
        strategy_name: str
    ):
        """
        Unregister a strategy from the engine.

        Args:
            strategy_name: Name of strategy to remove

        Raises:
            ValueError: If strategy is not registered
        """
        if strategy_name not in self.strategies:
            raise ValueError(f"Strategy '{strategy_name}' is not registered")

        del self.strategies[strategy_name]
        self.logger.info(f"Unregistered strategy: {strategy_name}")

    def list_strategies(self) -> List[str]:
        """
        List all available strategies.

        Returns:
            List of strategy names
        """
        return list(self.strategies.keys())

    def get_strategy(self, strategy_name: str) -> Optional[DecompositionStrategyBase]:
        """
        Get a registered strategy by name.

        Args:
            strategy_name: Name of strategy to retrieve

        Returns:
            Strategy instance or None if not found
        """
        return self.strategies.get(strategy_name)

    @with_error_handling(severity=ErrorSeverity.HIGH, fallback=lambda problem, strategy_config: DecompositionPlan(
        id=generate_id("plan"),
        problem_id=problem.id,
        strategy=DecompositionStrategy.HYBRID,
        sub_problems=[],
        dependency_graph=DependencyGraph(nodes={}, edges={}),
        validation_checkpoints=[],
        quality_scores=QualityScores(overall_score=0.0, meets_thresholds=False),
        confidence_level=0.0,
        created_by="decomposition_engine_error",
        error_message="Custom strategy decomposition failed"
    ))
    def use_custom_strategy(
        self,
        problem: ProblemDefinition,
        strategy_config: Any
    ) -> DecompositionPlan:
        """
        Use custom strategy for one-off decomposition.

        Creates, validates, and uses custom strategy without
        permanently registering it.

        Args:
            problem: Problem to decompose
            strategy_config: StrategyConfig object containing:
                - strategy_name: Name of the custom strategy
                - decomposition_logic: Function that implements the decomposition
                - parameters: Dictionary of strategy-specific parameters
                - validation_rules: Rules for validating the strategy output

        Returns:
            DecompositionPlan with results from the custom strategy

        Raises:
            ValueError: If strategy validation fails
            ImportError: If CustomStrategyBuilder is not available
            RuntimeError: If strategy execution fails

        Example:
            >>> strategy_config = StrategyConfig(
            ...     strategy_name="custom_domain_specific",
            ...     decomposition_logic=my_custom_decomposition_function,
            ...     parameters={"domain": "healthcare", "granularity": "medium"},
            ...     validation_rules={"min_subproblems": 3, "max_subproblems": 8}
            ... )
            >>> plan = engine.use_custom_strategy(problem, strategy_config)

        Note:
            This method requires the custom_strategy_builder module to be available.
            The strategy_config should be compatible with CustomStrategyBuilder.create_strategy().
        """
        try:
            from custom_strategy_builder import CustomStrategyBuilder
        except ImportError as e:
            self.logger.error(f"CustomStrategyBuilder not available: {e}")
            raise ImportError(f"Custom strategy functionality requires custom_strategy_builder module: {e}")

        # Create builder
        builder = CustomStrategyBuilder()

        # Create strategy
        try:
            strategy = builder.create_strategy(strategy_config)
        except Exception as e:  # TODO: Catch specific exception instead of Exception
            self.logger.error(f"Failed to create custom strategy: {e}")
            raise RuntimeError(f"Strategy creation failed: {e}")

        # Validate
        try:
            validation = builder.validate_strategy(strategy)
            if not validation.is_valid:
                error_msg = f"Invalid strategy: {validation.errors}"
                self.logger.error(error_msg)
                raise ValueError(error_msg)
        except Exception as e:  # TODO: Catch specific exception instead of Exception
            self.logger.error(f"Strategy validation failed: {e}")
            raise RuntimeError(f"Strategy validation error: {e}")

        # Use strategy to decompose
        try:
            sub_problems = strategy.decompose(problem)
            if not sub_problems:
                self.logger.warning("Custom strategy returned empty sub-problems list")
            elif len(sub_problems) < 2:
                self.logger.warning(f"Custom strategy returned only {len(sub_problems)} sub-problem(s) - consider decomposing further")
        except Exception as e:  # TODO: Catch specific exception instead of Exception
            self.logger.error(f"Custom strategy decomposition failed: {e}")
            raise RuntimeError(f"Decomposition execution failed: {e}")

        # Create decomposition plan
        try:
            from dependency_analyzer import analyze_dependency_graph
            dependency_graph = analyze_dependency_graph(sub_problems) if DEPENDENCY_ANALYZER_AVAILABLE else None

            plan = DecompositionPlan(
                id=generate_id("plan"),
                problem_id=problem.id,
                strategy=DecompositionStrategy.HYBRID,  # Use HYBRID for custom strategies
                sub_problems=sub_problems,
                dependency_graph=dependency_graph or DependencyGraph(nodes={}, edges={}),
                validation_checkpoints=[],
                quality_scores=QualityScores(overall_score=0.8, meets_thresholds=True),
                confidence_level=0.8,
                created_by=f"custom_strategy_{strategy_config.strategy_name}"
            )

            self.logger.info(f"Custom strategy decomposition complete: {len(sub_problems)} sub-problems")
            return plan
        except Exception as e:  # TODO: Catch specific exception instead of Exception
            self.logger.error(f"Failed to create decomposition plan: {e}")
            raise RuntimeError(f"Plan creation failed: {e}")

