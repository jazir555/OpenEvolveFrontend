# OpenEvolve Production Environment Configuration
# IMPORTANT: Copy this file to .env.production and fill in SECURE values
# NEVER commit .env.production to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Use external managed database (AWS RDS, Google Cloud SQL, Azure Database)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://openevolve:CHANGE_THIS_PASSWORD@your-db-host:5432/openevolve_prod

# If using PostgreSQL via Docker (not recommended for production)
# DB_PASSWORD=your_secure_password_here

# Database connection pool settings
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# REDIS CONFIGURATION
# ============================================
# Use external managed Redis (AWS ElastiCache, Redis Labs, Azure Cache)
# Format: redis://host:port/db
REDIS_URL=redis://your-redis-host:6379/0

# If using Redis password
# REDIS_PASSWORD=your_redis_password

# Connection settings
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Generate using: openssl rand -base64 42
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHAR_MINIMUM_SECRET

JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_DAYS=7

# Password requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_UPPERCASE=true

# Session security
SESSION_TTL=28800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true

# ============================================
# API CONFIGURATION
# ============================================
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=8
LOG_LEVEL=WARNING
DEBUG=false

# CORS Configuration (Production)
CORS_ORIGINS=https://openevolve.ai,https://www.openevolve.ai
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_BASE_URL=https://openevolve.ai
VITE_WS_BASE_URL=wss://openevolve.ai
VITE_APP_TITLE=OpenEvolve
VITE_APP_ENV=production
VITE_ENABLE_DEBUG=false

# ============================================
# EXTERNAL SERVICES
# ============================================
# LeanAide Integration
LEANAIDE_URL=https://leanaide.openevolve.ai
LEANAIDE_TIMEOUT=30
LEANAIDE_API_KEY=your_leanaide_api_key_here
LEANAIDE_MAX_RETRIES=3

# BubbleLabs Integration
BUBBLELABS_URL=https://bubblelabs.openevolve.ai
BUBBLELABS_TIMEOUT=30
BUBBLELABS_API_KEY=your_bubblelabs_api_key_here
BUBBLELABS_MAX_RETRIES=3

# Knowledge Engine
KNOWLEDGE_ENGINE_URL=https://knowledge-engine.openevolve.ai
KNOWLEDGE_ENGINE_TIMEOUT=60
KNOWLEDGE_ENGINE_API_KEY=your_knowledge_engine_api_key_here
KNOWLEDGE_ENGINE_MAX_RETRIES=3

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=10000
WS_MESSAGE_QUEUE_SIZE=1000
WS_MAX_MESSAGE_SIZE=1048576

# ============================================
# FILE STORAGE
# ============================================
# Upload configuration
UPLOAD_MAX_SIZE_MB=500
UPLOAD_ALLOWED_EXTENSIONS=.csv,.json,.txt,.pdf,.doc,.docx,.png,.jpg,.jpeg,.zip,.tar.gz
UPLOAD_TEMP_DIR=/tmp/uploads

# Storage backend (s3, azure, gcs)
STORAGE_BACKEND=s3

# S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=openevolve-production
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_ACL=private

# CloudFront CDN (optional)
CLOUDFRONT_DOMAIN=cdn.openevolve.ai

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=notifications@openevolve.ai
SMTP_PASSWORD=your_smtp_password

EMAIL_FROM=noreply@openevolve.ai
EMAIL_REPLY_TO=support@openevolve.ai
EMAIL_ADMIN=ops@openevolve.ai

# Email templates
EMAIL_TEMPLATE_DIR=/app/templates/email

# ============================================
# MONITORING & LOGGING
# ============================================
# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging (Production - structured JSON)
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_LEVEL=WARNING
LOG_ROTATION=true
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.01

# DataDog (Alternative)
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_HOST=datadog-agent
DATADOG_PORT=8125

# ============================================
# DATABASE BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=s3://openevolve-backups/production
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key

# Point-in-time recovery
PITR_ENABLED=true
PITR_RETENTION_DAYS=7

# ============================================
# SSL/TLS CERTIFICATES
# ============================================
# Let's Encrypt
LETSENCRYPT_EMAIL=admin@openevolve.ai
LETSENCRYPT_STAGING=false

# Or provide custom certificates
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ============================================
# CONTENT DELIVERY NETWORK
# ============================================
CDN_ENABLED=true
CDN_PROVIDER=cloudfront
CDN_DOMAIN=cdn.openevolve.ai
CDN_DISTRIBUTION_ID=your_cloudfront_distribution_id

# ============================================
# SEARCH & ANALYTICS
# ============================================
# Elasticsearch (for search)
ELASTICSEARCH_URL=https://your-elasticsearch-cluster:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
ELASTICSEARCH_INDEX_PREFIX=openevolve

# PostHog (Product Analytics)
POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_ENABLED=true

# ============================================
# FEATURE FLAGS
# ============================================
# Use a feature flag service (LaunchDarkly, Flagsmith, etc.)
FEATURE_FLAG_SERVICE_URL=https://feature-flags.openevolve.ai
FEATURE_FLAG_SDK_KEY=your_feature_flag_sdk_key

# Local feature flags (fallback)
FEATURE_EVOLUTIONARY_ALGORITHMS=true
FEATURE_ADVERSARIAL_TESTING=true
FEATURE_MAKER_ENGINE=true
FEATURE_DECOMPOSITION_WORKFLOW=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_REALTIME_COLLABORATION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_AI_SUGGESTIONS=true

# ============================================
# WEBHOOKS
# ============================================
# Webhook endpoints for event notifications
WEBHOOK_SLACK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WEBHOOK_DISCORD=https://discord.com/api/webhooks/YOUR_DISCORD_WEBHOOK
WEBHOOK_TEAMS=https://outlook.office.com/webhook/YOUR_TEAMS_WEBHOOK

# ============================================
# PERFORMANCE & SCALING
# ============================================
# Connection pool settings
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache settings
CACHE_DEFAULT_TTL=600
CACHE_MAX_SIZE=100000
CACHE_EVICTION_POLICY=lru

# Worker settings
WORKER_CONCURRENCY=8
WORKER_PREFETCH_MULTIPLIER=4
WORKER_MAX_TASKS_PER_CHILD=1000
WORKER_TASK_SOFT_TIME_LIMIT=300
WORKER_TASK_TIME_LIMIT=600

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gcp-credentials.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_REGION=us-central1

# Azure
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_RESOURCE_GROUP=openevolve-rg
AZURE_LOCATION=eastus

# ============================================
# COMPLIANCE & AUDITING
# ============================================
# GDPR compliance
GDPR_ENABLED=true
GDPR_DATA_RETENTION_DAYS=365
GDPR_ANONYMIZATION_ENABLED=true

# SOC 2 compliance
SOC2_AUDIT_LOGGING=true
SOC2_AUDIT_LOG_RETENTION_DAYS=90
SOC2_ACCESS_LOG_ENABLED=true

# Audit log settings
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_EXPORT_TO_S3=true

# ============================================
# INCIDENT RESPONSE
# ============================================
# PagerDuty
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key
PAGERDUTY_API_KEY=your_pagerduty_api_key
PAGERDUTY_SERVICE_ID=your_pagerduty_service_id

# Opsgenie
OPSGENIE_API_KEY=your_opsgenie_api_key
OPSGENIE_HEARTBEART_NAME=OpenEvolve-Production
OPSGENIE_HEARTBEART_INTERVAL=60000

# ============================================
# DISASTER RECOVERY
# ============================================
DR_ENABLED=true
DR_BACKUP_REGION=us-west-2
DR_RECOVERY_TIME_OBJECTIVE=3600
DR_RECOVERY_POINT_OBJECTIVE=900

# ============================================
# COST OPTIMIZATION
# ============================================
# Resource tagging
COST_CENTER=engineering
ENVIRONMENT_TAG=production
PROJECT_TAG=openevolve

# ============================================
# DEVELOPMENT / DEBUG (DISABLE IN PRODUCTION)
# ============================================
DEBUG=false
DEBUG_TOOLBAR=false
PROFILING_ENABLED=false
SWAGGER_ENABLED=false
REDOC_ENABLED=false
HOT_RELOAD=false
SQL_LOGGING=false
