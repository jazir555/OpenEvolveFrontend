# OpenEvolve Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Generate a secure password using: openssl rand -base64 32
DB_PASSWORD=change_this_secure_password_immediately

# Database connection settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=openevolve_staging
DB_USER=openevolve
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Generate using: openssl rand -base64 42
JWT_SECRET=change_this_jwt_secret_min_32_characters_long_immediately

JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_DAYS=30

# Password requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBER=true

# ============================================
# API CONFIGURATION
# ============================================
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=4
LOG_LEVEL=INFO
DEBUG=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://staging.openevolve.ai
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Session Configuration
SESSION_TTL=86400
SESSION_COOKIE_NAME=openevolve_session

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_TITLE=OpenEvolve Staging
VITE_APP_ENV=staging
VITE_ENABLE_DEBUG=true

# ============================================
# EXTERNAL SERVICES
# ============================================
# LeanAide Integration
LEANAIDE_URL=http://leanaide:8080
LEANAIDE_TIMEOUT=30
LEANAIDE_API_KEY=

# BubbleLabs Integration
BUBBLELABS_URL=http://bubblelabs:5000
BUBBLELABS_TIMEOUT=30
BUBBLELABS_API_KEY=

# Knowledge Engine
KNOWLEDGE_ENGINE_URL=http://knowledge-engine:7500
KNOWLEDGE_ENGINE_TIMEOUT=60
KNOWLEDGE_ENGINE_API_KEY=

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
WS_MESSAGE_QUEUE_SIZE=100

# ============================================
# FILE STORAGE
# ============================================
# Upload configuration
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=.csv,.json,.txt,.pdf,.doc,.docx,.png,.jpg,.jpeg
UPLOAD_TEMP_DIR=/tmp/uploads

# Storage backend (local, s3, azure, gcs)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage

# S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=notifications@openevolve.ai
SMTP_PASSWORD=
EMAIL_FROM=noreply@openevolve.ai
EMAIL_REPLY_TO=support@openevolve.ai

# ============================================
# MONITORING & LOGGING
# ============================================
# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_ROTATION=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# DATABASE BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=

# ============================================
# PGADMIN CONFIGURATION (Staging Only)
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@openevolve.ai
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
HOT_RELOAD=true
PROFILING_ENABLED=true
DEBUG_TOOLBAR=false
SWAGGER_ENABLED=true
REDOC_ENABLED=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_EVOLUTIONARY_ALGORITHMS=true
FEATURE_ADVERSARIAL_TESTING=true
FEATURE_MAKER_ENGINE=true
FEATURE_DECOMPOSITION_WORKFLOW=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_REALTIME_COLLABORATION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_AI_SUGGESTIONS=true

# ============================================
# PERFORMANCE TUNING
# ============================================
# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache settings
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=10000
CACHE_EVICTION_POLICY=lru

# Worker settings
WORKER_CONCURRENCY=4
WORKER_PREFETCH_MULTIPLIER=4
WORKER_MAX_TASKS_PER_CHILD=1000
