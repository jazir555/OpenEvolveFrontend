{
  "python_version": "3.11",
  "required_packages": [
    "streamlit>=1.28.0",
    "pytest>=7.4.0",
    "psutil>=5.9.0",
    "requests>=2.31.0"
  ],
  "database_path": "sovereign_system.db",
  "log_level": "INFO",
  "health_check_port": 8000,
  "api_port": 8501,
  "cache_size": 1000,
  "cache_ttl_seconds": 3600,
  "max_concurrent_problems": 100,
  "max_refinement_cycles": 5,
  "quality_thresholds": {
    "coherence": 0.85,
    "completeness": 0.90,
    "feasibility": 0.80,
    "overall": 0.85
  },
  "performance_targets": {
    "simple_decomposition_seconds": 10,
    "complex_decomposition_seconds": 30,
    "concurrent_capacity": 100
  },
  "monitoring": {
    "enabled": true,
    "health_check_interval_seconds": 60,
    "metrics_retention_days": 30
  },
  "backup": {
    "enabled": true,
    "interval_hours": 24,
    "retention_days": 7
  }
}
