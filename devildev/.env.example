# Database
DATABASE_URL="postgresql://user:password@localhost:5432/devildev"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# E2B Sandbox Configuration
E2B_API_KEY="e2b_api_key_here"
E2B_TEMPLATE_ID="e2b_template_id_here"

# Python-Specific Configuration (NEW)
# Python execution timeout in milliseconds
PYTHON_EXECUTION_TIMEOUT=30000

# Python memory limit in MB
PYTHON_MEMORY_LIMIT=512

# Python sandbox pool size (min number of warm sandboxes)
PYTHON_SANDBOX_POOL_MIN=5

# Python sandbox pool size (max number of warm sandboxes)
PYTHON_SANDBOX_POOL_MAX=20

# Python default template IDs
E2B_PYTHON_BASE_TEMPLATE_ID=""
E2B_PYTHON_DATA_SCIENCE_TEMPLATE_ID=""
E2B_PYTHON_WEB_TEMPLATE_ID=""

# Python package installation timeout (seconds)
PYTHON_PACKAGE_INSTALL_TIMEOUT=120

# Enable Python caching (true/false)
PYTHON_CACHE_ENABLED=true

# Python cache TTL in seconds (default: 1 hour)
PYTHON_CACHE_TTL=3600

# Python supported versions (comma-separated)
PYTHON_SUPPORTED_VERSIONS="3.9,3.10,3.11,3.12,3.13"

# Python default version
PYTHON_DEFAULT_VERSION="3.12"

# Enable Python async execution (true/false)
PYTHON_ASYNC_ENABLED=true

# Python max async workers
PYTHON_ASYNC_MAX_WORKERS=10

# Python max concurrent executions
PYTHON_MAX_CONCURRENT_EXECUTIONS=20

# Redis URL for Python execution caching
REDIS_URL="redis://localhost:6379"

# Enable Prometheus metrics for Python execution
PYTHON_PROMETHEUS_ENABLED=true

# Sentry DSN for Python error tracking
SENTRY_DSN=""

# Enable Python security scanning
PYTHON_SECURITY_SCAN_ENABLED=true

# Python security scan rules (comma-separated: semgrep,snyk,trivy)
PYTHON_SECURITY_SCAN_TOOLS="semgrep"

# Enable Python code linting
PYTHON_LINT_ENABLED=true

# Python linting tools (comma-separated: pylint,flake8,black)
PYTHON_LINT_TOOLS="flake8"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
