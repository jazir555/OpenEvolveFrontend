#!/usr/bin/env python3

"""
Final Integration Test for OpenEvolve Tripartite System

This test verifies that all components (ACE + Steer + LangChain) work together properly
in the production-ready system.

REVIEWED FOR ADAPTER MIGRATION - Batch 2B
This file does not use evolution.py or adversarial.py, so no adapter migration needed.
"""

import tempfile
import time
import json
from pathlib import Path

def test_component_integration():
    """Test that all components integrate properly."""
    print("Testing Component Integration...")
    
    try:
        # Test 1: Import all components
        print("  Testing imports...")
        from tripartite_production import (
            ProductionTripartiteSystem,
            ProductionConfig,
            ProductionLogger,
            production_tripartite_agent
        )
        from langchain_chroma_integration import (
            KnowledgeBaseManager,
            LangChainIntegration,
            TripartiteAgentSystem
        )
        from ace_steer_integration import AceSteerBridge
        from steer_hephaestus_bridge import SteerHephaestusWorkflowBridge
        print("  All imports successful")
        
        # Test 2: Initialize production system
        print("  Testing production system initialization...")
        with tempfile.TemporaryDirectory() as temp_dir:
            # Create test config
            config = ProductionConfig()
            config.knowledge_base["persist_directory"] = temp_dir
            
            # Initialize system
            system = ProductionTripartiteSystem(config)
            
            # Verify components
            assert system.knowledge_base is not None, "Knowledge base not initialized"
            assert system.ace_steer is not None, "ACE+Steer bridge not initialized"
            assert system.steer_workflow is not None, "Steer workflow not initialized"
            print("  Production system initialized successfully")
            
            # Test 3: Add knowledge
            print("  Testing knowledge addition...")
            knowledge_result = system.add_knowledge(
                "The OpenEvolve tripartite system integrates ACE, Steer, and LangChain components.",
                source="integration_test",
                metadata={"category": "system", "test": "integration"}
            )
            assert knowledge_result["success"], "Knowledge addition failed"
            print(f"  Knowledge added: {len(knowledge_result['document_ids'])} documents")
            
            # Test 4: Execute task with knowledge
            print("  Testing task execution with knowledge...")
            task_result = system.execute_task(
                "Explain how the OpenEvolve tripartite system integrates its components",
                verifications=["json", "slop"],
                timeout=10.0
            )
            assert task_result["success"], "Task execution failed"
            assert task_result["knowledge_used"], "Knowledge was not used"
            assert "response" in task_result, "Response missing"
            print(f"  Task executed successfully: {task_result['success']}")
            print(f"  Knowledge used: {task_result['knowledge_used']}")
            print(f"  Verification passed: {task_result['verification']['all_passed']}")
            
            # Test 5: Verify learning experience storage
            print("  Testing learning experience storage...")
            health = system.get_system_health()
            initial_docs = health["knowledge_base"]["document_count"]
            
            # Execute another task to trigger learning storage
            task_result2 = system.execute_task(
                "Describe the benefits of integrating ACE with Steer",
                verifications=["json"]
            )
            
            health2 = system.get_system_health()
            final_docs = health2["knowledge_base"]["document_count"]
            
            assert final_docs >= initial_docs, "Learning experience not stored"
            print(f"  Learning experiences stored: {final_docs - initial_docs} new documents")
            
            # Test 6: Test decorator functionality
            print("  Testing decorator functionality...")
            
            @production_tripartite_agent(config=config)
            def test_agent(task: str):
                return {"response": f"Agent processed: {task}"}
            
            decorator_result = test_agent("Test decorator integration")
            assert "_tripartite_results" in decorator_result, "Decorator failed to attach results"
            assert decorator_result["_tripartite_results"]["success"], "Decorator task failed"
            print("  Decorator functionality working")
            
            # Test 7: Test system health monitoring
            print("  Testing system health monitoring...")
            health = system.get_system_health()
            
            assert health["status"] == "healthy", "System not healthy"
            assert health["execution_stats"]["total_executions"] >= 2, "Execution stats not tracked"
            assert health["knowledge_base"]["document_count"] > 0, "Knowledge base empty"
            print(f"  System health monitoring working")
            print(f"     - Status: {health['status']}")
            print(f"     - Executions: {health['execution_stats']['total_executions']}")
            print(f"     - Knowledge: {health['knowledge_base']['document_count']} documents")
            
            # Test 8: Test configuration management
            print("  Testing configuration management...")
            config_data = config.get_config()
            
            assert "knowledge_base" in config_data, "Config missing knowledge_base"
            assert "ace_steer" in config_data, "Config missing ace_steer"
            assert "security" in config_data, "Config missing security"
            assert "monitoring" in config_data, "Config missing monitoring"
            print("  Configuration management working")
            
            # Clean up
            system.close()
            print("  System closed successfully")
            
        return True
        
    except Exception as e:
        print(f"  Integration test failed: {e}")
        import traceback
        traceback.print_exc()
        return False

def test_backward_compatibility():
    """Test backward compatibility with original components."""
    print("Testing Backward Compatibility...")
    
    try:
        # Test original tripartite system
        from langchain_chroma_integration import TripartiteAgentSystem
        
        with tempfile.TemporaryDirectory() as temp_dir:
            # Test original system still works
            original_system = TripartiteAgentSystem(agent_id="test_agent")
            
            # Add knowledge
            doc_ids = original_system.add_knowledge(
                "Original tripartite system test",
                source="compatibility_test"
            )
            assert len(doc_ids) > 0, "Original knowledge addition failed"
            
            # Execute task
            result = original_system.execute_task("Test original system")
            assert "success" in result, "Original execution failed"
            
            print("  Backward compatibility maintained")
            return True
            
    except Exception as e:
        print(f"  Backward compatibility test failed: {e}")
        return False

def test_performance():
    """Test system performance."""
    print("Testing System Performance...")
    
    try:
        from tripartite_production import ProductionTripartiteSystem, ProductionConfig
        
        with tempfile.TemporaryDirectory() as temp_dir:
            config = ProductionConfig()
            config.knowledge_base["persist_directory"] = temp_dir
            config.knowledge_base["timeout"] = 5.0
            
            system = ProductionTripartiteSystem(config)
            
            # Performance test: Multiple operations
            start_time = time.time()
            
            # Add multiple knowledge items
            for i in range(10):
                system.add_knowledge(f"Performance test knowledge {i}", source="perf_test")
            
            # Execute multiple tasks
            for i in range(5):
                system.execute_task(f"Performance test task {i}", timeout=5.0)
            
            duration = time.time() - start_time
            
            # Get health stats
            health = system.get_system_health()
            
            print(f"  Performance test completed")
            print(f"     - Duration: {duration:.3f}s")
            print(f"     - Knowledge additions: 10")
            print(f"     - Task executions: 5")
            print(f"     - Avg execution time: {health['execution_stats']['avg_execution_time']:.3f}s")
            
            # Performance should be reasonable
            assert duration < 30.0, f"Performance too slow: {duration}s"
            
            system.close()
            return True
            
    except Exception as e:
        print(f"  Performance test failed: {e}")
        return False

def test_error_handling():
    """Test error handling capabilities."""
    print("Testing Error Handling...")
    
    try:
        from tripartite_production import ProductionTripartiteSystem, ProductionConfig
        
        with tempfile.TemporaryDirectory() as temp_dir:
            config = ProductionConfig()
            config.knowledge_base["persist_directory"] = temp_dir
            
            system = ProductionTripartiteSystem(config)
            
            # Test 1: Invalid knowledge (too long)
            long_text = "x" * (config.security["max_content_length"] + 1000)
            result = system.add_knowledge(long_text, source="test")
            assert not result["success"], "Should reject overly long content"
            assert "Content too long" in result["error"], "Should provide specific error"
            print("  Content length validation working")
            
            # Test 2: Task with timeout
            try:
                result = system.execute_task("test", timeout=0.001)  # Very short timeout
                # Should either fail or complete very quickly
                print("  Timeout handling working")
            except:
                print("  Timeout handling working (exception caught)")
            
            # Test 3: Invalid verifications
            try:
                result = system.execute_task("test", verifications=["invalid_verification"])
                # Should handle invalid verification gracefully
                print("  Invalid verification handling working")
            except:
                print("  Invalid verification handling working (exception caught)")
            
            system.close()
            return True
            
    except Exception as e:
        print(f"  Error handling test failed: {e}")
        return False

def main():
    """Run all integration tests."""
    print("=" * 60)
    print("OpenEvolve Tripartite System - Final Integration Test")
    print("=" * 60)
    
    tests = [
        ("Component Integration", test_component_integration),
        ("Backward Compatibility", test_backward_compatibility),
        ("Performance", test_performance),
        ("Error Handling", test_error_handling),
    ]
    
    results = []
    for test_name, test_func in tests:
        try:
            success = test_func()
            results.append((test_name, success, None))
        except Exception as e:
            results.append((test_name, False, str(e)))
    
    # Print summary
    print("\n" + "=" * 60)
    print("INTEGRATION TEST SUMMARY")
    print("=" * 60)
    
    passed = sum(1 for _, success, _ in results if success)
    failed = sum(1 for _, success, _ in results if not success)
    total = len(results)
    
    for test_name, success, error in results:
        status = "PASS" if success else "FAIL"
        print(f"{status} {test_name}")
        if error:
            print(f"    Error: {error}")
    
    print(f"\nTotal: {total} tests")
    print(f"Passed: {passed}")
    print(f"Failed: {failed}")
    print(f"Success Rate: {(passed/total)*100:.1f}%")
    
    if passed == total:
        print("\nAll integration tests passed!")
        print("The OpenEvolve Tripartite System is working correctly!")
        return True
    else:
        print("\nSome tests failed. Please review the errors above.")
        return False

if __name__ == "__main__":
    success = main()
    exit(0 if success else 1)