# =============================================================================
# Adaptive MDAP/MAKER Adapter Environment Configuration
# =============================================================================
# Federation Constitution - Law 5: Configuration Explicitness
# "No Magic Defaults. Every configurable value must be injected via Environment Variables."
#
# Copy this file to .env and configure your values.
# Service will crash immediately if required values are missing.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED Configuration
# -----------------------------------------------------------------------------

# Request timeout in milliseconds
# Service CANNOT START without this value
ADAPTIVE_MDAP_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# OPTIONAL Configuration (with defaults)
# -----------------------------------------------------------------------------

# Maximum number of retry attempts for failed operations
# Default: 3
ADAPTIVE_MDAP_MAX_RETRIES=3

# Initial retry delay in milliseconds (exponential backoff)
# Default: 100
ADAPTIVE_MDAP_RETRY_DELAY_MS=100

# Number of failures before circuit breaker opens
# Default: 5
ADAPTIVE_MDAP_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker open timeout in milliseconds
# Default: 60000 (60 seconds)
ADAPTIVE_MDAP_CIRCUIT_BREAKER_TIMEOUT_MS=60000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
ADAPTIVE_MDAP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional: External Service Configuration
# -----------------------------------------------------------------------------

# MAKER API configuration (if using external MAKER service)
# MAKER_API_BASE_URL=http://localhost:8001
# MAKER_API_KEY=your-api-key-here

# Monitoring (optional)
# PROMETHEUS_PORT=9090
# HEALTH_CHECK_PORT=8080
