{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/components",
    "declaration": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/lib/**/*.ts",
    "src/hooks/**/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/tests/**"
  ]
}
