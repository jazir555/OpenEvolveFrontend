# Graphiti Adapter Environment Configuration
#
# Following CLAUDE.md: Law of Configuration Explicitness
# All configuration must be via environment variables - no magic defaults

# =============================================================================
# REQUIRED: Neo4j Configuration
# =============================================================================

# Neo4j connection URI
# Default: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687

# Neo4j username
# Default: neo4j
NEO4J_USER=neo4j

# Neo4j password
# REQUIRED - no default
NEO4J_PASSWORD=your_neo4j_password

# =============================================================================
# OPTIONAL: LLM Configuration (for entity extraction)
# =============================================================================

# OpenAI API Key (for GPT-4 based entity extraction)
# If not provided, Graphiti will use mock extraction
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (alternative to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# =============================================================================
# OPTIONAL: Adapter Configuration
# =============================================================================

# Graphiti API URL (if using REST API wrapper)
# Default: http://localhost:8000
GRAPHITI_API_URL=http://localhost:8000

# Request timeout in milliseconds
# Default: 30000 (30 seconds)
TIMEOUT_MS=30000

# Maximum retry attempts for transient failures
# Default: 3
MAX_RETRIES=3

# Retry delay in milliseconds (before exponential backoff)
# Default: 1000 (1 second)
RETRY_DELAY_MS=1000

# Circuit breaker failure threshold
# Default: 5 (trips after 5 consecutive failures)
CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker timeout in milliseconds
# Default: 60000 (60 seconds)
CIRCUIT_BREAKER_TIMEOUT_MS=60000

# =============================================================================
# OPTIONAL: Logging Configuration
# =============================================================================

# Log level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Enable JSON Lines logging (structured logging)
# Default: true
LOG_JSONL=true

# =============================================================================
# OPTIONAL: Feature Flags
# =============================================================================

# Enable community detection (computationally expensive)
# Default: false
UPDATE_COMMUNITIES=false

# Store raw episode content
# Default: true
STORE_RAW_EPISODES=true

# Enable OpenTelemetry tracing
# Default: false
ENABLE_TRACING=false

# =============================================================================
# TESTING ONLY
# =============================================================================

# Skip integration tests
# Default: false
SKIP_INTEGRATION_TESTS=false
