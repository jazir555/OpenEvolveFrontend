{
  "compilerOptions": {
    // Module resolution
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022"],

    // Path resolution
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@openevolve/*": ["../../adapters/*/src"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    // Output
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    // Type checking
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    // Advanced
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowJs": false,

    // Emit
    "newLine": "lf",
    "stripInternal": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
