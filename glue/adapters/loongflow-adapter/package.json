{
  "name": "@loongflow/loongflow-adapter",
  "version": "1.0.0",
  "description": "LoongFlow PES Agent Adapter - Integrates evolutionary AI capabilities into the federation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:contract": "jest tests/contract.test.ts",
    "test:contract:runner": "ts-node tests/contract-runner.ts",
    "test:contract:quick": "jest tests/contract.test.ts --testNamePattern='Environment|Fixture'",
    "test:contract:ci": "ts-node tests/contract-runner.ts",
    "clean": "rm -rf dist build .jest-cache",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "loongflow",
    "pes",
    "evolutionary",
    "adapter",
    "federation",
    "ai"
  ],
  "author": "OpenEvolve Federation",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "uuid": "^9.0.1",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
