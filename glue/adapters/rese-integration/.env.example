# ============================================================================
# RESE Framework - Environment Configuration
# ============================================================================
# This file contains ALL configuration for the RESE (Rational Epistemic
# Synthesis Engine) integration adapter. Following the "Law of Configuration
# Explicitness", there are NO magic defaults. All values must be explicitly
# configured.
#
# Validation: The adapter will CRASH at startup if required variables are missing.
# Units: Always specified (ms, seconds, count, etc.)
# ============================================================================

# ----------------------------------------------------------------------------
# GENERAL CONFIGURATION
# ----------------------------------------------------------------------------

# RESE Adapter Mode: development, staging, or production
# Required: Yes
# Validation: Must be one of [development, staging, production]
RESE_ENV=development

# Log level for structured logging (JSON Lines format)
# Required: Yes
# Validation: Must be one of [DEBUG, INFO, WARN, ERROR, CRITICAL]
RESE_LOG_LEVEL=INFO

# Correlation ID for request tracing (in production, this is injected)
# Required: Yes
# Validation: UUID v4 format or any unique string
RESE_CORRELATION_ID=local-dev-session

# ----------------------------------------------------------------------------
# PHASE I: EPISTEMIC AUDIT
# ----------------------------------------------------------------------------
# Purpose: Extract and validate assumptions from problem description
# Goal: Identify explicit, tacit, and conflicting assumptions
# ----------------------------------------------------------------------------

# Timeout for Phase I execution (milliseconds)
# Required: Yes
# Min: 1000 (1 second), Max: 300000 (5 minutes)
# Recommendation: 30000 for development, 60000 for production
PHASE1_TIMEOUT_MS=30000

# Maximum number of assumptions to extract per problem
# Required: Yes
# Min: 10, Max: 1000
# Recommendation: 100 for development, 500 for production
PHASE1_MAX_ASSUMPTIONS=100

# Minimum confidence threshold for assumption extraction (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# Recommendation: 0.6 for development, 0.8 for production
# Assumptions below this threshold are flagged for manual review
PHASE1_MIN_ASSUMPTION_CONFIDENCE=0.6

# Circuit breaker threshold for Phase I failures (count)
# Required: Yes
# Min: 1, Max: 100
# If Phase I fails this many times consecutively, the circuit opens
# and prevents further calls until reset
PHASE1_CIRCUIT_BREAKER_THRESHOLD=5

# Enable tacit assumption mining (extract unstated assumptions)
# Required: Yes
# Validation: true or false
# Uses LLM-based inference to identify assumptions not explicitly stated
PHASE1_ENABLE_TACIT_MINING=true

# Enable red team mode (actively search for contradicting assumptions)
# Required: Yes
# Validation: true or false
# Runs adversarial search to find assumptions that contradict each other
PHASE1_ENABLE_RED_TEAM=true

# Enable Lean4 formal verification integration
# Required: Yes
# Validation: true or false
# If true, attempts to verify assumptions in Lean4 theorem prover
# Requires LEAN4_EXEC_PATH to be set
PHASE1_ENABLE_LEAN4_INTEGRATION=false

# Path to Lean4 executable (required if LEAN4_INTEGRATION enabled)
# Required: Only if PHASE1_ENABLE_LEAN4_INTEGRATION=true
# Validation: Must be valid executable path
LEAN4_EXEC_PATH=/usr/local/bin/lean

# ----------------------------------------------------------------------------
# PHASE II: ISOMORPHIC MAPPING
# ----------------------------------------------------------------------------
# Purpose: Map problem domain to target solution domains
# Goal: Find isomorphic structures between different domains
# ----------------------------------------------------------------------------

# Timeout for Phase II execution (milliseconds)
# Required: Yes
# Min: 1000, Max: 600000 (10 minutes)
# Recommendation: 60000 for development, 120000 for production
PHASE2_TIMEOUT_MS=60000

# IMech (Isomorphism Engine) threshold for domain matching (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# Higher values = stricter matching (fewer but higher quality mappings)
# Recommendation: 0.5 for development, 0.7 for production
PHASE2_IMECH_THRESHOLD=0.5

# Maximum number of target domains to search for isomorphisms
# Required: Yes
# Min: 1, Max: 50
# Limits the search space to prevent combinatorial explosion
# Recommendation: 5 for development, 10 for production
PHASE2_MAX_TARGET_DOMAINS=5

# Pattern matching threshold (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# Controls how closely patterns must match to be considered isomorphic
# Recommendation: 0.6 for development, 0.8 for production
PHASE2_PATTERN_THRESHOLD=0.6

# Maximum number of isomorphic mappings to generate
# Required: Yes
# Min: 1, Max: 1000
# Limits output size to prevent overwhelming downstream phases
# Recommendation: 20 for development, 100 for production
PHASE2_MAX_MAPPINGS=20

# Enable constraint inversion (reverse engineering constraints)
# Required: Yes
# Validation: true or false
# If true, inverts constraints to find anti-isomorphisms (things that DON'T match)
PHASE2_ENABLE_CONSTRAINT_INVERSION=true

# Search depth for isomorphic mapping (tree depth)
# Required: Yes
# Min: 1, Max: 20
# Deeper search = more comprehensive but exponentially slower
# Recommendation: 3 for development, 5 for production
PHASE2_SEARCH_DEPTH=3

# ----------------------------------------------------------------------------
# PHASE III: MCTS SEARCH
# ----------------------------------------------------------------------------
# Purpose: Monte Carlo Tree Search for solution space exploration
# Goal: Find optimal synthesis paths through intelligent sampling
# ----------------------------------------------------------------------------

# Timeout for Phase III execution (milliseconds)
# Required: Yes
# Min: 1000, Max: 3600000 (1 hour)
# Recommendation: 120000 for development, 300000 for production
PHASE3_TIMEOUT_MS=120000

# Number of MCTS iterations to run (will be limited by timeout)
# Required: Yes
# Min: 100, Max: 10000000
# Acts as a soft limit; actual iterations depend on timeout
# Recommendation: 10000 for development, 100000 for production
PHASE3_ITERATIONS=10000

# UCB1 exploration constant (C parameter)
# Required: Yes
# Min: 0.0, Max: 10.0
# Higher values = more exploration (trying new nodes)
# Lower values = more exploitation (refining known good nodes)
# Standard value from literature: sqrt(2) ≈ 1.414
# Recommendation: 1.414 for most cases
PHASE3_UCB1_C=1.414

# Convergence threshold (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# MCTS stops early if improvement between iterations falls below this threshold
# Recommendation: 0.001 for development, 0.0001 for production
PHASE3_CONVERGENCE_THRESHOLD=0.001

# ACI (Adaptive Confidence Integration) window size (iterations)
# Required: Yes
# Min: 10, Max: 10000
# Number of iterations to average for confidence estimation
# Recommendation: 1000 for development, 5000 for production
PHASE3_ACI_WINDOW=1000

# Significance threshold for statistical tests (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# Used in Hoeffding bounds for node selection
# Recommendation: 0.05 for development, 0.01 for production
PHASE3_SIG_THRESHOLD=0.05

# Number of parallel workers for MCTS simulation
# Required: Yes
# Min: 1, Max: 64
# Recommendation: CPU count for production, 4 for development
PHASE3_PARALLEL_WORKERS=4

# ----------------------------------------------------------------------------
# PHASE IV: ARCHITECTURE ASSEMBLY
# ----------------------------------------------------------------------------
# Purpose: Assemble final solution from selected components
# Goal: Produce validated, coherent architecture
# ----------------------------------------------------------------------------

# Timeout for Phase IV execution (milliseconds)
# Required: Yes
# Min: 1000, Max: 300000 (5 minutes)
# Recommendation: 30000 for development, 60000 for production
PHASE4_TIMEOUT_MS=30000

# Beam width for beam search (number of candidates to maintain)
# Required: Yes
# Min: 1, Max: 100
# Wider beam = more options but slower
# Recommendation: 5 for development, 10 for production
PHASE4_BEAM_WIDTH=5

# Validation level: 0=none, 1=syntax, 2=semantic, 3=full
# Required: Yes
# Min: 0, Max: 3
# Level 0: No validation (fastest)
# Level 1: Syntax/type checking only
# Level 2: Semantic validation (logical consistency)
# Level 3: Full formal verification (slowest)
# Recommendation: 2 for development, 3 for production
PHASE4_VALIDATION_LEVEL=2

# Integration strategy: conservative, balanced, aggressive
# Required: Yes
# Validation: Must be one of [conservative, balanced, aggressive]
# Conservative: Only integrate components with 100% confidence
# Balanced: Integrate components with 80%+ confidence
# Aggressive: Integrate all viable components (higher risk, higher reward)
PHASE4_INTEGRATION_STRATEGY=balanced

# Minimum confidence threshold for component inclusion (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# Components below this threshold are excluded from final architecture
# Recommendation: 0.7 for development, 0.85 for production
PHASE4_MIN_CONFIDENCE_THRESHOLD=0.7

# ----------------------------------------------------------------------------
# SUPPORTING COMPONENTS: LLTL (Lean Temporal Logic)
# ----------------------------------------------------------------------------
# Purpose: Encode temporal logic constraints for verification
# Goal: Ensure temporal consistency of synthesized solution
# ----------------------------------------------------------------------------

# Dimension for LLTL encoding (vector size for embeddings)
# Required: Yes
# Min: 64, Max: 4096
# Recommendation: 512 for development, 1024 for production
# Must be power of 2 for some implementations
LLTL_ENCODING_DIM=512

# Default loss type for LLTL training: cross_entropy, mse, hinge
# Required: Yes
# Validation: Must be one of [cross_entropy, mse, hinge]
# Loss function used in learning temporal patterns
LLTL_DEFAULT_LOSS_TYPE=cross_entropy

# Contradiction detection threshold (0.0 to 1.0)
# Required: Yes
# Min: 0.0, Max: 1.0
# If two temporal constraints have similarity below this threshold, they contradict
# Recommendation: 0.3 for development, 0.2 for production
LLTL_CONTRADICTION_THRESHOLD=0.3

# Timeout for LLTL operations (milliseconds)
# Required: Yes
# Min: 100, Max: 60000 (1 minute)
# Recommendation: 5000 for development, 10000 for production
LLTL_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# EXTERNAL SERVICE CONNECTIONS
# ----------------------------------------------------------------------------

# OpenAI API Key (for LLM-based assumption extraction)
# Required: Yes, unless using local LLM
# Validation: Must start with "sk-"
OPENAI_API_KEY=sk-your-key-here

# OpenAI Model to use
# Required: Yes (if using OpenAI)
# Recommendation: gpt-4 for production, gpt-3.5-turbo for development
OPENAI_MODEL=gpt-4

# Alternative: Local LLM endpoint (e.g., Ollama)
# Required: Only if not using OpenAI
# Example: http://localhost:11434/api/generate
LOCAL_LLM_ENDPOINT=

# Redis URL for caching intermediate results
# Required: Yes
# Format: redis://[user:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis key TTL (seconds)
# Required: Yes
# Min: 60, Max: 604800 (7 days)
# Recommendation: 3600 (1 hour) for development, 86400 (1 day) for production
REDIS_KEY_TTL=3600

# ----------------------------------------------------------------------------
# TELEMETRY & OBSERVABILITY
# ----------------------------------------------------------------------------

# Enable Prometheus metrics export
# Required: Yes
# Validation: true or false
ENABLE_METRICS=true

# Prometheus metrics port
# Required: Only if ENABLE_METRICS=true
# Min: 1024, Max: 65535
METRICS_PORT=9090

# Enable distributed tracing (e.g., Jaeger)
# Required: Yes
# Validation: true or false
ENABLE_TRACING=false

# Jaeger endpoint (if tracing enabled)
# Required: Only if ENABLE_TRACING=true
# Format: http://host:port/api/traces
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ----------------------------------------------------------------------------
# FAILURE HANDLING
# ----------------------------------------------------------------------------

# Enable circuit breakers for all phases
# Required: Yes
# Validation: true or false
# If true, prevents cascading failures by stopping calls to failing phases
ENABLE_CIRCUIT_BREAKERS=true

# Circuit breaker reset timeout (milliseconds)
# Required: Only if ENABLE_CIRCUIT_BREAKERS=true
# Min: 1000, Max: 3600000 (1 hour)
# Time to wait before attempting to close an open circuit
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000

# Enable retry logic for transient failures
# Required: Yes
# Validation: true or false
ENABLE_RETRY=true

# Maximum retry attempts
# Required: Only if ENABLE_RETRY=true
# Min: 1, Max: 10
# Recommendation: 3 for most cases
MAX_RETRY_ATTEMPTS=3

# Retry base delay (milliseconds)
# Required: Only if ENABLE_RETRY=true
# Min: 100, Max: 10000
# Uses exponential backoff: delay = base_delay * 2^(attempt-1)
RETRY_BASE_DELAY_MS=1000

# Enable Dead Letter Queue for failed messages
# Required: Yes
# Validation: true or false
# If true, failed operations are sent to DLQ for manual inspection
ENABLE_DLQ=true

# Dead Letter Queue topic/queue name
# Required: Only if ENABLE_DLQ=true
DLQ_NAME=rese-failures

# ----------------------------------------------------------------------------
# ADVANCED CONFIGURATION
# ----------------------------------------------------------------------------

# Enable deterministic mode (for testing)
# Required: No
# Validation: true or false
# If true, uses fixed seeds for reproducible results
# Default: false (random seeds for production)
DETERMINISTIC_MODE=false

# Random seed (if DETERMINISTIC_MODE=true)
# Required: Only if DETERMINISTIC_MODE=true
# Min: 0, Max: 2147483647
RANDOM_SEED=42

# Enable profile logging (performance metrics)
# Required: No
# Validation: true or false
# If true, logs detailed timing for each operation
# Default: false
ENABLE_PROFILING=false

# Maximum memory usage (MB)
# Required: Yes
# Min: 128, Max: 65536
# Adapter will crash if memory usage exceeds this threshold
# Recommendation: 2048 for development, 8192 for production
MAX_MEMORY_MB=2048

# ============================================================================
# VALIDATION RULES
# ============================================================================
# At startup, the adapter will validate:
# 1. All required variables are present
# 2. All numeric values are within min/max ranges
# 3. All enum values match allowed options
# 4. All URLs are well-formed
# 5. All file paths are accessible
#
# If validation fails, the adapter will:
# - Log a detailed error message
# - Exit with code 1
# - NOT start with partial configuration
# ============================================================================
