{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "react": ["../../bubblelab/node_modules/react"],
      "react-dom": ["../../bubblelab/node_modules/react-dom"],
      "react/jsx-runtime": ["../../bubblelab/node_modules/react/jsx-runtime"]
    }
  },
  "include": [
    "src/index.ts",
    "src/types/plugin-types.ts",
    "src/components/RomaConfigPanel.tsx",
    "src/utils/createRomaPlugin.ts",
    "src/optional-ui-deps.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
