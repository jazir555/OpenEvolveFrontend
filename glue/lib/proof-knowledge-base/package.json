{
  "name": "@openevolve/proof-knowledge-base",
  "version": "1.0.0",
  "description": "Centralized proof knowledge base for storing, searching, and reusing formal proofs from Z3 and LeanAide",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "formal-verification",
    "proof-assistant",
    "z3",
    "leanaide",
    "theorem-proving",
    "knowledge-graph",
    "vector-search",
    "semantic-search",
    "proof-reuse",
    "mathematical-knowledge"
  ],
  "author": "OpenEvolve",
  "license": "MIT",
  "dependencies": {
    "@openevolve/glue-lib": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@openevolve/glue-lib": "^1.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openevolve/proof-knowledge-base"
  },
  "bugs": {
    "url": "https://github.com/openevolve/proof-knowledge-base/issues"
  },
  "homepage": "https://github.com/openevolve/proof-knowledge-base#readme"
}
