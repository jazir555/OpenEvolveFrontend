{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "logger.ts",
    "retry.ts",
    "circuit-breaker.ts",
    "env-validator.ts",
    "idempotency.ts",
    "timestampUtils.ts",
    "inputValidation.ts",
    "health-check.ts",
    "configValidation.ts",
    "startup-validation.ts",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.contract.test.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "event-enabled-adapter.ts",
    "metrics",
    "evolved-code-capture",
    "proof-knowledge-base",
    "unified-knowledge-query",
    "rese-sce.ts",
    "example.ts",
    "circuitBreaker.ts",
    "structuredLogger.ts"
  ],
  "references": []
}
