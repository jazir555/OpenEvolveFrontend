{
  "name": "@openevolve/unified-knowledge-query",
  "version": "1.0.0",
  "description": "Unified Knowledge Query Interface - Federation Constitution compliant multi-system query engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "probe:ragbits": "bash probes/check_ragbits.sh",
    "probe:graphiti": "bash probes/check_graphiti.sh",
    "probe:vectordb": "bash probes/check_vectordb.sh",
