{
  "name": "@glue/unified-verification",
  "version": "1.0.0",
  "description": "Unified verification orchestrator for cross-validation between Z3 and LeanAide",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:contract": "jest tests/contract.test.ts",
    "probe:z3": "bash probes/check_z3.sh",
    "probe:leanaide": "bash probes/check_leanaide.sh",
    "probe:cross": "bash probes/check_cross_validation.sh",
    "probes": "npm run probe:z3 && npm run probe:leanaide && npm run probe:cross"
  },
  "keywords": [
    "verification",
    "z3",
    "leanaide",
    "formal-methods",
    "orchestration"
  ],
  "author": "OpenEvolve Glue Layer",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4",
    "axios": "^1.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
