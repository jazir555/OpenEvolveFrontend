# OpenEvolve Federation Environment Configuration Template
#
# Following CLAUDE.md - Law of Configuration Explicitness:
# - All values must be explicitly configured
# - NO magic defaults - if a value is missing, the service will crash
# - Copy this file to .env and fill in all required values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual configuration
#   docker-compose -f docker-compose-all-adapters.yml up -d

# ========================================
# Infrastructure Ports
# ========================================
REDIS_PORT=6379
ORCHESTRATOR_PORT=8080

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# Python Adapters
# ========================================

# Curie-GlobalChem Integration
CURIE_GLOBALCHEM_PORT=5000
CURIE_GLOBALCHEM_API_URL=http://curie-core:8000
CURIE_GLOBALCHEM_API_KEY=your-curie-api-key-here
CURIE_GLOBALCHEM_TIMEOUT_MS=30000
CURIE_GLOBALCHEM_MAX_RETRIES=3

# LMQL-DSPY Integration
LMQL_DSPY_PORT=5001
LMQL_DSPY_API_URL=http://lmql-core:8000
LMQL_DSPY_API_KEY=your-lmql-api-key-here
LMQL_DSPY_TIMEOUT_MS=30000
LMQL_DSPY_MAX_RETRIES=3

# RESE DEE (Deep Exploration Engine)
RESE_DEE_PORT=8001
RESE_DEE_EXPLORATION_DEPTH=10
RESE_DEE_MCTS_ITERATIONS=1000
RESE_DEE_MCTS_EXPLORATION_CONSTANT=1.414
RESE_DEE_CONVERGENCE_THRESHOLD=0.001
RESE_DEE_EXPLORATION_TIMEOUT_MS=10000
RESE_DEE_MAX_HYPOTHESES=100
RESE_DEE_PATTERN_RECOGNITION_THRESHOLD=0.7

# RESE LLTL (Lean Latent Transformation Layer)
RESE_LLTDL_PORT=8002
RESE_LLTDL_ENCODING_DIM=128
RESE_LLTDL_USE_POSITIONAL=true
RESE_LLTDL_USE_TYPE_EMBEDDING=true
RESE_LLTDL_USE_CATEGORY_EMBEDDING=true
RESE_LLTDL_MAX_SEQUENCE_LENGTH=512
RESE_LLTDL_CACHE_SIZE=1000
RESE_LLTDL_DEFAULT_LOSS_TYPE=mse
RESE_LLTDL_COMBINATION_STRATEGY=weighted_sum
RESE_LLTDL_NORMALIZE_WEIGHTS=true
RESE_LLTDL_LEARNING_RATE=0.001
RESE_LLTDL_TIMEOUT_MS=3000
RESE_LLTDL_ENABLE_RTREE=false
RESE_LLTDL_ENABLE_LSH=false
RESE_LLTDL_ENABLE_HAG=false
RESE_LLTDL_CONTRADICTION_THRESHOLD=0.8
RESE_LLTDL_MAX_CONTRADICTIONS=1000

# RESE SCE (Symbolic Constraint Engine)
RESE_SCE_PORT=8003
RESE_SCE_CONTRADICTION_DETECTION=true
RESE_SCE_FORMAL_VERIFICATION=true
RESE_SCE_TIMEOUT_MS=5000

# RESE Phase 2
RESE_PHASE2_PORT=8004

# RESE Phase 4
RESE_PHASE4_PORT=8006

# RESE Verification
RESE_VERIFICATION_PORT=8007

# RESE Z3 Bridge
RESE_Z3_BRIDGE_PORT=8008
Z3_SOLVER_PATH=/usr/bin/z3
Z3_TIMEOUT_MS=30000
Z3_MAX_MEMORY_MB=4096
Z3_MAX_RETRIES=3

# RESE LeanAide Workflow
RESE_LEANAIDE_WORKFLOW_PORT=8009
RESE_LEANAIDE_API_URL=http://leanaide-core:8000
RESE_LEANAIDE_TIMEOUT_MS=30000
RESE_LEANAIDE_MAX_RETRIES=3

# ========================================
# TypeScript/Node.js Adapters
# ========================================

# BubbleLab Adapter
BUBBLELAB_PORT=3001
BUBBLELAB_API_URL=http://bubblelab-core:8000
BUBBLELAB_API_KEY=your-bubblelab-api-key-here
BUBBLELAB_TIMEOUT_MS=30000
BUBBLELAB_MAX_RETRIES=3

# Graphiti Adapter
GRAPHITI_PORT=3000
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
OPENAI_API_KEY=your-openai-api-key-here
GRAPHITI_TIMEOUT_MS=30000

# ICR Adapter
ICR_PORT=3002
ICR_API_URL=http://icr-core:8000
ICR_API_KEY=your-icr-api-key-here
ICR_TIMEOUT_MS=30000
ICR_MAX_RETRIES=3
ICR_RETRY_DELAY_MS=1000

# LeanAide Adapter
LEANAIDE_PORT=3006
LEANAIDE_API_URL=http://leanaide-core:8000
LEANAIDE_TIMEOUT_MS=30000
LEANAIDE_MAX_RETRIES=3

# OpenEvolve Adapter
OPENEVOLVE_PORT=3003
OPENEVOLVE_API_URL=http://openevolve-core:8000
OPENEVOLVE_API_KEY=your-openevolve-api-key-here
OPENEVOLVE_TIMEOUT_MS=30000
OPENEVOLVE_MAX_RETRIES=3

# RagBits-Graphiti Sync
RAGBITS_GRAPHITI_SYNC_PORT=3010
RAGBITS_API_URL=http://ragbits-core:8000
GRAPHITI_API_URL=http://graphiti:3000
RAGBITS_GRAPHITI_SYNC_TIMEOUT_MS=30000
RAGBITS_GRAPHITI_SYNC_INTERVAL_MS=60000

# VectorDB Adapter
VECTORDB_PORT=3004
VECTORDB_TYPE=pinecone
VECTORDB_API_URL=https://your-pinecone-instance.pinecone.io
VECTORDB_API_KEY=your-pinecone-api-key-here
VECTORDB_TIMEOUT_MS=30000
VECTORDB_MAX_RETRIES=3

# Z3 Adapter
Z3_PORT=3005
Z3_SOLVER_PATH=/usr/bin/z3
Z3_TIMEOUT_MS=30000
Z3_MAX_MEMORY_MB=4096
Z3_MAX_RETRIES=3

# LoongFlow Adapter
LOONGFLOW_PORT=8040
LOONGFLOW_API_URL=http://loongflow-core:8050
LOONGFLOW_TIMEOUT_MS=30000
LOONGFLOW_MAX_RETRIES=3
LOONGFLOW_MAX_CONCURRENT_WORKFLOWS=5
LOONGFLOW_ENABLE_CHECKPOINTING=true
LOONGFLOW_ENABLE_HYBRID=true
LOONGFLOW_ENABLE_PES_FALLBACK=true
LOONGFLOW_PES_TIMEOUT_MS=60000
LOONGFLOW_PES_MAX_ITERATIONS=10

# LoongFlow Core Service
LOONGFLOW_CORE_PORT=8050
LOONGFLOW_LLM_PROVIDER=openai
LOONGFLOW_LLM_API_KEY=your-openai-api-key-here
LOONGFLOW_LLM_MODEL=gpt-4
LOONGFLOW_LLM_TEMPERATURE=0.7
LOONGFLOW_LLM_MAX_TOKENS=2000
LOONGFLOW_LOG_LEVEL=INFO
LOONGFLOW_REDIS_URL=redis://event-bus:6379
LOONGFLOW_ENABLE_CHECKPOINTING=true
LOONGFLOW_MAX_CONCURRENT_WORKFLOWS=10
LOONGFLOW_WORKFLOW_TIMEOUT_MS=300000
LOONGFLOW_ENABLE_PRUNING=true
LOONGFLOW_PRUNING_THRESHOLD=1000
LOONGFLOW_ENABLE_PES=false
LOONGFLOW_PES_MAX_ITERATIONS=10
LOONGFLOW_PES_TIMEOUT_MS=60000

# ========================================
# Orchestration Layer
# ========================================
PIPELINE_TIMEOUT_MS=300000
MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000
CIRCUIT_BREAKER_HALF_OPEN_ATTEMPTS=3
DLQ_MAX_SIZE=1000

# ========================================
# Event Bus Configuration
# ========================================
EVENT_BUS_URL=redis://event-bus:6379
EVENT_BUS_MAX_EVENTS=10000
EVENT_BUS_PERSIST_EVENTS=true

# ========================================
# Security Configuration
# ========================================
# WARNING: Never commit actual secrets to version control
# Use secrets management (Docker Secrets, K8s Secrets, Vault) in production

# API Keys (REQUIRED - replace with actual values)
# CURIE_GLOBALCHEM_API_KEY=
# LMQL_DSPY_API_KEY=
# BUBBLELAB_API_KEY=
# NEO4J_PASSWORD=
# OPENAI_API_KEY=
# ICR_API_KEY=
# OPENEVOLVE_API_KEY=
# VECTORDB_API_KEY=

# ========================================
# External Service URLs
# ========================================
# These should point to your core project instances
# CURIE_GLOBALCHEM_API_URL=http://curie:8000
# LMQL_DSPY_API_URL=http://lmql:8000
# BUBBLELAB_API_URL=http://bubblelab:8000
# ICR_API_URL=http://icr:8000
# LEANAIDE_API_URL=http://leanaide:8000
# OPENEVOLVE_API_URL=http://openevolve:8000
# RAGBITS_API_URL=http://ragbits:8000
