# LoongFlow Environment Configuration Template
#
# Following CLAUDE.md - Law of Configuration Explicitness:
# - All values must be explicitly configured
# - NO magic defaults - if a required value is missing, the service will crash
# - Copy this file to .env and fill in all required values
#
# Usage:
#   cp .env.loongflow.example .env.loongflow
#   # Edit .env.loongflow with your actual configuration
#   docker-compose -f docker-compose.loongflow-core.yml --env-file .env.loongflow up -d

# =============================================================================
# LoongFlow Core Configuration
# =============================================================================

# LLM Provider Configuration (REQUIRED)
LOONGFLOW_LLM_PROVIDER=openai
LOONGFLOW_LLM_API_KEY=sk-your-openai-api-key-here

# Optional: Other LLM providers
# LOONGFLOW_LLM_PROVIDER=anthropic
# LOONGFLOW_LLM_API_KEY=sk-ant-your-anthropic-api-key-here
#
# LOONGFLOW_LLM_PROVIDER=google
# LOONGFLOW_LLM_API_KEY=your-google-api-key-here

# LLM Model Configuration
LOONGFLOW_LLM_MODEL=gpt-4
LOONGFLOW_LLM_TEMPERATURE=0.7
LOONGFLOW_LLM_MAX_TOKENS=2000

# Core Service Port
LOONGFLOW_CORE_PORT=8050

# Logging Configuration
LOONGFLOW_LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis URL for caching and checkpointing
LOONGFLOW_REDIS_URL=redis://redis:6379

# Optional: Redis authentication
# LOONGFLOW_REDIS_URL=redis://:password@redis:6379

# =============================================================================
# Workflow Configuration
# =============================================================================

# Checkpointing (enables workflow state persistence)
LOONGFLOW_ENABLE_CHECKPOINTING=true

# Maximum concurrent workflows
LOONGFLOW_MAX_CONCURRENT_WORKFLOWS=10

# Workflow timeout (milliseconds)
LOONGFLOW_WORKFLOW_TIMEOUT_MS=300000

# Workflow pruning (removes old/completed workflows)
LOONGFLOW_ENABLE_PRUNING=true
LOONGFLOW_PRUNING_THRESHOLD=1000

# =============================================================================
# PES Integration (Optional)
# =============================================================================

# Enable PES (Prompt Evolution Strategy) integration
LOONGFLOW_ENABLE_PES=false

# PES Configuration
LOONGFLOW_PES_MAX_ITERATIONS=10
LOONGFLOW_PES_TIMEOUT_MS=60000

# PES Cost Optimization
# LOONGFLOW_PES_COST_OPTIMIZATION=true
# LOONGFLOW_PES_MAX_COST_USD=10.0
# LOONGFLOW_PES_EARLY_STOPPING=true
# LOONGFLOW_PES_MIN_IMPROVEMENT=0.001

# =============================================================================
# LoongFlow Adapter Configuration
# =============================================================================

# Adapter Port
LOONGFLOW_PORT=8040

# LoongFlow Core API URL (internal Docker service name)
LOONGFLOW_API_URL=http://loongflow-core:8050

# Adapter timeouts and retries
LOONGFLOW_TIMEOUT_MS=30000
LOONGFLOW_MAX_RETRIES=3
LOONGFLOW_MAX_CONCURRENT_WORKFLOWS=5

# Adapter checkpointing
LOONGFLOW_ENABLE_CHECKPOINTING=true

# =============================================================================
# Hybrid Orchestration (PES + RESE)
# =============================================================================

# Enable hybrid orchestration mode
LOONGFLOW_ENABLE_HYBRID=true

# Enable PES fallback when RESE fails
LOONGFLOW_ENABLE_PES_FALLBACK=true

# PES fallback configuration
LOONGFLOW_PES_TIMEOUT_MS=60000
LOONGFLOW_PES_MAX_ITERATIONS=10

# =============================================================================
# Contract Testing
# =============================================================================

# Skip contract tests on startup (useful for development)
SKIP_CONTRACT_TESTS=false

# =============================================================================
# Logging (Global)
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# =============================================================================
# Timezone (Law of UTC)
# =============================================================================

# All services MUST use UTC (Law of UTC)
TZ=UTC

# =============================================================================
# Event Bus Configuration
# =============================================================================

# Event bus URL (Redis)
EVENT_BUS_URL=redis://event-bus:6379

# Event bus channel prefix
EVENT_BUS_CHANNEL_PREFIX=loongflow

# =============================================================================
# Advanced Settings
# =============================================================================

# Maximum request size (in MB)
MAX_REQUEST_SIZE=100

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (set to false in production)
DEBUG=false

# =============================================================================
# Production Checklist
# =============================================================================
#
# Before deploying to production, ensure:
#
# [ ] All required API keys are set
# [ ] LLM provider credentials are valid
# [ ] Redis connection is secure (TLS enabled)
# [ ] Log level is set to INFO or WARNING
# [ ] DEBUG=false
# [ ] TZ=UTC (Law of UTC)
# [ ] Contract tests are enabled (SKIP_CONTRACT_TESTS=false)
# [ ] Workflow timeout is appropriate for your use case
# [ ] PES cost optimization is enabled if using PES
# [ ] Resource limits are configured in docker-compose
# [ ] Health checks are configured
# [ ] Backup strategy is in place
# [ ] Monitoring and alerting are configured
# [ ] Secrets are managed securely (not in .env files)
#
# =============================================================================
