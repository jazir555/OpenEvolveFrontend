# Neo4j Development Environment Configuration
# OpenEvolve Knowledge Engine - Phase 1.1.1
#
# This configuration is optimized for local development and testing.
# For production deployment, use neo4j.prod.env instead.

# ============================================================================
# CONNECTION CONFIGURATION
# ============================================================================

# Neo4j Connection URI (Bolt protocol - recommended for applications)
NEO4J_URI=bolt://localhost:7687

# Alternative connection URIs (uncomment if needed)
# NEO4J_URI=bolt+routing://localhost:7687  # For causal clustering
# NEO4J_URI=neo4j://localhost:7687        # For driver-managed routing

# HTTP Browser Interface (for Neo4j Browser and REST API)
NEO4J_HTTP_URI=http://localhost:7474

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Neo4j Username (default: neo4j)
NEO4J_USER=neo4j

# Neo4j Password (MUST be changed in production)
# Development default password
NEO4J_PASSWORD=openevolve2026

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database Name (default: neo4j)
# Neo4j 5.x supports multiple databases per instance
NEO4J_DATABASE=neo4j

# ============================================================================
# CONNECTION POOL SETTINGS
# ============================================================================

# Maximum connection pool size (development: smaller)
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Connection acquisition timeout (seconds)
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60

# Connection timeout (seconds)
NEO4J_CONNECTION_TIMEOUT=30

# Maximum transaction retry time (seconds)
NEO4J_MAX_TRANSACTION_RETRY_TIME=30

# ============================================================================
# MEMORY CONFIGURATION (Development - Lower Requirements)
# ============================================================================

# JVM Heap Size (initial and maximum)
# Development: 1GB is sufficient for most development workloads
NEO4J_server_memory_heap_initial__size=1g
NEO4J_server_memory_heap_max__size=2g

# Page Cache Size
# Development: Allocate remaining available memory after heap
NEO4J_server_memory_pagecache_size=2g

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: DEBUG, INFO, WARN, ERROR
# Development: Use DEBUG for detailed troubleshooting
NEO4J_LOG_LEVEL=DEBUG

# Query Logging (enable for development debugging)
NEO4J_SERVER_LOGS_DEBUG_LEVEL=DEBUG

# ============================================================================
# APOC PLUGIN SETTINGS
# ============================================================================

# Enable APOC (Awesome Procedures on Cypher) procedures
NEO4J_dbms_security_procedures_unrestricted=apoc.*
NEO4J_dbms_security_procedures_allowlist=apoc.*

# ============================================================================
# VECTOR SEARCH CONFIGURATION
# ============================================================================

# Enable vector similarity search (for semantic search)
NEO4J_dbms_security_procedures_unrestricted=gds.*
NEO4J_dbms_security_procedures_allowlist=gds.*

# Vector index dimensions (depends on embedding model)
# OpenAI text-embedding-ada-002: 1536
# OpenAI text-embedding-3-small: 1536
# OpenAI text-embedding-3-large: 3072
# Cohere embed-english-v3.0: 1024
NEO4J_EMBEDDING_DIMENSION=1536

# ============================================================================
# TEMPORAL QUERY CONFIGURATION
# ============================================================================

# Enable temporal capabilities
NEO4J_SERVER_TEMPORAL_ENABLED=true

# Timezone for temporal operations
NEO4J_SERVER_TEMPORAL_TIMEZONE=UTC

# ============================================================================
# DEVELOPMENT-SPECIFIC SETTINGS
# ============================================================================

# Enable Cypher query logging (development only)
NEO4J_dbms_logs_debug_level=DEBUG

# Enable query plan logging
NEO4J_SERVER_LOGS_QUERY_PLAN_ENABLED=true

# Enable query statistics
NEO4J_SERVER_LOGS_QUERY_STATISTICS_ENABLED=true

# ============================================================================
# BACKUP AND EXPORT
# ============================================================================

# Backup directory
NEO4J_BACKUP_DIR=/var/lib/neo4j/backups

# Data export directory
NEO4J_EXPORT_DIR=/var/lib/neo4j/export

# ============================================================================
# PERFORMANCE TUNING (Development)
# ============================================================================

# Transaction timeout (longer for development debugging)
NEO4J_server_transaction_timeout=120s

# Maximum concurrent transactions
NEO4J_dbms_transaction_concurrent_maximum=100

# ============================================================================
# SECURITY SETTINGS (Development - Relaxed)
# ============================================================================

# Allow file imports from any URL (development only)
NEO4J_dbms_security_procedures_unrestricted=apoc.import.*

# Enable loading from local filesystem (development only)
NEO4J_dbms_security_procedures_unrestricted=apoc.load.*

# ============================================================================
# MONITORING AND METRICS
# ============================================================================

# Enable Prometheus metrics endpoint
NEO4J_SERVER_METRICS_ENABLED=true

# Metrics port
NEO4J_SERVER_METRICS_PORT=2004

# Enable CSV metrics export
NEO4J_SERVER_METRICS_CSV_ENABLED=true

# ============================================================================
# ENVIRONMENT TAGS
# ============================================================================

# Environment identifier
ENVIRONMENT=development

# Deployment identifier
DEPLOYMENT_STAGE=dev

# Application identifier
APPLICATION_ID=openevolve-knowledge-engine
