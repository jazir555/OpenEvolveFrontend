# Neo4j Production Environment Configuration
# OpenEvolve Knowledge Engine - Phase 1.1.1
#
# This configuration is optimized for production workloads with:
# - High-performance memory settings
# - Enhanced security configuration
# - Connection pooling for scalability
# - Monitoring and observability
#
# CRITICAL: Change all default passwords before deploying to production!

# ============================================================================
# CONNECTION CONFIGURATION
# ============================================================================

# Neo4j Connection URI (Bolt protocol - recommended for applications)
# Use internal DNS name for container-to-container communication
NEO4J_URI=bolt://openevolve-neo4j:7687

# External connection URI (for load balancers and external clients)
NEO4J_URI_EXTERNAL=bolt://neo4j.openevolve.example.com:7687

# HTTP Browser Interface (for Neo4j Browser - restrict access in production)
NEO4J_HTTP_URI=http://openevolve-neo4j:7474

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Neo4j Username (default: neo4j)
NEO4J_USER=neo4j

# Neo4j Password
# CRITICAL: Change this to a strong, unique password in production
# Use a secrets manager (AWS Secrets Manager, Azure Key Vault, etc.)
# Generate with: openssl rand -base64 32
NEO4J_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database Name (default: neo4j)
# For multi-tenant deployments, consider creating separate databases
NEO4J_DATABASE=neo4j

# ============================================================================
# CONNECTION POOL SETTINGS
# ============================================================================

# Maximum connection pool size (production: higher for scalability)
# Formula: (Number of application instances × connections per instance) + 20%
NEO4J_MAX_CONNECTION_POOL_SIZE=500

# Connection acquisition timeout (seconds)
# Production: Lower timeout to fail fast on connection issues
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30

# Connection timeout (seconds)
# Production: Aggressive timeout for quick failure detection
NEO4J_CONNECTION_TIMEOUT=10

# Maximum transaction retry time (seconds)
# Production: Lower for faster retry cycles
NEO4J_MAX_TRANSACTION_RETRY_TIME=15

# Connection idle timeout (seconds)
# Production: Close idle connections to free resources
NEO4J_CONNECTION_IDLE_TIMEOUT=300

# Connection max lifetime (seconds)
# Production: Rotate connections periodically
NEO4J_CONNECTION_MAX_LIFETIME=3600

# ============================================================================
# MEMORY CONFIGURATION (Production - High Performance)
# ============================================================================

# JVM Heap Size (initial and maximum)
# Production: Allocate based on available RAM and workload
# Formula: Heap = 50% of available RAM (for 32GB RAM: 16GB heap)
# Adjust based on heap usage monitoring
NEO4J_server_memory_heap_initial__size=8g
NEO4J_server_memory_heap_max__size=16g

# Page Cache Size
# Production: Allocate remaining memory after heap for optimal caching
# Formula: Page Cache = (Available RAM - Heap) - 2GB (OS overhead)
# For 32GB RAM: (32GB - 16GB) - 2GB = 14GB page cache
NEO4J_server_memory_pagecache_size=14g

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level: DEBUG, INFO, WARN, ERROR
# Production: Use INFO or WARN to reduce log volume
NEO4J_LOG_LEVEL=INFO

# Query Logging (disable in production for performance)
NEO4J_SERVER_LOGS_DEBUG_LEVEL=WARN

# Query logging threshold (milliseconds)
# Only log queries slower than this threshold
NEO4J_SERVER_LOGS_QUERY_THRESHOLD=1000

# ============================================================================
# APOC PLUGIN SETTINGS
# ============================================================================

# Enable APOC (Awesome Procedures on Cypher) procedures
# Production: Only enable required procedures
NEO4J_dbms_security_procedures_unrestricted=apoc.core.*,apoc.cypher.*,apoc.path.*,apoc.algo.*
NEO4J_dbms_security_procedures_allowlist=apoc.core.*,apoc.cypher.*,apoc.path.*,apoc.algo.*

# ============================================================================
# VECTOR SEARCH CONFIGURATION
# ============================================================================

# Enable Graph Data Science (GDS) library for vector operations
NEO4J_dbms_security_procedures_unrestricted=gds.*
NEO4J_dbms_security_procedures_allowlist=gds.*

# Vector index dimensions (depends on embedding model)
# Ensure this matches your embedding model dimension
# OpenAI text-embedding-3-large: 3072 (recommended for production)
NEO4J_EMBEDDING_DIMENSION=3072

# Vector similarity algorithm
NEO4J_VECTOR_SIMILARITY_FUNCTION=cosine

# ============================================================================
# TEMPORAL QUERY CONFIGURATION
# ============================================================================

# Enable temporal capabilities
NEO4J_SERVER_TEMPORAL_ENABLED=true

# Timezone for temporal operations (always use UTC)
NEO4J_SERVER_TEMPORAL_TIMEZONE=UTC

# ============================================================================
# TRANSACTION CONFIGURATION
# ============================================================================

# Transaction timeout (seconds)
# Production: Shorter timeout to prevent long-running transactions
NEO4J_server_transaction_timeout=30s

# Maximum concurrent transactions
# Production: Scale based on workload and connection pool size
NEO4J_dbms_transaction_concurrent_maximum=1000

# Transaction scheduling algorithm
NEO4J_dbms_transaction_scheduling=round_robin

# ============================================================================
# SECURITY SETTINGS (Production - Strict)
# ============================================================================

# Enable TLS/SSL for Bolt protocol (recommended for production)
NEO4J_dbms_connector_bolt_tls__level=REQUIRED

# Enable TLS for HTTP
NEO4J_dbms_connector_https_enabled=true

# Require authentication for all operations
NEO4J_dbms_security_auth_enabled=true

# Disable file imports from external URLs (security risk)
NEO4J_dbms_security_procedures_unrestricted=apoc.import.file.*

# Only allow imports from specific directories
NEO4J_dbms_security_procedures_allowlist=apoc.import.file.*

# ============================================================================
# PERFORMANCE TUNING (Production)
# ============================================================================

# Bolt thread pool size (max concurrent connections)
# Formula: Max connections × number of CPU cores
NEO4J_dbms_connector_bolt_thread__pool__max__size=400

# Bolt thread pool min size (keep for performance)
NEO4J_dbms_connector_bolt_thread__pool__min__size=20

# Network max packet size (for large query results)
NEO4J_dbms_connector_bolt_max__chunk__size=8192

# ============================================================================
# MONITORING AND METRICS
# ============================================================================

# Enable Prometheus metrics endpoint
NEO4J_SERVER_METRICS_ENABLED=true

# Metrics port (internal access only)
NEO4J_SERVER_METRICS_PORT=2004

# Enable JMX monitoring
NEO4J_SERVER_METRICS_JMX_ENABLED=true

# Enable CSV metrics export
NEO4J_SERVER_METRICS_CSV_ENABLED=true

# Metrics retention (days)
NEO4J_SERVER_METRICS_RETENTION=7

# Enable health check endpoint
NEO4J_SERVER_HEALTH_CHECK_ENABLED=true

# ============================================================================
# BACKUP AND RECOVERY
# ============================================================================

# Backup directory
NEO4J_BACKUP_DIR=/var/lib/neo4j/backups

# Backup schedule (cron expression)
# Example: Daily at 2 AM UTC
NEO4J_BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
NEO4J_BACKUP_RETENTION_DAYS=30

# Enable online backups (no downtime required)
NEO4J_dbms_backup_enabled=true

# ============================================================================
# CLUSTER CONFIGURATION (Optional - for Causal Clustering)
# ============================================================================

# Enable clustering for high availability (requires enterprise edition)
# NEO4J_dbms_mode=CORE

# Cluster name
# NEO4J_causal_clustering_cluster_name=openevolve-prod-cluster

# Initial cluster members
# NEO4J_causal_clustering_initial_discovery_members=neo4j-1:5000,neo4j-2:5000,neo4j-3:5000

# Number of core instances
# NEO4J_causal_clustering_minimum_core_cluster_size_at_formation=3

# Number of read replicas
# NEO4J_causal_clustering_minimum_core_cluster_size_at_runtime=3

# ============================================================================
# ENVIRONMENT TAGS
# ============================================================================

# Environment identifier
ENVIRONMENT=production

# Deployment stage
DEPLOYMENT_STAGE=prod

# Application identifier
APPLICATION_ID=openevolve-knowledge-engine

# Region/zone for multi-region deployments
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_ZONE=us-east-1a

# ============================================================================
# RATE LIMITING
# ============================================================================

# Maximum concurrent queries per user
NEO4J_dbms_statement_max_queries_per_transaction=1000

# Query timeout (milliseconds)
NEO4J_dbms_transaction_timeout=30000

# Maximum query execution time (milliseconds)
# Kill queries that run longer than this
NEO4J_dbms_transaction_max__execution__time=60000
