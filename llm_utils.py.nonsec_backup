def _compose_messages(system_message: str, user_message: str) -> List[Dict[str, str]]:
    """Helper function to compose messages in the format expected by OpenAI-compatible chat APIs."""
    return [{"role": "system", "content": system_message}, {"role": "user", "content": user_message}]

async def initialize_llm_client(
    api_config: Dict[str, Any],
    default_models: Dict[str, str],
    logger: Optional[logging.Logger] = None,
    verbose_output: bool = False
) -> Tuple[Any, str]:
    """
    Initializes an asynchronous LLM client based on available API keys.
    Prioritizes Anthropic, then OpenAI, then Google.
    """
    if logger is None:
        import logging
        logger = logging.getLogger(__name__)

    try:
        import openai
        import anthropic
        from openai import AsyncOpenAI
        from anthropic import AsyncAnthropic
    except ImportError as e:
        logger.error(f"Required LLM libraries not installed: {e}")
        raise ValueError(f"Missing LLM libraries: {e}")

    # 1. Try Anthropic
    anthropic_cfg = api_config.get("anthropic", {})
    anthropic_key = anthropic_cfg.get("api_key") or os.environ.get("ANTHROPIC_API_KEY")
    if anthropic_key:
        try:
            client = AsyncAnthropic(api_key=anthropic_key)
            if verbose_output:
                logger.info("Using Anthropic as the primary LLM provider.")
            return client, "anthropic"
        except Exception as e:
            logger.warning(f"Failed to initialize Anthropic client: {e}")

    # 2. Try OpenAI
    openai_cfg = api_config.get("openai", {})
    openai_key = openai_cfg.get("api_key") or os.environ.get("OPENAI_API_KEY")
    if openai_key:
        try:
            base_url = openai_cfg.get("base_url") or os.environ.get("OPENAI_BASE_URL")
            client = AsyncOpenAI(api_key=openai_key, base_url=base_url)
            if verbose_output:
                logger.info("Using OpenAI as the primary LLM provider.")
            return client, "openai"
        except Exception as e:
            logger.warning(f"Failed to initialize OpenAI client: {e}")

    # 3. Try Google/Gemini
    google_cfg = api_config.get("google", {})
    google_key = google_cfg.get("api_key") or os.environ.get("GOOGLE_API_KEY")
    if google_key:
        # Note: Google's genai library is typically used differently, 
        # but many wrappers make it OpenAI-compatible.
        # For production readiness, we'd use the actual genai async client.
        try:
            import google.generativeai as genai
            genai.configure(api_key=google_key)
            if verbose_output:
                logger.info("Using Google/Gemini as the primary LLM provider.")
            return genai, "google"
        except Exception as e:
            logger.warning(f"Failed to initialize Google client: {e}")

    logger.error("No valid LLM API keys found in config or environment.")
    raise ValueError("No valid LLM API keys found. Please check mcp_agent.secrets.yaml or environment variables.")

