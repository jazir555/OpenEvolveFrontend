        result_content = response.choices[0].message.content if response.choices[0] else None

        # ACE + Steer: Verification & Learning
        if bridge and result_content:
            verifications = ["slop"]
            if response_json_format or (response_format and isinstance(response_format, dict) and response_format.get("type") == "json_object"):
