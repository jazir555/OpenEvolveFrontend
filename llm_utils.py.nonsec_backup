    if robust_engine and not ROBUST_ENGINE_ACTIVE:
        try:
            ROBUST_ENGINE_ACTIVE = True
            # Reconstruct prompt from messages
            prompt = "\n".join([f"{m['role']}: {m['content']}" for m in messages])
            result = robust_engine.solve_problem(prompt)
            ROBUST_ENGINE_ACTIVE = False
