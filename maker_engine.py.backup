"""
Maker Engine

Implementation of the Maker pattern for structured, multi-step problem solving.
The Maker engine orchestrates complex workflows through discrete, observable steps.

Key Concepts:
    - MakerStep: Individual step in a Maker workflow
    - MakerConfig: Configuration for Maker runs
    - MakerState: State management during execution
    - MakerRunResult: Results from completed runs
    - CheckpointStore: Persistence for intermediate results

Classes:
    MakerStep: Represents a single step in the workflow
    MakerConfig: Configuration for Maker execution
    MakerState: Mutable state during execution
    MakerRunResult: Immutable result of execution
    CheckpointStore: Abstract checkpoint storage
    FileCheckpointStore: Filesystem-based checkpoint storage
    MakerEngine: Main engine for running Maker workflows

Example:
    >>> from maker_engine import MakerEngine, MakerConfig
    >>> engine = MakerEngine()
    >>> config = MakerConfig(goal="Solve optimization problem")
    >>> result = engine.run(config)

Author: OpenEvolve
Date: 2026-01-03
"""

import json
import logging
import sys
import time
from dataclasses import dataclass, field, asdict
from typing import Any, Callable, Dict, List, Optional, Tuple

from llm_utils import _compose_messages, _request_openai_compatible_chat
from workflow_structures import ModelConfig, Team
from base_configuration import BaseConfiguration
from mdap_engine import (
    RedFlagRules,
    RedFlagger,
    canonicalize_candidate
)

# Guardrails Integration
try:
    from reliability.guardrails_adapter import (
        GuardrailsAdapter,
        create_adapter
    )
    GUARDRAILS_ADAPTER_AVAILABLE = True
except ImportError:
    GUARDRAILS_ADAPTER_AVAILABLE = False
    GuardrailsAdapter = None
    create_adapter = None

# ACE + Steer Integration
try:
    from ace_steer_integration import AceSteerBridge
    from ace_steer_config import (
        get_ace_steer_config,
        is_ace_enabled,
        is_steer_enabled,
        is_unified_bridge_enabled,
        ACE_AVAILABLE,
        STEER_AVAILABLE
    )
    STEER_ACE_BRIDGE_AVAILABLE = True
except ImportError:
    # Fallback to basic availability checking
    try:
        from ace_steer_integration import AceSteerBridge
        from ace_mcp_tools import ACE_AVAILABLE
        from steer_mcp_tools import STEER_AVAILABLE
        STEER_ACE_BRIDGE_AVAILABLE = True

        # Create fallback config functions if ace_steer_config unavailable
        def get_ace_steer_config(user_config=None, use_env=True):
            # Handle both dict and object with .get() method
            if user_config is None:
                ace_enabled = True
                steer_enabled = True
            elif isinstance(user_config, dict):
                ace_enabled = user_config.get('ace_enabled', True)
                steer_enabled = user_config.get('steer_enabled', True)
            elif hasattr(user_config, 'get'):
                # BaseConfiguration object
                try:
                    ace_enabled = user_config.get('ace_enabled', True)
                    steer_enabled = user_config.get('steer_enabled', True)
                except:
                    ace_enabled = True
                    steer_enabled = True
            else:
                ace_enabled = True
                steer_enabled = True

            return {
                'ace_enabled': ace_enabled,
                'steer_enabled': steer_enabled,
                'ace_available': ACE_AVAILABLE,
                'steer_available': STEER_AVAILABLE,
                'both_available': ACE_AVAILABLE and STEER_AVAILABLE,
            }

        def is_ace_enabled(user_config=None):
            if user_config is None:
                return ACE_AVAILABLE
            elif isinstance(user_config, dict):
                return ACE_AVAILABLE and user_config.get('ace_enabled', True)
            elif hasattr(user_config, 'get'):
                try:
                    return ACE_AVAILABLE and user_config.get('ace_enabled', True)
                except:
                    return ACE_AVAILABLE
            else:
                return ACE_AVAILABLE

        def is_steer_enabled(user_config=None):
            if user_config is None:
                return STEER_AVAILABLE
            elif isinstance(user_config, dict):
                return STEER_AVAILABLE and user_config.get('steer_enabled', True)
            elif hasattr(user_config, 'get'):
                try:
                    return STEER_AVAILABLE and user_config.get('steer_enabled', True)
                except:
                    return STEER_AVAILABLE
            else:
                return STEER_AVAILABLE

        def is_unified_bridge_enabled(user_config=None):
            return ACE_AVAILABLE and STEER_AVAILABLE
    except ImportError:
        STEER_ACE_BRIDGE_AVAILABLE = False
        ACE_AVAILABLE = False
        STEER_AVAILABLE = False
        AceSteerBridge = None

        def get_ace_steer_config(user_config=None, use_env=True):
            return {'ace_available': False, 'steer_available': False, 'both_available': False}

        def is_ace_enabled(user_config=None):
            return False

        def is_steer_enabled(user_config=None):
            return False

        def is_unified_bridge_enabled(user_config=None):
            return False

logger = logging.getLogger(__name__)


@dataclass
class MakerStep:
    """
    Represents a single step in a Maker workflow.

    A MakerStep encapsulates a discrete unit of work in the Maker workflow,
    including the prompt template, required inputs, and execution logic.

    Attributes:
        name (str): Unique name/identifier for the step
        prompt (str): Prompt template for the step
        inputs (List[str]): Required input parameter names

    Example:
        >>> step = MakerStep(
        ...     name="analyze",
        ...     prompt="Analyze: {problem}",
        ...     inputs=["problem"]
        ... )
    """
    step_id: str
    prompt_template: str
    expected_schema: Optional[Dict[str, Any]] = None
    task_type: str = "general"
    priority: int = 0
    system_prompt: Optional[str] = None
    stop_sequences: Optional[List[str]] = None
    metadata: Dict[str, Any] = field(default_factory=dict)

    def render_prompt(self, state: Any, history: List[Dict[str, Any]]) -> str:
        state_payload = json.dumps(state, ensure_ascii=True)
        history_payload = json.dumps(history, ensure_ascii=True)
        return self.prompt_template.format(state=state_payload, history=history_payload)


class MakerConfig(BaseConfiguration):
    """
    Configuration for a Maker workflow execution.

    Contains all configuration parameters needed to execute a Maker workflow,
    including goals, constraints, and execution parameters.

    Attributes:
        k_min (int): Minimum number of candidates to generate
        k_max (int): Maximum number of candidates to generate
        max_votes_per_step (int): Maximum voting rounds per step
        max_steps (int): Maximum number of steps to execute
        timeout_seconds (int): Timeout for each step execution
        checkpoint_interval (int): How often to save checkpoints
        red_flag_rules (RedFlagRules): Rules for content validation
        ace_enabled (bool): Whether ACE integration is enabled
        ace_skillbook_path (str): Path to ACE skillbook configuration

    Example:
        >>> config = MakerConfig(
        ...     max_steps=100,
        ...     timeout_seconds=90
        ... )
    """
    def __init__(self, parameters: Optional[Dict[str, Any]] = None, validate: bool = True, **kwargs):
        defaults = {
            'k_min': 2,
            'k_max': 8,
            'max_votes_per_step': 60,
            'max_steps': 1000,
            'timeout_seconds': 90,
            'checkpoint_interval': 25,
            'red_flag_rules': {},
            'ace_enabled': True,
            'steer_enabled': True,
            'ace_skillbook_path': "./ace_skillbook.json",
            'steer_verifications': ['json', 'slop'],
            'api_key': ""
        }
        
        merged_params = defaults.copy()
        if parameters:
            merged_params.update(parameters)
        merged_params.update(kwargs)
        
        # Convert RedFlagRules object to dict if present
        if 'red_flag_rules' in merged_params:
            if hasattr(merged_params['red_flag_rules'], '__dataclass_fields__'):
                 merged_params['red_flag_rules'] = asdict(merged_params['red_flag_rules'])
        
        super().__init__(parameters=merged_params, validate=validate)

    @property
    def red_flag_rules(self) -> RedFlagRules:
        val = self.get('red_flag_rules', {})
        if isinstance(val, dict):
            # Filter out keys not in RedFlagRules fields to avoid TypeError
            valid_keys = set(RedFlagRules.__dataclass_fields__.keys())
            filtered_val = {k: v for k, v in val.items() if k in valid_keys}
            return RedFlagRules(**filtered_val)
        return val


@dataclass
class MakerState:
    """
    Mutable state during Maker workflow execution.

    Tracks the current state of a Maker workflow run, including
    intermediate results, history, and metadata.

    Attributes:
        step_index (int): Index of current step
        current_state (Any): Current workflow state
        history (List[Dict]): History of previous steps
        last_action (Any): Last action taken

    Example:
        >>> state = MakerState()
        >>> state.step_index = 5
        >>> state.history.append({"step": 4, "result": "done"})
    """
    step_index: int = 0
    current_state: Any = None
    history: List[Dict[str, Any]] = field(default_factory=list)
    last_action: Optional[Any] = None


@dataclass
class MakerRunResult:
    """
    Immutable result of a Maker workflow execution.

    Contains the final results, metrics, and artifacts from a
    completed Maker workflow run.

    Attributes:
        state (MakerState): Final state of the workflow
        metrics (Dict[str, Any]): Performance and execution metrics
        terminated_reason (str): Reason for workflow termination

    Example:
        >>> print(result.terminated_reason)
        "max_steps_reached"
        >>> print(result.metrics["total_duration_ms"])
        5000
    """
    state: MakerState
    metrics: Dict[str, Any]
    terminated_reason: str


class CheckpointStore:
    """
    Abstract base class for checkpoint storage.

    Defines the interface for persisting and loading Maker workflow
    checkpoints for fault tolerance and resume capability.

    Methods:
        save: Save checkpoint data
        load: Load checkpoint data

    Example:
        >>> store = CheckpointStore()
        >>> # Implement save/load in subclass
    """

    def save(self, state: MakerState):
        """
        Save checkpoint data.

        Args:
            state (MakerState): Current state to checkpoint

        Raises:
            NotImplementedError: Abstract method
        """
        raise NotImplementedError

    def load(self) -> Optional[MakerState]:
        """
        Load checkpoint data.

        Returns:
            Optional[MakerState]: Loaded state or None if not found

        Raises:
            NotImplementedError: Abstract method
        """
        raise NotImplementedError


class FileCheckpointStore(CheckpointStore):
    """
    Filesystem-based implementation of checkpoint storage.

    Persists Maker workflow checkpoints to the local filesystem,
    organized by workflow ID and checkpoint ID.

    Attributes:
        path (str): File path for checkpoint storage

    Methods:
        save: Save checkpoint to file
        load: Load checkpoint from file

    Example:
        >>> store = FileCheckpointStore(path="/tmp/checkpoint.json")
        >>> store.save(state)
        >>> loaded = store.load()
    """

    def __init__(self, path: str):
        """
        Initialize file checkpoint store.

        Args:
            path (str): File path for checkpoint storage
        """
        self.path = path

    def save(self, state: MakerState):
        """
        Save checkpoint to file.

        Args:
            state (MakerState): Current state to checkpoint

        Note:
            Logs error if save fails but does not raise exception
        """
        payload = {
            "step_index": state.step_index,
            "current_state": state.current_state,
            "history": state.history,
            "last_action": state.last_action
        }
        try:
            with open(self.path, "w", encoding="utf-8") as handle:
                json.dump(payload, handle, ensure_ascii=True, indent=2)
        except (IOError, TypeError) as e:
            logger.error(f"Failed to save checkpoint: {e}")

    def load(self) -> Optional[MakerState]:
        """
        Load checkpoint from file.

        Returns:
            Optional[MakerState]: Loaded state or None if not found

        Note:
            Returns None if file not found or if JSON decoding fails
        """
        try:
            with open(self.path, "r", encoding="utf-8") as handle:
                payload = json.load(handle)
        except FileNotFoundError:
            return None
        except (json.JSONDecodeError, IOError) as e:
            logger.warning(f"Failed to load checkpoint: {e}")
            return None

        return MakerState(
            step_index=payload.get("step_index", 0),
            current_state=payload.get("current_state"),
            history=payload.get("history", []),
            last_action=payload.get("last_action")
        )


class MakerEngine:
    """
    Main engine for executing Maker workflows.

    The MakerEngine orchestrates the execution of Maker workflows,
    managing steps, state, checkpoints, and error handling.

    Attributes:
        team (Team): Team of agents for executing steps
        config (MakerConfig): Configuration for workflow execution
        red_flagger (RedFlagger): Content validation system
        ace_enabled (bool): Whether ACE integration is enabled
        ace_steer_bridge (Optional[AceSteerBridge]): ACE+Steer integration bridge
        metrics (Dict[str, Any]): Execution metrics

    Methods:
        solve: Execute a Maker workflow with given parameters

    Example:
        >>> engine = MakerEngine(team=my_team, config=my_config)
        >>> result = engine.solve(
        ...     initial_state=problem,
        ...     step_builder=step_builder_fn,
        ...     apply_action=apply_fn
        ... )
    """

    def __init__(self, team: Team, config: MakerConfig, ace_steer_bridge: Optional[AceSteerBridge] = None):
        self.team = team
        self.config = config

        # Initialize Guardrails adapter
        self.guardrails_adapter = None
        if GUARDRAILS_ADAPTER_AVAILABLE:
            try:
                self.guardrails_adapter = create_adapter(
                    enabled=config.get('guardrails_enabled', True),
                    default_on_fail=config.get('guardrails_on_fail', 'filter')
                )
                logger.info("Guardrails adapter initialized for MAKER Engine")
            except Exception as e:
                logger.warning(f"Failed to initialize Guardrails adapter: {e}")

        # Initialize RedFlagger with Guardrails
        self.red_flagger = RedFlagger(config.red_flag_rules, self.guardrails_adapter)

        # ACE + Steer Integration with enhanced configuration
        # Store local references to helper functions to avoid import issues
        _is_ace_enabled = is_ace_enabled
        _is_steer_enabled = is_steer_enabled
        _is_unified_bridge_enabled = is_unified_bridge_enabled

        # Check if functions are callable before using them
        try:
            if callable(_is_ace_enabled):
                self.ace_enabled = _is_ace_enabled(config)
            else:
                logger.warning("⚠️ is_ace_enabled is not callable, using default False")
                self.ace_enabled = False
        except Exception as e:
            logger.warning(f"⚠️ Error checking ACE enabled status: {e}")
            self.ace_enabled = False

        try:
            if callable(_is_steer_enabled):
                self.steer_enabled = _is_steer_enabled(config)
            else:
                logger.warning("⚠️ is_steer_enabled is not callable, using default False")
                self.steer_enabled = False
        except Exception as e:
            logger.warning(f"⚠️ Error checking Steer enabled status: {e}")
            self.steer_enabled = False

        try:
            if callable(_is_unified_bridge_enabled):
                self.unified_bridge_enabled = _is_unified_bridge_enabled(config)
            else:
                logger.warning("⚠️ is_unified_bridge_enabled is not callable, using default False")
                self.unified_bridge_enabled = False
        except Exception as e:
            logger.warning(f"⚠️ Error checking unified bridge status: {e}")
            self.unified_bridge_enabled = False

        self.ace_steer_bridge = ace_steer_bridge

        # Auto-initialize bridge if enabled but not provided
        if self.unified_bridge_enabled and not self.ace_steer_bridge and AceSteerBridge is not None:
            try:
                skillbook_path = config.get('ace_skillbook_path', './ace_skillbook.json')
                self.ace_steer_bridge = AceSteerBridge(
                    ace_agent_id=f"maker_engine_{team.name}",
                    skillbook_path=skillbook_path
                )
                logger.info(f"✅ Auto-initialized ACE+Steer bridge for MAKER team: {team.name}")
            except Exception as e:
                logger.warning(f"⚠️ Failed to initialize ACE+Steer bridge: {e}")
                self.ace_steer_bridge = None
                self.unified_bridge_enabled = False

        # Log effective configuration
        logger.info(f"MAKER Engine {team.name} configuration:")
        logger.info(f"  - ACE: {self.ace_enabled}")
        logger.info(f"  - Steer: {self.steer_enabled}")
        logger.info(f"  - Unified Bridge: {self.unified_bridge_enabled}")

        self.metrics = {
            "steps": 0,
            "votes_cast": 0,
            "red_flags": 0,
            "escalations": 0,
            "errors": 0
        }

    def solve(
        self,
        initial_state: Any,
        step_builder: Callable[[Any, List[Dict[str, Any]]], MakerStep],
        apply_action: Callable[[Any, Any], Any],
        checkpoint_store: Optional[CheckpointStore] = None,
        stop_condition: Optional[Callable[[MakerState], bool]] = None
    ) -> MakerRunResult:
        state = MakerState(current_state=initial_state)
        terminated_reason = "max_steps_reached"

        for _ in range(self.config.max_steps):
            step = step_builder(state.current_state, state.history)
            action = self._maker_step(step, state.current_state, state.history)
            if action is None:
                terminated_reason = "no_action_selected"
                break

            try:
                next_state = apply_action(state.current_state, action)
            except Exception as exc:
                self.metrics["errors"] += 1
                terminated_reason = f"apply_action_failed:{exc}"
                break

            state.history.append({"action": action, "state": next_state})
            state.last_action = action
            state.step_index += 1
            self.metrics["steps"] += 1
            state.current_state = next_state

            if checkpoint_store and state.step_index % self.config.checkpoint_interval == 0:
                checkpoint_store.save(state)
            if stop_condition and stop_condition(state):
                terminated_reason = "stop_condition_met"
                break

        return MakerRunResult(state=state, metrics=self.metrics.copy(), terminated_reason=terminated_reason)

    def _maker_step(self, step: MakerStep, current_state: Any,
                    history: List[Dict[str, Any]]) -> Optional[Any]:
        start = time.time()
        votes: Dict[str, int] = {}
        attempts = 0
        k_value = self._compute_k_value(step)

        while attempts < self.config.max_votes_per_step:
            if time.time() - start > self.config.timeout_seconds:
                break

            raw_text, candidate = self._collect_vote(step, current_state, history)
            attempts += 1
            self.metrics["votes_cast"] += 1

            if not self._candidate_has_action(candidate):
                self.metrics["red_flags"] += 1
                continue

            is_flagged, _ = self.red_flagger.is_flagged(raw_text, candidate, step.expected_schema)
            if is_flagged:
                self.metrics["red_flags"] += 1
                continue

            key = canonicalize_candidate(candidate)
            votes[key] = votes.get(key, 0) + 1

            if self._has_k_ahead(votes, k_value):
                try:
                    winner_key = max(votes, key=votes.get)
                    winner = self._decode_vote(winner_key)
                    if isinstance(winner, dict):
                        return winner.get("action")
                    return winner
                except (ValueError, KeyError):
                    logger.warning("Failed to determine winner despite having k-ahead")
                    continue

        self.metrics["escalations"] += 1
        return self._best_effort_action(votes)

    def _collect_vote(self, step: MakerStep, current_state: Any,
                      history: List[Dict[str, Any]]) -> Tuple[str, Any]:
        agent = self._select_agent(step)
        system_prompt = step.system_prompt or "You are a specialized AI agent. Follow the instructions precisely."
        prompt = step.render_prompt(current_state, history)
        
        # ACE + Steer: Skill Injection (ACE only)
        original_prompt = prompt
        if self.ace_enabled and self.ace_steer_bridge:
            try:
                prompt = self.ace_steer_bridge.prepare_prompt(
                    task=prompt,
                    model=agent.model_id
                )
            except Exception as e:
                logger.warning(f"⚠️ ACE prepare_prompt failed, using original prompt: {e}")
                prompt = original_prompt

        messages = _compose_messages(system_prompt, prompt)

        response = _request_openai_compatible_chat(
            api_key=agent.api_key,
            base_url=agent.api_base,
            model=agent.model_id,
            messages=messages,
            temperature=agent.temperature,
            top_p=agent.top_p,
            frequency_penalty=agent.frequency_penalty,
            presence_penalty=agent.presence_penalty,
            max_tokens=agent.max_tokens,
            seed=agent.seed,
            stop_sequences=step.stop_sequences or agent.stop_sequences,
            logprobs=agent.logprobs,
            top_logprobs=agent.top_logprobs,
            response_format=agent.response_format,
            stream=agent.stream,
            user=agent.user,
            reasoning_effort=agent.reasoning_effort,
            max_retries=agent.max_retries,
            timeout=agent.timeout,
            organization=agent.organization,
            response_model=agent.response_model,
            tools=agent.tools,
            tool_choice=agent.tool_choice,
            system_fingerprint=agent.system_fingerprint,
            deployment_id=agent.deployment_id,
            encoding_format=agent.encoding_format,
            max_input_tokens=agent.max_input_tokens,
            stop_token=agent.stop_token,
            best_of=agent.best_of,
            logprobs_offset=agent.logprobs_offset,
            suffix=agent.suffix,
            presence_penalty_range=agent.presence_penalty_range,
            frequency_penalty_range=agent.frequency_penalty_range,
            stop_token_id=agent.stop_token_id,
            response_json_format=agent.response_json_format,
            max_output_tokens=agent.max_output_tokens,
            stream_options=agent.stream_options,
            logprobs_type=agent.logprobs_type,
            top_k=agent.top_k,
            repetition_penalty=agent.repetition_penalty,
            length_penalty=agent.length_penalty,
            early_stopping=agent.early_stopping,
            num_beams=agent.num_beams,
            do_sample=agent.do_sample,
            temperature_fallback=agent.temperature_fallback,
            top_p_fallback=agent.top_p_fallback,
            max_time=agent.max_time,
            return_full_text=agent.return_full_text,
            tokenizer_config=agent.tokenizer_config,
            model_kwargs=agent.model_kwargs
        )

        raw_text = response or ""

        # ACE + Steer: Verification & Learning
        # Check if Steer is enabled for verification, ACE for learning
        if self.steer_enabled and self.ace_steer_bridge and raw_text:
            try:
                verifications = ["slop"]
                if step.expected_schema or step.task_type in ["critical", "security"]:
                    verifications.append("json")

                steer_v = self.ace_steer_bridge.verify_and_learn(
                    query=original_prompt,
                    output=raw_text,
                    verifications=verifications,
                    model=agent.model_id
                )
                if not steer_v["all_passed"]:
                    logger.warning(f"MAKER Step {step.step_id} failed Steer verification: {steer_v['failed_verifications']}")
            except Exception as e:
                logger.warning(f"⚠️ Steer verification failed for MAKER step {step.step_id}: {e}")
        elif self.ace_enabled and self.ace_steer_bridge and raw_text:
            # ACE enabled but Steer disabled - do ACE learning only if we have feedback
            try:
                # This would require feedback source, skip for now
                pass
            except Exception as e:
                logger.warning(f"⚠️ ACE learning failed for MAKER step {step.step_id}: {e}")

        candidate = self._parse_candidate(raw_text, step.expected_schema)

        # Guardrails validation (line 692 - after parsing)
        if self.guardrails_adapter and self.guardrails_adapter.is_available():
            try:
                validation_result = self.guardrails_adapter.validate_output(
                    output=json.dumps(candidate) if isinstance(candidate, (dict, list)) else str(candidate),
                    validators=["toxic_language", "pii_filter", "secrets_detection"],
                    on_fail="filter",
                    correlation_id=f"maker_{step.step_id}"
                )

                if not validation_result.is_valid:
                    logger.warning(
                        f"Guardrails validation failed for MAKER step: {step.step_id}",
                        failures=[f.get('message', '') for f in validation_result.failures]
                    )

                    # Apply remediation if available
                    if validation_result.remediation_applied and validation_result.output:
                        try:
                            remediated = json.loads(validation_result.output)
                            logger.info(f"Using Guardrails-remediated candidate for {step.step_id}")
                            candidate = remediated
                        except:
                            candidate = {"error": "validation_failed", "reasons": validation_result.failures}
                    else:
                        candidate = {"__guardrails_rejected__": True, "reasons": validation_result.failures}

            except Exception as e:
                logger.warning(f"Guardrails validation error for {step.step_id}: {e}")

        return raw_text, candidate

    def _parse_candidate(self, raw_text: str, schema: Optional[Dict[str, Any]]) -> Any:
        stripped = raw_text.strip()
        if not stripped:
            return {}

        try:
            expects_json = schema is not None and schema.get("type") in ("object", "array")
        except (AttributeError, TypeError):
            expects_json = False

        if expects_json:
            try:
                return json.loads(stripped)
            except Exception as exc:
                logger.warning("Failed to parse JSON candidate: %s", exc)
                return {"raw": raw_text, "parse_error": str(exc)}
        if stripped.startswith("{") or stripped.startswith("["):
            try:
                return json.loads(stripped)
            except Exception:
                return stripped
        return stripped

    def _candidate_has_action(self, candidate: Any) -> bool:
        if isinstance(candidate, dict):
            return "action" in candidate
        return isinstance(candidate, str)

    def _select_agent(self, step: MakerStep) -> ModelConfig:
        if not self.team.members:
            raise ValueError("Team has no members")
        return self.team.members[step.priority % len(self.team.members)]

    def _has_k_ahead(self, votes: Dict[str, int], k_value: int) -> bool:
        if not votes:
            return False
        try:
            leader = max(votes, key=votes.get)
            leader_count = votes[leader]
            max_other = max((count for key, count in votes.items() if key != leader), default=0)
            return leader_count >= max_other + k_value
        except (ValueError, KeyError):
            return False

    def _compute_k_value(self, step: MakerStep) -> int:
        base_k = max(self.config.k_min, min(self.config.k_max, 1 + step.priority))
        if step.task_type in ["critical", "security", "safety"]:
            base_k = min(self.config.k_max, base_k + 1)
        return base_k

    def _decode_vote(self, vote_key: str) -> Any:
        try:
            return json.loads(vote_key)
        except Exception:
            return vote_key

    def _best_effort_action(self, votes: Dict[str, int]) -> Optional[Any]:
        if not votes:
            return None
        try:
            winner_key = max(votes, key=votes.get)
            winner = self._decode_vote(winner_key)
            if isinstance(winner, dict):
                return winner.get("action")
            return winner
        except (ValueError, KeyError):
            logger.warning("Failed to determine best effort action")
            return None


# Compatibility alias for modules expecting MAKEREngine
MAKEREngine = MakerEngine
