class MDAPConfig(BaseConfiguration):
    def __init__(self, parameters: Optional[Dict[str, Any]] = None, validate: bool = True, **kwargs):
        defaults = {
            'k_min': 2,
            'k_max': 8,
            'max_votes_per_step': 50,
            'timeout_seconds': 60,
            'red_flag_rules': {},
            'fallback_policy': "escalate_then_best_effort",
            'cache_ttl_seconds': None,
            'cache_max_size': 5000,
            'ace_enabled': True,
            'steer_enabled': True,
            'ace_skillbook_path': "./ace_skillbook.json",
            'steer_verifications': ['json', 'slop'],
            'api_key': ""
        }
        
        merged_params = defaults.copy()
        if parameters:
            merged_params.update(parameters)
        merged_params.update(kwargs)
        
        # Convert RedFlagRules object to dict if present
        if 'red_flag_rules' in merged_params:
            if hasattr(merged_params['red_flag_rules'], '__dataclass_fields__'):
                 merged_params['red_flag_rules'] = asdict(merged_params['red_flag_rules'])
        
        super().__init__(parameters=merged_params, validate=validate)

    @property
    def red_flag_rules(self) -> RedFlagRules:
        val = self.get('red_flag_rules', {})
        if isinstance(val, dict):
            valid_keys = set(RedFlagRules.__dataclass_fields__.keys())
            filtered_val = {k: v for k, v in val.items() if k in valid_keys}
            return RedFlagRules(**filtered_val)
        return val


