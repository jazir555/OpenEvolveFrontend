            elif hasattr(user_config, 'get'):
                try:
                    return STEER_AVAILABLE and user_config.get('steer_enabled', True)
                except:
                    return STEER_AVAILABLE
            else:
                return STEER_AVAILABLE

        def is_unified_bridge_enabled(user_config=None):
            return ACE_AVAILABLE and STEER_AVAILABLE
    except ImportError:
