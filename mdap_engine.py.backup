class MDAPCache:
    def __init__(self, max_size: int, ttl_seconds: int):
        self.max_size = max_size
        self.ttl_seconds = ttl_seconds
        self._cache: Dict[str, Dict[str, Any]] = {}
        self._access: Dict[str, float] = {}

    def get(self, key: str) -> Optional[Any]:
        now = time.time()
        entry = self._cache.get(key)
        if not entry:
            return None
        try:
            if now - entry["timestamp"] > self.ttl_seconds:
                self._cache.pop(key, None)
                self._access.pop(key, None)
                return None
            self._access[key] = now
            return entry["value"]
        except (KeyError, TypeError):
            return None

    def set(self, key: str, value: Any):
        if len(self._cache) >= self.max_size:
            self._evict_lru()
        self._cache[key] = {"value": value, "timestamp": time.time()}
        self._access[key] = time.time()

    def _evict_lru(self):
        if not self._access:
            return
        try:
            lru_key = min(self._access, key=self._access.get)
            self._cache.pop(lru_key, None)
            self._access.pop(lru_key, None)
        except (ValueError, KeyError):
            # If min fails, clear oldest entry by timestamp
            if self._cache:
                oldest_key = next(iter(self._cache))
                self._cache.pop(oldest_key, None)
                self._access.pop(oldest_key, None)


class MDAPCacheManager:
    """
    Manages caching of validated MDAP task outputs with TTL and performance tracking.

    Enhanced version of MDAPCache with:
    - Persistent storage to disk
    - Performance statistics tracking
    - Detailed metadata support
    - Configurable eviction policies
    - Cache warming capabilities
    """

    def __init__(self,
                 max_size: int = 10000,
                 ttl_seconds: int = 3600,
                 storage_path: str = "mdap_cache.json"):
        """
        Initialize cache manager.

        Args:
            max_size: Maximum number of cache entries
            ttl_seconds: Time-to-live for cache entries (default 1 hour)
            storage_path: Path for persistent cache storage
        """
        self.max_size = max_size
        self.ttl_seconds = ttl_seconds
        self.cache: Dict[str, Dict[str, Any]] = {}
        self.access_times: Dict[str, float] = {}
        self.hit_count = 0
        self.miss_count = 0
        self.storage_path = storage_path
        self.logger = logging.getLogger(__name__)

        # Load cache from storage if exists
        self._load_cache_from_storage()

    def get_cached_solution(self,
                          subtask_signature: str) -> Optional[Dict]:
        """
        Retrieve cached solution if available and not expired.

        Args:
            subtask_signature: Unique signature identifying the subtask

        Returns:
            Solution dict if found and valid, None otherwise
        """
        current_time = time.time()

        if subtask_signature in self.cache:
            cached_item = self.cache[subtask_signature]

            # Check if cache entry is still valid
            if current_time - cached_item["timestamp"] < self.ttl_seconds:
                self.hit_count += 1
                self.access_times[subtask_signature] = current_time
                self.logger.debug(f"Cache HIT for {subtask_signature[:16]}...")
                return cached_item["solution"]
            else:
                # Remove expired entry
                del self.cache[subtask_signature]
                del self.access_times[subtask_signature]
                self.logger.debug(f"Cache EXPIRED for {subtask_signature[:16]}...")

        self.miss_count += 1
        self.logger.debug(f"Cache MISS for {subtask_signature[:16]}...")
        return None

    def cache_solution(self,
                      subtask_signature: str,
                      solution: Dict,
                      metadata: Optional[Dict[str, Any]] = None) -> None:
        """
        Cache a solution with metadata for future reuse.

        Args:
            subtask_signature: Unique signature identifying the subtask
            solution: Solution to cache
            metadata: Optional metadata (task_type, complexity, etc.)
        """
        current_time = time.time()

        # Check cache size and evict if necessary
        if len(self.cache) >= self.max_size:
            self._evict_lru_entries(count=max(1, len(self.cache) // 10))

        # Store solution with timestamp and metadata
        self.cache[subtask_signature] = {
            "solution": solution,
            "timestamp": current_time,
            "metadata": metadata or {}
        }
        self.access_times[subtask_signature] = current_time

        self.logger.debug(f"Cached solution for {subtask_signature[:16]}... "
                         f"(cache size: {len(self.cache)}/{self.max_size})")

        # Persist to storage asynchronously (save on every N writes or on shutdown)
        if len(self.cache) % 100 == 0:  # Save every 100 additions
            self._save_cache_to_storage()

    def _evict_lru_entries(self, count: int = 1) -> None:
        """
        Evict least recently used entries.

        Args:
            count: Number of entries to evict
        """
        if not self.access_times:
            return

        # Find and remove LRU entries
        sorted_access = sorted(self.access_times.items(),
                              key=lambda x: x[1])

        evicted = 0
        for i in range(min(count, len(sorted_access))):
            lru_key = sorted_access[i][0]
            del self.cache[lru_key]
            del self.access_times[lru_key]
            evicted += 1

        if evicted > 0:
            self.logger.debug(f"Evicted {evicted} LRU cache entries")

    def get_cache_stats(self) -> Dict[str, Any]:
        """
        Get cache performance statistics.

        Returns:
            Dict with hit_rate, hit_count, miss_count, cache_size, etc.
        """
        total_requests = self.hit_count + self.miss_count
        hit_rate = self.hit_count / total_requests if total_requests > 0 else 0.0

        # Calculate average entry age
        current_time = time.time()
        entry_ages = []
        for entry in self.cache.values():
            age = current_time - entry["timestamp"]
            entry_ages.append(age)

        avg_age = sum(entry_ages) / len(entry_ages) if entry_ages else 0.0

        return {
            "hit_rate": hit_rate,
            "hit_count": self.hit_count,
            "miss_count": self.miss_count,
            "cache_size": len(self.cache),
            "max_size": self.max_size,
            "ttl_seconds": self.ttl_seconds,
            "avg_entry_age_seconds": avg_age,
            "utilization_percent": (len(self.cache) / self.max_size) * 100
        }

    def clear_cache(self) -> None:
        """Clear all cache entries."""
        cleared_count = len(self.cache)
        self.cache.clear()
        self.access_times.clear()
        self._save_cache_to_storage()
        self.logger.info(f"Cleared {cleared_count} cache entries")

    def warm_cache(self, signatures_and_solutions: List[Tuple[str, Dict]]) -> None:
        """
        Warm cache with pre-computed solutions.

        Args:
            signatures_and_solutions: List of (signature, solution) tuples
        """
        for signature, solution in signatures_and_solutions:
            if signature not in self.cache:
                self.cache_solution(signature, solution)

        self.logger.info(f"Warmed cache with {len(signatures_and_solutions)} entries")

    def _load_cache_from_storage(self) -> None:
        """Load cache from persistent storage."""
        try:
            if not os.path.exists(self.storage_path):
                self.logger.debug(f"No cache file found at {self.storage_path}")
                return

            with open(self.storage_path, 'r', encoding='utf-8') as f:
                data = json.load(f)

            # Filter out expired entries
            current_time = time.time()
            valid_entries = 0
            expired_entries = 0

            for key, entry in data.get("cache", {}).items():
                if current_time - entry.get("timestamp", 0) < self.ttl_seconds:
                    self.cache[key] = entry
                    self.access_times[key] = entry.get("timestamp", current_time)
                    valid_entries += 1
                else:
                    expired_entries += 1

            self.hit_count = data.get("hit_count", 0)
            self.miss_count = data.get("miss_count", 0)

            self.logger.info(f"Loaded cache from storage: {valid_entries} valid, "
                           f"{expired_entries} expired entries")

        except Exception as e:
            self.logger.warning(f"Failed to load cache from storage: {e}")

    def _save_cache_to_storage(self) -> None:
        """Save cache to persistent storage."""
        try:
            # Create directory if it doesn't exist
            storage_dir = os.path.dirname(self.storage_path)
            if storage_dir and not os.path.exists(storage_dir):
                os.makedirs(storage_dir, exist_ok=True)

            data = {
                "cache": self.cache,
                "hit_count": self.hit_count,
                "miss_count": self.miss_count,
                "last_saved": datetime.utcnow().isoformat()
            }

            # Write to temporary file first, then rename for atomicity
            temp_path = self.storage_path + ".tmp"
            with open(temp_path, 'w', encoding='utf-8') as f:
                json.dump(data, f, indent=2)

            # Atomic rename
            if os.path.exists(self.storage_path):
                os.replace(temp_path, self.storage_path)
            else:
                os.rename(temp_path, self.storage_path)

            self.logger.debug(f"Saved {len(self.cache)} cache entries to storage")

        except Exception as e:
            self.logger.warning(f"Failed to save cache to storage: {e}")

    def cleanup_expired_entries(self) -> int:
        """
        Clean up expired cache entries.

        Returns:
            Number of entries removed
        """
        current_time = time.time()
        expired_keys = []

        for key, entry in self.cache.items():
            if current_time - entry["timestamp"] >= self.ttl_seconds:
                expired_keys.append(key)

        for key in expired_keys:
            del self.cache[key]
            del self.access_times[key]

        if expired_keys:
            self.logger.info(f"Cleaned up {len(expired_keys)} expired cache entries")
            self._save_cache_to_storage()

        return len(expired_keys)


class AgentSelector:
    def __init__(self, team: Team, rng: Optional[random.Random] = None):
        self.team = team
        self.rng = rng or random.Random()

    def select(self, step: MDAPStep) -> ModelConfig:
        members = self.team.members
        if not members:
            raise ValueError("Team has no members")

        weights: List[float] = []
        for member in members:
            weight = 1.0
            if step.task_type and member.problem_type_specialization:
                if step.task_type in member.problem_type_specialization:
                    weight += 1.0
            if member.performance_metrics and "success_rate" in member.performance_metrics:
                weight *= max(0.1, member.performance_metrics["success_rate"])
            weights.append(weight)

        total = sum(weights)
        if total <= 0:
            return members[0]

        pick = self.rng.uniform(0, total)
        cumulative = 0.0
        for member, weight in zip(members, weights):
            cumulative += weight
            if cumulative >= pick:
                return member
        return members[-1]


class MDAPLoadBalancer:
    """
    Balances MDAP task load across available agents based on capability and performance.

    Features:
    - Multi-dimensional agent scoring (capability, load, performance, cost)
    - Historical performance tracking
    - Domain specialization tracking
    - Dynamic agent addition/removal
    - Graceful failure handling
    """

    def __init__(self, available_agents: List[ModelConfig]):
        """
        Initialize load balancer.

        Args:
            available_agents: List of available agent configurations
        """
        self.available_agents = available_agents
        self.agent_load: Dict[str, int] = {agent.model_id: 0 for agent in available_agents}
        self.agent_performance: Dict[str, Dict[str, float]] = {
            agent.model_id: {
                "success_rate": 1.0,
                "total_tasks": 0,
                "successful_tasks": 0,
                "avg_response_time": 0.0,
                "last_updated": time.time()
            }
            for agent in available_agents
        }
        self.agent_specializations: Dict[str, List[str]] = {}
        self.logger = logging.getLogger(__name__)

    def select_agent_for_task(self,
                             task: MDAPStep,
                             agents: Optional[List[ModelConfig]] = None) -> ModelConfig:
        """
        Select the best agent for a specific MDAP task.

        Selection criteria:
        - Capability match (agent has required skills)
        - Current load (prefer less loaded agents)
        - Historical performance (prefer higher success rate)
        - Cost efficiency (prefer cheaper agents for simple tasks)
        - Specialization match (prefer domain specialists)

        Args:
            task: The MDAP step to execute
            agents: Optional list of agents to choose from (uses all if None)

        Returns:
            Best ModelConfig for the task

        Raises:
            ValueError: If no agents available
        """
        candidate_agents = agents or self.available_agents

        if not candidate_agents:
            raise ValueError("No agents available for task assignment")

        # Score each agent
        agent_scores = []

        for agent in candidate_agents:
            score = self._calculate_agent_score(agent, task)
            agent_scores.append((agent, score))

        # Sort by score descending
        agent_scores.sort(key=lambda x: x[1], reverse=True)

        selected_agent = agent_scores[0][0]
        self.agent_load[selected_agent.model_id] += 1

        self.logger.debug(f"Selected agent {selected_agent.model_id} for task {task.step_id} "
                         f"(score: {agent_scores[0][1]:.3f})")

        return selected_agent

    def _calculate_agent_score(self,
                              agent: ModelConfig,
                              task: MDAPStep) -> float:
        """
        Calculate agent suitability score for a task.

        Returns 0.0-1.0 based on:
        - Capability match: 40%
        - Load availability: 25%
        - Historical performance: 20%
        - Cost efficiency: 15%

        Args:
            agent: Agent configuration
            task: MDAP step to execute

        Returns:
            Score between 0.0 and 1.0
        """
        # 1. Capability match score (40% weight)
        capability_score = self._calculate_capability_score(agent, task)

        # 2. Load availability score (25% weight)
        load_score = self._calculate_load_score(agent)

        # 3. Historical performance score (20% weight)
        performance_score = self._calculate_performance_score(agent)

        # 4. Cost efficiency score (15% weight)
        cost_score = self._calculate_cost_score(agent, task)

        # Weighted combination
        total_score = (
            capability_score * 0.40 +
            load_score * 0.25 +
            performance_score * 0.20 +
            cost_score * 0.15
        )

        return min(1.0, max(0.0, total_score))

    def _calculate_capability_score(self, agent: ModelConfig, task: MDAPStep) -> float:
        """Calculate capability match score (0.0-1.0)."""
        score = 0.5  # Base score

        # Check problem type specialization
        if agent.problem_type_specialization:
            if task.task_type in agent.problem_type_specialization:
                score += 0.3

        # Check domain specialization
        if agent.model_id in self.agent_specializations:
            specializations = self.agent_specializations[agent.model_id]
            if task.task_type in specializations:
                score += 0.2

        return min(1.0, score)

    def _calculate_load_score(self, agent: ModelConfig) -> float:
        """Calculate load availability score (0.0-1.0)."""
        current_load = self.agent_load.get(agent.model_id, 0)
        total_load = sum(self.agent_load.values())

        if total_load == 0:
            return 1.0

        # Higher score for lower load
        load_ratio = current_load / max(1, total_load)
        return 1.0 - load_ratio

    def _calculate_performance_score(self, agent: ModelConfig) -> float:
        """Calculate historical performance score (0.0-1.0)."""
        perf = self.agent_performance.get(agent.model_id, {})
        return perf.get("success_rate", 1.0)

    def _calculate_cost_score(self, agent: ModelConfig, task: MDAPStep) -> float:
        """
        Calculate cost efficiency score (0.0-1.0).

        Prefer cheaper models for simple tasks, but allow expensive models
        for complex tasks.
        """
        # Base score on model size/cost (heuristic)
        model_id_lower = agent.model_id.lower()

        # Simple cost categorization
        if any(x in model_id_lower for x in ['haiku', 'mini', 'small', '3.5']):
            base_cost = 0.2  # Low cost
        elif any(x in model_id_lower for x in ['sonnet', '4', 'medium']):
            base_cost = 0.5  # Medium cost
        elif any(x in model_id_lower for x in ['opus', 'turbo', 'large']):
            base_cost = 0.8  # High cost
        else:
            base_cost = 0.5  # Unknown/medium

        # For simple tasks, prefer cheaper models
        if task.priority <= 3:
            return 1.0 - base_cost
        # For complex tasks, cost matters less
        else:
            return 0.7  # Neutral

    def update_agent_performance(self,
                                agent_id: str,
                                success: bool,
                                response_time: float,
                                task_complexity: float) -> None:
        """
        Update agent performance tracking.

        Args:
            agent_id: Model identifier
            success: Whether the task succeeded
            response_time: Task execution time in seconds
            task_complexity: Task complexity score (0.0-1.0)
        """
        if agent_id not in self.agent_performance:
            self.agent_performance[agent_id] = {
                "success_rate": 1.0,
                "total_tasks": 0,
                "successful_tasks": 0,
                "avg_response_time": 0.0,
                "last_updated": time.time()
            }

        perf = self.agent_performance[agent_id]
        perf["total_tasks"] += 1
        if success:
            perf["successful_tasks"] += 1

        # Update success rate
        perf["success_rate"] = perf["successful_tasks"] / perf["total_tasks"]

        # Update average response time (exponential moving average)
        alpha = 0.2  # Smoothing factor
        perf["avg_response_time"] = (
            alpha * response_time +
            (1 - alpha) * perf["avg_response_time"]
        )

        perf["last_updated"] = time.time()

        # Reduce load counter
        if agent_id in self.agent_load and self.agent_load[agent_id] > 0:
            self.agent_load[agent_id] -= 1

        self.logger.debug(f"Updated performance for {agent_id}: "
                         f"success_rate={perf['success_rate']:.3f}, "
                         f"total_tasks={perf['total_tasks']}")

    def add_agent_specialization(self,
                                agent_id: str,
                                specialization: str) -> None:
        """
        Add a domain specialization for an agent.

        Args:
            agent_id: Model identifier
            specialization: Domain/task type the agent specializes in
        """
        if agent_id not in self.agent_specializations:
            self.agent_specializations[agent_id] = []

        if specialization not in self.agent_specializations[agent_id]:
            self.agent_specializations[agent_id].append(specialization)
            self.logger.info(f"Added specialization '{specialization}' to agent {agent_id}")

    def get_agent_statistics(self) -> Dict[str, Dict[str, Any]]:
        """
        Get statistics for all agents.

        Returns:
            Dict mapping agent_id to statistics
        """
        stats = {}

        for agent in self.available_agents:
            agent_id = agent.model_id
            stats[agent_id] = {
                "current_load": self.agent_load.get(agent_id, 0),
                "performance": self.agent_performance.get(agent_id, {}),
                "specializations": self.agent_specializations.get(agent_id, [])
            }

        return stats

    def reset_load_counters(self) -> None:
        """Reset all load counters (useful for periodic cleanup)."""
        for agent_id in self.agent_load:
            self.agent_load[agent_id] = 0
        self.logger.debug("Reset all load counters")


class AdaptiveThresholdManager:
    """
    Manages adaptive voting thresholds based on performance metrics.

    Features:
    - Dynamic k-value calculation based on task complexity
    - Performance-based threshold adaptation
    - Trend analysis and tracking
    - Task-type-specific tuning
    - Mathematical rigor (follows MDAP specification)
    """

    def __init__(self,
                 initial_k: int = 3,
                 min_k: int = 1,
                 max_k: int = 10):
        """
        Initialize threshold manager.

        Args:
            initial_k: Initial voting threshold
            min_k: Minimum allowed k value
            max_k: Maximum allowed k value
        """
        self.current_k = initial_k
        self.min_k = min_k
        self.max_k = max_k
        self.performance_history: List[Dict[str, Any]] = []
        self.target_success_rate = 0.95
        self.logger = logging.getLogger(__name__)

    def calculate_optimal_k(self,
                           task_complexity: float,
                           task_type: str,
                           recent_performance: Optional[List[Dict]] = None) -> int:
        """
        Calculate optimal k value based on task and performance.

        Algorithm from specification:
        - k_min = Θ(ln s) for target success probability
        - Higher complexity → higher k
        - Lower recent success rate → higher k
        - Cap at max_k

        Args:
            task_complexity: Task complexity score (0.0-1.0)
            task_type: Type of task (decomposition, solution, etc.)
            recent_performance: Optional recent performance metrics

        Returns:
            Optimal k value for voting
        """
        # Base k on complexity using logarithmic scaling
        # k ≈ ln(steps) for target success probability
        base_k = max(self.min_k, int(task_complexity * 10))

        # Get recent performance
        perf_history = recent_performance or self.performance_history

        if perf_history:
            # Calculate recent success rate (last 10 tasks)
            recent_window = perf_history[-10:]
            recent_success = sum(
                1 for p in recent_window if p.get('success', False)
            ) / len(recent_window)

            # Adjust k based on success rate
            if recent_success < self.target_success_rate:
                # Increase k to improve reliability
                k_adjustment = int((self.target_success_rate - recent_success) * 10)
                base_k = min(self.max_k, base_k + k_adjustment + 1)
            elif recent_success > 0.98:
                # Can decrease k for efficiency
                base_k = max(self.min_k, base_k - 1)

        # Task-type specific adjustments
        type_multipliers = {
            "critical": 1.5,      # Higher k for critical tasks
            "decomposition": 1.2, # Higher k for decomposition (foundational)
            "solution": 1.0,      # Standard k for solutions
            "validation": 1.3,    # Higher k for validation
            "patch": 0.9,         # Lower k for patches (iterative)
            "analysis": 1.1,      # Slightly higher for analysis
            "general": 1.0        # Default
        }

        multiplier = type_multipliers.get(task_type, 1.0)
        final_k = int(base_k * multiplier)

        # Ensure within bounds
        final_k = max(self.min_k, min(self.max_k, final_k))

        self.logger.debug(f"Calculated optimal k={final_k} for {task_type} task "
                         f"(complexity={task_complexity:.2f})")

        return final_k

    def update_threshold(self, task_result: Dict[str, Any]) -> int:
        """
        Update voting threshold based on task performance.

        Args:
            task_result: Dict with success, confidence, complexity

        Returns:
            Updated k value
        """
        # Record performance
        self.performance_history.append({
            "success": task_result.get("success", False),
            "confidence": task_result.get("confidence", 0.5),
            "complexity": task_result.get("complexity", 5.0),
            "k_value": self.current_k,
            "timestamp": time.time()
        })

        # Keep only recent history (last 100 entries)
        if len(self.performance_history) > 100:
            self.performance_history = self.performance_history[-100:]

        # Calculate recent success rate
        recent_success = self._calculate_recent_success_rate()

        # Adapt threshold
        if recent_success < self.target_success_rate - 0.05:
            # Success rate too low, increase k
            self.current_k = min(self.max_k, self.current_k + 1)
            self.logger.info(f"Increased k to {self.current_k} (success rate: {recent_success:.3f})")
        elif recent_success > self.target_success_rate + 0.05:
            # Success rate high, can decrease k
            self.current_k = max(self.min_k, self.current_k - 1)
            self.logger.info(f"Decreased k to {self.current_k} (success rate: {recent_success:.3f})")

        return self.current_k

    def _calculate_recent_success_rate(self, window: int = 10) -> float:
        """
        Calculate success rate from recent history.

        Args:
            window: Number of recent tasks to consider

        Returns:
            Success rate (0.0-1.0)
        """
        if not self.performance_history:
            return 1.0  # Default to high success rate

        recent = self.performance_history[-window:]
        successful = sum(1 for p in recent if p.get("success", False))
        return successful / len(recent)

    def get_adaptation_trend(self) -> str:
        """
        Get trend of k value adaptations.

        Returns:
            'increasing', 'decreasing', or 'stable'
        """
        if len(self.performance_history) < 10:
            return 'stable'

        recent_ks = [p['k_value'] for p in self.performance_history[-10:]]

        # Check monotonic trends
        increasing = all(recent_ks[i] <= recent_ks[i+1] for i in range(len(recent_ks)-1))
        decreasing = all(recent_ks[i] >= recent_ks[i+1] for i in range(len(recent_ks)-1))

        if increasing and recent_ks[-1] > recent_ks[0]:
            return 'increasing'
        elif decreasing and recent_ks[-1] < recent_ks[0]:
            return 'decreasing'
        else:
            return 'stable'

    def get_statistics(self) -> Dict[str, Any]:
        """
        Get threshold manager statistics.

        Returns:
            Dict with current_k, trend, success_rate, etc.
        """
        recent_success = self._calculate_recent_success_rate()

        return {
            "current_k": self.current_k,
            "min_k": self.min_k,
            "max_k": self.max_k,
            "target_success_rate": self.target_success_rate,
            "recent_success_rate": recent_success,
            "adaptation_trend": self.get_adaptation_trend(),
            "total_tracked": len(self.performance_history),
            "performance_history_size": len(self.performance_history)
        }

    def reset_history(self) -> None:
        """Reset performance history (useful for major system changes)."""
        self.performance_history.clear()
        self.logger.info("Reset performance history")


class MDAPOrchestrator:
    """
    Enhanced MDAP Orchestrator with:
    - Advanced caching (MDAPCacheManager)
    - Load balancing (MDAPLoadBalancer)
    - Adaptive thresholds (AdaptiveThresholdManager)
    - ACE+Steer integration
    - Guardrails validation for vote security
    - Comprehensive metrics tracking
    """

    def __init__(self,
                 team: Team,
                 config: MDAPConfig,
                 ace_steer_bridge: Optional[AceSteerBridge] = None,
                 cache_manager: Optional[MDAPCacheManager] = None,
                 load_balancer: Optional[MDAPLoadBalancer] = None,
                 adaptive_threshold_manager: Optional[AdaptiveThresholdManager] = None,
                 guardrails_adapter: Optional[GuardrailsAdapter] = None):
        """
        Initialize MDAP Orchestrator with enhanced components.

        Args:
            team: Team of agents to use
            config: MDAP configuration
            ace_steer_bridge: Optional ACE+Steer bridge
            cache_manager: Optional enhanced cache manager (uses MDAPCache if None)
            load_balancer: Optional load balancer for agent selection
            adaptive_threshold_manager: Optional adaptive threshold manager
            guardrails_adapter: Optional Guardrails adapter for vote validation
        """
        self.team = team
        self.config = config
        self.selector = AgentSelector(team)

        # Initialize Guardrails adapter
        self.guardrails_adapter = guardrails_adapter
        if guardrails_adapter is None and GUARDRAILS_ADAPTER_AVAILABLE:
            try:
                self.guardrails_adapter = create_adapter(
                    enabled=config.get('guardrails_enabled', True),
                    default_on_fail=config.get('guardrails_on_fail', 'filter')
                )
                logger.info("Guardrails adapter initialized for MDAP Orchestrator")
            except Exception as e:
                logger.warning(f"Failed to initialize Guardrails adapter: {e}")
                self.guardrails_adapter = None

        # Initialize RedFlagger with Guardrails
        self.red_flagger = RedFlagger(config.red_flag_rules, self.guardrails_adapter)

        # Enhanced caching - use MDAPCacheManager if provided, otherwise basic MDAPCache
        if cache_manager and config.cache_ttl_seconds:
            self.cache_manager = cache_manager
            self.cache = cache_manager  # For backward compatibility
        elif config.cache_ttl_seconds:
            self.cache_manager = MDAPCacheManager(
                max_size=config.cache_max_size,
                ttl_seconds=config.cache_ttl_seconds
            )
            self.cache = self.cache_manager
        else:
            self.cache_manager = None
            self.cache = None

        # Load balancer for intelligent agent selection
        self.load_balancer = load_balancer or MDAPLoadBalancer(team.members)

        # Adaptive threshold manager
        self.adaptive_threshold_manager = adaptive_threshold_manager or AdaptiveThresholdManager(
            initial_k=config.k_min,
            min_k=1,
            max_k=config.k_max
        )

        # ACE + Steer Integration with enhanced configuration
        # Store local references to helper functions to avoid import issues
        _is_ace_enabled = is_ace_enabled
        _is_steer_enabled = is_steer_enabled
        _is_unified_bridge_enabled = is_unified_bridge_enabled

        # Check if functions are callable before using them
        try:
            if callable(_is_ace_enabled):
                self.ace_enabled = _is_ace_enabled(config)
            else:
                logger.warning("⚠️ is_ace_enabled is not callable, using default False")
                self.ace_enabled = False
        except Exception as e:
            logger.warning(f"⚠️ Error checking ACE enabled status: {e}")
            self.ace_enabled = False

        try:
            if callable(_is_steer_enabled):
                self.steer_enabled = _is_steer_enabled(config)
            else:
                logger.warning("⚠️ is_steer_enabled is not callable, using default False")
                self.steer_enabled = False
        except Exception as e:
            logger.warning(f"⚠️ Error checking Steer enabled status: {e}")
            self.steer_enabled = False

        try:
            if callable(_is_unified_bridge_enabled):
                self.unified_bridge_enabled = _is_unified_bridge_enabled(config)
            else:
                logger.warning("⚠️ is_unified_bridge_enabled is not callable, using default False")
                self.unified_bridge_enabled = False
        except Exception as e:
            logger.warning(f"⚠️ Error checking unified bridge status: {e}")
            self.unified_bridge_enabled = False

        self.ace_steer_bridge = ace_steer_bridge

        # Auto-initialize bridge if enabled but not provided
        if self.unified_bridge_enabled and not self.ace_steer_bridge and AceSteerBridge is not None:
            try:
                skillbook_path = config.get('ace_skillbook_path', './ace_skillbook.json')
                self.ace_steer_bridge = AceSteerBridge(
                    ace_agent_id=f"mdap_orchestrator_{team.name}",
                    skillbook_path=skillbook_path
                )
                logger.info(f"✅ Auto-initialized ACE+Steer bridge for MDAP team: {team.name}")
            except Exception as e:
                logger.warning(f"⚠️ Failed to initialize ACE+Steer bridge: {e}")
                self.ace_steer_bridge = None
                self.unified_bridge_enabled = False

        # Log effective configuration
        logger.info(f"MDAP Orchestrator {team.name} configuration:")
        logger.info(f"  - ACE: {self.ace_enabled}")
        logger.info(f"  - Steer: {self.steer_enabled}")
        logger.info(f"  - Unified Bridge: {self.unified_bridge_enabled}")

        self.metrics = {
            "steps_completed": 0,
            "steps_failed": 0,
            "red_flags": 0,
            "votes_cast": 0,
            "cache_hits": 0,
            "cache_misses": 0,
            "adaptive_k_adjustments": 0
        }

    def execute_task(self, task: MDAPTask) -> MDAPRunResult:
        step_results: Dict[str, MDAPStepResult] = {}
        for step in task.steps:
            result = self._execute_step_with_retries(step, task)
            step_results[step.step_id] = result
            if result.status == "success":
                self.metrics["steps_completed"] += 1
            else:
                self.metrics["steps_failed"] += 1

        return MDAPRunResult(task_id=task.task_id, step_results=step_results, metrics=self.metrics.copy())

    def _execute_step_with_retries(self, step: MDAPStep, task: MDAPTask) -> MDAPStepResult:
        retries = 0
        vote_result = self._execute_step(step, task)
        while vote_result.winner is None and retries < task.max_retries:
            retries += 1
            vote_result = self._execute_step(step, task)

        status = "success" if vote_result.winner is not None else "failure"
        return MDAPStepResult(step_id=step.step_id, vote_result=vote_result, status=status, retries=retries)

    def _execute_step(self, step: MDAPStep, task: MDAPTask) -> MDAPVoteResult:
        """
        Execute MDAP step with enhanced caching, load balancing, and adaptive thresholds.

        Uses:
        - MDAPCacheManager for caching results
        - AdaptiveThresholdManager for dynamic k-values
        - MDAPLoadBalancer for agent selection (via _sample_candidate)
        """
        start = time.time()
        votes: Dict[str, int] = {}
        red_flags = 0
        attempts = 0
        flagged_reasons: List[str] = []
        errors: List[str] = []

        # Calculate optimal k using adaptive threshold manager
        k_value = self.adaptive_threshold_manager.calculate_optimal_k(
            task_complexity=step.priority / 10.0,  # Normalize priority to 0-1
            task_type=step.task_type,
            recent_performance=self.adaptive_threshold_manager.performance_history
        )

        cache_key = self._cache_key(step, task)

        # Check cache using enhanced cache manager
        if self.cache_manager:
            cached = self.cache_manager.get_cached_solution(cache_key)
            if cached is not None:
                self.metrics["cache_hits"] += 1
                logger.debug(f"Cache hit for step {step.step_id}")
                return MDAPVoteResult(
                    winner=cached,
                    votes={canonicalize_candidate(cached): 1},
                    red_flags=0,
                    confidence=1.0,
                    attempts=0,
                    duration_seconds=0.0
                )
            elif self.cache_manager:
                self.metrics["cache_misses"] += 1

        while attempts < self.config.max_votes_per_step:
            if time.time() - start > self.config.timeout_seconds:
                errors.append("timeout")
                break

            raw_text, candidate = self._sample_candidate(step)
            attempts += 1
            self.metrics["votes_cast"] += 1

            is_flagged, reasons = self.red_flagger.is_flagged(raw_text, candidate, step.expected_schema)
            if is_flagged:
                red_flags += 1
                self.metrics["red_flags"] += 1
                flagged_reasons.extend(reasons)
                continue

            # Guardrails vote key validation (before counting vote)
            if self.guardrails_adapter and self.guardrails_adapter.is_available():
                try:
                    # Check for Guardrails-rejected candidates
                    if isinstance(candidate, dict) and candidate.get("__guardrails_rejected__"):
                        logger.debug(
                            f"Skipping Guardrails-rejected vote for step {step.step_id}",
                            reasons=candidate.get("reasons", [])
                        )
                        continue

                    # Validate vote key for malicious patterns
                    candidate_key = canonicalize_candidate(candidate)

                    # Additional validation for vote key
                    key_validation = self.guardrails_adapter.validate_output(
                        output=candidate_key,
                        validators=["toxic_language", "secrets_detection"],
                        on_fail="filter",
                        correlation_id=f"mdap_vote_{step.step_id}_{attempts}"
                    )

                    if not key_validation.is_valid:
                        logger.warning(
                            f"Guardrails rejected vote key for step {step.step_id}",
                            failures=[f.get('message', '') for f in key_validation.failures]
                        )
                        continue  # Skip this vote

                    votes[candidate_key] = votes.get(candidate_key, 0) + 1

                except Exception as e:
                    logger.warning(f"Guardrails vote key validation error for {step.step_id}: {e}")
                    # Fallback to standard voting on error
                    candidate_key = canonicalize_candidate(candidate)
                    votes[candidate_key] = votes.get(candidate_key, 0) + 1
            else:
                candidate_key = canonicalize_candidate(candidate)
                votes[candidate_key] = votes.get(candidate_key, 0) + 1

            if self._has_k_ahead(votes, k_value):
                try:
                    winner_key = max(votes, key=votes.get)
                    winner = self._decode_vote(winner_key)
                    confidence = votes[winner_key] / max(1, sum(votes.values()))

                    # Cache the winning result
                    if self.cache_manager:
                        self.cache_manager.cache_solution(
                            cache_key,
                            winner,
                            metadata={
                                "task_type": step.task_type,
                                "priority": step.priority,
                                "k_value": k_value,
                                "attempts": attempts
                            }
                        )
                    elif self.cache:
                        self.cache.set(cache_key, winner)

                    # Update adaptive threshold based on result
                    self.adaptive_threshold_manager.update_threshold({
                        "success": True,
                        "confidence": confidence,
                        "complexity": step.priority / 10.0
                    })

                    return MDAPVoteResult(
                        winner=winner,
                        votes=votes,
                        red_flags=red_flags,
                        confidence=confidence,
                        attempts=attempts,
                        duration_seconds=time.time() - start,
                        flagged_reasons=flagged_reasons,
                        errors=errors
                    )
                except (ValueError, KeyError, ZeroDivisionError):
                    logger.warning("Failed to determine winner despite having k-ahead")
                    continue

        return self._fallback_result(step, task, votes, red_flags, attempts, start, flagged_reasons, errors)

    def _fallback_result(
        self,
        step: MDAPStep,
        task: MDAPTask,
        votes: Dict[str, int],
        red_flags: int,
        attempts: int,
        start: float,
        flagged_reasons: List[str],
        errors: List[str]
    ) -> MDAPVoteResult:
        if self.config.fallback_policy != "escalate_then_best_effort":
            return MDAPVoteResult(
                winner=None,
                votes=votes,
                red_flags=red_flags,
                confidence=0.0,
                attempts=attempts,
                duration_seconds=time.time() - start,
                flagged_reasons=flagged_reasons,
                errors=errors
            )

        if votes:
            try:
                winner_key = max(votes, key=votes.get)
                winner = self._decode_vote(winner_key)
                confidence = votes[winner_key] / max(1, sum(votes.values()))
                return MDAPVoteResult(
                    winner=winner,
                    votes=votes,
                    red_flags=red_flags,
                    confidence=confidence,
                    attempts=attempts,
                    duration_seconds=time.time() - start,
                    flagged_reasons=flagged_reasons,
                    errors=errors
                )
            except (ValueError, KeyError, ZeroDivisionError):
                logger.warning("Failed to determine best effort winner")

        return MDAPVoteResult(
            winner=None,
            votes=votes,
            red_flags=red_flags,
            confidence=0.0,
            attempts=attempts,
            duration_seconds=time.time() - start,
            flagged_reasons=flagged_reasons,
            errors=errors
        )

    def _sample_candidate(self, step: MDAPStep) -> Tuple[str, Any]:
        agent = self.selector.select(step)
        system_prompt = self._system_prompt_for_step(step)
        user_prompt = self._user_prompt_for_step(step)

        # ACE + Steer: Skill Injection (ACE only)
        original_user_prompt = user_prompt
        if self.ace_enabled and self.ace_steer_bridge:
            try:
                user_prompt = self.ace_steer_bridge.prepare_prompt(
                    task=user_prompt,
                    model=agent.model_id
                )
            except Exception as e:
                logger.warning(f"⚠️ ACE prepare_prompt failed, using original prompt: {e}")
                user_prompt = original_user_prompt

        messages = _compose_messages(system_prompt, user_prompt)

        response = _request_openai_compatible_chat(
            api_key=agent.api_key,
            base_url=agent.api_base,
            model=agent.model_id,
            messages=messages,
            temperature=step.temperature_override or agent.temperature,
            top_p=agent.top_p,
            frequency_penalty=agent.frequency_penalty,
            presence_penalty=agent.presence_penalty,
            max_tokens=step.max_tokens_override or agent.max_tokens,
            seed=agent.seed,
            stop_sequences=step.stop_sequences or agent.stop_sequences,
            logprobs=agent.logprobs,
            top_logprobs=agent.top_logprobs,
            response_format=agent.response_format,
            stream=agent.stream,
            user=agent.user,
            reasoning_effort=agent.reasoning_effort,
            max_retries=agent.max_retries,
            timeout=agent.timeout,
            organization=agent.organization,
            response_model=agent.response_model,
            tools=agent.tools,
            tool_choice=agent.tool_choice,
            system_fingerprint=agent.system_fingerprint,
            deployment_id=agent.deployment_id,
            encoding_format=agent.encoding_format,
            max_input_tokens=agent.max_input_tokens,
            stop_token=agent.stop_token,
            best_of=agent.best_of,
            logprobs_offset=agent.logprobs_offset,
            suffix=agent.suffix,
            presence_penalty_range=agent.presence_penalty_range,
            frequency_penalty_range=agent.frequency_penalty_range,
            stop_token_id=agent.stop_token_id,
            response_json_format=agent.response_json_format,
            max_output_tokens=agent.max_output_tokens,
            stream_options=agent.stream_options,
            logprobs_type=agent.logprobs_type,
            top_k=agent.top_k,
            repetition_penalty=agent.repetition_penalty,
            length_penalty=agent.length_penalty,
            early_stopping=agent.early_stopping,
            num_beams=agent.num_beams,
            do_sample=agent.do_sample,
            temperature_fallback=agent.temperature_fallback,
            top_p_fallback=agent.top_p_fallback,
            max_time=agent.max_time,
            return_full_text=agent.return_full_text,
            tokenizer_config=agent.tokenizer_config,
            model_kwargs=agent.model_kwargs
        )

        raw_text = response or ""

        # ACE + Steer: Verification & Learning
        # Check if Steer is enabled for verification, ACE for learning
        if self.steer_enabled and self.ace_steer_bridge and raw_text:
            try:
                verifications = ["slop"]
                if step.expected_schema or step.task_type in ["content_analysis", "decomposition"]:
                    verifications.append("json")

                steer_v = self.ace_steer_bridge.verify_and_learn(
                    query=original_user_prompt,
                    output=raw_text,
                    verifications=verifications,
                    model=agent.model_id
                )
                if not steer_v["all_passed"]:
                    logger.warning(f"MDAP Step {step.step_id} failed Steer verification: {steer_v['failed_verifications']}")
            except Exception as e:
                logger.warning(f"⚠️ Steer verification failed for MDAP step {step.step_id}: {e}")
        elif self.ace_enabled and self.ace_steer_bridge and raw_text:
            # ACE enabled but Steer disabled - do ACE learning only if we have feedback
            try:
                # This would require feedback source, skip for now
                pass
            except Exception as e:
                logger.warning(f"⚠️ ACE learning failed for MDAP step {step.step_id}: {e}")

        candidate = self._parse_candidate(raw_text, step.expected_schema)

        # Guardrails vote validation (after parsing, before returning)
        if self.guardrails_adapter and self.guardrails_adapter.is_available():
            try:
                # Validate candidate structure and content
                validation_result = self.guardrails_adapter.validate_output(
                    output=json.dumps(candidate) if isinstance(candidate, (dict, list)) else str(candidate),
                    validators=["vote_json", "toxic_language", "pii_filter"],
                    on_fail="filter",
                    correlation_id=f"mdap_{step.step_id}"
                )

                if not validation_result.is_valid:
                    logger.warning(
                        f"Guardrails validation failed for MDAP vote: {step.step_id}",
                        failures=[f.get('message', '') for f in validation_result.failures],
                        remediation=validation_result.remediation_applied
                    )

                    # If remediation was applied, use remediated output
                    if validation_result.remediation_applied and validation_result.output:
                        try:
                            remediated = json.loads(validation_result.output)
                            logger.info(f"Using Guardrails-remediated vote for {step.step_id}")
                            candidate = remediated
                        except:
                            # If remediation can't be parsed, return error candidate
                            candidate = {"error": "validation_failed", "reasons": validation_result.failures}
                    else:
                        # Mark as invalid vote (will be filtered out)
                        candidate = {"__guardrails_rejected__": True, "reasons": validation_result.failures}

            except Exception as e:
                logger.warning(f"Guardrails vote validation error for {step.step_id}: {e}")

        return raw_text, candidate

    def _parse_candidate(self, raw_text: str, schema: Optional[Dict[str, Any]]) -> Any:
        stripped = raw_text.strip()
        if not stripped:
            return {}

        try:
            expects_json = schema is not None and schema.get("type") in ("object", "array")
        except (AttributeError, TypeError):
            expects_json = False

        looks_like_json = stripped.startswith("{") or stripped.startswith("[")
        if expects_json or looks_like_json:
            parsed, error = _safe_json_loads(stripped)
            if parsed is not None:
                return parsed
            logger.warning("Failed to parse JSON candidate: %s", error)
            return {"raw": raw_text, "parse_error": error}
        return stripped

    def _system_prompt_for_step(self, step: MDAPStep) -> str:
        if step.system_prompt:
            return step.system_prompt

        system_map = {
            "content_analysis": self.team.content_analysis_system_prompt,
            "decomposition": self.team.decomposition_system_prompt,
            "solve": self.team.solver_system_prompt,
            "patch": self.team.patcher_system_prompt,
            "assemble": self.team.assembler_system_prompt,
            "red_team": self.team.red_team_system_prompt,
            "gold_team": self.team.gold_team_system_prompt
        }
        return system_map.get(step.task_type) or "You are a specialized AI agent. Follow the instructions precisely."

    def _user_prompt_for_step(self, step: MDAPStep) -> str:
        template_map = {
            "content_analysis": self.team.content_analysis_user_prompt_template,
            "decomposition": self.team.decomposition_user_prompt_template,
            "solve": self.team.solver_user_prompt_template,
            "patch": self.team.patcher_user_prompt_template,
            "assemble": self.team.assembler_user_prompt_template,
            "red_team": self.team.red_team_user_prompt_template,
            "gold_team": self.team.gold_team_user_prompt_template
        }
        template = template_map.get(step.task_type)
        if template and "{prompt}" in template:
            return template.format(prompt=step.prompt)
        return step.prompt

    def _has_k_ahead(self, votes: Dict[str, int], k_value: int) -> bool:
        if not votes:
            return False
        try:
            winner = max(votes, key=votes.get)
            winner_count = votes[winner]
            max_other = max((count for key, count in votes.items() if key != winner), default=0)
            return winner_count >= max_other + k_value
        except (ValueError, KeyError):
            return False

    def _compute_k_value(self, step: MDAPStep, task: MDAPTask) -> int:
        base_k = max(self.config.k_min, min(self.config.k_max, int(1 + step.priority)))
        if task.target_success_rate >= 0.98:
            base_k = min(self.config.k_max, base_k + 1)
        return base_k

    def _decode_vote(self, vote_key: str) -> Any:
        candidate, error = _safe_json_loads(vote_key)
        if candidate is not None:
            return candidate
        return vote_key

    def _cache_key(self, step: MDAPStep, task: MDAPTask) -> str:
        payload = f"{task.task_id}:{step.step_id}:{step.prompt}"
        return hashlib.sha256(payload.encode("utf-8")).hexdigest()

    def get_enhanced_statistics(self) -> Dict[str, Any]:
        """
        Get comprehensive statistics from all enhanced MDAP components.

        Returns:
            Dict with cache, load balancer, and adaptive threshold statistics
        """
        stats = {
            "orchestrator_metrics": self.metrics.copy(),
            "cache_stats": None,
            "load_balancer_stats": None,
            "adaptive_threshold_stats": None
        }

        if self.cache_manager:
            stats["cache_stats"] = self.cache_manager.get_cache_stats()

        if self.load_balancer:
            stats["load_balancer_stats"] = self.load_balancer.get_agent_statistics()

        if self.adaptive_threshold_manager:
            stats["adaptive_threshold_stats"] = self.adaptive_threshold_manager.get_statistics()

        return stats

    def cleanup(self) -> None:
        """
        Cleanup resources (save cache, reset counters, etc.).

        Call this before shutdown or when reinitializing.
        """
        if self.cache_manager:
            self.cache_manager._save_cache_to_storage()

        if self.load_balancer:
            self.load_balancer.reset_load_counters()

        logger.info("MDAP Orchestrator cleanup complete")
