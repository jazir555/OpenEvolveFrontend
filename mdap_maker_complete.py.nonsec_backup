@dataclass
class TaskDecomposition:
    """Represents a task decomposition result."""
    subtask1: Optional[Dict[str, Any]] = None
    subtask2: Optional[Dict[str, Any]] = None
    composition_function: Optional[str] = None
    is_atomic: bool = False
    confidence: float = 0.5


@dataclass
class MAKERRunMetrics:
    """Metrics for MAKER execution."""
    total_steps: int = 0
    total_votes: int = 0
    red_flags: int = 0
    decompositions: int = 0
    atomic_solves: int = 0
    voting_rounds: int = 0
    total_time: float = 0.0
    avg_confidence: float = 0.0


# =============================================================================
# ALGORITHM 3: get_vote - Get vote with red-flagging
# =============================================================================

class VoteCollector:
    """
    Algorithm 3: get_vote from the paper.

    Collects votes from agents with red-flagging to discard unreliable responses.

    From paper: "get_vote" (line 3-7):
    1: Input x, M
    2: while True do
    3:   r ∼ (M ◦ ϕ)(x)
    4:   if r has no red flags then
    5:     return ψa (r), ψx (r)
    6:   end if
    7: end while
    """

    def __init__(
        self,
        max_token_length: int = 750,
        max_retries: int = 10,
        temperature_first: float = 0.0,
        temperature_subsequent: float = 0.1,
        ace_steer_bridge: Optional[AceSteerBridge] = None,
        ace_enabled: bool = True
    ):
        self.max_token_length = max_token_length
        self.max_retries = max_retries
        self.temperature_first = temperature_first
        self.temperature_subsequent = temperature_subsequent
        self.attempt_count = 0
        
        # ACE + Steer Integration
        self.ace_enabled = ace_enabled and STEER_ACE_BRIDGE_AVAILABLE
        self.ace_steer_bridge = ace_steer_bridge
        
        if self.ace_enabled and not self.ace_steer_bridge:
            # Auto-initialize bridge if enabled but not provided
            self.ace_steer_bridge = AceSteerBridge(
                ace_agent_id="maker_vote_collector",
                skillbook_path="./ace_skillbook.json"
            )
            logger.info("Auto-initialized ACE+Steer bridge for MAKER VoteCollector")

    def get_vote(
        self,
        prompt: str,
        system_prompt: str,
        agent: ModelConfig,
        expected_schema: Optional[Dict[str, Any]] = None,
        parser: Optional[Callable[[str], Tuple[Any, Any]]] = None
    ) -> Tuple[Any, Any, str]:
        """
        Collect a single vote with red-flagging.

        Args:
            prompt: User prompt
            system_prompt: System prompt
            agent: Model configuration
            expected_schema: Optional schema for validation
            parser: Optional custom parser (returns (action, state))

        Returns:
            Tuple of (action, next_state, raw_text)

        Raises:
            RuntimeError: If max retries exceeded
        """
        for attempt in range(self.max_retries):
            self.attempt_count += 1

            # Use temperature=0 for first vote, 0.1 for subsequent
            temperature = self.temperature_first if attempt == 0 else self.temperature_subsequent

            # Generate response
            raw_text = self._call_llm(prompt, system_prompt, agent, temperature)

            # Check red flags
            if self._has_red_flags(raw_text, expected_schema):
                logger.debug(f"Vote {attempt + 1} red-flagged, retrying...")
                continue

            # Parse response
            if parser:
                try:
                    action, state = parser(raw_text)
                    return action, state, raw_text
                except Exception as e:
                    logger.warning(f"Parse error on vote {attempt + 1}: {e}")
                    continue
            else:
                # Default parsing
                action, state = self._default_parse(raw_text)
                return action, state, raw_text

        raise RuntimeError(f"Failed to get valid vote after {self.max_retries} attempts")

    def _call_llm(
        self,
        prompt: str,
        system_prompt: str,
        agent: ModelConfig,
        temperature: float
    ) -> str:
        """Call LLM with given parameters."""
        # ACE + Steer: Skill Injection
        original_prompt = prompt
        if self.ace_enabled and self.ace_steer_bridge:
            prompt = self.ace_steer_bridge.prepare_prompt(
                task=prompt,
                model=agent.model_id
            )

        messages = _compose_messages(system_prompt, prompt)

        response = _request_openai_compatible_chat(
            api_key=agent.api_key,
            base_url=agent.api_base,
            model=agent.model_id,
            messages=messages,
            temperature=temperature,
            max_tokens=self.max_token_length,
            **self._extract_agent_params(agent)
        )
        
        # ACE + Steer: Verification & Learning
        if self.ace_enabled and self.ace_steer_bridge and response:
            steer_v = self.ace_steer_bridge.verify_and_learn(
                query=original_prompt,
                output=response,
                verifications=["slop"], # General slop check
                model=agent.model_id
            )
            if not steer_v["all_passed"]:
                logger.warning(f"MAKER Vote failed Steer verification: {steer_v['failed_verifications']}")

        return response or ""

    def _has_red_flags(
        self,
        raw_text: str,
        expected_schema: Optional[Dict[str, Any]]
    ) -> bool:
        """
        Check for red flags indicating unreliable response.

        From paper Section 3.3: "Red-Flagging: Recognizing Signs of Unreliability"
        - Overly long responses
        - Incorrectly formatted responses
        """
        # Check length
        if self._approx_token_count(raw_text) > self.max_token_length * 0.9:
            return True

        # Check for basic format issues
        if not raw_text or raw_text.isspace():
            return True

        # Check for required structure
        if expected_schema:
            try:
                parsed = json.loads(raw_text)
                # Validate schema
                if not self._validate_schema(parsed, expected_schema):
                    return True
            except (json.JSONDecodeError, TypeError):
                # If JSON expected but not found
                if expected_schema.get("type") in ("object", "array"):
                    return True

        return False

    def _approx_token_count(self, text: str) -> int:
        """Approximate token count."""
        return max(1, int(len(text) / 4))

    def _validate_schema(self, data: Any, schema: Dict[str, Any]) -> bool:
        """Validate data against schema."""
        schema_type = schema.get("type")

        if schema_type == "object":
            if not isinstance(data, dict):
                return False
            required = schema.get("required", [])
            return all(key in data for key in required)
        elif schema_type == "array":
            return isinstance(data, list)
        elif schema_type == "string":
            return isinstance(data, str)
        elif schema_type in ("number", "integer"):
            return isinstance(data, (int, float))
        elif schema_type == "boolean":
            return isinstance(data, bool)

        return True

    def _default_parse(self, raw_text: str) -> Tuple[Any, Any]:
        """Default parser for responses without custom parser."""
        # Try to extract action and state
        # Look for patterns like "action = ..." and "next_state = ..."
        import re

        action_match = re.search(r'action\s*=\s*(.+?)(?:\n|$)', raw_text, re.IGNORECASE)
        state_match = re.search(r'next_state\s*=\s*(.+?)(?:\n|$)', raw_text, re.IGNORECASE)

        action = None
        state = None

        if action_match:
            action_str = action_match.group(1).strip()
            try:
                action = json.loads(action_str)
            except json.JSONDecodeError:
                action = action_str

        if state_match:
            state_str = state_match.group(1).strip()
            try:
                state = json.loads(state_str)
            except json.JSONDecodeError:
                state = state_str

        return action, state

    def _extract_agent_params(self, agent: ModelConfig) -> Dict[str, Any]:
        """Extract additional parameters from agent config."""
        return {
            "top_p": agent.top_p,
            "frequency_penalty": agent.frequency_penalty,
            "presence_penalty": agent.presence_penalty,
            "seed": agent.seed,
            "timeout": agent.timeout,
            "max_retries": agent.max_retries,
        }


# =============================================================================
# ALGORITHM 2: do_voting - First-to-ahead-by-k voting
# =============================================================================

class VotingEngine:
    """
    Algorithm 2: do_voting from the paper.

    Implements first-to-ahead-by-k voting mechanism.

    From paper (line 1-9):
    1: Input: x, M, k
    2: V ← {v : 0 ∀v}    # Vote counts
    3: while True do
    4:   y ← get_vote(x, M)
    5:   V [y] = V [y] + 1
    6:   if V [y] ≥ k + maxv̸=y V [v] then
    7:     return y
    8:   end if
    9: end while

    Also supports first-to-k voting (simpler variant).
    """

    def __init__(
        self,
        vote_collector: VoteCollector,
        max_rounds: int = 50,
        enable_first_to_ahead: bool = True
    ):
        self.vote_collector = vote_collector
        self.max_rounds = max_rounds
        self.enable_first_to_ahead = enable_first_to_ahead
        self.metrics = {
            "total_rounds": 0,
            "red_flags": 0,
            "votes_per_candidate": {}
        }

    def do_voting(
        self,
        prompt: str,
        system_prompt: str,
        agents: List[ModelConfig],
        k: int,
        expected_schema: Optional[Dict[str, Any]] = None,
        parser: Optional[Callable[[str], Tuple[Any, Any]]] = None
    ) -> Tuple[Any, Dict[str, int], MAKERRunMetrics]:
        """
        Perform voting until winner emerges.

        Args:
            prompt: User prompt
            system_prompt: System prompt
            agents: List of agents (will cycle through)
            k: Winning threshold
            expected_schema: Optional schema for validation
            parser: Optional custom parser

        Returns:
            Tuple of (winner, vote_counts, metrics)
        """
        votes: Dict[str, int] = {}
        agent_idx = 0
        round_num = 0

        while round_num < self.max_rounds:
            round_num += 1
            self.metrics["total_rounds"] += 1

            # Select agent (round-robin)
            agent = agents[agent_idx % len(agents)]
            agent_idx += 1

            # Collect vote
            try:
                action, state, raw_text = self.vote_collector.get_vote(
                    prompt, system_prompt, agent, expected_schema, parser
                )
            except RuntimeError as e:
                logger.warning(f"Vote collection failed: {e}")
                self.metrics["red_flags"] += 1
                continue

            # Canonicalize candidate for counting
            candidate_key = self._canonicalize_candidate(action, state)

            # Count vote
            votes[candidate_key] = votes.get(candidate_key, 0) + 1
            self.metrics["votes_per_candidate"] = votes.copy()

            # Check for winner
            if self._has_winner(votes, k):
                try:
                    winner_key = max(votes, key=votes.get)
                    winner = self._decode_vote(winner_key)
                    return winner, votes, self._create_metrics(round_num)
                except (ValueError, KeyError):
                    logger.warning("Failed to determine winner despite having votes")
                    continue

        # Timeout - return best effort
        logger.warning(f"Voting reached max rounds ({self.max_rounds}), returning best effort")
        if votes:
            try:
                winner_key = max(votes, key=votes.get)
                winner = self._decode_vote(winner_key)
                return winner, votes, self._create_metrics(round_num)
            except (ValueError, KeyError):
                logger.warning("Failed to determine best effort winner")

        return None, votes, self._create_metrics(round_num)

    def _canonicalize_candidate(self, action: Any, state: Any) -> str:
        """Convert candidate to canonical string for voting."""
        candidate = {"action": action, "state": state}
        return json.dumps(candidate, sort_keys=True, separators=(",", ":"), ensure_ascii=True)

    def _decode_vote(self, vote_key: str) -> Any:
        """Decode vote key back to candidate."""
        try:
            candidate = json.loads(vote_key)
            return candidate.get("action")
        except (json.JSONDecodeError, TypeError):
            return vote_key

    def _has_winner(self, votes: Dict[str, int], k: int) -> bool:
        """
        Check if any candidate has won.

        For first-to-ahead-by-k: V[y] ≥ k + max V[v≠y]
        For first-to-k: V[y] ≥ k
        """
        if not votes:
            return False

        try:
            leader = max(votes, key=votes.get)
            leader_count = votes[leader]

            if self.enable_first_to_ahead:
                # First-to-ahead-by-k
                max_other = max((count for key, count in votes.items() if key != leader), default=0)
                return leader_count >= max_other + k
            else:
                # First-to-k
                return leader_count >= k
        except (ValueError, KeyError):
            return False

    def _create_metrics(self, rounds: int) -> MAKERRunMetrics:
        """Create metrics object."""
        return MAKERRunMetrics(
            voting_rounds=rounds,
            total_votes=rounds,
            red_flags=self.metrics["red_flags"],
            avg_confidence=0.0  # Will be calculated externally
        )


# =============================================================================
# ALGORITHM 1: generate_solution - Main orchestration
# =============================================================================

class MAKEREngine:
    """
    Algorithm 1: generate_solution from the paper.

    Main orchestration for MAKER system.

    From paper (line 1-8):
    1: Input xo, M, k
    2: Initialize A ← []   # Action list
    3: Initialize x ← xo
    4: for s steps do
    5:   a, x ← do_voting(x, M, k)
    6:   Append a to A
    7: end for
    8: return A
    """

    def __init__(
        self,
        team: Team,
        k_ahead: int = 3,
        max_token_length: int = 750,
        max_steps: int = 1000,
        enable_first_to_ahead: bool = True,
        enable_red_flagging: bool = True,
        ace_steer_bridge: Optional[AceSteerBridge] = None,
        ace_enabled: bool = True
    ):
        self.team = team
        self.k_ahead = k_ahead
        self.max_token_length = max_token_length
        self.max_steps = max_steps
        self.enable_first_to_ahead = enable_first_to_ahead
        self.enable_red_flagging = enable_red_flagging
        
        # ACE + Steer Integration
        self.ace_enabled = ace_enabled and STEER_ACE_BRIDGE_AVAILABLE
        self.ace_steer_bridge = ace_steer_bridge
        
        if self.ace_enabled and not self.ace_steer_bridge:
            # Auto-initialize bridge if enabled but not provided
            self.ace_steer_bridge = AceSteerBridge(
                ace_agent_id="maker_engine_v2",
                skillbook_path="./ace_skillbook.json"
            )
            logger.info("Auto-initialized ACE+Steer bridge for MAKEREngine")

        # Initialize components
        self.vote_collector = VoteCollector(
            max_token_length=max_token_length,
            temperature_first=0.0,
            temperature_subsequent=0.1,
            ace_steer_bridge=self.ace_steer_bridge,
            ace_enabled=self.ace_enabled
        )
        self.voting_engine = VotingEngine(
            vote_collector=self.vote_collector,
            enable_first_to_ahead=enable_first_to_ahead
        )

    def generate_solution(
        self,
        initial_state: Any,
        prompt_template: Callable[[Any], str],
        system_prompt: str,
        expected_schema: Optional[Dict[str, Any]] = None,
        parser: Optional[Callable[[str], Tuple[Any, Any]]] = None,
        stop_condition: Optional[Callable[[Any], bool]] = None,
        progress_callback: Optional[Callable[[int, Any], None]] = None
    ) -> Tuple[List[Any], Any, MAKERRunMetrics]:
        """
        Generate solution through iterative voting.

        Args:
            initial_state: Starting state
            prompt_template: Function(state) -> prompt
            system_prompt: System prompt for all agents
            expected_schema: Optional schema for validation
            parser: Optional custom parser
            stop_condition: Optional function(state) -> bool
            progress_callback: Optional callback(step, state)

        Returns:
            Tuple of (action_list, final_state, metrics)
        """
        action_list: List[Any] = []
        current_state = initial_state
        total_votes = 0
        total_red_flags = 0
        start_time = time.time()

        for step in range(self.max_steps):
            # Check stop condition
            if stop_condition and stop_condition(current_state):
                logger.info(f"Stop condition met at step {step}")
                break

            # Generate prompt for current state
            prompt = prompt_template(current_state)

            # Perform voting
            try:
                winner, votes, step_metrics = self.voting_engine.do_voting(
                    prompt=prompt,
                    system_prompt=system_prompt,
                    agents=self.team.members,
                    k=self.k_ahead,
                    expected_schema=expected_schema,
                    parser=parser
                )

                total_votes += step_metrics.total_votes
                total_red_flags += step_metrics.red_flags

                if winner is None:
                    logger.error(f"Voting failed at step {step}")
                    break

                # Apply action to get next state
                # This is task-specific - default is to use state from vote
                if isinstance(winner, dict) and "next_state" in winner:
                    next_state = winner["next_state"]
                    action = winner.get("action")
                else:
                    action = winner
                    next_state = current_state  # State unchanged

                # Append action
                action_list.append(action)
                current_state = next_state

                # Progress callback
                if progress_callback:
                    progress_callback(step + 1, current_state)

            except Exception as e:
                logger.error(f"Error at step {step}: {e}", exc_info=True)
                break

        total_time = time.time() - start_time

        metrics = MAKERRunMetrics(
            total_steps=len(action_list),
            total_votes=total_votes,
            red_flags=total_red_flags,
            total_time=total_time,
            avg_confidence=0.0 if not action_list else 0.95
        )

        return action_list, current_state, metrics


