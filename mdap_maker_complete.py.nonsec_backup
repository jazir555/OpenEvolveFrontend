# ALGORITHM 4: Recursive Multi-Agent Solve
# =============================================================================

class RecursiveMAKERSolver:
    """
    Algorithm 4: Recursive multi-agent solve from Appendix F.

    Implements general-purpose decomposition with voting at each level:
    - DECOMPOSE(x): Recursively break task into subtasks
    - ATOMIC(x): Solve minimal tasks without decomposition
    - SOLVE(x, d): Main recursive solve function

    This is the most general form of MAKER that can handle arbitrary tasks,
    not just predetermined sequences like Towers of Hanoi.

    From paper (line 1-18):
    1:  N ← 2k − 1                    # First-to-k voting, N candidates per step
    2:  function D ECOMPOSE(x)
    3:    sample N decompositions via D ECOMPOSER(x)
    4:    vote via S OLUTION D ISCRIMINATOR until one reaches k
    5:    return (P1 , P2 , C)        # Subtask1, Subtask2, Composition
    6:  end function
    7:
    7:  function ATOMIC(x)
    8:    sample N answers via T HINKING M ODULE(x)
    9:    vote via C OMPOSITION D ISCRIMINATOR
    10:   return winner
    11: end function
    12:
    12: function S OLVE(x, d)
    13:   if d ≥ MAX_DEPTH then
    14:     return ATOMIC(x)
    15:   end if
    16:   (P1 , P2 , C) ← D ECOMPOSE(x)
    17:   if P1 = ∅ or P2 = ∅ or C = ∅ then
    18:     return ATOMIC(x)
    19:   end if
    20:   s1 ← S OLVE(P1 , d + 1)
    21:   s2 ← S OLVE(P2 , d + 1)
    22:   sample N composed solutions via T HINKING M ODULE("Solve C(P1 , P2 ) with P1 =s1 , P2 =s2 ")
    23:   vote via C OMPOSITION D ISCRIMINATOR until one reaches k
    24:   return winner
    25: end function
    """

    def __init__(
        self,
        team: Team,
        max_depth: int = 5,
        k_ahead: int = 3,
        num_candidates: int = 5,
        max_token_length: int = 750,
        ace_steer_bridge: Optional[AceSteerBridge] = None,
        ace_enabled: bool = True
    ):
        self.team = team
        self.max_depth = max_depth
        self.k_ahead = k_ahead
        self.num_candidates = num_candidates  # N = 2k - 1
        self.max_token_length = max_token_length
        
        # ACE + Steer Integration
        self.ace_enabled = ace_enabled and STEER_ACE_BRIDGE_AVAILABLE
        self.ace_steer_bridge = ace_steer_bridge
        
        if self.ace_enabled and not self.ace_steer_bridge:
            # Auto-initialize bridge if enabled but not provided
            self.ace_steer_bridge = AceSteerBridge(
                ace_agent_id="recursive_maker_solver",
                skillbook_path="./ace_skillbook.json"
            )
            logger.info("Auto-initialized ACE+Steer bridge for RecursiveMAKERSolver")

        # Initialize voting components
        self.vote_collector = VoteCollector(
            max_token_length=max_token_length,
            ace_steer_bridge=self.ace_steer_bridge,
            ace_enabled=self.ace_enabled
        )
        self.voting_engine = VotingEngine(
            vote_collector=self.vote_collector,
            enable_first_to_ahead=True
        )

        self.metrics = {
            "total_decompositions": 0,
            "atomic_solves": 0,
            "composition_votes": 0,
            "max_depth_reached": 0
        }

    def solve(
        self,
        task: str,
        context: Optional[Dict[str, Any]] = None,
        max_depth: Optional[int] = None
    ) -> Tuple[Any, MAKERRunMetrics]:
        """
        Main entry point for recursive solving.

        Args:
            task: Task description
            context: Optional context/requirements
            max_depth: Override max depth

        Returns:
            Tuple of (solution, metrics)
        """
        context = context or {}
        max_depth = max_depth or self.max_depth

        logger.info(f"Starting recursive MAKER solve for task: {task[:100]}...")
        start_time = time.time()

        try:
            solution = self._solve_recursive(task, context, depth=0, max_depth=max_depth)
            total_time = time.time() - start_time

            metrics = MAKERRunMetrics(
                total_steps=self.metrics.get("total_decompositions", 0) + self.metrics.get("atomic_solves", 0),
                total_votes=self.metrics.get("composition_votes", 0),
                decompositions=self.metrics.get("total_decompositions", 0),
                atomic_solves=self.metrics.get("atomic_solves", 0),
                total_time=total_time,
                avg_confidence=0.95
            )

            return solution, metrics

        except Exception as e:
            logger.error(f"Recursive solve failed: {e}", exc_info=True)
            total_time = time.time() - start_time
            return None, MAKERRunMetrics(total_time=total_time)

    def _solve_recursive(
        self,
        task: str,
        context: Dict[str, Any],
        depth: int,
        max_depth: int
    ) -> Any:
        """Internal recursive solve (Algorithm 4, lines 12-24)."""
        self.metrics["max_depth_reached"] = max(self.metrics["max_depth_reached"], depth)

        # Line 13-15: Max depth check
        if depth >= max_depth:
            logger.debug(f"Max depth {max_depth} reached, using atomic solve")
            return self._atomic_solve(task, context, depth)

        # Line 16: Try to decompose
        decomposition = self._decompose(task, context, depth)

        # Line 17-19: If decomposition failed, use atomic solve
        if (decomposition.is_atomic or
            decomposition.subtask1 is None or
            decomposition.subtask2 is None or
            decomposition.composition_function is None):
            logger.debug(f"Decomposition failed at depth {depth}, using atomic solve")
            return self._atomic_solve(task, context, depth)

        # Line 20-21: Recursively solve subtasks
        logger.debug(f"Recursively solving at depth {depth}")
        self.metrics["total_decompositions"] += 1

        solution1 = self._solve_recursive(
            decomposition.subtask1["task"],
            {**context, **decomposition.subtask1.get("context", {})},
            depth + 1,
            max_depth
        )

        solution2 = self._solve_recursive(
            decomposition.subtask2["task"],
            {**context, **decomposition.subtask2.get("context", {})},
            depth + 1,
            max_depth
        )

        # Line 22-24: Compose solutions with voting
        return self._compose_solutions(
            task,
            solution1,
            solution2,
            decomposition.composition_function,
            context
        )

    def _decompose(
        self,
        task: str,
        context: Dict[str, Any],
        depth: int
    ) -> TaskDecomposition:
        """
        Decompose task with voting (Algorithm 4, lines 2-6).

        Samples N decompositions and votes on best one.
        """
        logger.debug(f"Decomposing at depth {depth}: {task[:50]}...")

        # Sample N decompositions
        decompositions = []
        for i in range(self.num_candidates):
            decomp = self._sample_decomposition(task, context)
            if decomp:
                decompositions.append(decomp)

        if not decompositions:
            return TaskDecomposition(is_atomic=True)

        # Vote on best decomposition
        winner = self._vote_on_decompositions(task, decompositions, context)
        return winner

    def _sample_decomposition(
        self,
        task: str,
        context: Dict[str, Any]
    ) -> Optional[TaskDecomposition]:
        """Sample a single decomposition using LLM."""
        agent = self.team.members[0]  # Use primary agent

        prompt = self._build_decomposition_prompt(task, context)
        system_prompt = self._get_decomposition_system_prompt()

        try:
            # ACE + Steer Integration via VoteCollector
            raw_text = self.vote_collector._call_llm(
                prompt, system_prompt, agent, temperature=0.3
            )

            return self._parse_decomposition(raw_text)

        except Exception as e:
            logger.warning(f"Decomposition sampling failed: {e}")
            return None

    def _build_decomposition_prompt(self, task: str, context: Dict[str, Any]) -> str:
        """Build prompt for decomposition."""
        context_str = json.dumps(context, indent=2) if context else "{}"

        return f"""You are an expert at decomposing complex tasks into simpler sub-tasks.

TASK TO DECOMPOSE:
{task}

CONTEXT:
{context_str}

INSTRUCTIONS:
Break this task into exactly TWO sub-tasks that:
1. Are simpler and more focused than the original
2. Can be solved independently (in parallel if possible)
3. Together fully address the original task

OUTPUT FORMAT (JSON):
{{
  "subtask1": {{
    "task": "Description of first subtask",
    "context": {{}}  // Additional context for this subtask
  }},
  "subtask2": {{
    "task": "Description of second subtask",
    "context": {{}}
  }},
  "composition_function": "Description of how to combine results",
  "is_atomic": false
}}

If the task is too simple to decompose, set "is_atomic": true.

Provide your decomposition:"""

    def _get_decomposition_system_prompt(self) -> str:
        """Get system prompt for decomposition."""
        return """You are a specialized decomposition agent. Your job is to break complex tasks into simpler, manageable sub-tasks.

Guidelines:
- Break tasks into 2 simpler sub-tasks
- Each sub-task should be independently solvable
- Provide clear composition function
- Mark simple tasks as "is_atomic": true
- Always respond with valid JSON"""

    def _parse_decomposition(self, raw_text: str) -> Optional[TaskDecomposition]:
        """Parse decomposition from LLM response."""
        try:
            # Extract JSON from response
            import re
            json_match = re.search(r'\{.*\}', raw_text, re.DOTALL)
            if not json_match:
                return None

            data = json.loads(json_match.group(0))

            return TaskDecomposition(
                subtask1=data.get("subtask1"),
                subtask2=data.get("subtask2"),
                composition_function=data.get("composition_function"),
                is_atomic=data.get("is_atomic", False),
                confidence=data.get("confidence", 0.5)
            )

        except (json.JSONDecodeError, AttributeError) as e:
            logger.warning(f"Failed to parse decomposition: {e}")
            return None

    def _vote_on_decompositions(
        self,
        task: str,
        decompositions: List[TaskDecomposition],
        context: Dict[str, Any]
    ) -> TaskDecomposition:
        """Vote on best decomposition using discriminator."""
        if not decompositions:
            return TaskDecomposition(is_atomic=True)

        # For now, return highest confidence
        # In full implementation, would use discriminator agents
        # Filter out None values and use confidence
        valid_decomps = [d for d in decompositions if d is not None and d.confidence is not None]
        if not valid_decomps:
            return decompositions[0]

        return max(valid_decomps, key=lambda d: d.confidence)

    def _atomic_solve(
        self,
        task: str,
        context: Dict[str, Any],
        depth: int
    ) -> Any:
        """
        Atomic solve without decomposition (Algorithm 4, lines 7-11).

        Samples N answers and votes on best one.
        """
        logger.debug(f"Atomic solve at depth {depth}: {task[:50]}...")
        self.metrics["atomic_solves"] += 1

        # Sample N solutions
        solutions = []
        for i in range(self.num_candidates):
            solution = self._sample_atomic_solution(task, context)
            if solution:
                solutions.append(solution)

        if not solutions:
            return {"error": "Failed to generate solutions"}

        # Vote on best solution
        return self._vote_on_atomic_solutions(task, solutions, context)

    def _sample_atomic_solution(
        self,
        task: str,
        context: Dict[str, Any]
    ) -> Optional[Any]:
        """Sample a single atomic solution using LLM."""
        agent = self.team.members[0]

        prompt = self._build_atomic_prompt(task, context)
        system_prompt = "You are a helpful assistant. Solve the given task directly."

        try:
            raw_text = self.vote_collector._call_llm(
                prompt, system_prompt, agent, temperature=0.3
            )

            return self._parse_atomic_solution(raw_text)

        except Exception as e:
            logger.warning(f"Atomic solution sampling failed: {e}")
            return None

    def _build_atomic_prompt(self, task: str, context: Dict[str, Any]) -> str:
        """Build prompt for atomic solve."""
        context_str = json.dumps(context, indent=2) if context else "{}"

        return f"""Solve this task directly:

TASK:
{task}

CONTEXT:
{context_str}

Provide your solution. Be specific and actionable."""

    def _parse_atomic_solution(self, raw_text: str) -> Any:
        """Parse atomic solution from LLM response."""
        # Try JSON first
        try:
            return json.loads(raw_text)
        except json.JSONDecodeError:
            pass

        # Return as text
        return raw_text.strip()

    def _vote_on_atomic_solutions(
        self,
        task: str,
        solutions: List[Any],
        context: Dict[str, Any]
    ) -> Any:
        """Vote on best atomic solution."""
        if not solutions:
            return {"error": "No valid solutions"}

        # For now, return first non-None
        # In full implementation, would use discriminator agents
        for solution in solutions:
            if solution is None:
                continue
            if isinstance(solution, dict) and solution.get("error"):
                continue
            return solution

        return solutions[0]

    def _compose_solutions(
        self,
        original_task: str,
        solution1: Any,
        solution2: Any,
        composition_function: str,
        context: Dict[str, Any]
    ) -> Any:
        """
        Compose solutions with voting (Algorithm 4, lines 22-24).

        Samples N compositions and votes on best one.
        """
        logger.debug("Composing solutions...")
        self.metrics["composition_votes"] += 1

        # Sample N compositions
        compositions = []
        for i in range(self.num_candidates):
            composition = self._sample_composition(
                original_task, solution1, solution2, composition_function, context
            )
            if composition:
                compositions.append(composition)

        if not compositions:
            # Fallback: simple combination
            return {
                "solution1": solution1,
                "solution2": solution2,
                "composition": "combined"
            }

        # Vote on best composition
        return self._vote_on_compositions(compositions)

    def _sample_composition(
        self,
        original_task: str,
        solution1: Any,
        solution2: Any,
        composition_function: str,
        context: Dict[str, Any]
    ) -> Optional[Any]:
        """Sample a single composition using LLM."""
        agent = self.team.members[0]

        prompt = self._build_composition_prompt(
            original_task, solution1, solution2, composition_function
        )
        system_prompt = "You are an expert at combining partial solutions into complete solutions."

        try:
            raw_text = self.vote_collector._call_llm(
                prompt, system_prompt, agent, temperature=0.3
            )

            return self._parse_composition(raw_text)

        except Exception as e:
            logger.warning(f"Composition sampling failed: {e}")
            return None

    def _build_composition_prompt(
        self,
        original_task: str,
        solution1: Any,
        solution2: Any,
        composition_function: str
    ) -> str:
        """Build prompt for composition."""
        return f"""Combine these two partial solutions into a complete solution.

ORIGINAL TASK:
{original_task}

COMPOSITION FUNCTION:
{composition_function}

SOLUTION 1:
{json.dumps(solution1, indent=2)}

SOLUTION 2:
{json.dumps(solution2, indent=2)}

Combine these solutions according to the composition function.
Provide the final, complete solution."""

    def _parse_composition(self, raw_text: str) -> Any:
        """Parse composition from LLM response."""
        # Try JSON first
        try:
            return json.loads(raw_text)
        except json.JSONDecodeError:
            pass

        # Return as text
        return raw_text.strip()

    def _vote_on_compositions(self, compositions: List[Any]) -> Any:
        """Vote on best composition."""
        if not compositions:
            return None

        # For now, return first non-None
        for composition in compositions:
            if composition is not None:
                return composition

        return compositions[0]


