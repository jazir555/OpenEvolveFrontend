"""
Problem Decomposition System for OpenEvolve
Implements hierarchical decomposition strategies for complex content
"""

import time
import json
import re
import hashlib
from typing import Dict, List, Any, Optional, Tuple
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum

# Import with fallback for standalone operation
try:
    from content_analyzer import ContentAnalyzer
except ImportError:
    class ContentAnalyzer:
        """Simple mock content analyzer for problem decomposition"""
        def analyze_content(self, content: str) -> Dict[str, Any]:
            return {
                "length": len(content),
                "lines": len(content.split('\n')),
                "words": len(content.split()),
                "complexity": min(len(content) / 1000, 1.0)
            }

try:
    from error_handler import with_error_handling, ErrorCategory, ErrorSeverity
except ImportError:
    # Mock error handling for standalone operation
    def with_error_handling(category=None, severity=None, fallback_value=None):
        def decorator(func):
            def wrapper(*args, **kwargs):
                try:
                    return func(*args, **kwargs)
                except Exception as e:
                    print(f"Error in {func.__name__}: {e}")
                    return fallback_value
            return wrapper
        return decorator

    class ErrorCategory:
        PROCESSING = "processing"

    class ErrorSeverity:
        MEDIUM = "medium"

ERROR_CATEGORY_PROCESSING = getattr(
    ErrorCategory,
    "PROCESSING_ERROR",
    getattr(ErrorCategory, "PROCESSING", "processing")
)
ERROR_SEVERITY_MEDIUM = getattr(ErrorSeverity, "MEDIUM", "medium")

try:
    from problem_analyzer import ProblemAnalyzer
    PROBLEM_ANALYZER_AVAILABLE = True
except ImportError:
    PROBLEM_ANALYZER_AVAILABLE = False
    ProblemAnalyzer = None

try:
    from roma_dspy import Atomizer, Planner
    from roma_dspy.types import PredictionStrategy, NodeType, TaskType
    from roma_dspy.config import load_config
    ROMA_DSPY_AVAILABLE = True
except ImportError:
    ROMA_DSPY_AVAILABLE = False
    Atomizer = None
    Planner = None
    PredictionStrategy = None
    NodeType = None
    TaskType = None
    load_config = None

try:
    from roma_mcp_tools import solve_with_roma, get_roma_status
    ROMA_MCP_AVAILABLE = True
except ImportError:
    ROMA_MCP_AVAILABLE = False
    solve_with_roma = None
    get_roma_status = None


class DecompositionStrategy(Enum):
    """Strategies for problem decomposition"""
    HIERARCHICAL = "hierarchical"
    FUNCTIONAL = "functional"
    SEMANTIC = "semantic"
    STRUCTURAL = "structural"
    DEPENDENCY_BASED = "dependency_based"
    COMPLEXITY_BASED = "complexity_based"
    ROMA = "roma"


class ComponentType(Enum):
    """Types of components that can be identified"""
    CORE_LOGIC = "core_logic"
    SUPPORTING_FUNCTION = "supporting_function"
    DATA_STRUCTURE = "data_structure"
    INTERFACE = "interface"
    CONFIGURATION = "configuration"
    DOCUMENTATION = "documentation"
    TEST_CASE = "test_case"
    ERROR_HANDLING = "error_handling"


@dataclass
class Component:
    """Represents a decomposed component"""
    id: str
    title: str
    content: str
    component_type: ComponentType
    complexity_score: float = 0.0  # 0-1 scale
    dependencies: List[str] = field(default_factory=list)
    metadata: Dict[str, Any] = field(default_factory=dict)
    evolution_priority: float = 1.0  # Higher = evolve first
    estimated_effort: int = 1  # 1-10 scale


@dataclass
class DecompositionResult:
    """Result of problem decomposition"""
    original_content: str
    components: List[Component]
    dependency_graph: Dict[str, List[str]]
    decomposition_strategy: DecompositionStrategy
    quality_score: float
    metadata: Dict[str, Any]
    reassembly_instructions: Dict[str, Any]


@dataclass
class ReassemblyResult:
    """Result of component reassembly"""
    reassembled_content: str
    components_used: List[str]
    quality_score: float
    improvement_metrics: Dict[str, Any]
    metadata: Dict[str, Any]


class ProblemDecomposer:
    """Main problem decomposition system"""

    def __init__(self, problem_analyzer: Optional[Any] = None, auto_create_analyzer: bool = True):
        """
        Initialize ProblemDecomposer.

        Args:
            problem_analyzer: Optional ProblemAnalyzer instance
            auto_create_analyzer: If True (default), auto-create ProblemAnalyzer when available
                               If False, only use provided problem_analyzer
        """
        self.content_analyzer = ContentAnalyzer()
        # Handle problem_analyzer initialization
        if problem_analyzer is not None:
            self.problem_analyzer = problem_analyzer
        elif auto_create_analyzer and PROBLEM_ANALYZER_AVAILABLE:
            try:
                self.problem_analyzer = ProblemAnalyzer()
            except Exception:
                # If ProblemAnalyzer fails to initialize, gracefully fall back to None
                self.problem_analyzer = None
        else:
            self.problem_analyzer = None
        self.last_roma_error: Optional[str] = None
        self.last_domain_context: Optional[Dict[str, Any]] = None
        self._domain_context_cache: Dict[str, Dict[str, Any]] = {}
        self.decomposition_history: List[DecompositionResult] = []
    
    @with_error_handling(
        category=ERROR_CATEGORY_PROCESSING,
        severity=ERROR_SEVERITY_MEDIUM,
        fallback_value=None
    )
    def decompose_content(
        self,
        content: str,
        strategy: DecompositionStrategy = DecompositionStrategy.ROMA,
        max_components: int = 10,
        min_component_size: int = 50,
        **kwargs
    ) -> DecompositionResult:
        """
        Decompose content into manageable components using specified strategy.

        Strategies:
            - ROMA: Recursive hierarchical decomposition using ROMA framework (default)
            - HIERARCHICAL: Section-based decomposition
            - FUNCTIONAL: Function/class-based decomposition
            - SEMANTIC: Semantic coherence-based decomposition
            - STRUCTURAL: Pattern-based decomposition
            - DEPENDENCY_BASED: Dependency cluster decomposition
            - COMPLEXITY_BASED: Complexity region decomposition

        ROMA-Specific Parameters (pass via **kwargs):
            roma_fractal: Use fractal decomposition (default: True)
            roma_allow_small_components: Allow small components (default: True)
            roma_max_depth: Maximum recursion depth (default: 3)
            roma_max_nodes: Maximum nodes to create (default: max_components * 4)
            roma_include_non_leaf: Include intermediate plan nodes (default: False)
            roma_profile: ROMA config profile name (e.g., 'crypto_agent')
            roma_config_path: Path to ROMA YAML config file
            roma_overrides: List of config override strings
            roma_model: Model for both atomizer and planner
            roma_model_config: Model configuration dict
            roma_prediction_strategy: Prediction strategy for both
            roma_atomizer_model: Model for atomizer only
            roma_planner_model: Model for planner only
            roma_context: Additional context string
            roma_extra_context: Extra context appended to auto-generated context
            use_problem_analyzer: Use ProblemAnalyzer for domain context (default: True)

        Args:
            content: Content to decompose
            strategy: Decomposition strategy to use
            max_components: Maximum number of components to create
            min_component_size: Minimum size for a component (in characters)
            **kwargs: Additional strategy-specific parameters

        Returns:
            DecompositionResult: Decomposition results with components, dependencies,
                             and quality metrics
        """
        start_time = time.time()
        self.last_roma_error = None
        self.last_domain_context = None

        # Analyze content first
        analysis = self.content_analyzer.analyze_content(content)
        domain_context = self._get_domain_context(
            content,
            title=kwargs.get("problem_title", ""),
            allow_analysis=kwargs.get("use_problem_analyzer", True),
        )
        self.last_domain_context = domain_context
        
        # Choose decomposition method based on strategy
        if strategy == DecompositionStrategy.HIERARCHICAL:
            components = self._hierarchical_decomposition(
                content, analysis, max_components, min_component_size)
        elif strategy == DecompositionStrategy.FUNCTIONAL:
            components = self._functional_decomposition(
                content, analysis, max_components, min_component_size)
        elif strategy == DecompositionStrategy.SEMANTIC:
            components = self._semantic_decomposition(
                content, analysis, max_components, min_component_size)
        elif strategy == DecompositionStrategy.STRUCTURAL:
            components = self._structural_decomposition(
                content, analysis, max_components, min_component_size)
        elif strategy == DecompositionStrategy.DEPENDENCY_BASED:
            components = self._dependency_based_decomposition(
                content, analysis, max_components, min_component_size)
        elif strategy == DecompositionStrategy.ROMA:
            components = self._roma_decomposition(
                content,
                analysis,
                max_components,
                min_component_size,
                domain_context=domain_context,
                **kwargs,
            )
        else:  # COMPLEXITY_BASED
            components = self._complexity_based_decomposition(
                content, analysis, max_components, min_component_size)
        
        # Build dependency graph
        dependency_graph = self._build_dependency_graph(components)
        
        # Calculate quality score
        quality_score = self._calculate_decomposition_quality(content, components)
        
        # Create reassembly instructions
        reassembly_instructions = self._create_reassembly_instructions(components, dependency_graph)
        
        # Create result
        result = DecompositionResult(
            original_content=content,
            components=components,
            dependency_graph=dependency_graph,
            decomposition_strategy=strategy,
            quality_score=quality_score,
            metadata={
                "decomposition_time": time.time() - start_time,
                "component_count": len(components),
                "avg_component_size": sum(len(c.content) for c in components) / len(components) if components else 0,
                "complexity_distribution": self._analyze_complexity_distribution(components),
                "strategy_used": strategy.value,
                "domain_context": domain_context,
                "roma_error": self.last_roma_error,
            },
            reassembly_instructions=reassembly_instructions
        )
        
        # Store in history
        self.decomposition_history.append(result)
        
        return result
    
    def _hierarchical_decomposition(
        self, content: str, analysis: Any, max_components: int, min_component_size: int
    ) -> List[Component]:
        """Decompose content hierarchically based on major structural elements"""
        components = []
        
        # Split by major structural elements
        sections = self._identify_sections(content)
        
        for i, section in enumerate(sections):
            if len(section.strip()) >= min_component_size:
                component = Component(
                    id=f"hier_{i+1}",
                    title=f"Section {i+1}",
                    content=section.strip(),
                    component_type=self._classify_component_type(section),
                    complexity_score=self._calculate_component_complexity(section),
                    metadata={
                        "section_index": i,
                        "original_position": content.find(section)
                    }
                )
                components.append(component)
                
                if len(components) >= max_components:
                    break
        
        return components
    
    def _functional_decomposition(
        self, content: str, analysis: Any, max_components: int, min_component_size: int
    ) -> List[Component]:
        """Decompose content based on functional units (functions, classes, procedures, etc.)"""
        components = []
        
        # Identify functional units
        functional_units = self._identify_functional_units(content)
        
        for i, unit in enumerate(functional_units):
            if len(unit['content']) >= min_component_size:
                component = Component(
                    id=f"func_{i+1}",
                    title=unit['name'],
                    content=unit['content'],
                    component_type=ComponentType.CORE_LOGIC if unit['type'] == 'main' else ComponentType.SUPPORTING_FUNCTION,
                    complexity_score=self._calculate_component_complexity(unit['content']),
                    dependencies=unit.get('dependencies', []),
                    metadata={
                        "function_type": unit['type'],
                        "parameters": unit.get('parameters', [])
                    }
                )
                components.append(component)
                
                if len(components) >= max_components:
                    break
        
        return components
    
    def _semantic_decomposition(
        self, content: str, analysis: Any, max_components: int, min_component_size: int
    ) -> List[Component]:
        """Decompose content based on semantic meaning using semantic analysis"""
        components = []
        
        # Use semantic analysis to identify coherent chunks
        semantic_chunks = self._identify_semantic_chunks(content)
        
        for i, chunk in enumerate(semantic_chunks):
            if len(chunk['content']) >= min_component_size:
                component = Component(
                    id=f"sem_{i+1}",
                    title=chunk['topic'],
                    content=chunk['content'],
                    component_type=self._classify_component_type(chunk['content']),
                    complexity_score=chunk['complexity_score'],
                    metadata={
                        "semantic_topic": chunk['topic'],
                        "coherence_score": chunk['coherence']
                    }
                )
                components.append(component)
                
                if len(components) >= max_components:
                    break
        
        return components
    
    def _structural_decomposition(
        self, content: str, analysis: Any, max_components: int, min_component_size: int
    ) -> List[Component]:
        """Decompose content based on structural patterns"""
        components = []
        
        # Identify structural elements
        structural_elements = self._identify_structural_elements(content)
        
        for i, element in enumerate(structural_elements):
            if len(element['content']) >= min_component_size:
                component = Component(
                    id=f"struct_{i+1}",
                    title=element['title'],
                    content=element['content'],
                    component_type=self._map_structure_type_to_component_type(element['type']),
                    complexity_score=self._calculate_component_complexity(element['content']),
                    metadata={
                        "structural_type": element['type'],
                        "nesting_level": element.get('level', 0)
                    }
                )
                components.append(component)
                
                if len(components) >= max_components:
                    break
        
        return components
    
    def _dependency_based_decomposition(
        self, content: str, analysis: Any, max_components: int, min_component_size: int
    ) -> List[Component]:
        """Decompose content based on dependency relationships"""
        components = []
        
        # Identify dependency clusters
        dependency_clusters = self._identify_dependency_clusters(content)
        
        for i, cluster in enumerate(dependency_clusters):
            if len(cluster['content']) >= min_component_size:
                component = Component(
                    id=f"dep_{i+1}",
                    title=cluster['name'],
                    content=cluster['content'],
                    component_type=ComponentType.CORE_LOGIC if cluster['is_core'] else ComponentType.SUPPORTING_FUNCTION,
                    complexity_score=cluster['complexity'],
                    dependencies=cluster['dependencies'],
                    metadata={
                        "dependency_cluster": True,
                        "cluster_size": cluster['size']
                    }
                )
                components.append(component)
                
                if len(components) >= max_components:
                    break
        
        return components
    
    def _complexity_based_decomposition(
        self, content: str, analysis: Any, max_components: int, min_component_size: int
    ) -> List[Component]:
        """Decompose content based on complexity analysis"""
        components = []
        
        # Identify high-complexity areas that need separate attention
        complexity_regions = self._identify_complexity_regions(content)
        
        for i, region in enumerate(complexity_regions):
            if len(region['content']) >= min_component_size:
                component = Component(
                    id=f"complex_{i+1}",
                    title=f"Complex Region {i+1}",
                    content=region['content'],
                    component_type=self._classify_component_type(region['content']),
                    complexity_score=region['complexity'],
                    evolution_priority=region['complexity'],  # Higher complexity = higher priority
                    metadata={
                        "complexity_region": True,
                        "complexity_factors": region['factors']
                    }
                )
                components.append(component)
                
                if len(components) >= max_components:
                    break
        
        return components

    def _get_domain_context(
        self,
        content: str,
        title: str = "",
        allow_analysis: bool = True,
    ) -> Optional[Dict[str, Any]]:
        """
        Get domain context for ROMA decomposition.

        This extracts structured domain information from ProblemAnalyzer
        to enhance ROMA's understanding of the problem space.
        """
        if not allow_analysis or not self.problem_analyzer:
            return None

        content_key = self._hash_content(content)
        cached = self._domain_context_cache.get(content_key)
        if cached:
            return cached

        try:
            problem = self.problem_analyzer.analyze_problem(content, title=title)
        except Exception as e:
            # Log error but don't fail - fallback to None
            import logging
            logging.getLogger(__name__).warning(f"Problem analysis failed: {e}")
            return None

        domain_context = getattr(problem, "domain_context", None)
        complexity_score = getattr(problem, "complexity_score", None)

        # Extract structured context with safe defaults
        context = {
            "domain": getattr(domain_context, "domain", None),
            "subdomain": getattr(domain_context, "subdomain", None),
            "related_domains": getattr(domain_context, "related_domains", []) or [],
            "key_concepts": getattr(domain_context, "domain_knowledge", {}).get(
                "key_concepts", []
            ),
            "problem_type": getattr(
                getattr(problem, "problem_type", None), "value", None
            ),
            "constraints": [
                getattr(constraint, "description", "")
                for constraint in getattr(problem, "constraints", []) or []
                if getattr(constraint, "description", "")
            ],
            "complexity": {
                "overall": getattr(complexity_score, "overall_complexity", None),
                "cognitive": getattr(complexity_score, "cognitive_complexity", None),
                "computational": getattr(
                    complexity_score, "computational_complexity", None
                ),
                "domain": getattr(complexity_score, "domain_complexity", None),
                "integration": getattr(
                    complexity_score, "integration_complexity", None
                ),
            },
        }

        self._domain_context_cache[content_key] = context
        return context

    def _hash_content(self, content: str) -> str:
        return hashlib.sha256(content.encode("utf-8")).hexdigest()

    def _build_roma_context(
        self,
        content: str,
        analysis: Any,
        domain_context: Optional[Dict[str, Any]] = None,
        extra_context: Optional[str] = None,
    ) -> Optional[str]:
        sections = []
        if domain_context:
            lines = ["Domain Context:"]
            domain = domain_context.get("domain")
            subdomain = domain_context.get("subdomain")
            if domain:
                lines.append(f"- domain: {domain}")
            if subdomain:
                lines.append(f"- subdomain: {subdomain}")
            related = domain_context.get("related_domains") or []
            if related:
                lines.append(f"- related_domains: {', '.join(related)}")
            concepts = domain_context.get("key_concepts") or []
            if concepts:
                lines.append(f"- key_concepts: {', '.join(concepts)}")
            problem_type = domain_context.get("problem_type")
            if problem_type:
                lines.append(f"- problem_type: {problem_type}")
            constraints = domain_context.get("constraints") or []
            if constraints:
                lines.append(f"- constraints: {', '.join(constraints[:5])}")
            complexity = domain_context.get("complexity") or {}
            if any(value is not None for value in complexity.values()):
                lines.append(
                    "- complexity: "
                    f"overall={complexity.get('overall')}, "
                    f"cognitive={complexity.get('cognitive')}, "
                    f"computational={complexity.get('computational')}, "
                    f"domain={complexity.get('domain')}, "
                    f"integration={complexity.get('integration')}"
                )
            sections.append("\n".join(lines))

        if analysis:
            sections.append(
                "Content Metrics:\n"
                f"- length: {analysis.get('length')}\n"
                f"- lines: {analysis.get('lines')}\n"
                f"- words: {analysis.get('words')}\n"
                f"- complexity: {analysis.get('complexity')}"
            )

        if extra_context:
            sections.append(str(extra_context).strip())

        return "\n\n".join([section for section in sections if section]).strip() or None

    def _roma_decomposition(
        self,
        content: str,
        analysis: Any,
        max_components: int,
        min_component_size: int,
        domain_context: Optional[Dict[str, Any]] = None,
        **kwargs
    ) -> List[Component]:
        """
        Decompose content using ROMA's planning output.

        This is the main ROMA integration method that tries multiple approaches:
        1. ROMA DSPy (fractal decomposition from ROMA library)
        2. ROMA MCP (via MCP tools if available)
        3. Fallback to semantic decomposition if ROMA unavailable

        Args:
            content: Content to decompose
            analysis: Content analysis from ContentAnalyzer
            max_components: Maximum number of components
            min_component_size: Minimum component size
            domain_context: Optional domain context from ProblemAnalyzer
            **kwargs: ROMA-specific parameters

        Returns:
            List of Component objects
        """
        roma_allow_small = kwargs.get("roma_allow_small_components", True)
        roma_use_fractal = kwargs.get("roma_fractal", True)
        roma_profile = kwargs.get("roma_profile")
        roma_config_path = kwargs.get("roma_config_path")
        roma_overrides = kwargs.get("roma_overrides")
        roma_context = kwargs.get("roma_context")
        roma_model = kwargs.get("roma_model")
        roma_model_config = kwargs.get("roma_model_config")
        roma_prediction_strategy = kwargs.get("roma_prediction_strategy")

        # Approach 1: Try ROMA DSPy (direct library usage)
        if ROMA_DSPY_AVAILABLE:
            try:
                # Build ROMA context if not provided
                if not roma_context:
                    roma_context = self._build_roma_context(
                        content,
                        analysis,
                        domain_context=domain_context,
                        extra_context=kwargs.get("roma_extra_context"),
                    )

                # Build ROMA modules (Atomizer and Planner)
                atomizer, planner = self._build_roma_modules(
                    roma_profile=roma_profile,
                    roma_config_path=roma_config_path,
                    roma_overrides=roma_overrides,
                    roma_model=roma_model,
                    roma_model_config=roma_model_config,
                    roma_prediction_strategy=roma_prediction_strategy,
                    roma_atomizer_model=kwargs.get("roma_atomizer_model"),
                    roma_atomizer_model_config=kwargs.get("roma_atomizer_model_config"),
                    roma_planner_model=kwargs.get("roma_planner_model"),
                    roma_planner_model_config=kwargs.get("roma_planner_model_config"),
                    roma_atomizer_prediction_strategy=kwargs.get(
                        "roma_atomizer_prediction_strategy"
                    ),
                    roma_planner_prediction_strategy=kwargs.get(
                        "roma_planner_prediction_strategy"
                    ),
                )

                # Use fractal decomposition if requested and Atomizer available
                if roma_use_fractal and atomizer:
                    return self._roma_fractal_decomposition(
                        content=content,
                        atomizer=atomizer,
                        planner=planner,
                        roma_context=roma_context,
                        max_components=max_components,
                        min_component_size=min_component_size,
                        roma_allow_small=roma_allow_small,
                        roma_max_depth=kwargs.get("roma_max_depth", 3),
                        roma_max_nodes=kwargs.get("roma_max_nodes"),
                        roma_include_non_leaf=kwargs.get("roma_include_non_leaf", False),
                    )

                # Otherwise, use standard planner-based decomposition
                plan = planner.forward(goal=content, context=roma_context)
                return self._create_roma_components_from_plan(
                    plan,
                    max_components,
                    min_component_size,
                    roma_allow_small,
                )

            except Exception as exc:
                # Log error and try fallback
                import logging
                logger = logging.getLogger(__name__)
                logger.warning(f"ROMA DSPy decomposition failed: {exc}. Trying fallback...")
                self.last_roma_error = str(exc)

        # Approach 2: Try ROMA MCP (via MCP tools)
        if ROMA_MCP_AVAILABLE:
            try:
                return self._roma_decomposition_via_mcp(
                    content,
                    max_components,
                    min_component_size,
                    roma_allow_small,
                    **kwargs,
                )
            except Exception as exc:
                import logging
                logger = logging.getLogger(__name__)
                logger.warning(f"ROMA MCP decomposition failed: {exc}. Using fallback...")
                self.last_roma_error = f"MCP: {exc}"

        # Approach 3: Fallback to semantic decomposition
        import logging
        logger = logging.getLogger(__name__)
        logger.info("ROMA not available, falling back to semantic decomposition")
        return self._semantic_decomposition(content, analysis, max_components, min_component_size)

    def _build_roma_modules(
        self,
        roma_profile: Optional[str],
        roma_config_path: Optional[str],
        roma_overrides: Optional[List[str]],
        roma_model: Optional[str],
        roma_model_config: Optional[Dict[str, Any]],
        roma_prediction_strategy: Optional[Any],
        roma_atomizer_model: Optional[str],
        roma_atomizer_model_config: Optional[Dict[str, Any]],
        roma_planner_model: Optional[str],
        roma_planner_model_config: Optional[Dict[str, Any]],
        roma_atomizer_prediction_strategy: Optional[Any],
        roma_planner_prediction_strategy: Optional[Any],
    ) -> Tuple[Any, Any]:
        """
        Build ROMA Atomizer and Planner modules with flexible configuration.

        Supports three configuration modes:
        1. Profile-based: Load from named profile (e.g., 'crypto_agent')
        2. Config file: Load from custom YAML config path
        3. Direct: Specify models and strategies directly

        Returns:
            Tuple of (Atomizer, Planner) instances

        Raises:
            ValueError: If configuration is invalid or ROMA components unavailable
        """
        # Mode 1: Profile or config file based configuration
        if roma_profile or roma_config_path or roma_overrides:
            if load_config is None:
                raise ValueError(
                    "ROMA config loader not available - cannot use profile/config mode. "
                    "Either install roma_dspy[persistence] or use direct model configuration."
                )
            try:
                roma_config = load_config(
                    config_path=roma_config_path,
                    profile=roma_profile,
                    overrides=roma_overrides,
                )
            except Exception as e:
                raise ValueError(f"Failed to load ROMA config: {e}")

            atomizer_config = roma_config.agents.atomizer if roma_config else None
            planner_config = roma_config.agents.planner if roma_config else None

            if atomizer_config is None:
                raise ValueError("Atomizer config not found in ROMA config")
            if planner_config is None:
                raise ValueError("Planner config not found in ROMA config")

            try:
                atomizer = Atomizer(config=atomizer_config)
                planner = Planner(config=planner_config)
                return atomizer, planner
            except Exception as e:
                raise ValueError(f"Failed to create ROMA modules from config: {e}")

        # Mode 2: Direct model specification
        if not roma_model and not (roma_atomizer_model or roma_planner_model):
            raise ValueError(
                "ROMA model required when config is not provided. "
                "Specify either roma_model (for both) or roma_atomizer_model + roma_planner_model."
            )

        # Default to Chain of Thought if no strategy specified
        if roma_prediction_strategy is None:
            roma_prediction_strategy = PredictionStrategy.CHAIN_OF_THOUGHT

        atomizer_strategy = roma_atomizer_prediction_strategy or roma_prediction_strategy
        planner_strategy = roma_planner_prediction_strategy or roma_prediction_strategy

        try:
            atomizer = Atomizer(
                prediction_strategy=atomizer_strategy,
                model=roma_atomizer_model or roma_model,
                model_config=roma_atomizer_model_config or roma_model_config or None,
            )
            planner = Planner(
                prediction_strategy=planner_strategy,
                model=roma_planner_model or roma_model,
                model_config=roma_planner_model_config or roma_model_config or None,
            )
            return atomizer, planner
        except Exception as e:
            raise ValueError(f"Failed to create ROMA modules: {e}")

    def _roma_fractal_decomposition(
        self,
        content: str,
        atomizer: Any,
        planner: Any,
        roma_context: Optional[str],
        max_components: int,
        min_component_size: int,
        roma_allow_small: bool,
        roma_max_depth: int = 3,
        roma_max_nodes: Optional[int] = None,
        roma_include_non_leaf: bool = False,
    ) -> List[Component]:
        """
        Perform fractal decomposition using ROMA's recursive planning.

        This method recursively decomposes content into a hierarchy of subtasks,
        creating components from either leaf nodes or all nodes in the decomposition tree.

        Args:
            content: Content to decompose
            atomizer: ROMA Atomizer instance (determines atomicity)
            planner: ROMA Planner instance (creates subtask plans)
            roma_context: Optional context string for ROMA agents
            max_components: Maximum number of components to return
            min_component_size: Minimum size for components (if roma_allow_small=False)
            roma_allow_small: Include components below min_component_size
            roma_max_depth: Maximum recursion depth (default: 3)
            roma_max_nodes: Maximum nodes to create (default: max_components * 4)
            roma_include_non_leaf: Include intermediate plan nodes (default: False)

        Returns:
            List of Component objects from ROMA decomposition tree
        """
        nodes: Dict[str, Dict[str, Any]] = {}
        node_order: List[str] = []
        max_nodes = roma_max_nodes or max(20, max_components * 4)

        def build_id(path: List[int]) -> str:
            return "roma_" + "_".join(str(part) for part in path)

        def register_node(
            node_id: str,
            goal: str,
            task_type: Any,
            depth: int,
            parent_id: Optional[str],
            dependencies: Optional[List[str]] = None,
            is_atomic: bool = False,
            source: str = "planner",
        ) -> None:
            if node_id in nodes:
                return
            nodes[node_id] = {
                "id": node_id,
                "goal": goal,
                "task_type": task_type,
                "depth": depth,
                "parent_id": parent_id,
                "dependencies": dependencies or [],
                "children": [],
                "is_atomic": is_atomic,
                "source": source,
            }
            node_order.append(node_id)

        def is_atomic_response(atomized: Any) -> bool:
            atomic_flag = bool(getattr(atomized, "is_atomic", False))
            node_type = getattr(atomized, "node_type", None)
            if node_type is None:
                return atomic_flag
            if isinstance(node_type, str):
                return atomic_flag or node_type.upper() == "EXECUTE"
            if hasattr(node_type, "is_execute"):
                return atomic_flag or node_type.is_execute
            return atomic_flag

        def decompose(
            goal: str,
            depth: int,
            parent_id: Optional[str],
            path: List[int],
            task_type: Any = None,
            dependencies: Optional[List[str]] = None,
        ) -> Optional[str]:
            cleaned_goal = goal.strip()
            if not cleaned_goal:
                return None

            node_id = build_id(path)
            if node_id in nodes:
                return node_id

            if depth >= roma_max_depth or len(nodes) >= max_nodes:
                register_node(
                    node_id,
                    cleaned_goal,
                    task_type,
                    depth,
                    parent_id,
                    dependencies,
                    is_atomic=True,
                    source="depth_cap",
                )
                return node_id

            try:
                atomized = atomizer.forward(goal=cleaned_goal, context=roma_context)
                atomic = is_atomic_response(atomized)
            except Exception:
                atomic = True

            register_node(
                node_id,
                cleaned_goal,
                task_type,
                depth,
                parent_id,
                dependencies,
                is_atomic=atomic,
                source="atomizer",
            )

            if atomic:
                return node_id

            plan = planner.forward(goal=cleaned_goal, context=roma_context)
            subtasks = getattr(plan, "subtasks", None) or []
            dependencies_graph = getattr(plan, "dependencies_graph", None) or {}
            if not subtasks:
                nodes[node_id]["is_atomic"] = True
                nodes[node_id]["source"] = "planner_empty"
                return node_id

            index_to_id = {}
            for idx in range(len(subtasks)):
                child_id = build_id(path + [idx + 1])
                index_to_id[str(idx)] = child_id
                index_to_id[str(idx + 1)] = child_id

            dependency_map = self._normalize_roma_dependency_graph(
                dependencies_graph,
                index_to_id,
            )

            for idx, subtask in enumerate(subtasks):
                child_goal = subtask.get("goal", "") if isinstance(subtask, dict) else (
                    getattr(subtask, "goal", None) or str(subtask)
                )
                child_task_type = (
                    subtask.get("task_type") if isinstance(subtask, dict) else getattr(subtask, "task_type", None)
                )
                raw_deps = (
                    subtask.get("dependencies") if isinstance(subtask, dict) else getattr(subtask, "dependencies", None)
                )
                raw_deps = raw_deps or []
                child_dependencies = self._normalize_roma_dependencies(raw_deps, index_to_id)
                child_id = index_to_id.get(str(idx), build_id(path + [idx + 1]))
                if child_id in dependency_map:
                    child_dependencies = sorted(
                        set(child_dependencies).union(dependency_map[child_id])
                    )

                child_node_id = decompose(
                    child_goal,
                    depth + 1,
                    node_id,
                    path + [idx + 1],
                    task_type=child_task_type,
                    dependencies=child_dependencies,
                )
                if child_node_id:
                    nodes[node_id]["children"].append(child_node_id)

            return node_id

        root_id = decompose(content, 0, None, [1])
        if not root_id:
            return []

        leaf_cache: Dict[str, List[str]] = {}

        def leaf_descendants(node_id: str) -> List[str]:
            cached = leaf_cache.get(node_id)
            if cached is not None:
                return cached
            node = nodes.get(node_id, {})
            children = node.get("children") or []
            if not children:
                leaf_cache[node_id] = [node_id]
                return leaf_cache[node_id]
            leaves: List[str] = []
            for child in children:
                leaves.extend(leaf_descendants(child))
            leaf_cache[node_id] = leaves
            return leaves

        def collect_dependencies(node_id: str) -> List[str]:
            dependencies: List[str] = []
            current_id = node_id
            while current_id:
                node = nodes.get(current_id, {})
                dependencies.extend(node.get("dependencies") or [])
                current_id = node.get("parent_id")
            return dependencies

        if roma_include_non_leaf:
            component_ids = node_order[:]
        else:
            component_ids = [
                node_id for node_id in node_order if not nodes[node_id]["children"]
            ]

        if len(component_ids) > max_components:
            component_ids = component_ids[:max_components]
        included_set = set(component_ids)

        components: List[Component] = []
        for node_id in component_ids:
            node = nodes[node_id]
            goal = node["goal"]
            if not goal:
                continue
            if not roma_allow_small and len(goal) < min_component_size:
                continue

            raw_dependencies = collect_dependencies(node_id)
            expanded_deps: List[str] = []
            for dep_id in raw_dependencies:
                if dep_id == node_id:
                    continue
                if dep_id in included_set:
                    expanded_deps.append(dep_id)
                else:
                    expanded_deps.extend(leaf_descendants(dep_id))
            dependencies = sorted({dep for dep in expanded_deps if dep in included_set})

            component = Component(
                id=node_id,
                title=f"Subtask {node_id}: {goal[:60]}",
                content=goal,
                component_type=self._map_roma_task_type(node.get("task_type")),
                complexity_score=self._calculate_component_complexity(goal),
                dependencies=dependencies,
                metadata={
                    "roma_task_type": str(node.get("task_type")),
                    "roma_source": node.get("source"),
                    "roma_parent_id": node.get("parent_id"),
                    "roma_depth": node.get("depth"),
                    "roma_children": node.get("children"),
                    "roma_is_atomic": node.get("is_atomic"),
                    "roma_node_kind": "leaf" if not node.get("children") else "plan",
                },
            )
            components.append(component)

        return components

    def _roma_decomposition_via_mcp(
        self,
        content: str,
        max_components: int,
        min_component_size: int,
        roma_allow_small: bool,
        **kwargs
    ) -> List[Component]:
        if not solve_with_roma:
            return []

        task = (
            "Create a detailed, domain-specific decomposition plan for the following content.\n"
            "Return a numbered list of subtasks with concise goals and dependencies when relevant.\n\n"
            f"{content}"
        )
        result = solve_with_roma(
            task=task,
            max_depth=kwargs.get("roma_max_depth", 2),
            execution_mode=kwargs.get("roma_execution_mode", "recursive"),
            provider=kwargs.get("roma_provider"),
            model=kwargs.get("roma_model"),
            api_key=kwargs.get("roma_api_key"),
        )

        if not isinstance(result, dict) or "error" in result:
            return []

        plan_text = result.get("result", "")
        subtasks = self._parse_roma_plan_text(plan_text)
        return self._create_roma_components_from_items(
            subtasks,
            max_components,
            min_component_size,
            roma_allow_small,
            source="mcp",
        )

    def _create_roma_components_from_plan(
        self,
        plan: Any,
        max_components: int,
        min_component_size: int,
        roma_allow_small: bool,
    ) -> List[Component]:
        subtasks = getattr(plan, "subtasks", None) or []
        dependencies_graph = getattr(plan, "dependencies_graph", None) or {}
        return self._create_roma_components_from_items(
            subtasks,
            max_components,
            min_component_size,
            roma_allow_small,
            dependencies_graph=dependencies_graph,
            source="planner",
        )

    def _create_roma_components_from_items(
        self,
        subtasks: List[Any],
        max_components: int,
        min_component_size: int,
        roma_allow_small: bool,
        dependencies_graph: Optional[Dict[str, List[str]]] = None,
        source: str = "planner",
    ) -> List[Component]:
        components = []
        if not subtasks:
            return components

        index_to_id = {str(i): f"roma_{i+1}" for i in range(len(subtasks))}
        index_to_id.update({str(i + 1): f"roma_{i+1}" for i in range(len(subtasks))})
        dependency_map = self._normalize_roma_dependency_graph(
            dependencies_graph or {},
            index_to_id,
        )

        for i, subtask in enumerate(subtasks):
            if len(components) >= max_components:
                break

            if isinstance(subtask, dict):
                goal = subtask.get("goal", "")
            else:
                goal = getattr(subtask, "goal", None) or str(subtask)
            goal = goal.strip()
            if not goal:
                continue
            if not roma_allow_small and len(goal) < min_component_size:
                continue

            task_type = getattr(subtask, "task_type", None)
            if task_type is None and isinstance(subtask, dict):
                task_type = subtask.get("task_type")

            raw_deps = getattr(subtask, "dependencies", None)
            if raw_deps is None and isinstance(subtask, dict):
                raw_deps = subtask.get("dependencies")
            raw_deps = raw_deps or []
            dependencies = self._normalize_roma_dependencies(raw_deps, index_to_id)

            component_id = index_to_id.get(str(i), f"roma_{i+1}")
            if component_id in dependency_map:
                dependencies = sorted(set(dependencies).union(dependency_map[component_id]))

            component = Component(
                id=component_id,
                title=f"Subtask {i+1}: {goal[:60]}",
                content=goal,
                component_type=self._map_roma_task_type(task_type),
                complexity_score=self._calculate_component_complexity(goal),
                dependencies=dependencies,
                metadata={
                    "roma_task_type": str(task_type) if task_type is not None else None,
                    "roma_source": source,
                    "roma_dependencies": raw_deps,
                },
            )
            components.append(component)

        return components

    def _normalize_roma_dependency_graph(
        self,
        dependencies_graph: Dict[str, List[str]],
        index_to_id: Dict[str, str],
    ) -> Dict[str, List[str]]:
        normalized = {}
        for node_idx, deps in dependencies_graph.items():
            node_id = index_to_id.get(str(node_idx), str(node_idx))
            normalized[node_id] = self._normalize_roma_dependencies(deps or [], index_to_id)
        return normalized

    def _normalize_roma_dependencies(
        self,
        dependencies: List[Any],
        index_to_id: Dict[str, str],
    ) -> List[str]:
        normalized = []
        for dep in dependencies:
            key = str(dep).strip()
            if not key:
                continue
            normalized.append(index_to_id.get(key, key))
        return normalized

    def _map_roma_task_type(self, task_type: Any) -> ComponentType:
        if task_type is None:
            return ComponentType.CORE_LOGIC

        task_value = task_type.value if hasattr(task_type, "value") else str(task_type)
        task_value = task_value.upper()
        mapping = {
            "RETRIEVE": ComponentType.SUPPORTING_FUNCTION,
            "WRITE": ComponentType.DOCUMENTATION,
            "THINK": ComponentType.CORE_LOGIC,
            "CODE_INTERPRET": ComponentType.CORE_LOGIC,
            "IMAGE_GENERATION": ComponentType.INTERFACE,
        }
        return mapping.get(task_value, ComponentType.CORE_LOGIC)

    def _parse_roma_plan_text(self, plan_text: str) -> List[Dict[str, Any]]:
        items = []
        for line in plan_text.splitlines():
            stripped = line.strip()
            if not stripped:
                continue
            match = re.match(r"^(?:\d+\.|[-*+])\s+(.*)$", stripped)
            if match:
                items.append({"goal": match.group(1).strip()})

        if not items and plan_text:
            for chunk in re.split(r"[;\n]+", plan_text):
                cleaned = chunk.strip()
                if cleaned:
                    items.append({"goal": cleaned})

        return items
    
    def _identify_sections(self, content: str) -> List[str]:
        """Identify major sections in content"""
        # Simple implementation - split by double newlines and headers
        sections = []
        
        # Split by headers (lines starting with #, ##, etc.)
        header_pattern = r'^#+\s+.*$'
        lines = content.split('\n')
        current_section = []
        
        for line in lines:
            if re.match(header_pattern, line) and current_section:
                sections.append('\n'.join(current_section))
                current_section = [line]
            else:
                current_section.append(line)
        
        if current_section:
            sections.append('\n'.join(current_section))
        
        # If no headers found, split by double newlines
        if len(sections) <= 1:
            sections = [s.strip() for s in content.split('\n\n') if s.strip()]
        
        return sections
    
    def _identify_functional_units(self, content: str) -> List[Dict[str, Any]]:
        """Identify functional units like functions, classes, etc."""
        units = []
        
        # Pattern for function definitions
        func_pattern = r'def\s+(\w+)\s*\([^)]*\):'
        class_pattern = r'class\s+(\w+).*?:'
        
        # Find functions
        for match in re.finditer(func_pattern, content, re.MULTILINE):
            start = match.start()
            name = match.group(1)
            
            # Find the end of the function (simple heuristic)
            lines = content[start:].split('\n')
            func_lines = [lines[0]]
            indent_level = len(lines[0]) - len(lines[0].lstrip())
            
            for line in lines[1:]:
                if line.strip() and len(line) - len(line.lstrip()) <= indent_level and not line.startswith(' '):
                    break
                func_lines.append(line)
            
            units.append({
                'name': name,
                'type': 'function',
                'content': '\n'.join(func_lines),
                'dependencies': self._extract_dependencies('\n'.join(func_lines))
            })
        
        # Find classes
        for match in re.finditer(class_pattern, content, re.MULTILINE):
            start = match.start()
            name = match.group(1)
            
            # Find the end of the class (simple heuristic)
            lines = content[start:].split('\n')
            class_lines = [lines[0]]
            indent_level = len(lines[0]) - len(lines[0].lstrip())
            
            for line in lines[1:]:
                if line.strip() and len(line) - len(line.lstrip()) <= indent_level and not line.startswith(' '):
                    break
                class_lines.append(line)
            
            units.append({
                'name': name,
                'type': 'class',
                'content': '\n'.join(class_lines),
                'dependencies': self._extract_dependencies('\n'.join(class_lines))
            })
        
        return units
    
    def _identify_semantic_chunks(self, content: str) -> List[Dict[str, Any]]:
        """Identify semantically coherent chunks"""
        chunks = []
        
        # Simple implementation - split by paragraphs and analyze topics
        paragraphs = [p.strip() for p in content.split('\n\n') if p.strip()]
        
        for i, paragraph in enumerate(paragraphs):
            # Extract key topics (simple keyword extraction)
            words = re.findall(r'\b\w+\b', paragraph.lower())
            word_freq = {}
            for word in words:
                if len(word) > 3:  # Skip short words
                    word_freq[word] = word_freq.get(word, 0) + 1
            
            # Get most frequent words as topic
            if word_freq:
                topic = max(word_freq, key=word_freq.get)
            else:
                topic = f"Topic {i+1}"
            
            chunks.append({
                'topic': topic,
                'content': paragraph,
                'coherence': len(set(words)) / len(words) if words else 0,
                'complexity_score': min(len(paragraph) / 1000, 1.0)
            })
        
        return chunks
    
    def _identify_structural_elements(self, content: str) -> List[Dict[str, Any]]:
        """Identify structural elements in content"""
        elements = []
        
        # Look for various structural patterns
        patterns = {
            'header': r'^#+\s+(.+)$',
            'list_item': r'^\s*[-*+]\s+(.+)$',
            'numbered_item': r'^\s*\d+\.\s+(.+)$',
            'code_block': r'```[\s\S]*?```',
            'quote': r'^>\s+(.+)$'
        }
        
        lines = content.split('\n')
        for i, line in enumerate(lines):
            for element_type, pattern in patterns.items():
                match = re.match(pattern, line)
                if match:
                    elements.append({
                        'type': element_type,
                        'title': match.group(1) if match.groups() else f"{element_type} {i+1}",
                        'content': line,
                        'level': len(line) - len(line.lstrip())
                    })
        
        return elements
    
    def _identify_dependency_clusters(self, content: str) -> List[Dict[str, Any]]:
        """Identify clusters based on dependencies"""
        clusters = []
        
        # Simple implementation - group by import statements and function calls
        lines = content.split('\n')
        current_cluster = []
        cluster_deps = set()
        
        for line in lines:
            # Check for imports
            if 'import' in line or 'from' in line:
                cluster_deps.add(line.strip())
            
            current_cluster.append(line)
            
            # End cluster on empty line or new import
            if not line.strip() and current_cluster:
                if len(current_cluster) > 1:
                    clusters.append({
                        'name': f"Cluster {len(clusters) + 1}",
                        'content': '\n'.join(current_cluster),
                        'dependencies': list(cluster_deps),
                        'is_core': len(cluster_deps) > 2,
                        'size': len(current_cluster),
                        'complexity': min(len(current_cluster) / 50, 1.0)
                    })
                current_cluster = []
                cluster_deps = set()
        
        # Add final cluster
        if current_cluster:
            clusters.append({
                'name': f"Cluster {len(clusters) + 1}",
                'content': '\n'.join(current_cluster),
                'dependencies': list(cluster_deps),
                'is_core': len(cluster_deps) > 2,
                'size': len(current_cluster),
                'complexity': min(len(current_cluster) / 50, 1.0)
            })
        
        return clusters
    
    def _identify_complexity_regions(self, content: str) -> List[Dict[str, Any]]:
        """Identify regions of high complexity"""
        regions = []
        
        # Split content into chunks and analyze complexity
        chunk_size = 200  # characters
        chunks = [content[i:i+chunk_size] for i in range(0, len(content), chunk_size)]
        
        for i, chunk in enumerate(chunks):
            if not chunk.strip():
                continue
            complexity_factors = []
            complexity_score = 0.0
            
            # Analyze various complexity factors
            # Nesting depth
            lines = [line for line in chunk.split('\n') if line.strip()]
            nesting = max((line.count('    ') for line in lines), default=0)
            if nesting > 3:
                complexity_factors.append('deep_nesting')
                complexity_score += 0.3
            
            # Number of conditions
            conditions = len(re.findall(r'\b(if|elif|while|for)\b', chunk))
            if conditions > 5:
                complexity_factors.append('many_conditions')
                complexity_score += 0.2
            
            # Long lines
            long_lines = sum(1 for line in chunk.split('\n') if len(line) > 100)
            if long_lines > 3:
                complexity_factors.append('long_lines')
                complexity_score += 0.2
            
            # Complex expressions
            complex_expr = len(re.findall(r'[(){}[\]]', chunk))
            if complex_expr > 20:
                complexity_factors.append('complex_expressions')
                complexity_score += 0.3
            
            if complexity_score > 0.5:  # High complexity threshold
                regions.append({
                    'content': chunk,
                    'complexity': min(complexity_score, 1.0),
                    'factors': complexity_factors
                })
        
        return regions
    
    def _extract_dependencies(self, content: str) -> List[str]:
        """Extract dependencies from content"""
        dependencies = []
        
        # Look for import statements
        import_pattern = r'(?:from\s+(\w+)|import\s+(\w+))'
        for match in re.finditer(import_pattern, content):
            dep = match.group(1) or match.group(2)
            if dep:
                dependencies.append(dep)
        
        # Look for function calls
        call_pattern = r'(\w+)\s*\('
        for match in re.finditer(call_pattern, content):
            func_name = match.group(1)
            if func_name not in ['print', 'len', 'str', 'int', 'float']:  # Skip built-ins
                dependencies.append(func_name)
        
        return list(set(dependencies))
    
    def _classify_component_type(self, content: str) -> ComponentType:
        """Classify the type of a component based on its content"""
        content_lower = content.lower()
        
        if 'def ' in content or 'class ' in content:
            return ComponentType.CORE_LOGIC
        elif 'import ' in content or 'from ' in content:
            return ComponentType.SUPPORTING_FUNCTION
        elif 'config' in content_lower or 'setting' in content_lower:
            return ComponentType.CONFIGURATION
        elif 'test' in content_lower or 'assert' in content_lower:
            return ComponentType.TEST_CASE
        elif 'try:' in content or 'except' in content:
            return ComponentType.ERROR_HANDLING
        elif content.startswith('#') or '"""' in content:
            return ComponentType.DOCUMENTATION
        elif '{' in content or '[' in content:
            return ComponentType.DATA_STRUCTURE
        else:
            return ComponentType.INTERFACE
    
    def _map_structure_type_to_component_type(self, structure_type: str) -> ComponentType:
        """Map structural type to component type"""
        mapping = {
            'header': ComponentType.DOCUMENTATION,
            'list_item': ComponentType.DATA_STRUCTURE,
            'numbered_item': ComponentType.DATA_STRUCTURE,
            'code_block': ComponentType.CORE_LOGIC,
            'quote': ComponentType.DOCUMENTATION
        }
        return mapping.get(structure_type, ComponentType.INTERFACE)
    
    def _calculate_component_complexity(self, content: str) -> float:
        """Calculate complexity score for a component"""
        if not content.strip():
            return 0.0

        score = 0.0

        # Length factor
        score += min(len(content) / 1000, 0.3)

        # Nesting factor
        lines = [line for line in content.split('\n') if line.strip()]
        max_nesting = max(((len(line) - len(line.lstrip())) // 4 for line in lines), default=0)
        score += min(max_nesting / 10, 0.3)
        
        # Complexity keywords
        complexity_keywords = ['if', 'elif', 'else', 'for', 'while', 'try', 'except', 'with']
        keyword_count = sum(content.lower().count(keyword) for keyword in complexity_keywords)
        score += min(keyword_count / 20, 0.4)
        
        return min(score, 1.0)
    
    def _build_dependency_graph(self, components: List[Component]) -> Dict[str, List[str]]:
        """Build dependency graph between components"""
        graph = {}

        for component in components:
            dependencies = set()

            # Check dependencies against other components
            for other in components:
                if other.id != component.id:
                    # Simple heuristic - check if component mentions other component's title
                    if other.title.lower() in component.content.lower():
                        dependencies.add(other.id)

                    # Check explicit dependencies
                    for dep in component.dependencies:
                        if dep == other.id:
                            dependencies.add(other.id)
                        elif dep.lower() in other.title.lower() or dep.lower() in other.content.lower():
                            dependencies.add(other.id)

            graph[component.id] = sorted(dependencies)

        return graph
    
    def _calculate_decomposition_quality(self, original_content: str, components: List[Component]) -> float:
        """Calculate quality score for decomposition"""
        if not components or not original_content:
            return 0.0
        
        score = 0.0
        
        # Coverage - how much of original content is covered
        total_component_length = sum(len(c.content) for c in components)
        coverage = min(total_component_length / len(original_content), 1.0)
        score += coverage * 0.4
        
        # Balance - components should be reasonably sized
        lengths = [len(c.content) for c in components]
        avg_length = sum(lengths) / len(lengths)
        if avg_length == 0:
            balance = 0.0
        else:
            variance = sum((l - avg_length) ** 2 for l in lengths) / len(lengths)
            balance = 1.0 / (1.0 + variance / (avg_length ** 2))
        score += balance * 0.3
        
        # Coherence - components should be internally coherent
        coherence = sum(self._calculate_component_coherence(c) for c in components) / len(components)
        score += coherence * 0.3
        
        return min(score, 1.0)
    
    def _calculate_component_coherence(self, component: Component) -> float:
        """Calculate internal coherence of a component"""
        # Simple heuristic based on repeated words and concepts
        words = re.findall(r'\b\w+\b', component.content.lower())
        if not words:
            return 0.0
        
        word_freq = {}
        for word in words:
            if len(word) > 3:  # Skip short words
                word_freq[word] = word_freq.get(word, 0) + 1
        
        # Calculate coherence based on word repetition
        if not word_freq:
            return 0.0
        
        max_freq = max(word_freq.values())
        coherence = max_freq / len(words)
        return min(coherence * 5, 1.0)  # Scale up and cap at 1.0
    
    def _analyze_complexity_distribution(self, components: List[Component]) -> Dict[str, Any]:
        """Analyze complexity distribution across components"""
        if not components:
            return {}
        
        complexities = [c.complexity_score for c in components]
        return {
            'min': min(complexities),
            'max': max(complexities),
            'avg': sum(complexities) / len(complexities),
            'high_complexity_count': sum(1 for c in complexities if c > 0.7)
        }
    
    def _create_reassembly_instructions(
        self, components: List[Component], dependency_graph: Dict[str, List[str]]
    ) -> Dict[str, Any]:
        """Create instructions for reassembling components"""
        return {
            'assembly_order': self._calculate_assembly_order(components, dependency_graph),
            'merge_strategies': self._suggest_merge_strategies(components),
            'validation_checks': self._create_validation_checks(components)
        }
    
    def _calculate_assembly_order(
        self, components: List[Component], dependency_graph: Dict[str, List[str]]
    ) -> List[str]:
        """Calculate optimal order for assembling components"""
        # Topological sort based on dependencies
        visited = set()
        temp_visited = set()
        order = []
        
        def visit(component_id: str):
            if component_id in temp_visited:
                return  # Cycle detected, skip
            if component_id in visited:
                return
            
            temp_visited.add(component_id)
            for dep in dependency_graph.get(component_id, []):
                visit(dep)
            temp_visited.remove(component_id)
            visited.add(component_id)
            order.append(component_id)
        
        for component in components:
            if component.id not in visited:
                visit(component.id)
        
        return order
    
    def _suggest_merge_strategies(self, components: List[Component]) -> Dict[str, str]:
        """Suggest strategies for merging components"""
        strategies = {}
        
        for component in components:
            if component.component_type == ComponentType.CORE_LOGIC:
                strategies[component.id] = "preserve_structure"
            elif component.component_type == ComponentType.DOCUMENTATION:
                strategies[component.id] = "merge_similar"
            else:
                strategies[component.id] = "standard_merge"
        
        return strategies
    
    def _create_validation_checks(self, components: List[Component]) -> List[str]:
        """Create validation checks for reassembly"""
        checks = [
            "verify_all_components_included",
            "check_dependency_satisfaction",
            "validate_syntax_correctness",
            "ensure_functionality_preservation"
        ]
        
        # Add component-specific checks
        for component in components:
            if component.component_type == ComponentType.TEST_CASE:
                checks.append(f"run_tests_for_{component.id}")
            elif component.component_type == ComponentType.CONFIGURATION:
                checks.append(f"validate_config_{component.id}")
        
        return checks
    
    def reassemble_components(
        self, 
        components: List[Component], 
        reassembly_instructions: Dict[str, Any],
        **kwargs
    ) -> ReassemblyResult:
        """
        Reassemble components back into coherent content.
        
        Args:
            components: List of components to reassemble
            reassembly_instructions: Instructions for reassembly
            **kwargs: Additional parameters
            
        Returns:
            ReassemblyResult: Result of reassembly process
        """
        start_time = time.time()
        
        # Follow assembly order
        assembly_order = reassembly_instructions.get('assembly_order', [c.id for c in components])
        merge_strategies = reassembly_instructions.get('merge_strategies', {})
        
        # Reassemble content
        reassembled_parts = []
        components_used = []
        
        for component_id in assembly_order:
            component = next((c for c in components if c.id == component_id), None)
            if component:
                strategy = merge_strategies.get(component_id, 'standard_merge')
                
                if strategy == "preserve_structure":
                    reassembled_parts.append(component.content)
                elif strategy == "merge_similar":
                    # Simple merge - could be enhanced
                    reassembled_parts.append(component.content)
                else:  # standard_merge
                    reassembled_parts.append(component.content)
                
                components_used.append(component_id)
        
        # Join parts
        reassembled_content = '\n\n'.join(reassembled_parts)
        
        # Calculate quality metrics
        quality_score = self._calculate_reassembly_quality(
            reassembled_content, components, reassembly_instructions
        )
        
        # Calculate improvement metrics
        improvement_metrics = self._calculate_improvement_metrics(
            reassembled_content, components
        )
        
        result = ReassemblyResult(
            reassembled_content=reassembled_content,
            components_used=components_used,
            quality_score=quality_score,
            improvement_metrics=improvement_metrics,
            metadata={
                "reassembly_time": time.time() - start_time,
                "components_count": len(components_used),
                "assembly_strategy": "ordered_merge"
            }
        )
        
        return result
    
    def _calculate_reassembly_quality(
        self, 
        reassembled_content: str, 
        components: List[Component], 
        instructions: Dict[str, Any]
    ) -> float:
        """Calculate quality of reassembled content"""
        score = 0.0
        
        # Completeness - all components should be included
        total_component_content = sum(len(c.content) for c in components)
        if total_component_content == 0:
            return 0.0
        completeness = min(len(reassembled_content) / total_component_content, 1.0)
        score += completeness * 0.4
        
        # Coherence - content should flow well
        coherence = self._calculate_content_coherence(reassembled_content)
        score += coherence * 0.3
        
        # Structure preservation
        structure_score = self._calculate_structure_preservation(reassembled_content, components)
        score += structure_score * 0.3
        
        return min(score, 1.0)
    
    def _calculate_content_coherence(self, content: str) -> float:
        """Calculate coherence of content"""
        # Simple heuristic - check for smooth transitions
        paragraphs = [p.strip() for p in content.split('\n\n') if p.strip()]
        if len(paragraphs) < 2:
            return 1.0
        
        coherence_score = 0.0
        for i in range(len(paragraphs) - 1):
            # Check for common words between adjacent paragraphs
            words1 = set(re.findall(r'\b\w+\b', paragraphs[i].lower()))
            words2 = set(re.findall(r'\b\w+\b', paragraphs[i + 1].lower()))
            
            if words1 and words2:
                overlap = len(words1.intersection(words2))
                coherence_score += overlap / max(len(words1), len(words2))
        
        return coherence_score / (len(paragraphs) - 1)
    
    def _calculate_structure_preservation(
        self, reassembled_content: str, components: List[Component]
    ) -> float:
        """Calculate how well structure is preserved"""
        # Simple heuristic - check if component boundaries are maintained
        score = 0.0
        
        for component in components:
            if component.content.strip() in reassembled_content:
                score += 1.0
        
        return score / len(components) if components else 0.0
    
    def _calculate_improvement_metrics(
        self, reassembled_content: str, components: List[Component]
    ) -> Dict[str, Any]:
        """Calculate improvement metrics"""
        original_length = sum(len(c.content) for c in components)
        
        return {
            "length_change": len(reassembled_content) - original_length,
            "length_ratio": len(reassembled_content) / original_length if original_length > 0 else 1.0,
            "component_integration": len(components),
            "structure_improvements": self._count_structure_improvements(reassembled_content, components)
        }
    
    def _count_structure_improvements(
        self, reassembled_content: str, components: List[Component]
    ) -> int:
        """Count structural improvements made during reassembly"""
        improvements = 0
        
        # Count transitions added
        transitions = len(re.findall(r'\n\n', reassembled_content))
        improvements += transitions
        
        # Count formatting improvements
        if reassembled_content.count('\n') > sum(c.content.count('\n') for c in components):
            improvements += 1
        
        return improvements
    
    def get_decomposition_history(self) -> List[DecompositionResult]:
        """Get history of decomposition results"""
        return self.decomposition_history.copy()
    
    def clear_history(self):
        """Clear decomposition history"""
        self.decomposition_history.clear()


# Additional utility functions for advanced decomposition features

def get_roma_integration_status() -> Dict[str, Any]:
    """
    Get the status of ROMA integration in ProblemDecomposition.

    Returns:
        Dict with ROMA availability status and version information
    """
    status = {
        "roma_dspy_available": ROMA_DSPY_AVAILABLE,
        "roma_mcp_available": ROMA_MCP_AVAILABLE,
        "roma_available": ROMA_DSPY_AVAILABLE or ROMA_MCP_AVAILABLE,
        "recommendation": "ROMA" if (ROMA_DSPY_AVAILABLE or ROMA_MCP_AVAILABLE) else "SEMANTIC"
    }

    if ROMA_DSPY_AVAILABLE:
        try:
            from roma_dspy import __version__
            status["roma_dspy_version"] = __version__
        except:
            status["roma_dspy_version"] = "unknown"

    return status


def get_recommended_strategy(content: str, prefer_roma: bool = True) -> DecompositionStrategy:
    """
    Recommend the best decomposition strategy based on content analysis.

    Args:
        content: Content to analyze
        prefer_roma: Whether to prefer ROMA when available

    Returns:
        Recommended DecompositionStrategy
    """
    patterns = analyze_content_patterns(content)
    roma_status = get_roma_integration_status()

    # If ROMA is available and preferred, use it for complex content
    if roma_status["roma_available"] and (
        prefer_roma
        or len(content) > 1500
        or patterns['functions'] > 3
        or patterns['classes'] > 1
        or patterns['headers'] > 2
    ):
        return DecompositionStrategy.ROMA

    # Fallback to other strategies
    if patterns['functions'] > 3 or patterns['classes'] > 1:
        return DecompositionStrategy.FUNCTIONAL
    elif patterns['headers'] > 2:
        return DecompositionStrategy.HIERARCHICAL
    elif patterns['imports'] > 5:
        return DecompositionStrategy.DEPENDENCY_BASED
    elif len(content) > 2000:
        return DecompositionStrategy.COMPLEXITY_BASED
    else:
        return DecompositionStrategy.SEMANTIC


def analyze_content_patterns(content: str) -> Dict[str, Any]:
    """Analyze patterns in content for better decomposition"""
    patterns = {
        'code_blocks': len(re.findall(r'```[\s\S]*?```', content)),
        'headers': len(re.findall(r'^#+\s+', content, re.MULTILINE)),
        'lists': len(re.findall(r'^\s*[-*+]\s+', content, re.MULTILINE)),
        'functions': len(re.findall(r'def\s+\w+\s*\(', content)),
        'classes': len(re.findall(r'class\s+\w+', content)),
        'imports': len(re.findall(r'^(?:from|import)\s+', content, re.MULTILINE))
    }
    
    return patterns


def suggest_optimal_strategy(content: str, prefer_roma: bool = True) -> DecompositionStrategy:
    """Suggest optimal decomposition strategy based on content analysis"""
    patterns = analyze_content_patterns(content)

    # Rule-based strategy selection
    if (ROMA_DSPY_AVAILABLE or ROMA_MCP_AVAILABLE) and (
        prefer_roma
        or len(content) > 1500
        or patterns['functions'] > 3
        or patterns['classes'] > 1
        or patterns['headers'] > 2
    ):
        return DecompositionStrategy.ROMA
    if patterns['functions'] > 3 or patterns['classes'] > 1:
        return DecompositionStrategy.FUNCTIONAL
    elif patterns['headers'] > 2:
        return DecompositionStrategy.HIERARCHICAL
    elif patterns['imports'] > 5:
        return DecompositionStrategy.DEPENDENCY_BASED
    elif len(content) > 2000:
        return DecompositionStrategy.COMPLEXITY_BASED
    else:
        return DecompositionStrategy.SEMANTIC


def create_decomposition_report(result: DecompositionResult) -> str:
    """Create a comprehensive report of decomposition results"""
    report = f"""
# Decomposition Report

## Overview
- **Strategy Used:** {result.decomposition_strategy.value}
- **Components Created:** {len(result.components)}
- **Quality Score:** {result.quality_score:.2f}
- **Processing Time:** {result.metadata.get('decomposition_time', 0):.2f}s

## Components Summary
"""
    
    for i, component in enumerate(result.components, 1):
        report += f"""
### Component {i}: {component.title}
- **Type:** {component.component_type.value}
- **Size:** {len(component.content)} characters
- **Complexity:** {component.complexity_score:.2f}
- **Dependencies:** {len(component.dependencies)}
"""
    
    report += f"""
## Dependency Graph
{json.dumps(result.dependency_graph, indent=2)}

## Quality Metrics
- **Coverage:** {result.metadata.get('avg_component_size', 0):.0f} avg chars per component
- **Complexity Distribution:** {result.metadata.get('complexity_distribution', {})}
"""
    
    return report
