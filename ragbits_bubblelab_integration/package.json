{
  "name": "@openevolve/ragbits-bubblelab-integration",
  "version": "1.0.0",
  "description": "Integration between Ragbits RAG framework and BubbleLab workflow builder",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "watch": "concurrently \"npm run dev\" \"npm run start\"",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "ragbits",
    "bubblelab",
    "rag",
    "workflow",
    "ai",
    "genai",
    "typescript"
  ],
  "author": "OpenEvolve Team",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "concurrently": "^8.0.0",
    "nodemon": "^3.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openevolve/ragbits-bubblelab-integration.git"
  },
  "bugs": {
    "url": "https://github.com/openevolve/ragbits-bubblelab-integration/issues"
  },
  "homepage": "https://github.com/openevolve/ragbits-bubblelab-integration#readme"
}