"""
Report Template System for OpenEvolve Reporting

This module provides a comprehensive template system for custom report generation.
Supports Jinja2 templates with custom filters, global functions, and inheritance.

Features:
- Built-in template library
- Custom template creation
- Template variables and filters
- Template inheritance
- Dynamic content blocks
- Branding and styling
- Multi-language support
"""

import logging
import json
from typing import Dict, List, Any, Optional, Callable, Tuple
from pathlib import Path
from datetime import datetime
from collections import defaultdict

logger = logging.getLogger(__name__)

# Import Jinja2
try:
    from jinja2 import Environment, FileSystemLoader, BaseLoader, TemplateNotFound
    from jinja2 import select_autoescape
    JINJA2_AVAILABLE = True
except ImportError:
    logger.warning("Jinja2 not found. Template system will be disabled.")
    JINJA2_AVAILABLE = False


class TemplateManager:
    """
    Manages report templates with Jinja2.

    Provides:
    - Built-in templates for common report types
    - Custom template loading
    - Template variables and filters
    - Template inheritance
    - Dynamic content rendering
    """

    # Built-in templates
