    def __init__(self, template_dir: Optional[str] = None):
        """
        Initialize template manager.

        Args:
            template_dir: Directory containing custom templates
        """
        if not JINJA2_AVAILABLE:
            logger.warning("Jinja2 not available. Template system disabled.")
            self.env = None
            return

        self.template_dir = Path(template_dir) if template_dir else Path('./templates')
        self.template_dir.mkdir(parents=True, exist_ok=True)

        # Initialize Jinja2 environment
        try:
            if self.template_dir.exists():
                self.env = Environment(
                    loader=FileSystemLoader(str(self.template_dir)),
                    autoescape=select_autoescape(['html', 'xml']),
                    trim_blocks=True,
                    lstrip_blocks=True
                )
            else:
                # Use dict loader for built-in templates
                self.env = Environment(
                    loader=DictLoader(self.BUILTIN_TEMPLATES),
                    autoescape=select_autoescape(['html', 'xml']),
                    trim_blocks=True,
                    lstrip_blocks=True
                )

            # Register custom filters
            self._register_filters()

            # Register custom globals
            self._register_globals()

            logger.info(f"TemplateManager initialized with template dir: {self.template_dir}")
        except Exception as e:
            logger.error(f"Failed to initialize Jinja2 environment: {e}")
            self.env = None

        # Cache for custom templates
        self.custom_templates: Dict[str, str] = {}

    def _register_filters(self):
        """Register custom Jinja2 filters."""
        if not self.env:
            return

        # Format percentage
        def format_percentage(value: float) -> str:
            return f"{value:.1f}%"

        # Format date
        def format_date(value: str, format_str: str = "%Y-%m-%d") -> str:
            try:
                dt = datetime.fromisoformat(value) if isinstance(value, str) else value
                return dt.strftime(format_str)
            except:
                return str(value)

        # Format number
        def format_number(value: float, decimals: int = 2) -> str:
            return f"{value:.{decimals}f}"

        # Create status badge
        def status_badge(status: str) -> str:
            colors = {
                'completed': 'green',
                'in_progress': 'yellow',
                'pending': 'gray',
                'blocked': 'red'
            }
            color = colors.get(status.lower().replace('-', '_'), 'gray')
            return f'<span style="background-color: {color}; color: white; padding: 2px 8px; border-radius: 3px;">{status.replace("_", " ").title()}</span>'

        # Create progress bar
        def progress_bar(percentage: float, width: int = 20) -> str:
            filled = int(width * percentage / 100)
            bar = '█' * filled + '░' * (width - filled)
            return f"{bar} {percentage:.1f}%"

        # Truncate text
        def truncate(text: str, length: int = 50) -> str:
            if len(text) <= length:
                return text
            return text[:length - 3] + '...'

        # Word wrap
        def word_wrap(text: str, width: int = 80) -> str:
            words = text.split()
            lines = []
            current_line = []
            current_length = 0

            for word in words:
                if current_length + len(word) + 1 <= width:
                    current_line.append(word)
                    current_length += len(word) + 1
                else:
                    lines.append(' '.join(current_line))
                    current_line = [word]
                    current_length = len(word)

            if current_line:
                lines.append(' '.join(current_line))

            return '\n'.join(lines)

        # Register filters
        self.env.filters['percentage'] = format_percentage
        self.env.filters['date'] = format_date
        self.env.filters['number'] = format_number
        self.env.filters['status_badge'] = status_badge
        self.env.filters['progress_bar'] = progress_bar
        self.env.filters['truncate'] = truncate
        self.env.filters['word_wrap'] = word_wrap

        logger.debug("Registered custom Jinja2 filters")

    def _register_globals(self):
        """Register custom Jinja2 global functions."""
        if not self.env:
            return

        # Current date/time
        def now(format_str: str = "%Y-%m-%d %H:%M:%S") -> str:
            return datetime.now().strftime(format_str)

        # Calculate average
        def average(values: List[float]) -> float:
            return sum(values) / len(values) if values else 0

        # Calculate sum
        def total(values: List[float]) -> float:
            return sum(values)

        # Get max
        def maximum(values: List[float]) -> float:
            return max(values) if values else 0

        # Get min
        def minimum(values: List[float]) -> float:
            return min(values) if values else 0

        # Count items
        def count(items: List[Any]) -> int:
            return len(items)

        # Register globals
        self.env.globals['now'] = now
        self.env.globals['average'] = average
        self.env.globals['total'] = total
        self.env.globals['maximum'] = maximum
        self.env.globals['minimum'] = minimum
        self.env.globals['count'] = count

        logger.debug("Registered custom Jinja2 globals")

    def render_template(
        self,
        template_name: str,
        context: Dict[str, Any],
        use_builtin: bool = False
    ) -> str:
        """
        Render a template with the given context.

        Args:
            template_name: Name of the template
            context: Dictionary with template variables
            use_builtin: Whether to use built-in templates

        Returns:
            str: Rendered template content

        Raises:
            TemplateNotFound: If template doesn't exist
            RuntimeError: If Jinja2 is not available
        """
        if not JINJA2_AVAILABLE:
            raise RuntimeError("Jinja2 is not available. Cannot render templates.")

        if not self.env:
            raise RuntimeError("Jinja2 environment not initialized.")

        try:
            # Try loading from file system first
            if not use_builtin and template_name in self.custom_templates:
                template = self.env.from_string(self.custom_templates[template_name])
            else:
                template = self.env.get_template(template_name)

            rendered = template.render(**context)
            logger.debug(f"Rendered template: {template_name}")
            return rendered

        except TemplateNotFound:
            # Try built-in templates
            if template_name in self.BUILTIN_TEMPLATES:
                template = self.env.from_string(self.BUILTIN_TEMPLATES[template_name])
                return template.render(**context)
            raise
        except Exception as e:
            logger.error(f"Error rendering template {template_name}: {e}")
            raise

    def create_custom_template(
        self,
        name: str,
        template_content: str,
        save_to_file: bool = True
    ) -> None:
        """
        Create a custom template.

        Args:
            name: Template name
            template_content: Template content
            save_to_file: Whether to save to file
        """
        self.custom_templates[name] = template_content

        if save_to_file:
            template_file = self.template_dir / f"{name}.j2"
            with open(template_file, 'w', encoding='utf-8') as f:
                f.write(template_content)
            logger.info(f"Created custom template: {name}")

    def list_templates(self) -> Dict[str, List[str]]:
        """
        List all available templates.

        Returns:
            Dict with builtin and custom template names
        """
        templates = {
            'builtin': list(self.BUILTIN_TEMPLATES.keys()),
            'custom': list(self.custom_templates.keys())
        }

        if self.template_dir.exists():
            custom_files = [
                f.stem for f in self.template_dir.glob("*.j2")
                if f.is_file()
            ]
            templates['custom'].extend(custom_files)

        return templates

    def validate_template(self, template_content: str) -> Tuple[bool, List[str]]:
        """
        Validate a template by compiling it.

        Args:
            template_content: Template content to validate

        Returns:
            Tuple of (is_valid, error_messages)
        """
        if not JINJA2_AVAILABLE:
            return False, ["Jinja2 is not available"]

        errors = []

        try:
            from jinja2 import TemplateSyntaxError
            self.env.from_string(template_content)
            return True, []
        except TemplateSyntaxError as e:
            errors.append(f"Syntax error at line {e.lineno}: {e.message}")
        except Exception as e:
            errors.append(str(e))

        return False, errors

    def export_template(self, name: str, output_path: str) -> None:
        """
        Export a template to a file.

        Args:
            name: Template name
            output_path: Path to export to
        """
        if name in self.BUILTIN_TEMPLATES:
            content = self.BUILTIN_TEMPLATES[name]
        elif name in self.custom_templates:
            content = self.custom_templates[name]
        else:
            raise ValueError(f"Template not found: {name}")

        with open(output_path, 'w', encoding='utf-8') as f:
            f.write(content)

        logger.info(f"Exported template '{name}' to {output_path}")

    def import_template(self, name: str, input_path: str) -> None:
        """
        Import a template from a file.

        Args:
            name: Name to give the template
            input_path: Path to import from
        """
        with open(input_path, 'r', encoding='utf-8') as f:
            content = f.read()

        self.create_custom_template(name, content)
        logger.info(f"Imported template '{name}' from {input_path}")


class DictLoader:
    """Simple dict-based template loader for Jinja2."""

    def __init__(self, templates: Dict[str, str]):
        self.templates = templates

    def get_source(self, environment, template):
        if template not in self.templates:
            raise TemplateNotFound(template)

        source = self.templates[template]
        return source, None, lambda: False


class ReportContextBuilder:
    """
    Builds context dictionaries for report templates.

    Provides convenience methods for creating well-structured
    context data from decomposition plans and other sources.
    """

    def __init__(self):
        """Initialize context builder."""
        pass

    def build_executive_summary_context(
        self,
        decomposition_plan: Any,
        insights: List[str],
        recommendations: List[str]
    ) -> Dict[str, Any]:
        """
        Build context for executive summary template.

        Args:
            decomposition_plan: DecompositionPlan object
            insights: List of key insights
            recommendations: List of recommendations

        Returns:
            Dict with template context
        """
        plan_data = self._extract_plan_data(decomposition_plan)

        return {
            'problem': plan_data.get('problem', {}),
            'key_metrics': self._calculate_metrics(plan_data),
            'insights': insights,
            'recommendations': recommendations,
            'quality_summary': self._summarize_quality(plan_data),
            'metadata': plan_data.get('metadata', {})
        }

    def build_detailed_report_context(self, decomposition_plan: Any) -> Dict[str, Any]:
        """
        Build context for detailed report template.

        Args:
            decomposition_plan: DecompositionPlan object

        Returns:
            Dict with template context
        """
        plan_data = self._extract_plan_data(decomposition_plan)

        return {
            'metadata': plan_data.get('metadata', {}),
            'problem': plan_data.get('problem', {}),
            'sub_problems': plan_data.get('sub_problems', []),
            'dependency_graph': plan_data.get('dependency_graph', {}),
            'quality_scores': plan_data.get('quality_scores', {}),
            'timeline': plan_data.get('timeline', {})
        }

    def build_progress_report_context(
        self,
        decomposition_plan: Any
    ) -> Dict[str, Any]:
        """
        Build context for progress report template.

        Args:
            decomposition_plan: DecompositionPlan object

        Returns:
            Dict with template context
        """
        plan_data = self._extract_plan_data(decomposition_plan)
        sub_problems = plan_data.get('sub_problems', [])

        return {
            'metrics': self._calculate_metrics(plan_data),
            'completed_sub_problems': [sp for sp in sub_problems if sp.get('status') == 'completed'],
            'in_progress_sub_problems': [sp for sp in sub_problems if sp.get('status') == 'in_progress'],
            'pending_sub_problems': [sp for sp in sub_problems if sp.get('status') == 'pending'],
            'blocked_sub_problems': [sp for sp in sub_problems if sp.get('status') == 'blocked']
        }

    def build_quality_report_context(
        self,
        decomposition_plan: Any,
        quality_history: Optional[List[Dict]] = None
    ) -> Dict[str, Any]:
        """
        Build context for quality report template.

        Args:
            decomposition_plan: DecompositionPlan object
            quality_history: Optional historical quality data

        Returns:
            Dict with template context
        """
        plan_data = self._extract_plan_data(decomposition_plan)
        quality_scores = plan_data.get('quality_scores', {})

        return {
            'quality_scores': quality_scores,
            'quality_history': quality_history or []
        }

    def build_comparison_context(
        self,
        decomposition_plans: List[Any]
    ) -> Dict[str, Any]:
        """
        Build context for comparison report template.

        Args:
            decomposition_plans: List of DecompositionPlan objects

        Returns:
            Dict with template context
        """
        plans_data = [self._extract_plan_data(plan) for plan in decomposition_plans]

        # Find best plan
        best_plan_index = max(
            range(len(plans_data)),
            key=lambda i: plans_data[i].get('quality_scores', {}).get('overall_score', 0)
        )
        best_plan_score = plans_data[best_plan_index].get('quality_scores', {}).get('overall_score', 0)

        # Generate comparison recommendations
        recommendations = []
        if len(plans_data) > 1:
            recommendations.append("Consider adopting the strategy from the best-performing plan")
            recommendations.append("Review quality differences to identify improvement areas")

        return {
            'plans': plans_data,
            'best_plan_index': best_plan_index,
            'best_plan_score': best_plan_score,
            'comparison_recommendations': recommendations
        }

    def _extract_plan_data(self, plan: Any) -> Dict[str, Any]:
        """Extract data from decomposition plan."""
        if hasattr(plan, '__dict__'):
            return plan.__dict__
        elif isinstance(plan, dict):
            return plan
        else:
            return {}

    def _calculate_metrics(self, plan_data: Dict[str, Any]) -> Dict[str, Any]:
        """Calculate key metrics."""
        sub_problems = plan_data.get('sub_problems', [])

        return {
            'total_sub_problems': len(sub_problems),
            'completed': sum(1 for sp in sub_problems if sp.get('status') == 'completed'),
            'in_progress': sum(1 for sp in sub_problems if sp.get('status') == 'in_progress'),
            'pending': sum(1 for sp in sub_problems if sp.get('status') == 'pending'),
            'completion_percentage': self._calculate_completion(sub_problems)
        }

    def _calculate_completion(self, sub_problems: List[Dict]) -> float:
        """Calculate completion percentage."""
        if not sub_problems:
            return 0.0

        completed = sum(1 for sp in sub_problems if sp.get('status') == 'completed')
        return (completed / len(sub_problems)) * 100

    def _summarize_quality(self, plan_data: Dict[str, Any]) -> Dict[str, Any]:
        """Summarize quality metrics."""
        quality = plan_data.get('quality_scores', {})

        return {
            'overall_score': quality.get('overall_score', 0),
            'completeness': quality.get('completeness_score', 0),
            'consistency': quality.get('consistency_score', 0),
            'feasibility': quality.get('feasibility_score', 0),
            'dependency_validity': quality.get('dependency_score', 0),
            'balance': quality.get('balance_score', 0)
        }


# Convenience functions
def create_template_manager(template_dir: Optional[str] = None) -> TemplateManager:
    """Create a template manager instance."""
    return TemplateManager(template_dir)


def render_quick_report(
    decomposition_plan: Any,
    template_name: str = 'executive_summary'
) -> str:
    """
    Render a quick report using built-in templates.

    Args:
        decomposition_plan: DecompositionPlan object
        template_name: Name of template to use

    Returns:
        str: Rendered report content
    """
    manager = TemplateManager()
    builder = ReportContextBuilder()

    if template_name == 'executive_summary':
        context = builder.build_executive_summary_context(
            decomposition_plan,
            insights=["Sample insight"],
            recommendations=["Sample recommendation"]
        )
    elif template_name == 'detailed_report':
        context = builder.build_detailed_report_context(decomposition_plan)
    elif template_name == 'progress_report':
        context = builder.build_progress_report_context(decomposition_plan)
    else:
        raise ValueError(f"Unknown template: {template_name}")

    return manager.render_template(template_name, context, use_builtin=True)
