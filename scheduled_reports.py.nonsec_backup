class ScheduleConfig:
    """Configuration for a scheduled report."""

    def __init__(
        self,
        schedule_id: str,
        report_type: str,
        schedule_expression: str,
        recipients: List[str],
        format: str = 'html',
        template: Optional[str] = None,
        filters: Optional[Dict[str, Any]] = None,
        enabled: bool = True,
        retention_days: int = 30
    ):
        """
        Initialize schedule configuration.

        Args:
            schedule_id: Unique identifier for the schedule
            report_type: Type of report (executive_summary, detailed, progress, etc.)
            schedule_expression: Cron expression or simple schedule (daily, weekly, etc.)
            recipients: List of email addresses
            format: Output format (html, pdf, xlsx, etc.)
            template: Optional template name
            filters: Optional filters for data selection
            enabled: Whether schedule is enabled
            retention_days: Number of days to retain reports
        """
        self.schedule_id = schedule_id
        self.report_type = report_type
        self.schedule_expression = schedule_expression
        self.recipients = recipients
        self.format = format
        self.template = template
        self.filters = filters or {}
        self.enabled = enabled
        self.retention_days = retention_days
        self.created_at = datetime.now().isoformat()
        self.last_run = None
        self.next_run = None
        self.run_count = 0

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary."""
        return {
            'schedule_id': self.schedule_id,
            'report_type': self.report_type,
            'schedule_expression': self.schedule_expression,
            'recipients': self.recipients,
            'format': self.format,
            'template': self.template,
            'filters': self.filters,
            'enabled': self.enabled,
            'retention_days': self.retention_days,
            'created_at': self.created_at,
            'last_run': self.last_run,
            'next_run': self.next_run,
            'run_count': self.run_count
        }

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'ScheduleConfig':
        """Create from dictionary."""
        config = cls(
            schedule_id=data['schedule_id'],
            report_type=data['report_type'],
            schedule_expression=data['schedule_expression'],
            recipients=data['recipients'],
            format=data.get('format', 'html'),
            template=data.get('template'),
            filters=data.get('filters', {}),
            enabled=data.get('enabled', True),
            retention_days=data.get('retention_days', 30)
        )
        config.created_at = data.get('created_at', config.created_at)
        config.last_run = data.get('last_run')
        config.next_run = data.get('next_run')
        config.run_count = data.get('run_count', 0)
        return config


class ScheduledReportManager:
    """
    Manages scheduled report generation and delivery.

    Features:
    - Cron-like scheduling with croniter
    - Email notifications with attachments
    - Report archiving and retention
    - Schedule persistence
    - Concurrent job management
    - Error handling and retries
    """

    def __init__(
        self,
        config: Optional[Dict[str, Any]] = None,
        storage_path: Optional[str] = None
    ):
        """
        Initialize scheduled report manager.

        Args:
            config: Configuration dictionary
            storage_path: Path to store schedules and reports
        """
        self.config = config or {}
        self.storage_path = Path(storage_path or './scheduled_reports')
        self.storage_path.mkdir(parents=True, exist_ok=True)

        # Initialize report generator
        self.report_generator = ReportGenerator(self.config) if REPORT_GENERATOR_AVAILABLE else None

        # Email configuration
        self.smtp_config = self.config.get('smtp', {})
        self.smtp_enabled = SMTPLIB_AVAILABLE and bool(self.smtp_config)

        # Schedule storage
        self.schedules_file = self.storage_path / 'schedules.json'
        self.schedules: Dict[str, ScheduleConfig] = {}

        # Report archive
        self.archive_dir = self.storage_path / 'archive'
        self.archive_dir.mkdir(exist_ok=True)

        # Running state
        self.running = False
        self.scheduler_thread = None

        # Load existing schedules
        self._load_schedules()

        logger.info(f"ScheduledReportManager initialized. Storage: {self.storage_path}")

    def _load_schedules(self):
        """Load schedules from storage."""
        if not self.schedules_file.exists():
            logger.info("No existing schedules found")
            return

        try:
            with open(self.schedules_file, 'r') as f:
                data = json.load(f)

            for schedule_id, schedule_data in data.items():
                self.schedules[schedule_id] = ScheduleConfig.from_dict(schedule_data)

            logger.info(f"Loaded {len(self.schedules)} schedules")
        except Exception as e:
            logger.error(f"Failed to load schedules: {e}")

    def _save_schedules(self):
        """Save schedules to storage."""
        try:
            data = {
                schedule_id: schedule.to_dict()
                for schedule_id, schedule in self.schedules.items()
            }

            with open(self.schedules_file, 'w') as f:
                json.dump(data, f, indent=2, default=str)

            logger.debug("Schedules saved")
        except Exception as e:
            logger.error(f"Failed to save schedules: {e}")

    def add_schedule(self, schedule_config: ScheduleConfig) -> None:
        """
        Add a new scheduled report.

        Args:
            schedule_config: ScheduleConfig object
        """
        self.schedules[schedule_config.schedule_id] = schedule_config
        self._save_schedules()
        logger.info(f"Added schedule: {schedule_config.schedule_id}")

    def remove_schedule(self, schedule_id: str) -> None:
        """
        Remove a scheduled report.

        Args:
            schedule_id: Schedule ID to remove
        """
        if schedule_id in self.schedules:
            del self.schedules[schedule_id]
            self._save_schedules()
            logger.info(f"Removed schedule: {schedule_id}")
        else:
            logger.warning(f"Schedule not found: {schedule_id}")

    def update_schedule(self, schedule_id: str, **kwargs) -> None:
        """
        Update an existing schedule.

        Args:
            schedule_id: Schedule ID to update
            **kwargs: Fields to update
        """
        if schedule_id not in self.schedules:
            raise ValueError(f"Schedule not found: {schedule_id}")

        schedule = self.schedules[schedule_id]

        for key, value in kwargs.items():
            if hasattr(schedule, key):
                setattr(schedule, key, value)
            else:
                logger.warning(f"Unknown field: {key}")

        self._save_schedules()
        logger.info(f"Updated schedule: {schedule_id}")

    def get_schedule(self, schedule_id: str) -> Optional[ScheduleConfig]:
        """
        Get a schedule by ID.

        Args:
            schedule_id: Schedule ID

        Returns:
            ScheduleConfig or None
        """
        return self.schedules.get(schedule_id)

    def list_schedules(self, enabled_only: bool = False) -> List[ScheduleConfig]:
        """
        List all schedules.

        Args:
            enabled_only: Only return enabled schedules

        Returns:
            List of ScheduleConfig objects
        """
        schedules = list(self.schedules.values())

        if enabled_only:
            schedules = [s for s in schedules if s.enabled]

        return schedules

    def enable_schedule(self, schedule_id: str) -> None:
        """Enable a schedule."""
        self.update_schedule(schedule_id, enabled=True)

    def disable_schedule(self, schedule_id: str) -> None:
        """Disable a schedule."""
        self.update_schedule(schedule_id, enabled=False)

    def calculate_next_run(self, schedule: ScheduleConfig) -> Optional[datetime]:
        """
        Calculate next run time for a schedule.

        Args:
            schedule: ScheduleConfig object

        Returns:
            datetime or None
        """
        if not schedule.enabled:
            return None

        try:
            # Try cron expression first
            if CRONITER_AVAILABLE and self._is_cron_expression(schedule.schedule_expression):
                base_time = datetime.now()
                if schedule.last_run:
                    base_time = datetime.fromisoformat(schedule.last_run)

                cron = croniter(schedule.schedule_expression, base_time)
                return cron.get_next(datetime)

            # Try simple expressions
            elif schedule.schedule_expression.lower() == 'daily':
                return datetime.now().replace(hour=9, minute=0, second=0, microsecond=0) + timedelta(days=1)

            elif schedule.schedule_expression.lower() == 'weekly':
                return datetime.now().replace(hour=9, minute=0, second=0, microsecond=0) + timedelta(weeks=1)

            elif schedule.schedule_expression.lower() == 'monthly':
                # First day of next month
                next_month = datetime.now().replace(day=1) + timedelta(days=32)
                return next_month.replace(day=1, hour=9, minute=0, second=0, microsecond=0)

            elif schedule.schedule_expression.lower().startswith('every '):
                # Parse "every N hours/days/weeks"
                parts = schedule.schedule_expression.lower().split()
                if len(parts) >= 3:
                    try:
                        interval = int(parts[1])
                        unit = parts[2]

                        if unit.startswith('hour'):
                            return datetime.now() + timedelta(hours=interval)
                        elif unit.startswith('day'):
                            return datetime.now() + timedelta(days=interval)
                        elif unit.startswith('week'):
                            return datetime.now() + timedelta(weeks=interval)
                    except ValueError:
                        pass

            logger.warning(f"Cannot parse schedule expression: {schedule.schedule_expression}")
            return None

        except Exception as e:
            logger.error(f"Error calculating next run: {e}")
            return None

    def _is_cron_expression(self, expr: str) -> bool:
        """Check if expression is a cron expression."""
        # Simple heuristic: cron expressions have 5 or 6 parts
        parts = expr.split()
        return len(parts) in [5, 6]

    def run_schedule(self, schedule_id: str, data_source: Callable) -> Optional[str]:
        """
        Manually run a scheduled report.

        Args:
            schedule_id: Schedule ID to run
            data_source: Callable that returns decomposition plans

        Returns:
            str: Path to generated report or None
        """
        schedule = self.get_schedule(schedule_id)
        if not schedule:
            logger.error(f"Schedule not found: {schedule_id}")
            return None

        if not schedule.enabled:
            logger.warning(f"Schedule is disabled: {schedule_id}")
            return None

        logger.info(f"Running scheduled report: {schedule_id}")

        try:
            # Get data from source
            decomposition_plans = data_source(schedule.filters)

            if not decomposition_plans:
                logger.warning(f"No data returned for schedule: {schedule_id}")
                return None

            # Generate report
            if not self.report_generator:
                logger.error("Report generator not available")
                return None

            # Generate output path
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            output_filename = f"{schedule_id}_{timestamp}.{schedule.format}"
            output_path = self.archive_dir / output_filename

            # Generate report based on type
            if len(decomposition_plans) == 1:
                report_path = self.report_generator.generate_report(
                    decomposition_plans[0],
                    output_format=schedule.format,
                    template_name=schedule.template,
                    output_path=str(output_path)
                )
            else:
                report_path = self.report_generator.generate_aggregated_report(
                    decomposition_plans,
                    output_format=schedule.format,
                    output_path=str(output_path)
                )

            # Update schedule
            schedule.last_run = datetime.now().isoformat()
            schedule.run_count += 1
            schedule.next_run = self.calculate_next_run(schedule)
            self._save_schedules()

            # Send email notification
            if schedule.recipients and self.smtp_enabled:
                self._send_email(schedule, report_path)

            logger.info(f"Successfully ran schedule: {schedule_id}")
            return report_path

        except Exception as e:
            logger.error(f"Error running schedule {schedule_id}: {e}", exc_info=True)
            return None

    def _send_email(self, schedule: ScheduleConfig, report_path: str) -> None:
        """
        Send email notification with report attachment.

        Args:
            schedule: ScheduleConfig object
            report_path: Path to report file
        """
        if not self.smtp_enabled:
            logger.warning("SMTP not configured, skipping email")
            return

        try:
            # Create message
            msg = MIMEMultipart()
            msg['From'] = self.smtp_config.get('from', 'noreply@openevolve.com')
            msg['To'] = ', '.join(schedule.recipients)
            msg['Subject'] = f"Report: {schedule.schedule_id}"

            # Body
            body = f"""
Scheduled Report: {schedule.schedule_id}
Report Type: {schedule.report_type}
Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

Please find the report attached.
"""

            msg.attach(MIMEText(body, 'plain'))

            # Attach report
            if Path(report_path).exists():
                with open(report_path, 'rb') as f:
                    part = MIMEApplication(f.read(), Name=Path(report_path).name)

                part['Content-Disposition'] = f'attachment; filename="{Path(report_path).name}"'
                msg.attach(part)

            # Send email
            smtp_server = self.smtp_config.get('host', 'localhost')
            smtp_port = self.smtp_config.get('port', 25)
            smtp_username = self.smtp_config.get('username')
            smtp_password = self.smtp_config.get('password')
            smtp_use_tls = self.smtp_config.get('use_tls', True)

            with smtplib.SMTP(smtp_server, smtp_port) as server:
                if smtp_use_tls:
                    server.starttls()

                if smtp_username and smtp_password:
                    server.login(smtp_username, smtp_password)

                server.send_message(msg)

            logger.info(f"Email sent for schedule: {schedule.schedule_id}")

        except Exception as e:
            logger.error(f"Failed to send email: {e}")

    def start(self, data_source: Callable, check_interval: int = 60) -> None:
        """
        Start the scheduler.

        Args:
            data_source: Callable that returns decomposition plans
            check_interval: Seconds between schedule checks
        """
        if self.running:
            logger.warning("Scheduler is already running")
            return

        self.running = True
        self.data_source = data_source
        self.check_interval = check_interval

        # Calculate next runs for all schedules
        for schedule in self.schedules.values():
            schedule.next_run = self.calculate_next_run(schedule)

        self._save_schedules()

        # Start scheduler thread
        self.scheduler_thread = threading.Thread(target=self._scheduler_loop, daemon=True)
        self.scheduler_thread.start()

        logger.info("Scheduler started")

    def stop(self) -> None:
        """Stop the scheduler."""
        self.running = False

        if self.scheduler_thread:
            self.scheduler_thread.join(timeout=5)

        logger.info("Scheduler stopped")

    def _scheduler_loop(self) -> None:
        """Main scheduler loop."""
        while self.running:
            try:
                now = datetime.now()

                # Check each schedule
                for schedule in self.schedules.values():
                    if not schedule.enabled:
                        continue

                    if schedule.next_run and schedule.next_run <= now:
                        # Run the schedule
                        logger.info(f"Triggering scheduled report: {schedule.schedule_id}")
                        self.run_schedule(schedule.schedule_id, self.data_source)

                # Sleep until next check
                time.sleep(self.check_interval)

            except Exception as e:
                logger.error(f"Error in scheduler loop: {e}", exc_info=True)
                time.sleep(self.check_interval)

    def cleanup_old_reports(self) -> None:
        """Remove reports older than retention period."""
        try:
            now = datetime.now()
            removed_count = 0

            for report_file in self.archive_dir.iterdir():
                if report_file.is_file():
                    file_time = datetime.fromtimestamp(report_file.stat().st_mtime)
                    age_days = (now - file_time).days

                    # Check retention period for this schedule
                    schedule_id = report_file.stem.split('_')[0]
                    schedule = self.get_schedule(schedule_id)

                    if schedule and age_days > schedule.retention_days:
                        report_file.unlink()
                        removed_count += 1
                        logger.debug(f"Removed old report: {report_file.name}")

            logger.info(f"Cleaned up {removed_count} old reports")

        except Exception as e:
            logger.error(f"Error cleaning up old reports: {e}")

    def get_schedule_status(self, schedule_id: str) -> Optional[Dict[str, Any]]:
        """
        Get status of a schedule.

        Args:
            schedule_id: Schedule ID

        Returns:
            Dict with status information or None
        """
        schedule = self.get_schedule(schedule_id)
        if not schedule:
            return None

        return {
            'schedule_id': schedule.schedule_id,
            'enabled': schedule.enabled,
            'last_run': schedule.last_run,
            'next_run': schedule.next_run,
            'run_count': schedule.run_count,
            'report_count': len(list(self.archive_dir.glob(f"{schedule_id}_*")))
        }

    def get_all_statuses(self) -> List[Dict[str, Any]]:
        """
        Get status of all schedules.

        Returns:
            List of status dictionaries
        """
        return [
            self.get_schedule_status(schedule_id)
            for schedule_id in self.schedules.keys()
        ]


