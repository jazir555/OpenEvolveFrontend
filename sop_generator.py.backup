"""
SOP Generator and Refiner - MAKER-Based System

This module uses the MAKER framework (arXiv:2511.09030) to generate and refine
Standard Operating Procedures (SOPs) that are:
- Complete and unambiguous
- Physically realistic with achievable tolerances
- Turnkey-ready with all parameters specified
- Continuously improvable based on execution data

Key Features:
- Generate SOPs from high-level requirements
- Refine existing SOPs based on execution feedback
- Zero-error guarantees through MAKER voting
- Automatic parameter optimization
- QC and safety protocol generation

Author: SOP Generator System
Version: 1.0.0
Paper: arXiv:2511.09030
"""

import asyncio
import logging
import os
import re
import time
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum
from typing import Dict, List, Optional, Any, Tuple
import sqlite3
import json

try:
    from ace_steer_integration import AceSteerBridge
    ACE_STEER_AVAILABLE = True
except ImportError:
    AceSteerBridge = None
    ACE_STEER_AVAILABLE = False

from generic_maker_integration import (
    run_generic_maker,
    GenericEvaluator,
    GenericTask,
    GenericSolution,
    TaskType,
    MAKERConfig
)

# Configure logging
logger = logging.getLogger(__name__)


# ============================================================================
# SOP Data Models
# ============================================================================

class SOPSection(Enum):
    """Standard SOP sections"""
    TITLE = "title"
    PHILOSOPHY = "philosophy"
    PRECONDITIONS = "preconditions"
    EQUIPMENT = "equipment"
    MATERIALS = "materials"
    PROTOCOLS = "protocols"
    QUALITY_CONTROL = "quality_control"
    SAFETY = "safety"
    VALIDATION = "validation"
    SCALING = "scaling"


@dataclass
class SOPRequirement:
    """Structured SOP requirement analysis result"""
    requirement: str
    domain: str
    constraints: List[str]
    equipment: List[str]
    materials: List[str]
    flags: List[str]
    assumptions: List[str]


@dataclass
class SOPExecutionFeedback:
    """Execution feedback entry for refinement."""
    component: str
    issue: str
    severity: str = "medium"
    recommended_action: str = ""
    observed_value: Optional[float] = None
    expected_value: Optional[float] = None
    tolerance: Optional[float] = None


@dataclass
class SOPParameter:
    """A parameter specification in an SOP"""
    name: str
    value: float
    unit: str
    tolerance: float  # ± tolerance
    verification_method: str = ""
    critical: bool = True
    rationale: str = ""

    def format_spec(self) -> str:
        """Format as specification string"""
        if self.tolerance >= self.value:
            # Use percentage tolerance
            pct_tol = (self.tolerance / self.value) * 100
            return f"{self.value} {self.unit} ± {pct_tol:.1f}%"
        else:
            return f"{self.value} {self.unit} ± {self.tolerance} {self.unit}"


@dataclass
class SOPStep:
    """A single step in a protocol"""
    step_number: int
    action: str
    duration: Optional[float] = None  # in seconds
    duration_tolerance: Optional[float] = None
    verification_method: str = ""
    acceptance_criteria: str = ""
    contingency_action: str = ""
    substeps: List[str] = field(default_factory=list)

    def format_step(self) -> str:
        """Format as Markdown"""
        result = f"**Step {self.step_number}:** {self.action}\n\n"

        if self.duration:
            duration_str = self._format_duration(self.duration)
            if self.duration_tolerance:
                duration_str += f" ± {self._format_duration(self.duration_tolerance)}"
            result += f"· Duration: {duration_str}\n"

        if self.verification_method:
            result += f"· Verification: {self.verification_method}\n"

        if self.acceptance_criteria:
            result += f"· Acceptance: {self.acceptance_criteria}\n"

        if self.contingency_action:
            result += f"· Contingency: {self.contingency_action}\n"

        if self.substeps:
            result += "\n"
            for i, substep in enumerate(self.substeps, 1):
                result += f"  - Sub-step {self.step_number}.{i}: {substep}\n"

        return result

    def _format_duration(self, seconds: float) -> str:
        """Format duration in human-readable form"""
        if seconds < 60:
            return f"{seconds:.1f} seconds"
        elif seconds < 3600:
            mins = seconds / 60
            return f"{mins:.1f} minutes"
        else:
            hours = seconds / 3600
            return f"{hours:.1f} hours"


@dataclass
class StandardOperatingProcedure:
    """Complete SOP document"""
    title: str
    version: str
    status: str
    effective_date: str
    description: str
    classification: str = "TURNKEY"

    # SOP Sections
    preconditions: List[str] = field(default_factory=list)
    environmental_conditions: Dict[str, SOPParameter] = field(default_factory=dict)
    equipment: List[Dict[str, str]] = field(default_factory=list)
    materials: List[Dict[str, Any]] = field(default_factory=list)
    protocols: List[SOPStep] = field(default_factory=list)
    quality_control: List[str] = field(default_factory=list)
    safety_protocols: List[str] = field(default_factory=list)
    validation_criteria: List[str] = field(default_factory=list)
    scaling_info: List[str] = field(default_factory=list)

    metadata: Dict[str, Any] = field(default_factory=dict)
    created_at: float = field(default_factory=time.time)
    revision_history: List[Dict[str, str]] = field(default_factory=list)

    def to_markdown(self) -> str:
        """Convert to complete Markdown document"""
        md = []

        # Header
        md.append(f"# {self.title}\n")
        md.append(f"**Version:** {self.version}\n")
        md.append(f"**Status:** {self.status}\n")
        md.append(f"**Effective Date:** {self.effective_date}\n")
        md.append(f"**Classification:** {self.classification}\n")
        md.append(f"\n{self.description}\n")

        # Preconditions
        if self.preconditions:
            md.append("\n## Preconditions\n\n")
            for prec in self.preconditions:
                md.append(f"· {prec}\n")

        # Environmental Conditions
        if self.environmental_conditions:
            md.append("\n## Environmental Conditions\n\n")
            for param_name, param in self.environmental_conditions.items():
                md.append(f"### {param_name}\n\n")
                md.append(f"· Target: {param.format_spec()}\n")
                if param.verification_method:
                    md.append(f"· Verification: {param.verification_method}\n")
                if param.rationale:
                    md.append(f"· Rationale: {param.rationale}\n")
                md.append("\n")

        # Equipment
        if self.equipment:
            md.append("\n## Equipment Specifications\n\n")
            for eq in self.equipment:
                md.append(f"### {eq.get('name', 'Unknown')}\n\n")
                for key, value in eq.items():
                    if key != 'name':
                        md.append(f"· **{key}:** {value}\n")
                md.append("\n")

        # Materials
        if self.materials:
            md.append("\n## Materials\n\n")
            for mat in self.materials:
                md.append(f"### {mat.get('name', 'Unknown')}\n\n")
                for key, value in mat.items():
                    if key != 'name':
                        md.append(f"· **{key}:** {value}\n")
                md.append("\n")

        # Protocols
        if self.protocols:
            md.append("\n## Detailed Execution Protocols\n\n")
            for phase, steps in self._group_protocols():
                md.append(f"### {phase}\n\n")
                for step in steps:
                    md.append(step.format_step())
                    md.append("\n")

        # Quality Control
        if self.quality_control:
            md.append("\n## Quality Control\n\n")
            for qc in self.quality_control:
                md.append(f"· {qc}\n")

        # Safety
        if self.safety_protocols:
            md.append("\n## Safety Protocols\n\n")
            for safety in self.safety_protocols:
                md.append(f"· {safety}\n")

        # Validation
        if self.validation_criteria:
            md.append("\n## Validation\n\n")
            for val in self.validation_criteria:
                md.append(f"· {val}\n")

        # Scaling
        if self.scaling_info:
            md.append("\n## Scaling\n\n")
            for scale in self.scaling_info:
                md.append(f"· {scale}\n")

        # Metadata
        if self.metadata:
            md.append("\n---\n\n")
            md.append("## Metadata\n\n")
            for key, value in self.metadata.items():
                md.append(f"· **{key}:** {value}\n")

        return "".join(md)

    def _group_protocols(self) -> List[Tuple[str, List[SOPStep]]]:
        """Group steps into phases"""
        phases = {}
        current_phase = "General Protocol"

        for step in self.protocols:
            # Could infer phases from step numbering or step content
            if current_phase not in phases:
                phases[current_phase] = []
            phases[current_phase].append(step)

        return list(phases.items())

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "title": self.title,
            "version": self.version,
            "status": self.status,
            "effective_date": self.effective_date,
            "description": self.description,
            "classification": self.classification,
            "preconditions": self.preconditions,
            "environmental_conditions": {
                name: {
                    "value": param.value,
                    "unit": param.unit,
                    "tolerance": param.tolerance,
                    "verification_method": param.verification_method,
                    "critical": param.critical,
                    "rationale": param.rationale
                }
                for name, param in self.environmental_conditions.items()
            },
            "equipment": self.equipment,
            "materials": self.materials,
            "protocols": [
                {
                    "step_number": step.step_number,
                    "action": step.action,
                    "duration": step.duration,
                    "duration_tolerance": step.duration_tolerance,
                    "verification_method": step.verification_method,
                    "acceptance_criteria": step.acceptance_criteria,
                    "contingency_action": step.contingency_action,
                    "substeps": step.substeps
                }
                for step in self.protocols
            ],
            "quality_control": self.quality_control,
            "safety_protocols": self.safety_protocols,
            "validation_criteria": self.validation_criteria,
            "scaling_info": self.scaling_info,
            "metadata": self.metadata,
            "created_at": self.created_at,
            "revision_history": self.revision_history
        }

    def to_json(self, indent: int = 2) -> str:
        """Serialize SOP to JSON string"""
        return json.dumps(self.to_dict(), indent=indent)

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> "StandardOperatingProcedure":
        """Rehydrate SOP from dict"""
        sop = cls(
            title=data.get("title", ""),
            version=data.get("version", "1.0"),
            status=data.get("status", "DRAFT"),
            effective_date=data.get("effective_date", datetime.now().strftime("%Y-%m-%d")),
            description=data.get("description", ""),
            classification=data.get("classification", "TURNKEY"),
        )
        sop.preconditions = data.get("preconditions", [])
        sop.environmental_conditions = {
            name: SOPParameter(**param) for name, param in data.get("environmental_conditions", {}).items()
        }
        sop.equipment = data.get("equipment", [])
        sop.materials = data.get("materials", [])
        sop.protocols = [SOPStep(**step) for step in data.get("protocols", [])]
        sop.quality_control = data.get("quality_control", [])
        sop.safety_protocols = data.get("safety_protocols", [])
        sop.validation_criteria = data.get("validation_criteria", [])
        sop.scaling_info = data.get("scaling_info", [])
        sop.metadata = data.get("metadata", {})
        sop.created_at = data.get("created_at", time.time())
        sop.revision_history = data.get("revision_history", [])
        return sop


# ============================================================================
# SOP Generation/Refinement System
# ============================================================================

class SOPAceSteerPipeline:
    """ACE + Steer pipeline for SOP generation and refinement."""

    def __init__(
        self,
        ace_agent_id: str,
        skillbook_path: Optional[str] = None,
        verifications: Optional[List[str]] = None,
        model: Optional[str] = None,
        max_attempts: int = 2
    ):
        self.model = model
        self.max_attempts = max(1, max_attempts)
        self.verifications = verifications or ["slop", "markdown"]
        self.bridge = AceSteerBridge(ace_agent_id, skillbook_path) if ACE_STEER_AVAILABLE else None

    @property
    def available(self) -> bool:
        return self.bridge is not None

    def prepare_task(self, task_description: str) -> str:
        if not self.bridge:
            return task_description
        return self.bridge.prepare_prompt(task=task_description, model=self.model)

    def verify_output(self, query: str, output: Any) -> Dict[str, Any]:
        if not self.bridge:
            return {"all_passed": True, "results": [], "failed_verifications": []}
        return self.bridge.verify_and_learn(
            query=query,
            output=output,
            verifications=self.verifications,
            model=self.model
        )

    def append_verification_feedback(self, task_description: str, verification: Dict[str, Any]) -> str:
        failures = []
        for result in verification.get("results", []):
            if not result.get("passed"):
                reason = result.get("reason", "no reason provided")
                failures.append(f"- {result.get('judge', 'unknown')}: {reason}")
                for fix in result.get("suggested_fixes", []):
                    title = fix.get("title", "fix")
                    desc = fix.get("description", "")
                    failures.append(f"  - {title}: {desc}")

        if not failures:
            return task_description

        return (
            f"{task_description}\n\n"
            "STEER VERIFICATION FEEDBACK:\n"
            + "\n".join(failures)
            + "\n"
        )

class SOPGenerator:
    """
    Generates and refines SOPs using MAKER framework.

    Capabilities:
    - Generate complete SOP from requirements
    - Refine SOP based on execution data
    - Optimize parameters based on performance
    - Ensure all sections are complete
    """

    def __init__(
        self,
        config: MAKERConfig = None,
        ace_steer_enabled: bool = True,
        ace_agent_id: str = "sop_generator",
        ace_skillbook_path: Optional[str] = "./ace_skillbook.json",
        ace_verifications: Optional[List[str]] = None,
        ace_model: Optional[str] = None,
        ace_max_attempts: int = 2
    ):
        """
        Initialize SOP generator.

        Args:
            config: MAKER configuration
        """
        self.config = config or MAKERConfig(
            enable_voting=True,
            voting_threshold=3,
            enable_decomposition=True,
            max_generations=30,
            population_size=20
        )

        self.statistics = {
            "sops_generated": 0,
            "sops_refined": 0,
            "average_quality": 0.0,
            "total_generation_time": 0.0
        }
        self.requirement_analyzer = SOPRequirementAnalyzer()
        self.validator = SOPValidator()
        self.feedback_analyzer = SOPFeedbackAnalyzer()
        self.ace_pipeline = None
        if ace_steer_enabled and ACE_STEER_AVAILABLE:
            self.ace_pipeline = SOPAceSteerPipeline(
                ace_agent_id=ace_agent_id,
                skillbook_path=ace_skillbook_path,
                verifications=ace_verifications,
                model=ace_model,
                max_attempts=ace_max_attempts
            )

    async def generate_sop(
        self,
        requirement_description: str,
        domain: str = "general",
        constraints: List[str] = None,
        equipment_available: List[str] = None,
        existing_sop: Optional[StandardOperatingProcedure] = None,
        enable_auto_refine: bool = True
    ) -> StandardOperatingProcedure:
        """
        Generate or refine an SOP.

        Args:
            requirement_description: High-level requirement
            domain: Domain (e.g., "chemistry", "manufacturing", "software")
            constraints: Specific constraints
            equipment_available: Available equipment
            existing_sop: If provided, refine this SOP instead of creating new

        Returns:
            Generated or refined SOP
        """
        start_time = time.time()

        analysis = self.requirement_analyzer.analyze(
            requirement=requirement_description,
            domain=domain,
            constraints=constraints or [],
            equipment=equipment_available or []
        )

        if existing_sop:
            logger.info(f"Refining SOP: {existing_sop.title}")
            task = self._create_refinement_task(
                requirement_description,
                existing_sop,
                constraints or [],
                analysis
            )
            mode = TaskType.CUSTOM
        else:
            logger.info(f"Generating SOP for: {requirement_description}")
            task = self._create_generation_task(analysis)
            mode = TaskType.DOCUMENT_PROCESSING

        # Generate using MAKER with optional ACE + Steer reliability loop
        base_description = task.description
        task_description = base_description
        verification_report = None
        attempts = 1
        if self.ace_pipeline and self.ace_pipeline.available:
            task_description = self.ace_pipeline.prepare_task(task_description)
            attempts = self.ace_pipeline.max_attempts

        for attempt in range(attempts):
            result = await run_generic_maker(
                task_description=task_description,
                evaluator=SOPEvaluator(analysis.domain, analysis.constraints, analysis.equipment),
                task_type=mode,
                config=self.config
            )

            if not self.ace_pipeline or not self.ace_pipeline.available:
                break

            verification_report = self.ace_pipeline.verify_output(
                query=requirement_description,
                output=result.solution
            )
            if verification_report.get("all_passed"):
                break

            task_description = self.ace_pipeline.append_verification_feedback(
                base_description,
                verification_report
            )
            task_description = self.ace_pipeline.prepare_task(task_description)

        # Parse result into SOP
        sop = self._parse_to_sop(result.solution, requirement_description, domain, existing_sop)
        sop.metadata["quality_score"] = result.quality_score
        sop.metadata["task_id"] = result.task_id
        sop.metadata["domain"] = domain
        sop.metadata["analysis"] = {
            "flags": analysis.flags,
            "assumptions": analysis.assumptions
        }
        sop.metadata["validation"] = self.validator.validate(sop)
        if verification_report is not None:
            sop.metadata["steer_verification"] = verification_report

        if enable_auto_refine and sop.metadata["validation"]["issues"]:
            sop = await self._refine_until_valid(sop, analysis, max_iterations=2)

        # Update statistics
        if existing_sop:
            self.statistics["sops_refined"] += 1
        else:
            self.statistics["sops_generated"] += 1

        elapsed = time.time() - start_time
        self.statistics["total_generation_time"] += elapsed

        n = self.statistics["sops_generated"] + self.statistics["sops_refined"]
        if n > 0:
            prev_avg = self.statistics["average_quality"] * (n - 1)
            self.statistics["average_quality"] = (prev_avg + result.quality_score) / n

        logger.info(f"SOP {'refined' if existing_sop else 'generated'} in {elapsed:.1f}s")
        logger.info(f"Quality score: {result.quality_score:.3f}")

        return sop

    async def refine_from_execution(
        self,
        sop: StandardOperatingProcedure,
        observations: Dict[str, Any],
        requirement_description: str
    ) -> StandardOperatingProcedure:
        """Refine SOP using execution observations."""
        feedback = self.feedback_analyzer.analyze(sop, observations)
        if not feedback:
            return sop
        feedback_lines = [
            f"{item.severity.upper()}: {item.component} - {item.issue}"
            for item in feedback
        ]
        return await self.generate_sop(
            requirement_description=requirement_description,
            domain=sop.metadata.get("domain", "general"),
            constraints=feedback_lines,
            equipment_available=[e.get("name", "") for e in sop.equipment if e.get("name")],
            existing_sop=sop
        )

    async def _refine_until_valid(
        self,
        sop: StandardOperatingProcedure,
        analysis: SOPRequirement,
        max_iterations: int = 2
    ) -> StandardOperatingProcedure:
        """Iteratively refine SOP until validation passes or max iterations reached."""
        current = sop
        for _ in range(max_iterations):
            report = self.validator.validate(current)
            if report["passed"]:
                break
            feedback = report["issues"]
            current = await self.generate_sop(
                requirement_description=analysis.requirement,
                domain=analysis.domain,
                constraints=analysis.constraints + feedback,
                equipment_available=analysis.equipment,
                existing_sop=current,
                enable_auto_refine=False
            )
        return current

    def _create_generation_task(self, analysis: SOPRequirement) -> GenericTask:
        """Create task for SOP generation"""
        template_context = self._build_template_context(analysis.domain, analysis.constraints or [])
        analysis_context = self._format_requirement_analysis(analysis)
        desc = f"""
Generate a complete Standard Operating Procedure (SOP) for:

Requirement: {analysis.requirement}
Domain: {analysis.domain}

Parsed Requirements:
{analysis_context}

Template Guidance:
{template_context}

The SOP must include:
1. Title, version, status, effective date
2. Preconditions (environmental, personnel, certifications)
3. Environmental conditions with specific tolerances
4. Equipment specifications with models and parameters
5. Materials with exact specifications and tolerances
6. Detailed step-by-step protocols with:
   - Specific actions
   - Exact durations with tolerances
   - Verification methods
   - Acceptance criteria
   - Contingency actions
7. Quality control procedures
8. Safety protocols
9. Validation criteria
10. Scaling information

All parameters MUST have:
- Exact numerical values
- Realistic tolerances (no "as appropriate")
- Verification methods
- Rationale for critical parameters

Format as complete Markdown document.
"""
        return GenericTask(
            task_id=f"sop_gen_{int(time.time())}",
            description=desc,
            task_type=TaskType.DOCUMENT_PROCESSING,
            requirements=analysis.constraints or [],
            metadata={"domain": analysis.domain, "equipment": analysis.equipment or []}
        )

    def _build_template_context(self, domain: str, constraints: List[str]) -> str:
        """Load domain and method templates for prompt context"""
        templates = []
        domain_templates = self._load_templates_from_dir(
            os.path.join("sop_templates", "domains", domain)
        )
        templates.extend(domain_templates)

        method_keywords = {
            "experimental": "experimental",
            "observational": "observational",
            "computational": "computational",
        }
        constraint_text = " ".join(constraints).lower()
        for key, name in method_keywords.items():
            if key in constraint_text:
                method_template = self._load_template(os.path.join("sop_templates", "methods"), name)
                if method_template:
                    templates.append(method_template)

        if not templates:
            return "No templates available for this domain/method."

        return "\n\n".join(templates)

    def _load_template(self, base_path: str, filename: Optional[str] = None) -> str:
        """Load a template file if present"""
        if filename:
            path = os.path.join(os.path.dirname(__file__), base_path, f"{filename}.md")
        else:
            path = os.path.join(os.path.dirname(__file__), f"{base_path}.md")
        if not os.path.exists(path):
            return ""
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()

    def _load_templates_from_dir(self, relative_dir: str) -> List[str]:
        """Load all markdown templates from a directory"""
        base_dir = os.path.join(os.path.dirname(__file__), relative_dir)
        if not os.path.isdir(base_dir):
            return []
        templates = []
        for filename in sorted(os.listdir(base_dir)):
            if filename.endswith(".md"):
                path = os.path.join(base_dir, filename)
                with open(path, "r", encoding="utf-8") as handle:
                    templates.append(handle.read().strip())
        return templates

    def _create_refinement_task(
        self,
        requirement: str,
        existing_sop: StandardOperatingProcedure,
        constraints: List[str],
        analysis: SOPRequirement
    ) -> GenericTask:
        """Create task for SOP refinement"""
        analysis_context = self._format_requirement_analysis(analysis)
        feedback_block = "\n".join(f"- {item}" for item in constraints) if constraints else "- None"
        desc = f"""
Refine and improve this Standard Operating Procedure based on:

Requirement: {requirement}

Parsed Requirements:
{analysis_context}

Current SOP Issues/Feedback:
{self._analyze_sop_issues(existing_sop)}

Additional Feedback:
{feedback_block}

Refinement Goals:
- Improve parameter tolerances based on realistic variability
- Add missing verification methods
- Strengthen acceptance criteria
- Add missing contingency actions
- Optimize timing parameters
- Ensure all sections are complete

Current SOP Content:
{existing_sop.to_markdown()[:2000]}...  # First 2000 chars

Generate refined SOP that addresses all issues while maintaining completeness.
"""
        return GenericTask(
            task_id=f"sop_ref_{int(time.time())}",
            description=desc,
            task_type=TaskType.CUSTOM,
            requirements=constraints or [],
            metadata={"existing_sop": existing_sop.title}
        )

    def _format_requirement_analysis(self, analysis: SOPRequirement) -> str:
        """Format requirement analysis for prompt context."""
        constraints = analysis.constraints or ["No specific constraints"]
        equipment = analysis.equipment or ["Standard equipment"]
        materials = analysis.materials or ["No explicit materials listed"]
        flags = analysis.flags or ["No red flags detected"]
        assumptions = analysis.assumptions or ["No assumptions recorded"]

        return "\n".join(
            [
                "Constraints:",
                *[f"- {item}" for item in constraints],
                "Equipment:",
                *[f"- {item}" for item in equipment],
                "Materials:",
                *[f"- {item}" for item in materials],
                "Red Flags:",
                *[f"- {item}" for item in flags],
                "Assumptions:",
                *[f"- {item}" for item in assumptions],
            ]
        )

    def _analyze_sop_issues(self, sop: StandardOperatingProcedure) -> str:
        """Analyze existing SOP for issues"""
        issues = []

        # Check for missing tolerances
        for param_name, param in sop.environmental_conditions.items():
            if param.tolerance == 0:
                issues.append(f"- Parameter '{param_name}' has no tolerance specified")

        # Check for missing verification methods
        for param_name, param in sop.environmental_conditions.items():
            if not param.verification_method:
                issues.append(f"- Parameter '{param_name}' has no verification method")

        # Check for missing acceptance criteria
        for step in sop.protocols:
            if not step.acceptance_criteria:
                issues.append(f"- Step {step.step_number} has no acceptance criteria")

        # Check for missing contingency actions
        for step in sop.protocols:
            if not step.contingency_action:
                issues.append(f"- Step {step.step_number} has no contingency action")

        if not issues:
            return "No significant issues found. Focus on optimization."
        else:
            return "\n".join(issues)

    def _parse_to_sop(
        self,
        solution: str,
        title: str,
        domain: str,
        previous_sop: Optional[StandardOperatingProcedure]
    ) -> StandardOperatingProcedure:
        """Parse MAKER solution into SOP object"""
        # Create basic SOP structure
        if previous_sop:
            # Update existing SOP
            sop = previous_sop
            sop.version = self._increment_version(sop.version)
            sop.revision_history.append({
                "date": datetime.now().isoformat(),
                "change": f"Refined based on: {title}",
                "previous_version": sop.version
            })
        else:
            # Create new SOP
            version = "1.0"
            sop = StandardOperatingProcedure(
                title=self._extract_title(solution, title),
                version=version,
                status="DRAFT",
                effective_date=datetime.now().strftime("%Y-%m-%d"),
                description=title,
                classification="TURNKEY",
                revision_history=[{
                    "date": datetime.now().isoformat(),
                    "change": "Initial generation",
                    "previous_version": "N/A"
                }]
            )

        # Parse sections from solution
        self._parse_sections(solution, sop)

        return sop

    def _extract_title(self, solution: str, fallback: str) -> str:
        """Extract title from solution"""
        # Look for title pattern
        title_match = re.search(r'^#\s+(.+)$', solution, re.MULTILINE)
        if title_match:
            return title_match.group(1).strip()
        return fallback

    def _increment_version(self, version: str) -> str:
        """Increment version number"""
        try:
            major, minor = map(float, version.split('.'))
            return f"{major}.{minor + 1:.1f}"
        except:
            return version

    def _parse_sections(self, solution: str, sop: StandardOperatingProcedure):
        """Parse Markdown sections into SOP object"""
        # This is a simplified parser - real implementation would be more robust

        # Extract preconditions
        pre_section = self._extract_any_section(solution, ["Preconditions"])
        if pre_section:
            sop.preconditions = self._parse_list_items(pre_section)

        # Extract environmental conditions
        env_section = self._extract_any_section(solution, ["Environmental Conditions"])
        if env_section:
            sop.environmental_conditions = self._parse_environmental_conditions(env_section)

        # Extract equipment
        equipment_section = self._extract_any_section(solution, ["Equipment Specifications", "Equipment"])
        if equipment_section:
            sop.equipment = self._parse_equipment(equipment_section)

        # Extract materials
        materials_section = self._extract_any_section(solution, ["Materials"])
        if materials_section:
            sop.materials = self._parse_materials(materials_section)

        # Extract protocols
        protocols_section = self._extract_any_section(solution, ["Protocols"])
        if protocols_section:
            sop.protocols = self._parse_protocols(protocols_section)

        # Extract quality control
        qc_section = self._extract_any_section(solution, ["Quality Control"])
        if qc_section:
            sop.quality_control = self._parse_list_items(qc_section)

        # Extract safety
        safety_section = self._extract_any_section(solution, ["Safety"])
        if safety_section:
            sop.safety_protocols = self._parse_list_items(safety_section)

        # Extract validation criteria
        validation_section = self._extract_any_section(solution, ["Validation Criteria", "Validation"])
        if validation_section:
            sop.validation_criteria = self._parse_list_items(validation_section)

        # Extract scaling information
        scaling_section = self._extract_any_section(solution, ["Scaling Information", "Scaling"])
        if scaling_section:
            sop.scaling_info = self._parse_list_items(scaling_section)

    def _extract_section(self, content: str, section_name: str) -> Optional[str]:
        """Extract a section from Markdown content"""
        pattern = rf'## {re.escape(section_name)}.*?\n(.*?)(?=\n##|\Z|$)'
        match = re.search(pattern, content, re.DOTALL)
        return match.group(1).strip() if match else None

    def _extract_any_section(self, content: str, section_names: List[str]) -> Optional[str]:
        """Extract the first matching section from a list of names"""
        for name in section_names:
            section = self._extract_section(content, name)
            if section:
                return section
        return None

    def _parse_environmental_conditions(self, section: str) -> Dict[str, SOPParameter]:
        """Parse environmental conditions section"""
        params = {}

        # Look for subsections (###)
        subsections = re.split(r'###', section)

        for subsection in subsections:
            if not subsection.strip():
                continue

            lines = subsection.strip().split('\n')
            param_name = lines[0].strip() if lines else ""

            # Extract value and tolerance
            param = SOPParameter(
                name=param_name,
                value=0.0,
                unit="",
                tolerance=0.0,
                verification_method="",
                rationale=""
            )

            for line in lines[1:]:
                if "Target:" in line or "Aú" in line:
                    # Parse parameter line
                    if re.search(r'(\d+\.?\d*)\s*([Aø%]+)\s*Añ', line):
                        match = re.search(r'(\d+\.?\d*)\s*([Aø%]+)\s*Añ\s*(\d+\.?\d*)', line)
                        if match:
                            param.value = float(match.group(1))
                            param.unit = match.group(2)
                            param.tolerance = float(match.group(3))

            params[param_name] = param

        return params

    def _parse_protocols(self, section: str) -> List[SOPStep]:
        """Parse protocols section into steps"""
        steps: List[SOPStep] = []

        step_pattern = r'\*\*Step\s+(\d+):\*\*\s*(.*?)\n'
        matches = list(re.finditer(step_pattern, section))

        for idx, match in enumerate(matches):
            step_num = int(match.group(1))
            action = match.group(2).strip()

            start = match.end()
            end = matches[idx + 1].start() if idx + 1 < len(matches) else len(section)
            block = section[start:end]

            step = SOPStep(
                step_number=step_num,
                action=action,
                duration=None,
                duration_tolerance=None,
                verification_method="",
                acceptance_criteria="",
                contingency_action="",
                substeps=[]
            )

            duration_match = re.search(
                r'Duration:\s*([\d.]+)\s*(seconds|minutes|hours)(?:\s*AAñ\s*([\d.]+)\s*(seconds|minutes|hours))?',
                block
            )
            if duration_match:
                step.duration = self._convert_to_seconds(float(duration_match.group(1)), duration_match.group(2))
                if duration_match.group(3):
                    step.duration_tolerance = self._convert_to_seconds(
                        float(duration_match.group(3)),
                        duration_match.group(4)
                    )

            verification_match = re.search(r'Verification:\s*(.+)', block)
            if verification_match:
                step.verification_method = verification_match.group(1).strip()

            acceptance_match = re.search(r'Acceptance:\s*(.+)', block)
            if acceptance_match:
                step.acceptance_criteria = acceptance_match.group(1).strip()

            contingency_match = re.search(r'Contingency:\s*(.+)', block)
            if contingency_match:
                step.contingency_action = contingency_match.group(1).strip()

            for line in block.splitlines():
                line = line.strip()
                if line.startswith("- Sub-step"):
                    parts = line.split(":", 1)
                    if len(parts) == 2:
                        step.substeps.append(parts[1].strip())

            steps.append(step)

        return steps

    def _parse_equipment(self, section: str) -> List[Dict[str, str]]:
        """Parse equipment specifications section"""
        equipment: List[Dict[str, str]] = []
        subsections = re.split(r'###', section)
        for subsection in subsections:
            if not subsection.strip():
                continue
            lines = [line.strip() for line in subsection.strip().split('\n') if line.strip()]
            name = lines[0]
            entry: Dict[str, str] = {"name": name}
            for line in lines[1:]:
                kv_match = re.search(r'\*\*(.+?):\*\*\s*(.+)', line)
                if kv_match:
                    entry[kv_match.group(1).strip()] = kv_match.group(2).strip()
            equipment.append(entry)
        return equipment

    def _parse_materials(self, section: str) -> List[Dict[str, Any]]:
        """Parse materials section into dicts"""
        materials: List[Dict[str, Any]] = []
        subsections = re.split(r'###', section)
        for subsection in subsections:
            if not subsection.strip():
                continue
            lines = [line.strip() for line in subsection.strip().split('\n') if line.strip()]
            name = lines[0]
            entry: Dict[str, Any] = {"name": name}
            for line in lines[1:]:
                kv_match = re.search(r'\*\*(.+?):\*\*\s*(.+)', line)
                if kv_match:
                    entry[kv_match.group(1).strip()] = kv_match.group(2).strip()
            materials.append(entry)
        return materials

    def _parse_list_items(self, section: str) -> List[str]:
        """Parse bullet points into list"""
        items = []
        for line in section.split('\n'):
            if line.strip().startswith('Aú'):
                items.append(line.strip()[1:].strip())
            elif line.strip().startswith('-'):
                items.append(line.strip()[1:].strip())
        return items

    def _convert_to_seconds(self, value: float, unit: str) -> float:
        """Convert time value to seconds"""
        if unit == "seconds":
            return value
        elif unit == "minutes":
            return value * 60
        elif unit == "hours":
            return value * 3600
        return value


# ============================================================================
# Requirement Analysis and Red-Flagging
# ============================================================================

class SOPRequirementAnalyzer:
    """Analyze raw requirements and extract constraints, equipment, and flags."""

    AMBIGUOUS_PHRASES = [
        "as appropriate",
        "as needed",
        "if necessary",
        "standard equipment",
        "normal conditions",
        "typical",
    ]

    EQUIPMENT_HINTS = [
        "stirrer",
        "thermometer",
        "incubator",
        "centrifuge",
        "microscope",
        "balance",
        "pipette",
        "reactor",
        "server",
        "database",
        "load balancer",
    ]

    def analyze(
        self,
        requirement: str,
        domain: str,
        constraints: List[str],
        equipment: List[str],
    ) -> SOPRequirement:
        flags = []
        assumptions = []

        lower = requirement.lower()
        for phrase in self.AMBIGUOUS_PHRASES:
            if phrase in lower:
                flags.append(f"Ambiguous phrase detected: '{phrase}'")

        extracted_equipment = list(equipment)
        for hint in self.EQUIPMENT_HINTS:
            if hint in lower and not any(hint in item.lower() for item in extracted_equipment):
                extracted_equipment.append(hint)

        extracted_constraints = list(constraints)
        for line in requirement.splitlines():
            if "must" in line.lower() or "require" in line.lower():
                extracted_constraints.append(line.strip())

        materials = []
        for line in requirement.splitlines():
            if "solution" in line.lower() or "reagent" in line.lower():
                materials.append(line.strip())

        if not extracted_constraints:
            assumptions.append("No explicit constraints provided; default tolerances applied.")
        if not extracted_equipment:
            assumptions.append("No explicit equipment provided; assume standard equipment.")

        return SOPRequirement(
            requirement=requirement.strip(),
            domain=domain,
            constraints=extracted_constraints,
            equipment=extracted_equipment,
            materials=materials,
            flags=flags,
            assumptions=assumptions,
        )


class SOPFeedbackAnalyzer:
    """Generate feedback entries from SOP execution observations."""

    def analyze(
        self,
        sop: StandardOperatingProcedure,
        observations: Dict[str, Any]
    ) -> List[SOPExecutionFeedback]:
        feedback: List[SOPExecutionFeedback] = []

        for param_name, data in observations.get("environmental_conditions", {}).items():
            param = sop.environmental_conditions.get(param_name)
            if not param:
                continue
            observed = data.get("observed")
            expected = param.value
            tolerance = param.tolerance
            if observed is None:
                continue
            deviation = abs(observed - expected)
            if deviation > tolerance:
                feedback.append(
                    SOPExecutionFeedback(
                        component=f"environmental:{param_name}",
                        issue=f"Observed {observed}{param.unit} outside tolerance {tolerance}{param.unit}",
                        severity="high",
                        recommended_action="Adjust tolerance or improve control method",
                        observed_value=observed,
                        expected_value=expected,
                        tolerance=tolerance,
                    )
                )

        for step_obs in observations.get("protocols", []):
            step_number = step_obs.get("step_number")
            if step_number is None:
                continue
            step = next((s for s in sop.protocols if s.step_number == step_number), None)
            if not step:
                continue
            duration = step.duration
            tolerance = step.duration_tolerance or 0
            observed_duration = step_obs.get("duration")
            if duration and observed_duration:
                if abs(observed_duration - duration) > tolerance:
                    feedback.append(
                        SOPExecutionFeedback(
                            component=f"protocol_step:{step_number}",
                            issue="Duration exceeded tolerance",
                            severity="medium",
                            recommended_action="Update duration tolerance or adjust step timing",
                            observed_value=observed_duration,
                            expected_value=duration,
                            tolerance=tolerance,
                        )
                    )

            if step_obs.get("verification_failed"):
                feedback.append(
                    SOPExecutionFeedback(
                        component=f"protocol_step:{step_number}",
                        issue="Verification failed during execution",
                        severity="high",
                        recommended_action="Clarify verification method and acceptance criteria",
                    )
                )

        return feedback

# ============================================================================
# SOP Quality Evaluator
# ============================================================================

class SOPEvaluator(GenericEvaluator):
    """
    Evaluates SOP quality based on completeness, specificity, and realism.

    Evaluation Criteria:
    1. Completeness - All sections present
    2. Specificity - All parameters specified with tolerances
    3. Realism - Achievable tolerances and verification methods
    4. Clarity - Unambiguous instructions
    5. Safety - Comprehensive safety protocols
    """

    def __init__(
        self,
        domain: str = "general",
        constraints: List[str] = None,
        equipment: List[str] = None
    ):
        self.domain = domain
        self.constraints = constraints or []
        self.equipment = equipment or []

    def evaluate(self, solution: str, task: GenericTask) -> float:
        """
        Evaluate SOP quality.

        Returns:
            Quality score between 0.0 and 1.0
        """
        score = 0.0
        max_score = 0.0

        # 1. Completeness (30%)
        completeness_score = self._evaluate_completeness(solution)
        max_score += 0.3
        score += 0.3 * completeness_score

        # 2. Parameter Specificity (25%)
        specificity_score = self._evaluate_specificity(solution)
        max_score += 0.25
        score += 0.25 * specificity_score

        # 3. Realism (20%)
        realism_score = self._evaluate_realism(solution)
        max_score += 0.2
        score += 0.2 * realism_score

        # 4. Clarity (15%)
        clarity_score = self._evaluate_clarity(solution)
        max_score += 0.15
        score += 0.15 * clarity_score

        # 5. Safety (10%)
        safety_score = self._evaluate_safety(solution)
        max_score += 0.1
        score += 0.1 * safety_score

        # Normalize
        final_score = score / max_score if max_score > 0 else 0.0
        return min(1.0, final_score)

    def _evaluate_completeness(self, solution: str) -> float:
        """Check if all required sections are present"""
        required_sections = [
            "Environmental Conditions",
            "Equipment",
            "Materials",
            "Protocols",
            "Quality Control",
            "Safety"
        ]

        found = 0
        for section in required_sections:
            if section in solution:
                found += 1
            elif section.lower() in solution.lower():
                found += 0.5

        return found / len(required_sections)

    def _evaluate_specificity(self, solution: str) -> float:
        """Check if parameters have specific values and tolerances"""
        # Count parameters with tolerances
        tolerance_patterns = [
            r'±\s*\d+\.?\d*\s*%',
            r'±\s*\d+\.?\d*\s*°[CF]',
            r'\d+\.?\d*\s*±\s*\d+\.?\d*'
        ]

        tolerance_count = 0
        for pattern in tolerance_patterns:
            tolerance_count += len(re.findall(pattern, solution))

        # Expect at least 10 parameters with tolerances
        return min(1.0, tolerance_count / 10.0)

    def _evaluate_realism(self, solution: str) -> float:
        """Check if tolerances are realistic"""
        # Check for verification methods
        verification_count = len(re.findall(r'[Vv]erification', solution))

        # Check for specific equipment models
        equipment_count = len(re.findall(r'Model:\s*\w+', solution))

        # Check for realistic tolerances (not "as appropriate")
        if re.search(r'as appropriate', solution, re.IGNORECASE):
            return 0.0  # Automatic fail

        score = 0.0
        if verification_count >= 3:
            score += 0.5
        if equipment_count >= 2:
            score += 0.5

        return score

    def _evaluate_clarity(self, solution: str) -> float:
        """Check for clear, unambiguous language"""
        # Check for step-by-step format
        if re.search(r'Step\s+\d+:', solution):
            step_score = 0.4
        else:
            step_score = 0.0

        # Check for action verbs
        action_patterns = [
            r'\b(Command|Set|Activate|Verify|Record|Measure|Wait|Add|Remove|Mix|Ramp|Hold)\b'
        ]
        action_count = sum(len(re.findall(pattern, solution, re.IGNORECASE)) for pattern in action_patterns)

        action_score = min(0.6, action_count / 20.0)

        return step_score + action_score

    def _evaluate_safety(self, solution: str) -> float:
        """Evaluate safety protocols"""
        safety_indicators = [
            'emergency',
            'protective equipment',
            'safety glasses',
            'gloves',
            'ventilation',
            'contingency',
            'first aid',
            'warning'
        ]

        indicator_count = 0
        solution_lower = solution.lower()

        for indicator in safety_indicators:
            if indicator in solution_lower:
                indicator_count += 1

        # Expect at least 5 safety indicators
        return min(1.0, indicator_count / 5.0)

    def get_evaluation_details(self) -> Dict[str, Any]:
        return {
            "criteria": [
                "Completeness (30%)",
                "Specificity (25%)",
                "Realism (20%)",
                "Clarity (15%)",
                "Safety (10%)"
            ],
            "domain": self.domain,
            "constraints": self.constraints
        }


# ============================================================================
# SOP Validation
# ============================================================================

class SOPValidator:
    """Validate SOP completeness and quality before execution."""

    REQUIRED_SECTIONS = [
        "preconditions",
        "environmental_conditions",
        "equipment",
        "materials",
        "protocols",
        "quality_control",
        "safety_protocols",
        "validation_criteria",
    ]

    def validate(self, sop: StandardOperatingProcedure) -> Dict[str, Any]:
        issues: List[str] = []

        for section in self.REQUIRED_SECTIONS:
            value = getattr(sop, section, None)
            if not value:
                issues.append(f"Missing or empty section: {section}")

        for name, param in sop.environmental_conditions.items():
            if param.tolerance <= 0:
                issues.append(f"Environmental parameter '{name}' missing tolerance")
            if not param.verification_method:
                issues.append(f"Environmental parameter '{name}' missing verification")

        for step in sop.protocols:
            if not step.verification_method:
                issues.append(f"Step {step.step_number} missing verification method")
            if not step.acceptance_criteria:
                issues.append(f"Step {step.step_number} missing acceptance criteria")
            if not step.contingency_action:
                issues.append(f"Step {step.step_number} missing contingency action")

        return {
            "passed": len(issues) == 0,
            "issues": issues,
        }


class SOPParser:
    """Parse SOP markdown into a StandardOperatingProcedure object."""

    def parse(self, markdown: str) -> StandardOperatingProcedure:
        generator = SOPGenerator()
        return generator._parse_to_sop(markdown, "Parsed SOP", "general", None)


class SOPStorage:
    """SQLite storage for SOPs."""

    def __init__(self, db_path: str = "sops.db"):
        self.db_path = db_path
        self._ensure_schema()

    def _ensure_schema(self) -> None:
        with sqlite3.connect(self.db_path) as conn:
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS sops (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    title TEXT,
                    version TEXT,
                    domain TEXT,
                    status TEXT,
                    created_at REAL,
                    content TEXT
                )
                """
            )

    def save(self, sop: StandardOperatingProcedure) -> int:
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.execute(
                """
                INSERT INTO sops (title, version, domain, status, created_at, content)
                VALUES (?, ?, ?, ?, ?, ?)
                """,
                (
                    sop.title,
                    sop.version,
                    sop.metadata.get("domain", "general"),
                    sop.status,
                    sop.created_at,
                    sop.to_json(),
                ),
            )
            return int(cursor.lastrowid)

    def load(self, sop_id: int) -> Optional[StandardOperatingProcedure]:
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.execute(
                "SELECT content FROM sops WHERE id = ?",
                (sop_id,),
            )
            row = cursor.fetchone()
            if not row:
                return None
            data = json.loads(row[0])
            return StandardOperatingProcedure.from_dict(data)


# ============================================================================
# Main Entry Points
# ============================================================================

async def generate_sop(
    requirement: str,
    domain: str = "general",
    constraints: List[str] = None,
    equipment: List[str] = None
) -> StandardOperatingProcedure:
    """
    Generate a complete SOP from requirements.

    Args:
        requirement: High-level requirement description
        domain: Domain (e.g., "chemistry", "manufacturing")
        constraints: Specific constraints
        equipment: Available equipment

    Returns:
        Generated SOP

    Example:
        >>> sop = await generate_sop(
        ...     requirement="Create protocol for magnetic nanoparticle assembly",
        ...     domain="chemistry",
        ...     constraints=["Temperature must stay below 50°C"],
        ...     equipment=["Magnetometer", "Thermal stage"]
        ... )
        >>> print(sop.to_markdown())
    """
    generator = SOPGenerator()
    return await generator.generate_sop(
        requirement_description=requirement,
        domain=domain,
        constraints=constraints,
        equipment_available=equipment
    )


async def refine_sop(
    requirement: str,
    existing_sop: StandardOperatingProcedure,
    feedback: List[str] = None
) -> StandardOperatingProcedure:
    """
    Refine an existing SOP based on feedback or execution data.

    Args:
        requirement: What to improve or fix
        existing_sop: Current SOP to refine
        feedback: Specific issues or feedback

    Returns:
        Refined SOP
    """
    generator = SOPGenerator()
    feedback_text = ""
    if feedback:
        feedback_text = "\nFeedback:\n" + "\n".join(f"- {item}" for item in feedback)
    domain = existing_sop.metadata.get("domain", "general")
    equipment = [entry.get("name", "") for entry in existing_sop.equipment if entry.get("name")]
    return await generator.generate_sop(
        requirement_description=f"{requirement}{feedback_text}",
        domain=domain,
        constraints=feedback,
        equipment_available=equipment,
        existing_sop=existing_sop
    )


def validate_sop(sop: StandardOperatingProcedure) -> Dict[str, Any]:
    """Validate an SOP for completeness and execution readiness."""
    return SOPValidator().validate(sop)


def validate_sop_markdown(markdown: str) -> Dict[str, Any]:
    """Validate SOP from markdown content."""
    sop = SOPParser().parse(markdown)
    return SOPValidator().validate(sop)


def get_sop_capabilities() -> Dict[str, Any]:
    """Get SOP generator capabilities"""
    return {
        "sop_generation_enabled": True,
        "sop_refinement_enabled": True,
        "sop_validation_enabled": True,
        "requirement_analysis_enabled": True,
        "markdown_validation_enabled": True,
        "supported_domains": [
            "chemistry",
            "manufacturing",
            "software",
            "biology",
            "physics",
            "general"
        ],
        "features": {
            "zero_error_generation": "MAKER voting ensures complete SOPs",
            "parameter_optimization": "Automatic tolerance optimization",
            "completeness_checking": "All sections verified",
            "realism_validation": "Achievable tolerances enforced",
            "continuous_improvement": "Iterative refinement based on feedback",
            "curie_experiment_protocols": "Integration with Curie experimentation framework"
        },
        "paper": {
            "title": "Solving a Million-Step LLM Task with Zero Errors",
            "arxiv": "2511.09030",
            "url": "https://arxiv.org/abs/2511.09030"
        },
        "integrations": {
            "curie": "Automated scientific experimentation",
            "ace_steer": "Advanced control and steering",
            "maker": "Multi-agent validation framework"
        }
    }


# ============================================================================
# Curie Integration - Experiment Protocol Generation
# ============================================================================

async def generate_experiment_protocol(
    hypothesis: str,
    domain: str,
    constraints: Optional[List[str]] = None,
    available_equipment: Optional[List[str]] = None,
    experimental_variables: Optional[Dict[str, List[str]]] = None
) -> Dict[str, Any]:
    """
    Generate an experimental protocol using SOP Generator for Curie integration.

    This function creates rigorous experimental protocols that integrate with
    Curie's automated experimentation framework, filling GAP-4 (Experimental
    Data Integration) and GAP-12 (Scientific Experimentation Automation).

    Args:
        hypothesis: Scientific hypothesis to test
        domain: Experimental domain (physics, chemistry, biology, etc.)
        constraints: Experimental constraints
        available_equipment: Available laboratory equipment
        experimental_variables: Dict with keys:
            - independent: Variables being manipulated
            - dependent: Variables being measured
            - control: Variables kept constant

    Returns:
        Protocol dictionary with:
            - protocol_id: Unique identifier
            - hypothesis: Original hypothesis
            - domain: Scientific domain
            - steps: List of protocol steps
            - parameters: Experimental parameters
            - equipment: Required equipment
            - materials: Required materials
            - duration_estimate: Estimated duration in seconds
            - reproducibility_checks: List of reproducibility checks
            - safety_notes: Safety considerations
            - validation_criteria: Success criteria

    Example:
        >>> protocol = await generate_experiment_protocol(
        ...     hypothesis="Increasing temperature increases reaction rate",
        ...     domain="chemistry",
        ...     constraints=["temperature <= 100°C"],
        ...     available_equipment=["spectrometer", "hotplate"],
        ...     experimental_variables={
        ...         "independent": ["temperature"],
        ...         "dependent": ["reaction_rate"],
        ...         "control": ["pressure", "concentration"]
        ...     }
        ... )
    """
    logger.info(f"Generating experimental protocol for domain: {domain}")

    # Build requirement description for SOP Generator
    requirement_parts = [
        f"Design a rigorous experimental protocol to test the hypothesis: {hypothesis}",
        f"Domain: {domain}",
    ]

    if experimental_variables:
        if experimental_variables.get("independent"):
            requirement_parts.append(
                f"Independent variables (to manipulate): {', '.join(experimental_variables['independent'])}"
            )
        if experimental_variables.get("dependent"):
            requirement_parts.append(
                f"Dependent variables (to measure): {', '.join(experimental_variables['dependent'])}"
            )
        if experimental_variables.get("control"):
            requirement_parts.append(
                f"Control variables (to keep constant): {', '.join(experimental_variables['control'])}"
            )

    if constraints:
        requirement_parts.append(f"Constraints: {', '.join(constraints)}")

    if available_equipment:
        requirement_parts.append(f"Available equipment: {', '.join(available_equipment)}")

    requirement_parts.extend([
        "Protocol must include:",
        "- Detailed step-by-step procedures",
        "- All required materials and equipment",
        "- Parameter specifications with tolerances",
        "- Safety considerations",
        "- Quality control checkpoints",
        "- Validation criteria for success",
        "- Reproducibility checks",
        "- Estimated duration for each step"
    ])

    requirement_description = "\n".join(requirement_parts)

    # Generate SOP using SOP Generator
    generator = SOPGenerator()
    sop = await generator.generate_sop(
        requirement_description=requirement_description,
        domain=domain,
        constraints=constraints or [],
        equipment_available=available_equipment or []
    )

    # Convert SOP to Curie protocol format
    protocol_steps = []
    for step in sop.protocols:
        protocol_step = {
            "step_number": step.step_number,
            "title": f"Step {step.step_number}",
            "description": step.action,
            "action": step.action,
            "duration": step.duration or 300,  # Default 5 minutes
            "duration_tolerance": step.duration_tolerance,
            "parameters": {},
            "materials": [],
            "equipment": [],
            "safety_notes": [],
            "validation_criteria": {
                "verification_method": step.verification_method,
                "acceptance_criteria": step.acceptance_criteria
            }
        }

        # Add substeps if present
        if step.substeps:
            protocol_step["substeps"] = step.substeps

        protocol_steps.append(protocol_step)

    # Extract equipment and materials from SOP
    equipment_list = [
        {
            "name": eq.get("name", "Unknown"),
            "specification": eq.get("specification", ""),
            "quantity": eq.get("quantity", 1)
        }
        for eq in sop.equipment
    ]

    materials_list = [
        {
            "name": mat.get("name", "Unknown"),
            "quantity": mat.get("quantity", ""),
            "purity": mat.get("purity", ""),
            "hazards": mat.get("hazards", [])
        }
        for mat in sop.materials
    ]

    # Generate reproducibility checks from QC and validation criteria
    reproducibility_checks = []
    reproducibility_checks.extend(sop.quality_control)
    reproducibility_checks.extend(sop.validation_criteria)

    # Estimate total duration
    duration_estimate = sum(
        step.duration for step in sop.protocols if step.duration
    )

    # Create protocol dictionary
    protocol = {
        "protocol_id": f"{domain}_{int(time.time())}",
        "hypothesis": hypothesis,
        "domain": domain,
        "steps": protocol_steps,
        "parameters": _extract_parameters_from_sop(sop),
        "equipment": equipment_list,
        "materials": materials_list,
        "duration_estimate": duration_estimate,
        "reproducibility_checks": reproducibility_checks,
        "safety_notes": sop.safety_protocols,
        "validation_criteria": sop.validation_criteria,
        "metadata": {
            "sop_version": sop.version,
            "sop_status": sop.status,
            "generated_at": datetime.now().isoformat(),
            "classification": sop.classification
        }
    }

    logger.info(f"Generated experimental protocol: {protocol['protocol_id']}")
    return protocol


def _extract_parameters_from_sop(sop: StandardOperatingProcedure) -> Dict[str, Any]:
    """Extract experimental parameters from SOP"""
    parameters = {}

    # Environmental conditions (temperature, pressure, humidity, etc.)
    for key, value in sop.environmental_conditions.items():
        parameters[key] = {
            "value": value.value,
            "unit": value.unit,
            "tolerance": value.tolerance,
            "critical": value.critical
        }

    return parameters


async def refine_experiment_protocol(
    original_protocol: Dict[str, Any],
    execution_feedback: List[SOPExecutionFeedback],
    experimental_results: Optional[Dict[str, Any]] = None
) -> Dict[str, Any]:
    """
    Refine an experimental protocol based on execution feedback and results.

    This function uses the SOP Generator's refinement capabilities to improve
    experimental protocols based on actual execution data, supporting Curie's
    reflection-based refinement cycle.

    Args:
        original_protocol: Original protocol dictionary
        execution_feedback: List of feedback entries from protocol execution
        experimental_results: Optional experimental results data

    Returns:
        Refined protocol dictionary

    Example:
        >>> refined_protocol = await refine_experiment_protocol(
        ...     original_protocol=protocol,
        ...     execution_feedback=[
        ...         SOPExecutionFeedback(
        ...             component="temperature_control",
        ...             issue="Temperature fluctuated beyond tolerance",
        ...             severity="high",
        ...             recommended_action="Improve insulation"
        ...         )
        ...     ]
        ... )
    """
    logger.info("Refining experimental protocol based on feedback")

    # Convert protocol back to SOP format
    sop_steps = []
    for step_dict in original_protocol.get("steps", []):
        sop_step = SOPStep(
            step_number=step_dict.get("step_number", 0),
            action=step_dict.get("action", ""),
            duration=step_dict.get("duration"),
            duration_tolerance=step_dict.get("duration_tolerance"),
            verification_method=step_dict.get("validation_criteria", {}).get("verification_method", ""),
            acceptance_criteria=step_dict.get("validation_criteria", {}).get("acceptance_criteria", ""),
            contingency_action=step_dict.get("contingency_action", "")
        )
        sop_steps.append(sop_step)

    # Reconstruct SOP
    sop = StandardOperatingProcedure(
        title=f"Experimental Protocol: {original_protocol.get('hypothesis', 'Unknown')}",
        version="2.0",
        status="REFINED",
        effective_date=datetime.now().strftime("%Y-%m-%d"),
        description=f"Refined protocol for hypothesis: {original_protocol.get('hypothesis', 'Unknown')}",
        protocols=sop_steps,
        safety_protocols=original_protocol.get("safety_notes", []),
        validation_criteria=original_protocol.get("validation_criteria", []),
        quality_control=original_protocol.get("reproducibility_checks", []),
        metadata=original_protocol.get("metadata", {})
    )

    # Use SOP Generator's refinement
    generator = SOPGenerator()
    refined_sop = await generator.refine_sop(
        existing_sop=sop,
        feedback=execution_feedback
    )

    # Convert back to protocol format
    refined_protocol = await generate_experiment_protocol(
        hypothesis=original_protocol.get("hypothesis", ""),
        domain=original_protocol.get("domain", "general"),
        constraints=original_protocol.get("metadata", {}).get("constraints", []),
        available_equipment=[eq.get("name") for eq in original_protocol.get("equipment", [])]
    )

    # Update version
    refined_protocol["protocol_id"] = f"{original_protocol.get('protocol_id')}_refined"
    refined_protocol["metadata"]["refined_from"] = original_protocol.get("protocol_id")
    refined_protocol["metadata"]["refinement_count"] = original_protocol.get("metadata", {}).get("refinement_count", 0) + 1

    logger.info(f"Refined protocol: {refined_protocol['protocol_id']}")
    return refined_protocol


def validate_experiment_protocol(protocol: Dict[str, Any]) -> Dict[str, Any]:
    """
    Validate an experimental protocol for completeness and readiness.

    Args:
        protocol: Protocol dictionary from generate_experiment_protocol()

    Returns:
        Validation report with:
            - valid: Boolean indicating overall validity
            - completeness_score: Float from 0.0 to 1.0
            - checks_performed: List of validation checks
            - issues: List of identified issues
            - warnings: List of warnings
            - recommendations: List of improvement suggestions

    Example:
        >>> validation = validate_experiment_protocol(protocol)
        >>> if validation["valid"]:
        ...     print("Protocol is ready for execution")
    """
    logger.info(f"Validating experimental protocol: {protocol.get('protocol_id')}")

    issues = []
    warnings = []
    checks_performed = []

    # Check required fields
    required_fields = [
        "protocol_id",
        "hypothesis",
        "domain",
        "steps",
        "equipment",
        "materials",
        "validation_criteria"
    ]

    for field in required_fields:
        if field not in protocol:
            issues.append(f"Missing required field: {field}")
        else:
            checks_performed.append(f"Field present: {field}")

    # Check hypothesis
    if "hypothesis" in protocol:
        hypothesis = protocol["hypothesis"]
        if not hypothesis or len(hypothesis) < 10:
            issues.append("Hypothesis is too short or missing")
        checks_performed.append("Hypothesis validated")

    # Check protocol steps
    if "steps" in protocol:
        steps = protocol["steps"]
        if len(steps) == 0:
            issues.append("No protocol steps defined")
        else:
            checks_performed.append(f"Protocol steps defined: {len(steps)} steps")

            # Check each step
            for i, step in enumerate(steps):
                if "action" not in step or not step["action"]:
                    issues.append(f"Step {i+1} missing action")
                if "duration" not in step:
                    warnings.append(f"Step {i+1} missing duration")

    # Check equipment
    if "equipment" in protocol:
        equipment = protocol["equipment"]
        if len(equipment) == 0:
            warnings.append("No equipment specified")
        else:
            checks_performed.append(f"Equipment specified: {len(equipment)} items")

    # Check materials
    if "materials" in protocol:
        materials = protocol["materials"]
        if len(materials) == 0:
            warnings.append("No materials specified")
        else:
            checks_performed.append(f"Materials specified: {len(materials)} items")

    # Check validation criteria
    if "validation_criteria" in protocol:
        criteria = protocol["validation_criteria"]
        if len(criteria) == 0:
            issues.append("No validation criteria defined")
        else:
            checks_performed.append(f"Validation criteria: {len(criteria)} criteria")

    # Check safety notes
    if "safety_notes" in protocol:
        safety = protocol["safety_notes"]
        if len(safety) == 0:
            warnings.append("No safety notes provided")
        else:
            checks_performed.append(f"Safety notes: {len(safety)} notes")

    # Check reproducibility checks
    if "reproducibility_checks" in protocol:
        repro_checks = protocol["reproducibility_checks"]
        if len(repro_checks) == 0:
            warnings.append("No reproducibility checks defined")
        else:
            checks_performed.append(f"Reproducibility checks: {len(repro_checks)} checks")

    # Calculate completeness score
    total_checks = len(required_fields) + 5  # fields + steps + equipment + materials + criteria + safety + reproducibility
    passed_checks = len([c for c in checks_performed if "defined" in c.lower() or "specified" in c.lower() or "present" in c.lower()])
    completeness_score = min(1.0, passed_checks / total_checks if total_checks > 0 else 0.0)

    # Determine overall validity
    valid = len(issues) == 0

    # Generate recommendations
    recommendations = []
    if len(warnings) > 0:
        recommendations.append("Review warnings and add missing information if applicable")
    if completeness_score < 0.8:
        recommendations.append("Improve protocol completeness")
    if len(protocol.get("steps", [])) < 3:
        recommendations.append("Consider adding more detailed steps")
    if not protocol.get("safety_notes"):
        recommendations.append("Add safety notes for experimental procedures")

    validation_report = {
        "valid": valid,
        "completeness_score": completeness_score,
        "checks_performed": checks_performed,
        "issues": issues,
        "warnings": warnings,
        "recommendations": recommendations
    }

    logger.info(
        f"Validation complete: valid={valid}, "
        f"completeness={completeness_score:.2f}, "
        f"issues={len(issues)}, warnings={len(warnings)}"
    )

    return validation_report
