class TestBasicPESExecution:
    """Test basic PES (Plan-Execute-Summarize) execution."""

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_submit_and_execute_problem(self, setup_adapters, sample_problem):
        """Test submitting a problem and getting results."""
        loongflow_adapter = setup_adapters['loongflow']

        # Submit problem
        result = await loongflow_adapter.submit_problem(sample_problem)
        execution_id = result['execution_id']

        # Assert submission
        assert execution_id is not None
        assert result['status'] == 'SUBMITTED'
        assert 'submitted_at' in result

        # Wait for completion (simulated)
        await asyncio.sleep(0.1)

        # Get status
        status = await loongflow_adapter.get_status(execution_id)

        # Assert status
        assert status['execution_id'] == execution_id
        assert status['state'] in ['COMPLETED', 'RUNNING', 'SUBMITTED']
        assert 'progress' in status

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_retrieve_solution_results(self, setup_adapters, sample_problem):
        """Test retrieving solution results."""
        loongflow_adapter = setup_adapters['loongflow']

        # Submit and get result
        submit_result = await loongflow_adapter.submit_problem(sample_problem)
        execution_id = submit_result['execution_id']

        solution = await loongflow_adapter.get_result(execution_id)

        # Assert solution structure
        assert 'solution_id' in solution
        assert 'score' in solution or 'fitness' in solution
        assert 0 <= solution.get('score', solution.get('fitness', 0)) <= 1
        assert 'solution' in solution
        assert isinstance(solution['solution'], str)

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_pes_cycle_complete(self, setup_adapters):
        """Test complete Plan → Execute → Summarize cycle."""
        loongflow_adapter = setup_adapters['loongflow']

        problem = {
            'type': 'REASONING',
            'description': 'Prove that sqrt(2) is irrational',
            'context': {
                'domain': 'mathematics',
                'difficulty': 'medium'
            }
        }

        # Submit
        result = await loongflow_adapter.submit_problem(problem)
        execution_id = result['execution_id']

        # Get final result
        final_result = await loongflow_adapter.get_result(execution_id)

        # Assert PES phases
        assert 'generate_plan' in final_result or 'plan' in final_result
        assert 'solution' in final_result or 'execution' in final_result
        assert 'summary' in final_result
        assert 'score' in final_result or 'fitness' in final_result

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_get_best_solutions(self, setup_adapters):
        """Test retrieving best solutions from evolutionary database."""
        loongflow_adapter = setup_adapters['loongflow']

        solutions = await loongflow_adapter.get_best_solutions({
            'island_id': 'all',
            'top_k': 5
        })

        # Assert solutions retrieved
        assert isinstance(solutions, list)
        assert len(solutions) > 0
        assert all('solution_id' in s for s in solutions)
        assert all('score' in s or 'fitness' in s for s in solutions)
        assert all(0 <= s.get('score', s.get('fitness', 0)) <= 1 for s in solutions)


