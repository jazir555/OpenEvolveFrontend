class TestPerformanceAndScalability:
    """Test performance and scalability aspects."""

    @pytest.mark.asyncio
    @pytest.mark.e2e
    @pytest.mark.slow
    async def test_concurrent_problem_execution(self, setup_adapters):
        """Test executing multiple problems concurrently."""
        loongflow_adapter = setup_adapters['loongflow']

        # Create multiple problems
        problems = [
            {
                'type': 'OPTIMIZATION',
                'description': f'Problem {i}',
                'context': {'index': i}
            }
            for i in range(5)
        ]

        # Execute concurrently
        tasks = [
            loongflow_adapter.submit_problem(p)
            for p in problems
        ]
        results = await asyncio.gather(*tasks)

        # Assert all problems submitted
        assert len(results) == 5
        assert all('execution_id' in r for r in results)

    @pytest.mark.asyncio
    @pytest.mark.e2e
    @pytest.mark.slow
    async def test_workflow_execution_time(self, setup_adapters, e2e_config):
        """Test that workflows complete within acceptable time."""
        loongflow_adapter = setup_adapters['loongflow']
        openevolve_adapter = setup_adapters['openevolve']

        problem = {'type': 'OPTIMIZATION', 'description': 'Test'}

        # Measure PES execution time
        start_time = time.time()
        pes_result = await loongflow_adapter.submit_problem(problem)
        pes_solution = await loongflow_adapter.get_result(pes_result['execution_id'])
        pes_time = time.time() - start_time

        # Assert completes in reasonable time
        assert pes_time < e2e_config['timeout']

    @pytest.mark.asyncio
    @pytest.mark.e2e
