# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

async def wait_for_completion(
    execution_id: str,
    adapter,
    timeout: int = 60,
    poll_interval: float = 0.5
) -> Dict[str, Any]:
    """
    Wait for execution to complete.

    Args:
        execution_id: Execution ID to wait for
        adapter: Adapter instance
        timeout: Maximum time to wait in seconds
        poll_interval: Time between status checks

    Returns:
        Final status

    Raises:
        TimeoutError: If execution does not complete in time
    """
    start_time = time.time()

    while time.time() - start_time < timeout:
        status = await adapter.get_status(execution_id)

        if status['state'] in ['COMPLETED', 'FAILED', 'CANCELLED']:
            return status

        await asyncio.sleep(poll_interval)

    raise TimeoutError(
        f"Execution {execution_id} did not complete in {timeout}s"
    )


def create_test_problem(**kwargs) -> Dict[str, Any]:
    """
    Create a test problem with default values.

    Args:
        **kwargs: Problem fields to override

    Returns:
        Test problem dictionary
    """
    defaults = {
        'id': str(uuid.uuid4()),
        'type': 'OPTIMIZATION',
        'description': 'Test optimization problem',
        'context': {},
        'constraints': [],
        'success_criteria': [],
        'created_at': datetime.now(timezone.utc).isoformat()
    }
    defaults.update(kwargs)
    return defaults


# ============================================================================
# TEST MARKERS CONFIGURATION
# ============================================================================

def pytest_configure(config):
    """Configure pytest markers."""
    config.addinivalue_line(
        "markers", "e2e: End-to-end integration tests"
    )
    config.addinivalue_line(
        "markers", "slow: Slow-running tests"
    )
