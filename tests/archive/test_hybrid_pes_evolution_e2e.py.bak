class TestEvolutionaryOptimization:
    """Test evolutionary optimization integration."""

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_evolve_solution(self, setup_adapters):
        """Test evolving a solution with OpenEvolve."""
        openevolve_adapter = setup_adapters['openevolve']

        initial_solution = "def solve(x): return x * 2"

        result = await openevolve_adapter.optimize({
            'solution': initial_solution,
            'generations': 5,
            'population_size': 20,
            'mutation_rate': 0.1
        })

        # Assert evolution completed
        assert 'optimization_id' in result
        assert 'best_fitness' in result
        assert result['best_fitness'] >= 0
        assert 'generations' in result
        assert result['generations'] == 5
        assert 'final_population' in result

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_multi_generation_evolution(self, setup_adapters):
        """Test multiple generations of evolution."""
        openevolve_adapter = setup_adapters['openevolve']

        initial_solution = "def optimize(x): return x ** 2"

        result = await openevolve_adapter.optimize({
            'solution': initial_solution,
            'generations': 10,
            'population_size': 50,
            'crossover_rate': 0.8,
            'mutation_rate': 0.2
        })

        # Assert multi-generation evolution
        assert result['generations'] == 10
        assert 'final_population' in result
        assert len(result['final_population']) <= 50
        assert 'optimization_history' in result
        assert len(result['optimization_history']) == 11  # 0-10 generations

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_evolutionary_parameters(self, setup_adapters):
        """Test different evolutionary parameters."""
        openevolve_adapter = setup_adapters['openevolve']

        test_cases = [
            {'generations': 3, 'population_size': 10},
            {'generations': 5, 'population_size': 20, 'mutation_rate': 0.15},
            {'generations': 7, 'population_size': 30, 'crossover_rate': 0.9}
        ]

        for params in test_cases:
            result = await openevolve_adapter.optimize({
                'solution': 'test solution',
                **params
            })

            assert result['generations'] == params['generations']
            assert result['population_size'] == params['population_size']


