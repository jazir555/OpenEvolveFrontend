class TestHybridWorkflows:
    """Test hybrid PES-Evolution workflows."""

    @pytest.mark.asyncio
    @pytest.mark.e2e
    @pytest.mark.slow
    async def test_pes_evolution_workflow(self, setup_adapters, sample_hybrid_task):
        """Test complete PES → Evolution workflow."""
        loongflow_adapter = setup_adapters['loongflow']
        openevolve_adapter = setup_adapters['openevolve']

        # Step 1: PES execution
        pes_result = await loongflow_adapter.submit_problem(
            sample_hybrid_task['problem']
        )
        pes_execution_id = pes_result['execution_id']

        # Step 2: Get PES result
        pes_solution = await loongflow_adapter.get_result(pes_execution_id)

        # Step 3: Evolve the solution
        evolution_result = await openevolve_adapter.optimize({
            'solution': pes_solution['solution'],
            'generations': sample_hybrid_task['evolution_config']['generations'],
            'population_size': sample_hybrid_task['evolution_config']['population_size']
        })

        # Assert workflow completed
        assert 'execution_id' in pes_result
        assert 'solution' in pes_solution
        assert 'optimization_id' in evolution_result
        assert evolution_result['best_fitness'] >= pes_solution.get('score', 0)

        # Integration metrics
        integration_metrics = {
            'synergy_score': evolution_result['best_fitness'] - pes_solution.get('score', 0),
            'total_time': 0,  # Would track actual time
            'paradigm_switches': 1
        }

        assert integration_metrics['synergy_score'] >= -0.1  # Allow some degradation

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_knowledge_extraction_workflow(self, setup_adapters, e2e_config):
        """Test knowledge extraction and storage."""
        if not e2e_config['enable_knowledge_tests']:
            pytest.skip("Knowledge tests not enabled")

        loongflow_adapter = setup_adapters['loongflow']

        # Get best solutions
        solutions = await loongflow_adapter.get_best_solutions({
            'island_id': 'all',
            'top_k': 3
        })

        # Extract knowledge patterns
        knowledge_fragments = []
        for solution in solutions:
            fragment = {
                'id': str(uuid.uuid4()),
                'source_type': 'LOONGFLOW_SOLUTION',
                'problem_id': solution.get('problem_id'),
                'pattern': solution.get('generate_plan', ''),
                'success_rate': solution.get('score', solution.get('fitness', 0)),
                'avg_score': solution.get('score', solution.get('fitness', 0)),
                'usage_count': 0,
                'extracted_at': datetime.now(timezone.utc).isoformat()
            }
            knowledge_fragments.append(fragment)

        # Assert knowledge extracted
        assert len(knowledge_fragments) > 0
        assert all('id' in k for k in knowledge_fragments)
        assert all('pattern' in k for k in knowledge_fragments)
        assert all(0 <= k['success_rate'] <= 1 for k in knowledge_fragments)

    @pytest.mark.asyncio
    @pytest.mark.e2e
    async def test_adaptive_execution_workflow(self, setup_adapters):
        """Test adaptive paradigm switching."""
        loongflow_adapter = setup_adapters['loongflow']
        openevolve_adapter = setup_adapters['openevolve']

        # Create problem that might trigger adaptive switching
        problem = {
            'type': 'COMPLEX_OPTIMIZATION',
            'description': 'Solve complex multi-objective optimization',
            'context': {
                'complexity': 'high',
                'objectives': ['minimize_cost', 'maximize_quality']
            }
        }

        # Execute PES first
        pes_result = await loongflow_adapter.submit_problem(problem)
        pes_solution = await loongflow_adapter.get_result(pes_result['execution_id'])

        # Check if confidence is low (triggers evolution)
        confidence = pes_solution.get('score', pes_solution.get('fitness', 0))
        paradigm_switches = 0

        if confidence < 0.8:
            # Switch to evolution
            evolution_result = await openevolve_adapter.optimize({
                'solution': pes_solution['solution'],
                'generations': 5
            })
            paradigm_switches = 1

            # Assert evolution improved result
            assert evolution_result['best_fitness'] >= confidence

        # Assert adaptive behavior
        assert paradigm_switches >= 0
        assert 'final_paradigm' in {
            'final_paradigm': 'EVOLUTION' if paradigm_switches > 0 else 'PES'
        }

    @pytest.mark.asyncio
    @pytest.mark.e2e
    @pytest.mark.slow
    async def test_multi_stage_reasoning_workflow(self, setup_adapters):
        """Test multi-stage reasoning with validation."""
        loongflow_adapter = setup_adapters['loongflow']

        problem = {
            'type': 'FORMAL_VERIFICATION',
            'description': 'Verify correctness of sorting algorithm',
            'context': {
                'verification_method': 'formal_proof'
            }
        }

        # Stage 1: Plan
        result = await loongflow_adapter.submit_problem(problem)
        execution_id = result['execution_id']

        # Stage 2: Execute
        solution = await loongflow_adapter.get_result(execution_id)

        # Stage 3: Validate (simulated)
        validation_performed = 'validation' in solution or 'proof' in solution

        # Stage 4: Summarize
        summary = solution.get('summary', '')

        # Assert all stages
        stages_completed = {
            'PLAN': 'generate_plan' in solution or 'plan' in solution,
            'EXECUTE': 'solution' in solution,
            'VALIDATE': validation_performed,
            'SUMMARIZE': len(summary) > 0
        }

        assert all(stages_completed.values())


