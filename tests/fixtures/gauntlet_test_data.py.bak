PERFECT_SOLUTIONS = [
    TestSolution(
        solution_id="perfect_portfolio_opt_001",
        code='''\n
import numpy as np
from scipy.optimize import minimize
from typing import Dict, List, Tuple

class PortfolioOptimizer:
    '''Modern portfolio theory implementation with constraint handling'''

    def __init__(self, returns: np.ndarray, risk_tolerance: float = 0.1):
        """
        Initialize portfolio optimizer

        Args:
            returns: Historical return matrix (assets x time)
            risk_tolerance: Maximum acceptable portfolio variance
        """
        self.returns = returns
        self.risk_tolerance = risk_tolerance
        self.n_assets = returns.shape[0]
        self.mean_returns = np.mean(returns, axis=1)
        self.cov_matrix = np.cov(returns)

    def optimize(self) -> Dict[str, Any]:
        '''Optimize portfolio allocation using quadratic programming'''
        # Objective: minimize negative Sharpe ratio
        def objective(weights):
            portfolio_return = np.dot(self.mean_returns, weights)
            portfolio_variance = np.dot(weights.T, np.dot(self.cov_matrix, weights))
            return -(portfolio_return / np.sqrt(portfolio_variance))

        # Constraints
        constraints = [
            {'type': 'eq', 'fun': lambda w: np.sum(w) - 1.0},  # Fully invested
            {'type': 'ineq', 'fun': lambda w: self.risk_tolerance - np.dot(w.T, np.dot(self.cov_matrix, w))}
        ]

        # Bounds: no short selling
        bounds = tuple((0, 1) for _ in range(self.n_assets))

        # Initial guess: equal weight
        x0 = np.array([1.0 / self.n_assets] * self.n_assets)

        # Optimize
        result = minimize(
            objective,
            x0,
            method='SLSQP',
            bounds=bounds,
            constraints=constraints,
            options={'ftol': 1e-9}
        )

        if not result.success:
            raise RuntimeError(f"Optimization failed: {result.message}")

        # Extract results
        optimal_weights = result.x
        expected_return = np.dot(self.mean_returns, optimal_weights)
        expected_variance = np.dot(optimal_weights.T, np.dot(self.cov_matrix, optimal_weights))
        sharpe_ratio = expected_return / np.sqrt(expected_variance)

        return {
            'weights': optimal_weights.tolist(),
            'expected_return': float(expected_return),
            'expected_variance': float(expected_variance),
            'sharpe_ratio': float(sharpe_ratio),
            'status': result.success
        }

    def validate_solution(self, solution: Dict[str, Any]) -> bool:
        '''Validate solution meets constraints'''
        weights = np.array(solution['weights'])

        # Check fully invested
        if not np.isclose(np.sum(weights), 1.0, atol=1e-6):
            return False

        # Check no short selling
        if np.any(weights < -1e-10):
            return False

        # Check risk tolerance
        variance = np.dot(weights.T, np.dot(self.cov_matrix, weights))
        if variance > self.risk_tolerance + 1e-6:
            return False

        return True


# Example usage
if __name__ == '__main__':
    # Generate sample returns
    np.random.seed(42)
    returns = np.random.randn(10, 252) * 0.02  # 10 assets, 1 year of daily returns

    optimizer = PortfolioOptimizer(returns, risk_tolerance=0.01)
    result = optimizer.optimize()

    print(f"Optimal Weights: {result['weights']}")
    print(f"Expected Return: {result['expected_return']:.4f}")
    print(f"Expected Variance: {result['expected_variance']:.6f}")
    print(f"Sharpe Ratio: {result['sharpe_ratio']:.4f}")
    print(f"Valid: {optimizer.validate_solution(result)}")
""",
        problem_type="portfolio_optimization",
        domain="finance",
        expected_round1_score=0.95,
        expected_round2_score=0.92,
        expected_round3_score=0.90,
        expected_final_score=0.917,
        should_pass_round1=True,
        should_pass_round2=True,
        should_pass_round3=True,
        expected_termination_round=None,
        artifacts=[
            "covariance_matrix",
            "efficient_frontier",
            "constraint_satisfaction_proof"
        ],
        strengths=[
            "Proper use of scipy.optimize",
            "Constraint handling",
            "Well-documented",
            "Type hints",
            "Error handling",
            "Validation method",
            "Efficient numerical computation"
        ]
    ),
    TestSolution(
        solution_id="perfect_ml_pipeline_002",
        code="""
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import cross_val_score, StratifiedKFold
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from typing import Dict, Any, Tuple
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class MLPipeline:
    """
    Production-ready ML pipeline with proper validation and preprocessing
    """

    def __init__(self, n_estimators: int = 100, random_state: int = 42):
        self.n_estimators = n_estimators
        self.random_state = random_state
        self.pipeline = None
        self.feature_names = None

    def create_pipeline(self) -> Pipeline:
        """Create sklearn pipeline with preprocessing and model"""
        pipeline = Pipeline([
            ('scaler', StandardScaler()),
            ('classifier', RandomForestClassifier(
                n_estimators=self.n_estimators,
                random_state=self.random_state,
                n_jobs=-1,
                class_weight='balanced'
            ))
        ])
        return pipeline

    def train(self, X: pd.DataFrame, y: pd.Series) -> Dict[str, Any]:
        """
        Train model with cross-validation

        Args:
            X: Feature DataFrame
            y: Target series

        Returns:
            Training metrics dictionary
        """
        self.feature_names = X.columns.tolist()

        # Create pipeline
        self.pipeline = self.create_pipeline()

        # Cross-validation
        cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=self.random_state)
        cv_scores = cross_val_score(
            self.pipeline, X, y,
            cv=cv,
            scoring='f1_weighted',
            n_jobs=-1
        )

        # Train on full dataset
        self.pipeline.fit(X, y)

        # Extract metrics
        metrics = {
            'cv_f1_mean': float(cv_scores.mean()),
            'cv_f1_std': float(cv_scores.std()),
            'cv_scores': cv_scores.tolist(),
            'feature_importance': dict(zip(
                self.feature_names,
                self.pipeline.named_steps['classifier'].feature_importances_.tolist()
            ))
        }

        logger.info(f"Training completed. CV F1: {metrics['cv_f1_mean']:.4f} (+/- {metrics['cv_f1_std']:.4f})")

        return metrics

    def predict(self, X: pd.DataFrame) -> np.ndarray:
        """Make predictions on new data"""
        if self.pipeline is None:
            raise RuntimeError("Model not trained. Call train() first.")

        if not all(col in X.columns for col in self.feature_names):
            raise ValueError("Missing features in input data")

        return self.pipeline.predict(X)

    def predict_proba(self, X: pd.DataFrame) -> np.ndarray:
        """Get prediction probabilities"""
        if self.pipeline is None:
            raise RuntimeError("Model not trained. Call train() first.")

        return self.pipeline.predict_proba(X)

    def evaluate(self, X: pd.DataFrame, y: pd.Series) -> Dict[str, float]:
        """Evaluate model on test set"""
        from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

        y_pred = self.predict(X)

        metrics = {
            'accuracy': accuracy_score(y, y_pred),
            'precision': precision_score(y, y_pred, average='weighted'),
            'recall': recall_score(y, y_pred, average='weighted'),
            'f1': f1_score(y, y_pred, average='weighted')
        }

        return metrics


# Example usage
if __name__ == '__main__':
    from sklearn.datasets import make_classification

    # Generate sample data
    X, y = make_classification(
        n_samples=1000,
        n_features=20,
        n_informative=15,
        n_redundant=5,
        n_classes=3,
        random_state=42
    )

    X_df = pd.DataFrame(X, columns=[f'feature_{i}' for i in range(20)])
    y_series = pd.Series(y)

    # Train pipeline
    pipeline = MLPipeline(n_estimators=100)
    metrics = pipeline.train(X_df, y_series)

    print(f"Cross-Validation F1: {metrics['cv_f1_mean']:.4f} (+/- {metrics['cv_f1_std']:.4f})")
    print(f"Feature Importance: {metrics['feature_importance']}")
""",
        problem_type="classification",
        domain="machine_learning",
        expected_round1_score=0.93,
        expected_round2_score=0.90,
        expected_round3_score=0.91,
        expected_final_score=0.908,
        should_pass_round1=True,
        should_pass_round2=True,
        should_pass_round3=True,
        expected_termination_round=None,
        artifacts=[
            "cross_validation_results",
            "feature_importance_analysis",
            "confusion_matrix"
        ],
        strengths=[
            "Proper sklearn pipeline",
            "Cross-validation",
            "Feature preprocessing",
            "Comprehensive logging",
            "Type safety",
            "Error handling",
            "Multiple evaluation metrics"
        ]
    )
]


