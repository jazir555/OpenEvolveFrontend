        """Test get_config singleton"""
        config1 = get_config()
        config2 = get_config()

        # Should return same instance
        assert config1 is config2


# =============================================================================
# Performance Tests
# =============================================================================

class TestPerformance:
    """Performance and stress tests"""

    @pytest.mark.slow
    def test_large_constraint_set(self, test_config):
        """Test pipeline with large constraint set"""
        # Create many constraints
        constraints = [
            {
                'id': f'c{i}',
                'type': 'soft',
                'description': f'Constraint {i}',
                'formalization': f'x{i} > 0',
                'source': 'test'
            }
            for i in range(100)
        ]

        problem = ProblemInput(
            id="large_problem",
            description="Large constraint test",
            constraints=constraints,
            variables={f'x{i}': {'type': 'real'} for i in range(100)}
        )

        pipeline = RESEPipeline(test_config)
        result = pipeline.run(problem, phases=['phase1'], use_cache=False)

        assert result.status in [PipelineStatus.COMPLETED, PipelineStatus.FAILED]

    @pytest.mark.slow
    def test_pipeline_memory_efficiency(self, test_config):
        """Test pipeline memory efficiency"""
        import gc
        import sys

        pipeline = RESEPipeline(test_config)

        problem = ProblemInput(
            id="memory_test",
            description="Memory test",
            constraints=[
                {'id': 'c1', 'type': 'hard', 'description': 'Test',
                 'formalization': 'x > 0', 'source': 'test'}
            ],
            variables={'x': {'type': 'real'}}
        )

        # Get initial memory
        gc.collect()
        initial_size = sys.getsizeof(pipeline)

        # Run pipeline multiple times
        for i in range(10):
            result = pipeline.run(problem, phases=['phase1'], use_cache=False)

        # Check memory growth (should be reasonable)
        gc.collect()
        final_size = sys.getsizeof(pipeline)
        growth_ratio = final_size / initial_size if initial_size > 0 else 1

        # Memory growth should be less than 10x
        assert growth_ratio < 10.0


