        'TestLogging'
    ]

    for test_class in required_test_classes:
        if f"class {test_class}" not in test_content:
            print(f"[FAIL] Test file missing class: {test_class}")
            sys.exit(1)

    print(f"[OK] Test file has all {len(required_test_classes)} test classes")

except Exception as e:
    print(f"[FAIL] Test file check failed: {e}")
    sys.exit(1)

# Test 10: Check API documentation
print("\n[Test 10] Checking API documentation...")
try:
    with open("knowledge_engine/KNOWLEDGE_ENGINE_API.md", 'r', encoding='utf-8') as f:
        doc_content = f.read()

    required_sections = [
        '## Quick Start',
        '## Architecture',
        '## Configuration',
        '## API Reference',
        '## Usage Examples',
        '## Error Handling',
        '## Best Practices'
    ]

    for section in required_sections:
