#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
Verification script for KnowledgeEngine orchestration class.

Tests imports and basic functionality without requiring full dependencies.
"""

import sys
import os
from pathlib import Path

# Set UTF-8 encoding for Windows console
if sys.platform == 'win32':
    import codecs
    sys.stdout = codecs.getwriter('utf-8')(sys.stdout.buffer, 'strict')
    sys.stderr = codecs.getwriter('utf-8')(sys.stderr.buffer, 'strict')

# Add parent directory to path
sys.path.insert(0, str(Path(__file__).parent))

print("=" * 60)
print("KnowledgeEngine Verification Script")
print("=" * 60)

# Test 1: Import orchestration module
print("\n[Test 1] Importing orchestration module...")
try:
    from knowledge_engine import orchestration
    print("[OK] orchestration module imported successfully")
except ImportError as e:
    print(f"[FAIL] Failed to import orchestration: {e}")
    sys.exit(1)

# Test 2: Import main classes
print("\n[Test 2] Importing main classes...")
try:
    from knowledge_engine.orchestration import (
        KnowledgeEngine,
        create_knowledge_engine,
        ProcessingResult,
        QueryResult
    )
    print("[OK] KnowledgeEngine class imported")
    print("[OK] create_knowledge_engine function imported")
    print("[OK] ProcessingResult class imported")
    print("[OK] QueryResult class imported")
except ImportError as e:
    print(f"[FAIL] Failed to import classes: {e}")
    sys.exit(1)

# Test 3: Import from package __init__
print("\n[Test 3] Importing from package __init__...")
try:
    from knowledge_engine import (
        KnowledgeEngine,
        create_knowledge_engine,
        ProcessingResult,
        QueryResult,
        KnowledgeState,
        EntityKnowledgeGraph
    )
    print("[OK] All main classes imported from package")
except ImportError as e:
    print(f"[FAIL] Failed to import from package: {e}")
    sys.exit(1)

# Test 4: Check class structure
print("\n[Test 4] Checking class structure...")
try:
    # Check KnowledgeEngine has required methods
    required_methods = [
        'initialize',
        'close',
        'process_document',
        'query_temporal',
        'detect_contradictions',
        'visualize_graph',
        'search_knowledge',
        'get_statistics',
        'health_check'
    ]

    for method in required_methods:
        if not hasattr(KnowledgeEngine, method):
            print(f"[FAIL] KnowledgeEngine missing method: {method}")
            sys.exit(1)

    print(f"[OK] KnowledgeEngine has all {len(required_methods)} required methods")

    # Check dataclasses (dataclasses use __dataclass_fields__ attribute)
    assert hasattr(ProcessingResult, '__dataclass_fields__'), "ProcessingResult is not a dataclass"
    assert 'success' in ProcessingResult.__dataclass_fields__, "ProcessingResult missing 'success' field"
    assert hasattr(QueryResult, '__dataclass_fields__'), "QueryResult is not a dataclass"
    assert 'query' in QueryResult.__dataclass_fields__, "QueryResult missing 'query' field"
    print("[OK] ProcessingResult and QueryResult have required fields")

except AssertionError as e:
    print(f"[FAIL] Class structure check failed: {e}")
    sys.exit(1)

# Test 5: Check configuration loading
print("\n[Test 5] Checking configuration loading...")
try:
    # Test with minimal config
    engine = KnowledgeEngine(config={
        "openai_api_key": "test_key"
    })

    assert engine.config is not None, "Config is None"
    assert "openai_api_key" in engine.config, "Config missing openai_api_key"
    print("[OK] Configuration loading works")

    # Test config validation (should fail if missing required)
    try:
        bad_engine = KnowledgeEngine(config={
            "graphiti_uri": "bolt://localhost:7687",
            "graphiti_user": "neo4j",
            "graphiti_password": ""  # Empty = missing
        })
        print("[WARN] Config validation did not raise error (Graphiti may not be imported)")
    except RuntimeError:
        print("[OK] Configuration validation works (fails on missing required vars)")

except Exception as e:
    print(f"[FAIL] Configuration check failed: {e}")
    sys.exit(1)

# Test 6: Check async context manager
print("\n[Test 6] Checking async context manager support...")
try:
    assert hasattr(KnowledgeEngine, '__aenter__'), "Missing __aenter__"
    assert hasattr(KnowledgeEngine, '__aexit__'), "Missing __aexit__"
    print("[OK] Async context manager methods present")
except AssertionError as e:
    print(f"[FAIL] Async context manager check failed: {e}")
    sys.exit(1)

# Test 7: Check docstrings
print("\n[Test 7] Checking documentation...")
try:
    assert KnowledgeEngine.__doc__ is not None, "KnowledgeEngine missing docstring"
    assert create_knowledge_engine.__doc__ is not None, "create_knowledge_engine missing docstring"
    print("[OK] Documentation present")
except AssertionError as e:
    print(f"[FAIL] Documentation check failed: {e}")
    sys.exit(1)

# Test 8: Verify file structure
print("\n[Test 8] Verifying file structure...")
required_files = [
    "knowledge_engine/orchestration.py",
    "knowledge_engine/__init__.py",
    "knowledge_engine/tests/test_knowledge_engine.py",
    "knowledge_engine/KNOWLEDGE_ENGINE_API.md"
]

for file_path in required_files:
    if not Path(file_path).exists():
        print(f"[FAIL] Required file missing: {file_path}")
        sys.exit(1)

print(f"[OK] All {len(required_files)} required files present")

# Test 9: Check test file structure
print("\n[Test 9] Checking test file structure...")
try:
    with open("knowledge_engine/tests/test_knowledge_engine.py", 'r', encoding='utf-8') as f:
        test_content = f.read()

    required_test_classes = [
        'TestConfiguration',
