    print(f"[OK] API documentation has all {len(required_sections)} required sections")

except Exception as e:
    print(f"[FAIL] API documentation check failed: {e}")
    sys.exit(1)

# Final summary
print("\n" + "=" * 60)
print("[SUCCESS] ALL VERIFICATION TESTS PASSED")
print("=" * 60)
